---
// Replaces Starlight's hero on the homepage; anywhere else with a hero (Starlight's own 404 page) keeps Starlight's.
import StarlightHero from '@astrojs/starlight/components/Hero.astro';
import Screen from './Screen.astro';
import { latestRelease, local, repo } from '../lib/links';

const home = Astro.url.pathname.replace(/\/$/, '') === local('');
---

{
	home ? (
		<header class="home-hero">
			<div class="home-hero-text">
				{/* "_top" is the id Starlight's skip and "back to top" links aim at. */}
				<h1 id="_top">Open-source bookkeeping for small businesses and nonprofits</h1>
				<p class="home-lede">
					Invoices, bills, banking, inventory, sales tax, projects and reports, in your browser, with your books
					in a file or database you control. Every change is recorded, and the ledger always balances.
				</p>
				<div class="home-actions">
					<a class="home-button" href={latestRelease}>
						Download for Windows
					</a>
					<a class="home-button secondary" href={local('/guide/')}>
						Read the user guide
					</a>
				</div>
				<p class="home-small">
					Free software under the <a href={`${repo}/blob/master/LICENSE`}>GNU AGPL</a>. Several people?{' '}
					<a href="#install">Run it on a server</a>, with the same installer or Docker.
				</p>
				<p class="home-small">
					The Windows installer isn't code-signed yet, so Windows may warn before it runs:{' '}
					<a href="#download-check">why, and how to check it</a>.
				</p>
			</div>
			<figure class="home-hero-shot">
				<Screen
					name="dashboard"
					eager
					alt="The OpenBook dashboard for a demo company: cash in the bank, what customers owe and what is owed to vendors, profit for the month and year, and ratios."
				/>
				<figcaption>The dashboard of a demo company with two years of made-up books.</figcaption>
			</figure>
		</header>
	) : (
		<StarlightHero />
	)
}
