@* Category lines for bills, vendor credits and recurring bills (plus inventory item lines on bills, when Items is given). The parent owns the list and checks it with BillLineModel. *@

<div class="table-wrap">
    <table class="data entry">
        <thead>
            <tr>
                @if (Items.Count > 0)
                {
                    <th>Inventory item</th>
                    <th class="num">Qty</th>
                }
                <th>Category</th><th>Description</th><th class="num">Amount</th>
                @if (Classes is not null)
                {
                    <th>Class</th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Lines)
            {
                <tr @key="line">
                    @if (Items.Count > 0)
                    {
                        <td>
                            <SearchSelect Options="ItemOptions" @bind-Value="line.ItemId" @bind-Value:after="() => ItemChangedAsync(line)" EmptyText="(none)" Placeholder="Find an item…" AriaLabel="Inventory item" />
                        </td>
                        <td>
                            @if (line.ItemId is not null)
                            {
                                <input class="quantity" type="number" step="any" min="0" aria-label="Quantity" @bind="line.Quantity" @bind:after="() => QuantityChangedAsync(line)" />
                            }
                        </td>
                    }
                    <td>
                        @if (line.ItemId is { } chosen && Items.FirstOrDefault(i => i.Id == chosen) is { InventoryAssetAccountId: { } asset })
                        {
                            <span class="muted">@Labels.AccountName(Chart, asset, UseNumbers)</span>
                        }
                        else
                        {
                        <SearchSelect Options="CategoryOptions" @bind-Value="line.AccountId" @bind-Value:after="Changed.InvokeAsync" Placeholder="Find a category…" AriaLabel="Category" />
                        }
                    </td>
                    <td>
                        <input @bind="line.Description" aria-label="Description" />
                        @if (line.ItemId is { } tracked && Items.FirstOrDefault(i => i.Id == tracked)?.Tracking is { } tracking and not ItemTracking.None)
                        {
                            <input class="lots" @bind="line.Lots" aria-label="@(tracking == ItemTracking.Serial ? "Serial numbers" : "Lots")"
                                   placeholder="@(tracking == ItemTracking.Serial ? "Serial numbers received, e.g. SN1, SN2" : "Lots received, e.g. A-1 x 3; B-2 x 2")" />
                        }
                    </td>
                    <td><input class="amount" type="number" step="0.01" aria-label="Amount" @bind="line.Amount" @bind:after="Changed.InvokeAsync" /></td>
                    @if (Classes is not null)
                    {
                        <td><ClassSelect Classes="Classes" Value="line.ClassId" ValueChanged="v => line.ClassId = v" /></td>
                    }
                    <td>
                        @if (Lines.Count > 1)
                        {
                            <button type="button" class="remove" title="Remove line" aria-label="Remove line" @onclick="() => RemoveAsync(line)">×</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                @if (Items.Count > 0)
                {
                    <td></td>
                    <td></td>
                }
                <td><button type="button" class="secondary" @onclick="AddAsync">Add line</button></td>
                <td class="num">Total</td>
                <td class="num">@Labels.Amount(BillLineModel.Total(Lines))</td>
                <td colspan="@(Classes is null ? 1 : 2)"></td>
            </tr>
        </tfoot>
    </table>
</div>

@code {
    private IReadOnlyList<Item>? _itemsFor;
    private IReadOnlyList<PickerOption> _itemOptions = [];
    private IReadOnlyList<Account>? _categoriesFor;
    private IReadOnlyList<PickerOption> _categoryOptions = [];

    private IReadOnlyList<PickerOption> ItemOptions
    {
        get
        {
            if (!ReferenceEquals(_itemsFor, Items))
                (_itemsFor, _itemOptions) = (Items, PickerOptions.Items(Items));
            return _itemOptions;
        }
    }

    private IReadOnlyList<PickerOption> CategoryOptions
    {
        get
        {
            if (!ReferenceEquals(_categoriesFor, Categories))
                (_categoriesFor, _categoryOptions) = (Categories, PickerOptions.Accounts(Categories, Chart, UseNumbers));
            return _categoryOptions;
        }
    }


    /// <summary>Active classes when the company tracks them; null hides the class column.</summary>
    [Parameter]
    public IReadOnlyList<OpenBook.Application.Segments.SegmentChoice>? Classes { get; set; }
    [Parameter, EditorRequired]
    public List<BillLineModel> Lines { get; set; } = [];

    /// <summary>From <see cref="BillLineModel.Categories"/>.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<Account> Categories { get; set; } = [];

    [Parameter, EditorRequired]
    public ChartOfAccounts Chart { get; set; } = default!;

    [Parameter]
    public bool UseNumbers { get; set; }

    /// <summary>Active inventory items, for bills; leave empty where only categories are allowed.</summary>
    [Parameter]
    public IReadOnlyList<Item> Items { get; set; } = [];

    /// <summary>Raised after an edit that can change whether the lines are complete, so the parent re-renders.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    /// <summary>A newly chosen item fills in its name, one unit and its purchase cost.</summary>
    private Task ItemChangedAsync(BillLineModel line)
    {
        if (line.ItemId is { } id && Items.FirstOrDefault(i => i.Id == id) is { } item)
        {
            line.AccountId = null;
            line.Quantity ??= 1m;
            line.Description ??= item.Name;
            line.Amount ??= decimal.Round(line.Quantity.Value * item.PurchaseCost, 2, MidpointRounding.AwayFromZero);
        }
        else
        {
            line.Quantity = null;
        }

        return Changed.InvokeAsync();
    }

    private Task QuantityChangedAsync(BillLineModel line)
    {
        if (line.ItemId is { } id && Items.FirstOrDefault(i => i.Id == id) is { PurchaseCost: > 0m } item && line.Quantity is { } q)
            line.Amount = decimal.Round(q * item.PurchaseCost, 2, MidpointRounding.AwayFromZero);
        return Changed.InvokeAsync();
    }

    private Task AddAsync()
    {
        Lines.Add(new BillLineModel());
        return Changed.InvokeAsync();
    }

    private Task RemoveAsync(BillLineModel line)
    {
        Lines.Remove(line);
        return Changed.InvokeAsync();
    }
}
