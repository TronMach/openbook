@* A search-as-you-type picker for interactive forms (the ARIA combobox pattern): type part of a name to narrow the list,
   arrow keys and Enter to choose (searchselect.js), Esc or Tab to leave. Leaving with an exact name typed chooses it;
   anything else puts back the current choice. Given CustomerAdded, VendorAdded or ItemAdded it also offers to add a new
   one (QuickAdd), for people allowed to, and chooses it; the callback puts the record in the page's list first. *@

<div class="search-select @Class" @onfocusout="LeaveAsync">
    <input id="@Id" @ref="_input" class="search-input" type="text" role="combobox" autocomplete="off" spellcheck="false"
           aria-autocomplete="list" aria-expanded="@(_open ? "true" : "false")" aria-controls="@_listId" aria-label="@AriaLabel"
           placeholder="@Placeholder" value="@_text" disabled="@Disabled"
           @oninput="Typed" @onfocus="Open" @onclick="Open" />
    @if (_open)
    {
        <ul id="@_listId" class="search-list" role="listbox" aria-label="@(AriaLabel ?? Placeholder)">
            @if (EmptyText is not null && _query.Length == 0)
            {
                <li id="@($"{_listId}-none")" role="option" class="search-option muted" aria-selected="@(Value is null ? "true" : "false")"
                    @onmousedown="() => PickAsync(null)" @onmousedown:preventDefault>@EmptyText</li>
            }
            @{
                string? group = null;
                var index = 0;
            }
            @foreach (var option in _matches)
            {
                if (option.Group is not null && option.Group != group)
                {
                    group = option.Group;
                    <li role="presentation" class="search-group">@group</li>
                }
                var first = index++ == 0 && _query.Length > 0;
                <li id="@($"{_listId}-{option.Id:N}")" role="option" class="search-option@(first ? " active" : "")" aria-selected="@(option.Id == Value ? "true" : "false")"
                    @onmousedown="() => PickAsync(option)" @onmousedown:preventDefault>
                    <span>@option.Label</span>
                    @if (option.Detail is not null)
                    {
                        <span class="muted"> · @option.Detail</span>
                    }
                </li>
            }
            @if (_matches.Count == 0 && _query.Length > 0)
            {
                <li role="presentation" class="search-empty muted">No matches for “@_query”</li>
            }
            else if (_matches.Count == PickerOptions.MaxShown)
            {
                <li role="presentation" class="search-empty muted">Type more to see other matches</li>
            }
            @if (CanAdd && !_matches.Any(m => string.Equals(m.Label, _query, StringComparison.CurrentCultureIgnoreCase)))
            {
                <li id="@($"{_listId}-add")" role="option" class="search-option search-add@(_matches.Count == 0 && _query.Length > 0 ? " active" : "")" aria-selected="false"
                    @onmousedown="StartAdd" @onmousedown:preventDefault>@(_query.Length > 0 ? L["+ Add “{0}”", _query] : AddLabel)</li>
            }
        </ul>
    }
</div>
@if (_adding is { } adding)
{
    <QuickAdd Kind="Kind" Name="@adding" OnSaved="AddedAsync" OnCancel="() => StopAdding()" />
}

@code {
    private readonly string _listId = $"search-{Guid.NewGuid():N}";
    private bool _open;
    private string _query = string.Empty;
    private string _text = string.Empty;
    private IReadOnlyList<PickerOption> _matches = [];
    private Guid? _shownValue;
    private ElementReference _input;
    private string? _adding;
    private bool _focusBack;
    private bool _mayAdd;

    [Parameter, EditorRequired]
    public IReadOnlyList<PickerOption> Options { get; set; } = [];

    [Parameter]
    public Guid? Value { get; set; }

    [Parameter]
    public EventCallback<Guid?> ValueChanged { get; set; }

    /// <summary>For pages whose handler takes the change event, like a select's: Value is the id, or "" for none.</summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }

    /// <summary>A first choice meaning "none" ("(note only)", "No customer"); null when one must be chosen.</summary>
    [Parameter]
    public string? EmptyText { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<OpenBook.Domain.Sales.Customer> CustomerAdded { get; set; }

    [Parameter]
    public EventCallback<OpenBook.Domain.Purchases.Vendor> VendorAdded { get; set; }

    [Parameter]
    public EventCallback<OpenBook.Domain.Sales.Item> ItemAdded { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private QuickAddKind Kind =>
        CustomerAdded.HasDelegate ? QuickAddKind.Customer : VendorAdded.HasDelegate ? QuickAddKind.Vendor : QuickAddKind.Item;

    private bool CanAdd => _mayAdd && !Disabled;

    private string AddLabel => Kind switch
    {
        QuickAddKind.Customer => L["+ Add a new customer"],
        QuickAddKind.Vendor => L["+ Add a new vendor"],
        _ => L["+ Add a new product or service"],
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null || !(CustomerAdded.HasDelegate || VendorAdded.HasDelegate || ItemAdded.HasDelegate))
            return;
        var page = Kind switch
        {
            QuickAddKind.Customer => "/customers/new",
            QuickAddKind.Vendor => "/vendors/new",
            _ => "/items/new",
        };
        _mayAdd = (await AuthState).User.CanReach(page);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusBack)
        {
            await _input.FocusAsync();
            _focusBack = false;
        }
    }

    protected override void OnParametersSet()
    {
        // Follow the parent's value unless the user is typing.
        if (!_open || _shownValue != Value)
        {
            _shownValue = Value;
            _text = Label(Value);
        }

        if (_open)
            _matches = PickerOptions.Filter(Options, _query);
    }

    private string Label(Guid? id) => id is { } v ? Options.FirstOrDefault(o => o.Id == v)?.Label ?? string.Empty : string.Empty;

    private void Open()
    {
        if (_open || Disabled || _focusBack)
            return;
        _open = true;
        _query = string.Empty;
        _matches = PickerOptions.Filter(Options, _query);
    }

    private void Typed(ChangeEventArgs e)
    {
        _text = e.Value as string ?? string.Empty;
        _query = _text.Trim();
        _open = true;
        _matches = PickerOptions.Filter(Options, _query);
    }

    private void StartAdd()
    {
        _adding = _query;
        _open = false;
        _query = string.Empty;
        _text = Label(Value);
    }

    private void StopAdding()
    {
        _adding = null;
        _focusBack = true;
    }

    private async Task AddedAsync(QuickAdded added)
    {
        StopAdding();
        switch (added.Record)
        {
            case OpenBook.Domain.Sales.Customer customer:
                await CustomerAdded.InvokeAsync(customer);
                break;
            case OpenBook.Domain.Purchases.Vendor vendor:
                await VendorAdded.InvokeAsync(vendor);
                break;
            case OpenBook.Domain.Sales.Item item:
                await ItemAdded.InvokeAsync(item);
                break;
        }

        await PickAsync(new PickerOption(added.Id, added.Label));
    }

    private async Task PickAsync(PickerOption? option)
    {
        _open = false;
        _query = string.Empty;
        _text = option?.Label ?? string.Empty;
        _shownValue = option?.Id;
        if (option?.Id == Value)
            return;
        await ValueChanged.InvokeAsync(option?.Id);
        await OnChange.InvokeAsync(new ChangeEventArgs { Value = option?.Id.ToString() ?? string.Empty });
    }

    private async Task LeaveAsync()
    {
        if (!_open)
            return;
        var exact = _query.Length > 0
            ? Options.FirstOrDefault(o => string.Equals(o.Label, _query, StringComparison.CurrentCultureIgnoreCase))
            : null;
        if (exact is not null)
        {
            await PickAsync(exact);
            return;
        }

        if (_text.Length == 0 && EmptyText is not null && Value is not null)
        {
            await PickAsync(null);
            return;
        }

        _open = false;
        _query = string.Empty;
        _text = Label(Value);
    }
}
