@* Debit/credit lines for a journal entry or recurring template. The parent owns the list and checks it with JournalLines. *@

<div class="table-wrap">
    <table class="data entry">
        <thead>
            <tr>
                <th>Account</th>
                <th class="num">Debit</th>
                <th class="num">Credit</th>
                <th>Line memo</th>
                @if (Classes is not null)
                {
                    <th>Class</th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Lines)
            {
                <tr @key="line">
                    <td>
                        <SearchSelect Options="AccountOptions" @bind-Value="line.AccountId" @bind-Value:after="Changed.InvokeAsync" Placeholder="Find an account…" AriaLabel="Account" />
                    </td>
                    <td><input class="amount" type="number" min="0" step="0.01" aria-label="Debit" @bind="line.Debit" @bind:after="() => { line.Credit = line.Debit > 0 ? null : line.Credit; return Changed.InvokeAsync(); }" /></td>
                    <td><input class="amount" type="number" min="0" step="0.01" aria-label="Credit" @bind="line.Credit" @bind:after="() => { line.Debit = line.Credit > 0 ? null : line.Debit; return Changed.InvokeAsync(); }" /></td>
                    <td><input @bind="line.Memo" aria-label="Line memo" /></td>
                    @if (Classes is not null)
                    {
                        <td><ClassSelect Classes="Classes" Value="line.ClassId" ValueChanged="v => line.ClassId = v" /></td>
                    }
                    <td>
                        @if (Lines.Count > 2)
                        {
                            <button type="button" class="remove" title="Remove line" aria-label="Remove line" @onclick="() => RemoveAsync(line)">×</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td>
                    <button type="button" class="secondary" @onclick="AddLine">Add line</button>
                </td>
                <td class="num">@Labels.Amount(TotalDebits)</td>
                <td class="num">@Labels.Amount(TotalCredits)</td>
                <td colspan="@(Classes is null ? 2 : 3)" class="@(IsBalanced ? "muted" : "out-of-balance")">
                    @(IsBalanced ? "Balanced" : $"Out of balance by {Labels.Amount(Math.Abs(TotalDebits - TotalCredits))}")
                </td>
            </tr>
        </tfoot>
    </table>
</div>

@code {
    private IReadOnlyList<Account>? _accountsFor;
    private IReadOnlyList<PickerOption> _accountOptions = [];

    private IReadOnlyList<PickerOption> AccountOptions
    {
        get
        {
            if (!ReferenceEquals(_accountsFor, Accounts))
                (_accountsFor, _accountOptions) = (Accounts, PickerOptions.Accounts(Accounts, Chart, UseNumbers));
            return _accountOptions;
        }
    }


    /// <summary>Active classes when the company tracks them; null hides the class column.</summary>
    [Parameter]
    public IReadOnlyList<OpenBook.Application.Segments.SegmentChoice>? Classes { get; set; }
    [Parameter, EditorRequired]
    public List<JournalLineModel> Lines { get; set; } = [];

    /// <summary>Active accounts in chart order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<Account> Accounts { get; set; } = [];

    [Parameter, EditorRequired]
    public ChartOfAccounts Chart { get; set; } = default!;

    [Parameter]
    public bool UseNumbers { get; set; }

    /// <summary>Raised after an edit that can change whether the lines are complete, so the parent re-renders.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    private decimal TotalDebits => JournalLines.Debits(Lines);
    private decimal TotalCredits => JournalLines.Credits(Lines);
    private bool IsBalanced => JournalLines.IsBalanced(Lines);

    private void AddLine() => Lines.Add(new JournalLineModel());

    private Task RemoveAsync(JournalLineModel line)
    {
        Lines.Remove(line);
        return Changed.InvokeAsync();
    }
}
