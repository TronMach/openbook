@* The accounts a settlement's lines can go to, for static forms: not what customers or vendors owe. *@

<select name="@Name" aria-label="@Label" data-search>
    <option value="">@L["Choose…"]</option>
    @foreach (var a in Chart.Ordered(includeInactive: true).Select(x => x.Account).Where(a => a.Type is not (AccountType.AccountsReceivable or AccountType.AccountsPayable) && (a.IsActive || a.Id == Value)))
    {
        <option value="@a.Id" selected="@(a.Id == Value)">@Chart.FullName(a.Id)</option>
    }
</select>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired] public ChartOfAccounts Chart { get; set; } = new([]);

    [Parameter] public Guid? Value { get; set; }
}
