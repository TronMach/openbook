@* On a page a post came back to because its date is closed. shortcuts.js sends this with the next form, so every form on the page can use it. *@
@inject NavigationManager Navigation

@if (Refused)
{
    <div class="alert notice closing-box">
        <label for="ob-closing-password">Closing date password</label>
        <input id="ob-closing-password" type="password" autocomplete="off" />
        <span class="hint">Enter it here, then do that again. Using it is recorded in the audit log.</span>
    </div>
}

@code {
    private bool Refused
    {
        get
        {
            var query = new Uri(Navigation.Uri).Query;
            return query.Length > 0 && Uri.UnescapeDataString(query).Contains("closing date password", StringComparison.OrdinalIgnoreCase);
        }
    }
}
