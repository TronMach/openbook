@using OpenBook.Application.Projects
@inject WorkerService Workers
@inject ProjectService Projects
@inject OpenBook.Application.Sales.CustomerService Customers
@using OpenBook.Domain.Sales

@* The person responsible for a client or project; a project without one has its client's (or parent's). Shown once there are people. *@
@if (_customer is not null)
{
    <section class="card no-print" id="responsible">
        <h2>Projects and time</h2>
        <PostForm Action="@($"/customers/{CustomerId}/responsible")" data-enhance="false" class="inline-actions">
            <AntiforgeryToken />
            @if (Back is not null)
            {
                <input type="hidden" name="back" value="@Back" />
            }
            @if (_people.Count > 0)
            {
            <label for="responsible-person">Responsible</label>
            <select id="responsible-person" name="workerId">
                <option value="">@(_inherited is { } i ? $"As above: {Name(i)}" : "Nobody chosen")</option>
                @foreach (var w in _people.Where(p => p.IsActive || p.Id == _own))
                {
                    <option value="@w.Id" selected="@(w.Id == _own)">@w.Name@(w.IsActive ? "" : " (inactive)")</option>
                }
            </select>
            }
            <label for="time-format">Time on invoices</label>
            <select id="time-format" name="timeFormat">
                <option value="EachEntry" selected="@(_format == TimeBillingFormat.EachEntry)">A line per entry (date, person, notes)</option>
                <option value="ByPerson" selected="@(_format == TimeBillingFormat.ByPerson)">A line per person</option>
                <option value="ByService" selected="@(_format == TimeBillingFormat.ByService)">A line per service</option>
                <option value="OneLine" selected="@(_format == TimeBillingFormat.OneLine)">One sum per service</option>
            </select>
            <label for="markup">Usual markup on costs (%)</label>
            <input id="markup" name="markup" class="short" inputmode="decimal" value="@_customer.DefaultMarkupPercent.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)" />
            <button type="submit" class="secondary">Save</button>
        </PostForm>
        <p class="hint">Responsible is the partner or manager answering for this work. The project profitability and unbilled work reports can show one person's. Projects below this one take the same person unless they name their own. Time on invoices is how billed time shows on invoices addressed to this customer; the invoice also says how many hours it bills. The usual markup goes on costs passed on to them when none is given.</p>
    </section>
}

@code {
    private IReadOnlyList<OpenBook.Domain.Projects.Worker> _people = [];
    private Guid? _own;
    private Guid? _inherited;
    private TimeBillingFormat _format;
    private Customer? _customer;

    [Parameter, EditorRequired] public Guid CustomerId { get; set; }

    /// <summary>Where to come back to after saving (the customer page when null).</summary>
    [Parameter] public string? Back { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _people = await Workers.ListAsync(includeInactive: true);
        _customer = await Customers.GetAsync(CustomerId);
        var (own, effective) = await Projects.ResponsibleForAsync(CustomerId);
        _format = _customer?.TimeBillingFormat ?? TimeBillingFormat.EachEntry;
        _own = own;
        _inherited = own is null ? effective : null;
    }

    private string Name(Guid id) => _people.FirstOrDefault(p => p.Id == id)?.Name ?? "someone no longer listed";
}
