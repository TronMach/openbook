@* Shown once a save is refused because its date is in a closed period. Works in interactive and static forms. *@

@if (Visible)
{
    <div class="field closing-password">
        <label for="closing-password">Closing date password</label>
        @if (Interactive)
        {
            <input id="closing-password" type="password" autocomplete="off" value="@Value" @onchange="e => ValueChanged.InvokeAsync(e.Value as string)" />
        }
        else
        {
            <input id="closing-password" name="@Name" type="password" autocomplete="off" />
        }
        <span class="hint">This date is on or before the closing date. Enter the closing date password to save the change anyway; it's recorded in the audit log.</span>
    </div>
}

@code {
    [Parameter]
    public bool Visible { get; set; }

    /// <summary>True in interactive components (bound value); false in static forms (posted as <see cref="Name"/>).</summary>
    [Parameter]
    public bool Interactive { get; set; } = true;

    [Parameter]
    public string Name { get; set; } = "ClosingPassword";

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }
}
