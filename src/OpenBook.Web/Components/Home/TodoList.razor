@using System.Security.Claims
@using OpenBook.Application.Inventory
@using OpenBook.Application.Nonprofit
@using OpenBook.Domain.Companies
@using OpenBook.Infrastructure
@using OpenBook.Infrastructure.Persistence
@inject IServiceProvider Services
@inject OpenBookStorage Storage

@* The full view's home page: what's waiting (each line links to where it's done, and only shows when there's something
   to do and the person can open that page), then a getting-started checklist that ticks itself off from the books and
   leaves once everything is done. *@
<section class="card">
    <h2>@L["To do"]</h2>
    @if (_todos.Count == 0)
    {
        <p class="muted">@L["Nothing is waiting: no overdue invoices, bills due, bank lines to review or accounts to reconcile."]</p>
    }
    else
    {
        <ul class="todo-list">
            @foreach (var todo in _todos)
            {
                <li class="@(todo.Urgent ? "urgent" : null)">
                    <a href="@todo.Href">@todo.Text</a>
                    @if (todo.ShowCount)
                    {
                        <span class="badge">@todo.Count</span>
                    }
                    @if (todo.Detail is not null)
                    {
                        <span class="muted">@todo.Detail</span>
                    }
                </li>
            }
        </ul>
    }
</section>

@if (_steps.Count > 0 && _steps.Any(s => !s.Done))
{
    <section class="card">
        <h2>@L["Getting started"] <span class="muted">@L["{0} of {1} done", _steps.Count(s => s.Done), _steps.Count]</span></h2>
        <ul class="checklist">
            @foreach (var step in _steps)
            {
                <li class="@(step.Done ? "done" : null)">
                    <span class="tick" aria-hidden="true">@(step.Done ? "✓" : "○")</span>
                    <span>
                        <ActionLink Href="@step.Href">@step.Text</ActionLink>
                        <span class="muted">@step.Hint</span>
                        @if (step.Done)
                        {
                            <span class="visually-hidden">@L["(done)"]</span>
                        }
                    </span>
                </li>
            }
        </ul>
        <p class="muted">@L["This list goes away once every step is done. The user guide's first chapters walk through each one."] <a href="/help/01-getting-started">@L["Open the guide"]</a></p>
    </section>
}

@code {
    private List<Todo> _todos = [];
    private List<Step> _steps = [];

    [Parameter, EditorRequired]
    public ClaimsPrincipal User { get; set; } = default!;

    [Parameter, EditorRequired]
    public Company Company { get; set; } = default!;

    private sealed record Todo(int Count, string Text, string Href, string? Detail, bool Urgent, bool ShowCount);

    private sealed record Step(bool Done, string Text, string Href, string Hint);

    protected override async Task OnInitializedAsync()
    {
        var today = CompanyTime.Today;
        var figures = await Get<HomeWorkflowService>().FiguresAsync(today);
        var banking = await Get<BankingService>().ListAccountsAsync();
        var feed = Get<BankFeedService>();
        var bills = await Get<IPurchasesStore>().ListOpenBillsAsync(null, default);

        Add(figures.OverdueInvoices, L["Overdue invoices"], "/sales/collections", L["Remind the customers, or record payments that came in"], urgent: true);
        Add(figures.PaymentsToDeposit, L["Payments to deposit"], "/banking/deposits/new", L["{0} waiting to go into the bank", Labels.Amount(figures.ToDeposit)]);
        Add(figures.BillsDueSoon, L["Bills due within a week"], "/purchases/pay-bills", L["Including any overdue"], urgent: bills.Any(b => b.CanBePaid && b.IsOverdue(today)));
        Add(bills.Count(b => b.Approval == OpenBook.Domain.Purchases.BillApproval.Pending), L["Bills waiting for approval"], "/purchases/approvals");
        Add((await Get<OpenBook.Application.Sales.ScheduledEmailService>().ListAsync()).Count(e => e.Status == OpenBook.Domain.Sales.ScheduledEmailStatus.Failed),
            L["Invoice emails that failed"], "/sales/scheduled-emails", urgent: true);
        foreach (var account in banking)
        {
            Add(await feed.PendingCountAsync(account.Account.Id), L["Bank lines to review in {0}", account.FullName], $"/banking/{account.Account.Id}/feed");
            // Reconciled through the end of last month, or it's due (only for accounts in use).
            var lastMonthEnd = new DateOnly(today.Year, today.Month, 1).AddDays(-1);
            if (account.LastReconciledDate is { } last ? last < lastMonthEnd : account.Balance != 0m)
                Add(1, L["Reconcile {0}", account.FullName], $"/banking/{account.Account.Id}/reconcile",
                    account.LastReconciledDate is { } done ? L["Last reconciled through {0}", Labels.Date(done)] : L["Never reconciled"], showCount: false);
        }

        if (Get<OpenBook.Web.Diagnostics.BooksCheckStatus>().Last is { Problems: > 0 } check)
            Add(check.Problems, L["Figures in the books that don't agree"], "/accountant/check", L["Found by the daily check of the books"], urgent: true);
        Add(figures.OpenEstimates, L["Estimates waiting for an answer"], "/sales?show=estimates");
        Add(figures.OrdersToReceive, L["Purchase orders still to receive"], "/purchases/orders");
        if (figures.StockItems > 0)
            Add((await Get<ReorderService>().DueAsync()).Count, L["Items to reorder"], "/purchases/reorder", L["Counting what's on order and promised to customers"]);
        Add((await Get<OpenBook.Application.Documents.DocumentCaptureService>().ListAsync()).Count(d => d.Status == OpenBook.Domain.Documents.CapturedDocumentStatus.New),
            L["Documents to check"], "/documents", L["Vendor invoices, orders and packing slips uploaded and read"]);
        Add((await Get<ReceiptService>().ListAsync()).Count(r => r.Status == ReceiptStatus.New), L["Receipts to record"], "/purchases/receipts");
        if (Company.Edition == Edition.Nonprofit)
            Add((await Get<GiftService>().ListAsync()).Count(g => g.Status == DocumentStatus.Posted && g.AcknowledgedAt is null), L["Gifts not yet thanked"], "/nonprofit/thanks");

        var sales = Get<ISalesStore>();
        var email = await Get<EmailService>().GetSettingsAsync();
        _steps =
        [
            new((await Get<AccountService>().ListAsync()).Count > 0, L["Set up your chart of accounts"], "/accounts", L["the accounts every amount is filed under"]),
            new(banking.Count > 0, L["Add your bank and card accounts"], "/accounts/new", L["as accounts of type Bank or Credit card"]),
            new((await sales.ListCustomersAsync(default)).Count > 0, L["Add a customer"], "/customers/new", L["or import a list"]),
            new((await sales.ListItemsAsync(default)).Count > 0, L["Add the products and services you sell"], "/items/new", L["each with its price"]),
            new(figures.InvoicesUsed || figures.SalesReceiptsUsed, L["Make your first invoice or sales receipt"], "/sales/invoices/new", L["a receipt is for sales paid on the spot"]),
            new(email.IsConfigured, L["Set up email"], "/settings/email", L["so invoices and statements can be sent from OpenBook"]),
            new(banking.Any(a => a.LastReconciledDate is not null), L["Reconcile a bank account"], "/banking", L["check the books against a bank statement"]),
        ];
        if (Storage.Provider != DatabaseProvider.Postgres)
            _steps.Add(new((await Get<ScheduledBackupService>().GetAsync()).Enabled, L["Schedule backups"], "/backup", L["a copy of your books every day, kept somewhere safe"]));
    }

    private T Get<T>() where T : notnull => Services.GetRequiredService<T>();

    private void Add(int count, string text, string href, string? detail = null, bool urgent = false, bool showCount = true)
    {
        if (count > 0 && User.CanReach(href))
            _todos.Add(new Todo(count, text, href, detail, urgent, showCount));
    }
}
