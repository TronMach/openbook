@inject OpenBook.Application.Segments.SegmentService Segments
@* The fields of a sales channel, for the new channel form and the channel page (static forms posting to ChannelEndpoints). *@
@using OpenBook.Domain.Accounts
@using OpenBook.Domain.Channels
@using OpenBook.Application.Channels

<div class="row">
    <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" maxlength="100" required value="@Channel?.Name" placeholder="My Shopify store" />
    </div>
    <div class="field">
        <label for="kind">Channel</label>
        <select id="kind" name="kind">
            @foreach (var kind in Enum.GetValues<ChannelKind>())
            {
                <option value="@kind" selected="@(kind == Channel?.Kind)">@ChannelLabels.Kind(kind)</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="deposit">Payouts go into</label>
        <select id="deposit" name="depositAccountId" required data-search>
            <option value="">Choose…</option>
            @foreach (var a in Accounts.Where(a => a.Type is AccountType.Bank or AccountType.OtherCurrentAsset))
            {
                <option value="@a.Id" selected="@(a.Id == Channel?.DepositAccountId)">@Chart.FullName(a.Id)</option>
            }
        </select>
        <span class="hint">The bank account, or a "balance" account (Other current asset) when money waits in the channel first, as with PayPal or Etsy.</span>
    </div>
</div>
@if (Channel is not null)
{
    <input type="hidden" name="taxSet" value="true" />
    <label class="check">
        <input type="checkbox" name="marketplaceTax" value="true" checked="@Channel.MarketplaceCollectsTax" />
        <span>The marketplace collects and pays sales tax on these orders</span>
    </label>
}
@if (_classes.Count > 0 || _locations.Count > 0)
{
    <div class="row">
        @if (_classes.Count > 0)
        {
            <div class="field">
                <label for="channel-class">Class <span class="muted">(optional)</span></label>
                <select id="channel-class" name="classId">
                    <option value="">None</option>
                    @foreach (var c in _classes)
                    {
                        <option value="@c.Segment.Id" selected="@(c.Segment.Id == Channel?.ClassId)">@c.FullName</option>
                    }
                </select>
            </div>
        }
        @if (_locations.Count > 0)
        {
            <div class="field">
                <label for="channel-location">Location <span class="muted">(optional)</span></label>
                <select id="channel-location" name="locationId">
                    <option value="">None</option>
                    @foreach (var l in _locations)
                    {
                        <option value="@l.Segment.Id" selected="@(l.Segment.Id == Channel?.LocationId)">@l.FullName</option>
                    }
                </select>
            </div>
        }
        <span class="hint">Payouts, orders and returns from now on carry them, so profit and loss by class or location shows this channel's sales, fees and cost of goods sold.</span>
    </div>
}
<details open="@(Channel is not null)">
    <summary>Accounts for each part of a payout</summary>
    <div class="row">
        @foreach (var (name, label, usual, value) in Parts)
        {
            <div class="field">
                <label for="@name">@label</label>
                <select id="@name" name="@name" data-search>
                    <option value="">@usual (created if needed)</option>
                    @foreach (var a in Accounts.Where(a => a.Type is not (AccountType.AccountsReceivable or AccountType.AccountsPayable)))
                    {
                        <option value="@a.Id" selected="@(a.Id == value)">@Chart.FullName(a.Id)</option>
                    }
                </select>
            </div>
        }
        <div class="field">
            <label for="clearing">Invoices paid online</label>
            <select id="clearing" name="clearingAccountId" data-search>
                <option value="">@(Channel is null ? "The online payments deposit account (Stripe)" : "None")</option>
                @foreach (var a in Accounts.Where(a => a.Type is AccountType.Bank or AccountType.OtherCurrentAsset))
                {
                    <option value="@a.Id" selected="@(a.Id == Channel?.ClearingAccountId)">@Chart.FullName(a.Id)</option>
                }
            </select>
            <span class="hint">Stripe payouts can include invoices customers paid online, already recorded as payments into this account (usually Undeposited Funds): they clear it instead of counting as sales again.</span>
        </div>
    </div>
</details>

@code {
    [Parameter]
    public SalesChannel? Channel { get; set; }

    [Parameter, EditorRequired]
    public ChartOfAccounts Chart { get; set; } = new([]);

    private IEnumerable<Account> Accounts => Chart.Ordered(includeInactive: false).Select(x => x.Account);

    private IReadOnlyList<OpenBook.Application.Segments.SegmentChoice> _classes = [];
    private IReadOnlyList<OpenBook.Application.Segments.SegmentChoice> _locations = [];

    protected override async Task OnInitializedAsync()
    {
        _classes = await Segments.ListAsync(OpenBook.Domain.Segments.SegmentKind.Class, includeInactive: false);
        _locations = await Segments.ListAsync(OpenBook.Domain.Segments.SegmentKind.Location, includeInactive: false);
    }

    private IEnumerable<(string Name, string Label, string Usual, Guid? Value)> Parts =>
    [
        ("salesAccountId", "Sales", ChannelService.SalesName, Channel?.SalesAccountId),
        ("shippingAccountId", "Shipping charged", ChannelService.ShippingName, Channel?.ShippingAccountId),
        ("refundsAccountId", "Refunds", ChannelService.RefundsName, Channel?.RefundsAccountId),
        ("feesAccountId", "Fees", ChannelService.FeesName, Channel?.FeesAccountId),
        ("taxAccountId", "Sales tax", ChannelService.TaxName, Channel?.TaxAccountId),
        ("adjustmentsAccountId", "Adjustments", ChannelService.AdjustmentsName, Channel?.AdjustmentsAccountId),
    ];
}
