@* Line grid for invoices, sales receipts, estimates and credit memos. Picking an item fills its description, price and taxable setting.
   With a date, prices come from Prices.Quote (the customer's level, quantity breaks, rules) as the server will charge them. *@
@inject Operations Ops

<div class="table-wrap">
    <table class="data entry">
        <thead>
            <tr>
                <th>Product or service</th>
                <th>Description</th>
                <th class="num">Qty</th>
                <th class="num">Rate</th>
                <th class="num">Amount</th>
                @if (Tax is not null)
                {
                    <th title="Charge sales tax on this line">Tax</th>
                }
                @if (Classes is not null)
                {
                    <th>Class</th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody>
            @{
                var amounts = SalesLineModel.Amounts(Lines);
            }
            @for (var i = 0; i < Lines.Count; i++)
            {
                var line = Lines[i];
                var amount = amounts[i];
                <tr @key="line" class="@(line.IsDiscount ? "discount-line" : null)">
                    @if (line.IsDiscount)
                    {
                        <td>
                            <select value="@line.Kind" aria-label="Discount type" @onchange="e => SetDiscountKind(line, e)">
                                <option value="@SalesLineKind.DiscountPercent">Discount (percent)</option>
                                <option value="@SalesLineKind.DiscountAmount">Discount (amount)</option>
                            </select>
                        </td>
                        <td><input @bind="line.Description" aria-label="Description" placeholder="Discount" /></td>
                        <td class="num muted">@(line.Kind == SalesLineKind.DiscountPercent ? "%" : "")</td>
                        <td><input class="amount" type="number" step="any" min="0" aria-label="@(line.Kind == SalesLineKind.DiscountPercent ? "Percent off" : "Amount off")" @bind="line.Rate" @bind:after="Changed" /></td>
                    }
                    else
                    {
                        <td>
                            <SearchSelect Options="ItemOptions" Value="line.ItemId" OnChange="e => PickItem(line, e)" ItemAdded="ItemCallback" EmptyText="(note only)" Placeholder="Find a product or service…" AriaLabel="Product or service" />
                        </td>
                        <td>
                            <input @bind="line.Description" aria-label="Description" />
                            @if (line.ItemId is { } tracked && TrackingOf(tracked) is var tracking and not ItemTracking.None)
                            {
                                <input class="lots" @bind="line.Lots" aria-label="@(tracking == ItemTracking.Serial ? "Serial numbers" : "Lots")"
                                       placeholder="@(tracking == ItemTracking.Serial ? "Serial numbers (blank: oldest)" : "Lots, e.g. A-1 x 3 (blank: oldest)")" />
                            }
                        </td>
                        <td><input class="amount" type="number" step="any" aria-label="Quantity" @bind="line.Quantity" @bind:after="Changed" /></td>
                        <td>
                            <input class="amount" type="number" step="any" aria-label="Rate" @bind="line.Rate" @bind:after="() => TypedRate(line)" />
                            @if (line.ItemId is { } itemId)
                            {
                                <div class="price-note muted">
                                    @if (line.AutoPrice && line.PriceSource is not null)
                                    {
                                        <span title="@line.PriceSource">List @Labels.Price(line.ListRate ?? 0m) · @line.PriceSource</span>
                                    }
                                    else if (!line.AutoPrice && _context is not null)
                                    {
                                        <button type="button" class="link" @onclick="() => UseAutoPrice(line)">Automatic price</button>
                                    }
                                    @if (_lastPrices.GetValueOrDefault(itemId) is { } last)
                                    {
                                        <span title="Last charged on @last.DocumentNumber"> · Last @Labels.Price(last.Rate) on @Labels.Date(last.Date)</span>
                                    }
                                </div>
                            }
                        </td>
                    }
                    <td class="num">@Labels.AmountOrBlank(amount)</td>
                    @if (Tax is not null)
                    {
                        <td>
                            @if (!line.IsDiscount && line.ItemId is not null)
                            {
                                <input type="checkbox" aria-label="Taxable" checked="@line.IsTaxable(Items)" @onchange="e => SetTaxable(line, e)" />
                            }
                        </td>
                    }
                    @if (Classes is not null)
                    {
                        <td><ClassSelect Classes="Classes" Value="line.ClassId" ValueChanged="v => line.ClassId = v" /></td>
                    }
                    <td>
                        @if (Lines.Count > 1)
                        {
                            <button type="button" class="remove" title="Remove line" aria-label="Remove line" @onclick="() => RemoveAsync(line)">×</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            @{
                IReadOnlyList<SalesLineModel> everyLine = Also.Count == 0 ? Lines : [.. Lines, .. Also];
                var subtotal = SalesLineModel.Total(everyLine);
                var tax = SalesLineModel.Tax(everyLine, Items, Tax, Exempt);
                var extra = (Tax is null ? 1 : 2) + (Classes is null ? 0 : 1);
            }
            @if (Also.Count > 0)
            {
                <tr>
                    <td colspan="4" class="num">Lines below</td>
                    <td class="num">@Labels.Amount(subtotal - amounts.Sum())</td>
                    <td colspan="@extra"></td>
                </tr>
            }
            @if (Tax is not null)
            {
                <tr>
                    <td colspan="4" class="num">Subtotal</td>
                    <td class="num">@Labels.Amount(subtotal)</td>
                    <td colspan="@extra"></td>
                </tr>
                @foreach (var (label, taxAmount) in tax)
                {
                    <tr>
                        <td colspan="4" class="num muted">@label@(Exempt ? " · exempt" : "")</td>
                        <td class="num">@Labels.Amount(taxAmount)</td>
                        <td colspan="@extra"></td>
                    </tr>
                }
            }
            <tr>
                <td colspan="2">
                    <button type="button" class="secondary" @onclick="() => AddAsync(new SalesLineModel())">Add line</button>
                    <button type="button" class="secondary" @onclick="() => AddAsync(new SalesLineModel { Kind = SalesLineKind.DiscountPercent })">Add discount</button>
                </td>
                <td colspan="2" class="num">Total</td>
                <td class="num">@Labels.Amount(subtotal + tax.Sum(t => t.Amount))</td>
                <td colspan="@extra"></td>
            </tr>
        </tfoot>
    </table>
</div>

@code {
    /// <summary>A line's item's lot or serial tracking; bundles and untracked items show no lots box.</summary>
    private ItemTracking TrackingOf(Guid itemId) => Items.FirstOrDefault(i => i.Id == itemId)?.Tracking ?? ItemTracking.None;

    private IReadOnlyList<Item>? _optionsFor;
    private IReadOnlyList<PickerOption> _itemOptions = [];

    private IReadOnlyList<PickerOption> ItemOptions
    {
        get
        {
            if (!ReferenceEquals(_optionsFor, Items))
                (_optionsFor, _itemOptions) = (Items, PickerOptions.Items(Items));
            return _itemOptions;
        }
    }

    [Parameter, EditorRequired]
    public List<SalesLineModel> Lines { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<Item> Items { get; set; } = [];

    /// <summary>Lets the line picker add an item: this puts it in <see cref="Items"/>.</summary>
    [Parameter]
    public EventCallback<Item> OnItemAdded { get; set; }

    private EventCallback<Item> ItemCallback => OnItemAdded.HasDelegate ? EventCallback.Factory.Create<Item>(this, ItemAddedAsync) : default;

    // The picker chooses a new item at once, before the parent has rendered it into Items.
    private Item? _justAdded;

    private Task ItemAddedAsync(Item item)
    {
        _justAdded = item;
        return OnItemAdded.InvokeAsync(item);
    }

    /// <summary>Raised after an edit that changes the total, so the parent can re-render what depends on it.</summary>
    [Parameter]
    public EventCallback OnChange { get; set; }

    /// <summary>Lines the document has besides these (billed time, costs), shown elsewhere on the page but part of its totals and tax.</summary>
    [Parameter]
    public IReadOnlyList<SalesLineModel> Also { get; set; } = [];

    /// <summary>The tax code being charged; null hides the tax column and totals.</summary>
    [Parameter]
    public TaxCodeChoice? Tax { get; set; }

    /// <summary>The customer is exempt on the document date: tax shows as zero.</summary>
    [Parameter]
    public bool Exempt { get; set; }

    /// <summary>Active classes when the company tracks them; null hides the class column.</summary>
    [Parameter]
    public IReadOnlyList<OpenBook.Application.Segments.SegmentChoice>? Classes { get; set; }


    /// <summary>The document's customer; prices follow their level. Null prices at list (plus rules for all customers).</summary>
    [Parameter]
    public Guid? CustomerId { get; set; }

    /// <summary>The document date, for rule date ranges. Null turns automatic pricing off (lines keep the item price).</summary>
    [Parameter]
    public DateOnly? Date { get; set; }

    private PricingContext? _context;
    private IReadOnlyDictionary<Guid, LastPrice> _lastPrices = new Dictionary<Guid, LastPrice>();
    private Guid? _loadedFor;
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (Date is null)
        {
            _context = null;
            return;
        }

        if (!_loaded || _loadedFor != CustomerId)
        {
            (_loaded, _loadedFor) = (true, CustomerId);
            (_context, _lastPrices) = await Ops.RunAsync(async sp =>
            {
                var pricing = sp.GetRequiredService<PricingService>();
                var context = await pricing.ContextAsync(CustomerId);
                IReadOnlyDictionary<Guid, LastPrice> last = CustomerId is { } id ? await pricing.LastPricesAsync(id) : new Dictionary<Guid, LastPrice>();
                return (context, last);
            });
        }

        Reprice();
    }

    /// <summary>Automatic lines get the quoted price for the item's total quantity on the document.</summary>
    private void Reprice()
    {
        if (_context is null || Date is not { } date)
            return;
        var quantities = PricingContext.Quantities(Lines.Where(l => !l.IsDiscount).Select(l => (l.ItemId, l.Quantity ?? 0m)));
        foreach (var line in Lines.Where(l => l.AutoPrice && !l.IsDiscount))
        {
            if (line.ItemId is not { } id || Items.FirstOrDefault(i => i.Id == id) is not { } item)
                continue;
            var quote = _context.Quote(item, date, quantities.GetValueOrDefault(id));
            line.Rate = quote.Price;
            line.ListRate = quote.ListPrice;
            line.PriceSource = quote.Source;
        }
    }

    private Task Changed()
    {
        Reprice();
        return OnChange.InvokeAsync();
    }

    private Task TypedRate(SalesLineModel line)
    {
        line.AutoPrice = false;
        line.PriceSource = null;
        return Changed();
    }

    private Task UseAutoPrice(SalesLineModel line)
    {
        line.AutoPrice = true;
        return Changed();
    }

    private Task AddAsync(SalesLineModel line)
    {
        Lines.Add(line);
        return Changed();
    }

    private Task RemoveAsync(SalesLineModel line)
    {
        Lines.Remove(line);
        return Changed();
    }

    private Task SetDiscountKind(SalesLineModel line, ChangeEventArgs e)
    {
        if (Enum.TryParse<SalesLineKind>(e.Value as string, out var kind))
            line.Kind = kind;
        return Changed();
    }

    private Task PickItem(SalesLineModel line, ChangeEventArgs e)
    {
        line.ItemId = Guid.TryParse(e.Value as string, out var id) ? id : null;
        if ((_justAdded?.Id == line.ItemId ? _justAdded : Items.FirstOrDefault(i => i.Id == line.ItemId)) is { } item)
        {
            line.Description = item.Description ?? item.Name;
            line.Rate = item.Rate;
            line.Quantity ??= 1m;
            line.Taxable = item.Taxable;
            line.AutoPrice = _context is not null;
            line.ListRate = item.Rate;
            line.PriceSource = null;
        }

        return Changed();
    }

    private Task SetTaxable(SalesLineModel line, ChangeEventArgs e)
    {
        line.Taxable = e.Value is true || (e.Value is string text && bool.TryParse(text, out var on) && on);
        return Changed();
    }
}
