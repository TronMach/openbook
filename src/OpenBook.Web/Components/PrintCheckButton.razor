@* Prints one check in a new tab, through the same form endpoint as the checks page. *@

<form method="post" action="/checks/print" target="_blank" class="inline-form" data-enhance="false">
    <AntiforgeryToken />
    <input type="hidden" name="check" value="@($"{Kind}:{Id}")" />
    <button type="submit" class="secondary">@(PrintedAt is null ? "Print check" : "Print check again")</button>
</form>

@code {
    [Parameter, EditorRequired]
    public CheckKind Kind { get; set; }

    [Parameter, EditorRequired]
    public Guid Id { get; set; }

    [Parameter]
    public DateTimeOffset? PrintedAt { get; set; }
}
