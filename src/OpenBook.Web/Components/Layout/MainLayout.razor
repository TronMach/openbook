@using OpenBook.Domain.Companies
@inherits LayoutComponentBase
@inject OpenBook.Application.Companies.ViewModeService Views
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <header class="topbar">
            <a class="brand" href="/">OpenBook</a>
            <nav>
                @* The simple view's menus are in the bar below; here the nav only keeps the space. *@
                @if (!_simple)
                {
                @foreach (var href in Editions.Menu(_edition).Where(context.User.CanReach))
                {
                    @MenuLink(href)
                }
                @if (context.User.CanReach("/settings"))
                {
                    <NavLink href="/settings">@L["Settings"]</NavLink>
                }
                @if (context.User.CanReach("/backup"))
                {
                    <NavLink href="/backup">@L["Backup"]</NavLink>
                }
                <form method="post" action="/account/view" class="view-switch">
                    <AntiforgeryToken />
                    <input type="hidden" name="view" value="Simple" />
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    <button type="submit" class="link" title="@L["A shorter menu and a home page that shows each step of the work"]">@L["Simple view"]</button>
                </form>
                }
            </nav>
            <form class="search" method="get" action="/search" data-enhance="false" role="search">
                <input name="q" type="search" placeholder="@L["Search…"]" aria-label="@L["Search"]" />
            </form>
            <a class="muted" href="/account/password" title="@L["Change password"] · @AccessMiddleware.Describe(AccessRules.RoleOf(context.User) ?? UserRole.ViewOnly)">@context.User.Identity?.Name</a>
            <a class="muted" href="/account/region" title="@L["Language and region"]">@System.Globalization.CultureInfo.CurrentCulture.Name</a>
            <button type="button" id="theme-toggle" class="link theme-toggle" aria-label="Theme">Theme: auto</button>
            <form method="post" action="/logout">
                <AntiforgeryToken />
                <button type="submit" class="link">@L["Sign out"]</button>
            </form>
        </header>
        @if (_simple)
        {
            <SimpleNav User="context.User" Edition="_edition" ReturnUrl="@ReturnUrl" />
        }
    </Authorized>
</AuthorizeView>

@if (_simple)
{
    <div class="simple-shell">
        <AuthorizeView>
            <SimpleShortcuts User="context.User" Edition="_edition" />
        </AuthorizeView>
        <main class="page">
            @Body
        </main>
    </div>
}
else
{
    <main class="page">
        @Body
    </main>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private Edition _edition;
    private bool _simple;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Where the view switch comes back to: this page, query included.
    private string ReturnUrl => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext?.User.Identity?.IsAuthenticated != true)
            return;
        var view = await Views.CurrentAsync(HttpContext.RequestAborted);
        _edition = view.Edition;
        _simple = view.Mode == ViewMode.Simple;
    }

    // Each label is written out so the string catalog finds it.
    private RenderFragment MenuLink(string href) => href switch
    {
        "/" => @<NavLink href="/" Match="NavLinkMatch.All">@L["Home"]</NavLink>,
        "/accounts" => @<NavLink href="/accounts">@L["Accounts"]</NavLink>,
        "/banking" => @<NavLink href="/banking">@L["Banking"]</NavLink>,
        "/sales" => @<NavLink href="/sales">@L["Sales"]</NavLink>,
        "/purchases" => @<NavLink href="/purchases">@L["Purchases"]</NavLink>,
        "/inventory" => @<NavLink href="/inventory">@L["Inventory"]</NavLink>,
        "/projects" => @<NavLink href="/projects">@L["Projects"]</NavLink>,
        "/time" => @<NavLink href="/time">@L["Time"]</NavLink>,
        "/nonprofit" => @<NavLink href="/nonprofit">@L["Nonprofit"]</NavLink>,
        "/customers" => _edition switch
        {
            Edition.Nonprofit => @<NavLink href="/customers">@L["Donors"]</NavLink>,
            Edition.ProfessionalServices => @<NavLink href="/customers">@L["Clients"]</NavLink>,
            _ => @<NavLink href="/customers">@L["Customers"]</NavLink>,
        },
        "/journal" => @<NavLink href="/journal">@L["Journal"]</NavLink>,
        "/reports" => @<NavLink href="/reports">@L["Reports"]</NavLink>,
        _ => @<NavLink href="/dashboard">@L["Dashboard"]</NavLink>,
    };
}
