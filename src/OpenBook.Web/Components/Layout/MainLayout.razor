@using OpenBook.Domain.Companies
@using Microsoft.AspNetCore.Diagnostics
@inherits OrderedLayout
@inject OpenBook.Application.Companies.ViewModeService Views
@inject NavigationManager Navigation

<a class="skip-link" href="#main">@L["Skip to content"]</a>
<AuthorizeView>
    <Authorized>
        <header class="topbar">
            <a class="brand" href="/">OpenBook</a>
            <nav aria-label="@L["Main menu"]">
                @* The simple view's menus are in the bar below; here the nav only keeps the space. *@
                @if (!_simple && _menu == MenuStyle.DropDowns)
                {
                    <FullMenu User="context.User" Edition="_edition" Icons="_icons" />
                }
                else if (!_simple)
                {
                    @foreach (var href in Editions.Menu(_edition).Where(context.User.CanReach))
                    {
                        @MenuLink(href)
                    }
                }
                @if (!_simple)
                {
                    @Area("/settings", L["Settings"])
                }
            </nav>
            <form class="search" method="get" action="/search" data-enhance="false" role="search" aria-label="@L["Search the books"]">
                <input name="q" type="search" placeholder="@L["Search…"]" aria-label="@L["Search"]" />
            </form>
            <a class="help-topic" href="/help/@OpenBook.Web.Help.HelpTopics.For(ReturnUrl)" title="@L["The user guide's chapter about this page"]">@L["Help"]</a>
            <details class="menu user-menu">
                <summary title="@L["Your account, how OpenBook looks for you, and signing out"]">@context.User.Identity?.Name ▾</summary>
                <div class="menu-list">
                    <span class="menu-note">@L["Signed in as {0} ({1})", context.User.Identity?.Name ?? "", AccessMiddleware.Describe(AccessRules.RoleOf(context.User) ?? UserRole.ViewOnly)]</span>
                    <a href="/account/password">@L["Password and sessions"]</a>
                    <a href="/account/two-factor">@L["Two-factor sign-in"]</a>
                    @if (context.User.CanReach("/capture"))
                    {
                        <a href="/capture">@L["Offline capture on your phone"]</a>
                    }
                    <a href="/account/region">@L["Language and region"] <span class="muted">(@System.Globalization.CultureInfo.CurrentCulture.Name)</span></a>
                    <hr />
                    <button type="button" id="theme-toggle" class="link theme-toggle" aria-label="@L["Theme"]">Theme: auto</button>
                    <form method="post" action="/account/view">
                        <AntiforgeryToken />
                        <input type="hidden" name="view" value="@(_simple ? "Full" : "Simple")" />
                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                        @if (_simple)
                        {
                            <button type="submit" class="link" title="@L["Every area of OpenBook in the menu"]">@L["Switch to full view"]</button>
                        }
                        else
                        {
                            <button type="submit" class="link" title="@L["A shorter menu and a home page that shows each step of the work"]">@L["Switch to simple view"]</button>
                        }
                    </form>
                    @if (!_simple)
                    {
                        <form method="post" action="/account/menu">
                            <AntiforgeryToken />
                            <input type="hidden" name="menu" value="@(_menu == MenuStyle.DropDowns ? "Bar" : "DropDowns")" />
                            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                            @if (_menu == MenuStyle.DropDowns)
                            {
                                <button type="submit" class="link" title="@L["One link per area across the top"]">@L["Show the menu as a bar"]</button>
                            }
                            else
                            {
                                <button type="submit" class="link" title="@L["A drop-down per area listing its pages, so most pages are one click away"]">@L["Show the menu as drop-downs"]</button>
                            }
                        </form>
                    }
                    <form method="post" action="/account/icons">
                        <AntiforgeryToken />
                        <input type="hidden" name="icons" value="@(_icons ? "hide" : "show")" />
                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                        @if (_icons)
                        {
                            <button type="submit" class="link" title="@L["Only the names in the menus, without a picture beside each area"]">@L["Hide the menu pictures"]</button>
                        }
                        else
                        {
                            <button type="submit" class="link" title="@L["A picture beside each area's name in the menus, to help find it again"]">@L["Show the menu pictures"]</button>
                        }
                    </form>
                    <hr />
                    <form method="post" action="/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="link">@L["Sign out"]</button>
                    </form>
                </div>
            </details>
        </header>
        @if (_simple)
        {
            <SimpleNav User="context.User" Edition="_edition" ReturnUrl="@ReturnUrl" />
        }
    </Authorized>
</AuthorizeView>

@if (_simple)
{
    <div class="simple-shell">
        <AuthorizeView>
            <SimpleShortcuts User="context.User" Edition="_edition" Icons="_icons" />
        </AuthorizeView>
        <main class="page" id="main" tabindex="-1">
            <ClosingPasswordBox />
            @Body
        </main>
    </div>
}
else
{
    <main class="page" id="main" tabindex="-1">
        <ClosingPasswordBox />
        @Body
    </main>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private Edition _edition;
    private bool _simple;
    private MenuStyle _menu;
    private bool _icons = true;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Where the view switch comes back to: this page, query included.
    private string ReturnUrl => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext?.User.Identity?.IsAuthenticated != true)
            return;
        // A re-executed status page must draw without waiting: the framework doesn't wait for it, and would dispose
        // its services under a query on a database that really waits. So "not found" shows the usual menu.
        if (HttpContext.Features.Get<IStatusCodeReExecuteFeature>() is not null)
            return;
        var view = await Views.CurrentAsync(HttpContext.RequestAborted);
        _edition = view.Edition;
        _simple = view.Mode == ViewMode.Simple;
        _menu = view.Menu;
        _icons = view.Icons;
    }

    // Each label is written out so the string catalog finds it.
    private RenderFragment MenuLink(string href) => href switch
    {
        "/" => Area("/", L["Home"], NavLinkMatch.All),
        "/accounts" => Area("/accounts", L["Accounts"]),
        "/banking" => Area("/banking", L["Banking"]),
        "/sales" => Area("/sales", L["Sales"]),
        "/purchases" => Area("/purchases", L["Purchases"]),
        "/inventory" => Area("/inventory", L["Inventory"]),
        "/projects" => Area("/projects", L["Projects"]),
        "/time" => Area("/time", L["Time"]),
        "/nonprofit" => Area("/nonprofit", L["Nonprofit"]),
        "/customers" => _edition switch
        {
            Edition.Nonprofit => Area("/customers", L["Donors"]),
            Edition.ProfessionalServices => Area("/customers", L["Clients"]),
            _ => Area("/customers", L["Customers"]),
        },
        "/journal" => Area("/journal", L["Journal"]),
        "/reports" => Area("/reports", L["Reports"]),
        _ => Area("/dashboard", L["Dashboard"]),
    };

    // An area's link in the top bar: its picture (unless the person turned them off), then its name.
    private RenderFragment Area(string href, string label, NavLinkMatch match = NavLinkMatch.Prefix) =>
        @<NavLink href="@href" class="area-link" Match="match">@if (_icons) { @AreaIcons.Svg(AreaIcons.For(href)) }<span>@label</span></NavLink>;
}
