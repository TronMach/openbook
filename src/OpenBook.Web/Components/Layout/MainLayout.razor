@using OpenBook.Domain.Companies
@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <header class="topbar">
            <a class="brand" href="/">OpenBook</a>
            <nav>
                <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink href="/accounts">Accounts</NavLink>
                <NavLink href="/banking">Banking</NavLink>
                <NavLink href="/sales">Sales</NavLink>
                <NavLink href="/purchases">Purchases</NavLink>
                <NavLink href="/inventory">Inventory</NavLink>
                <NavLink href="/projects">Projects</NavLink>
                <NavLink href="/journal">Journal</NavLink>
                <NavLink href="/reports">Reports</NavLink>
                <NavLink href="/dashboard">Dashboard</NavLink>
                @if (context.User.Can(UserRole.Accountant))
                {
                    <NavLink href="/settings">Settings</NavLink>
                }
                @if (context.User.Can(UserRole.Admin))
                {
                    <NavLink href="/backup">Backup</NavLink>
                }
            </nav>
            <form class="search" method="get" action="/search" data-enhance="false" role="search">
                <input name="q" type="search" placeholder="Search…" aria-label="Search" />
            </form>
            <a class="muted" href="/account/password" title="Change password · @AccessMiddleware.Describe(AccessRules.RoleOf(context.User) ?? UserRole.ViewOnly)">@context.User.Identity?.Name</a>
            <button type="button" id="theme-toggle" class="link theme-toggle" aria-label="Theme">Theme: auto</button>
            <form method="post" action="/logout">
                <AntiforgeryToken />
                <button type="submit" class="link">Sign out</button>
            </form>
        </header>
    </Authorized>
</AuthorizeView>

<main class="page">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
