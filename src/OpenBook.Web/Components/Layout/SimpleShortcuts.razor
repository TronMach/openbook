@using System.Security.Claims
@using OpenBook.Domain.Companies

@* The simple view's shortcut column: the few places a one-person business goes every day, plus its edition's own. *@
<nav class="shortcuts" aria-label="@L["Shortcuts"]">
    @Link("/", L["Home"], AreaIcons.Home, NavLinkMatch.All)
    @Link("/customers/center", Edition switch
    {
        Edition.Nonprofit => L["Donors"],
        Edition.ProfessionalServices => L["Clients"],
        _ => L["Customers"],
    }, AreaIcons.People)
    @if (Edition == Edition.ProfessionalServices)
    {
        @Link("/time", L["Time"], AreaIcons.Clock)
    }
    @if (Edition == Edition.Nonprofit)
    {
        @Link("/nonprofit/gifts", L["Gifts"], AreaIcons.Gift)
    }
    @Link("/vendors/center", L["Vendors"], AreaIcons.Store)
    @Link("/items/center", L["Items"], AreaIcons.Box)
    @if (Settlements)
    {
        @Link("/settlements", L["Settlements"], AreaIcons.Truck)
    }
    @if (Edition == Edition.ECommerce)
    {
        @Link("/sales/channels", L["Sales channels"], AreaIcons.Cart)
    }
    @Link("/banking", L["Banking"], AreaIcons.Bank)
    @Link("/reports", L["Reports"], AreaIcons.Chart)
</nav>

@code {
    [Parameter, EditorRequired]
    public ClaimsPrincipal User { get; set; } = default!;

    [Parameter]
    public Edition Edition { get; set; }

    /// <summary>Whether the company is paid by carrier settlements.</summary>
    [Parameter]
    public bool Settlements { get; set; }

    /// <summary>Whether each shortcut's picture is drawn above its name (the person's choice).</summary>
    [Parameter]
    public bool Icons { get; set; } = true;

    private RenderFragment Link(string href, string label, string icon, NavLinkMatch match = NavLinkMatch.Prefix) => @<text>
        @if (User.CanReach(href))
        {
            <NavLink href="@href" Match="match">
                @if (Icons)
                {
                    @AreaIcons.Svg(icon, 22)
                }
                <span>@label</span>
            </NavLink>
        }
    </text>;
}
