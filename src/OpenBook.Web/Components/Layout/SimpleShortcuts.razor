@using System.Security.Claims
@using OpenBook.Domain.Companies

@* The simple view's shortcut column: the few places a one-person business goes every day, plus its edition's own. *@
<nav class="shortcuts" aria-label="@L["Shortcuts"]">
    @Link("/", L["Home"], Icons.Home, NavLinkMatch.All)
    @Link("/customers/center", Edition switch
    {
        Edition.Nonprofit => L["Donors"],
        Edition.ProfessionalServices => L["Clients"],
        _ => L["Customers"],
    }, Icons.People)
    @if (Edition == Edition.ProfessionalServices)
    {
        @Link("/time", L["Time"], Icons.Clock)
    }
    @if (Edition == Edition.Nonprofit)
    {
        @Link("/nonprofit/gifts", L["Gifts"], Icons.Gift)
    }
    @Link("/vendors/center", L["Vendors"], Icons.Store)
    @Link("/items/center", L["Items"], Icons.Box)
    @if (Edition == Edition.ECommerce)
    {
        @Link("/sales/channels", L["Sales channels"], Icons.Cart)
    }
    @Link("/banking", L["Banking"], Icons.Bank)
    @Link("/reports", L["Reports"], Icons.Chart)
</nav>

@code {
    [Parameter, EditorRequired]
    public ClaimsPrincipal User { get; set; } = default!;

    [Parameter]
    public Edition Edition { get; set; }

    private RenderFragment Link(string href, string label, string icon, NavLinkMatch match = NavLinkMatch.Prefix) => @<text>
        @if (User.CanReach(href))
        {
            <NavLink href="@href" Match="match">
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="@icon" /></svg>
                <span>@label</span>
            </NavLink>
        }
    </text>;

    // Simple line drawings of our own, stroked in the text color (24 × 24).
    private static class Icons
    {
        public const string Home = "M3 11.5 12 4l9 7.5M5.5 9.5V20h5v-6h3v6h5V9.5";
