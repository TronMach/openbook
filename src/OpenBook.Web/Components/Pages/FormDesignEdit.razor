@page "/settings/forms/{Id:guid}"
@using OpenBook.Domain.Companies
@using OpenBook.Domain.CustomFields
@inject FormDesignService Designs
@inject FormFontService Fonts
@inject OpenBook.Application.CustomFields.CustomFieldService CustomFields

<PageTitle>@(_design?.Name ?? "Design") · OpenBook</PageTitle>

<div class="wide design-page">
    @if (_design is null)
    {
        <h1>Design</h1>
        <p>There's no such design. <ActionLink Href="/settings/forms">All designs</ActionLink></p>
    }
    else
    {
        <div class="toolbar">
            <h1>@_design.Name</h1>
            @if (_design.IsDefault)
            {
                <span class="badge ok">Default</span>
            }
            <ActionLink Class="button secondary" Href="/settings/forms">All designs</ActionLink>
            <ActionLink Class="button secondary" Href="@($"/audit?entityType=form_style&entityId={_design.Id}")">History</ActionLink>
        </div>

        @if (Error is not null)
        {
            <div class="alert error" role="alert">@Error</div>
        }
        @if (Done is "saved" or "created")
        {
            <div class="alert notice" role="status">@(Done == "created" ? "Created. Change it below; the preview follows as you type." : "Saved.")</div>
        }
        @if (!_design.IsActive)
        {
            <div class="alert notice" role="status">This design is switched off: nothing prints with it.</div>
        }

        <div class="design-editor" data-design-editor>
            <div class="design-settings">
                <form method="post" action="/settings/forms/@_design.Id" data-enhance="false" data-preview="design-preview" data-logo="@(_design.Logo is null ? "" : _design.Id.ToString())" class="card design-form">
                    <AntiforgeryToken />
                    <details class="design-section" open>
                        <summary>Look</summary>
                        <div class="row">
                            <div class="field">
                                <label for="name">Name</label>
                                <input id="name" name="name" required maxlength="@FormDesign.MaxNameLength" value="@_design.Name" />
                            </div>
                            <div class="field">
                                <label for="template">Template</label>
                                <select id="template" name="template">
                                    @foreach (var choice in Enum.GetValues<FormTemplate>())
                                    {
                                        <option value="@choice" selected="@(choice == _design.Template)">@Labels.For(choice)</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label for="color">Accent color</label>
                                <input id="color" name="accentColor" type="color" value="@_design.AccentColor" />
                            </div>
                            <div class="field">
                                <label for="paper">Paper</label>
                                <select id="paper" name="paperSize">
                                    <option value="@FormPaperSize.Letter" selected="@(_design.PaperSize == FormPaperSize.Letter)">US Letter</option>
                                    <option value="@FormPaperSize.A4" selected="@(_design.PaperSize == FormPaperSize.A4)">A4</option>
                                </select>
                            </div>
                            <div class="field">
                                <label for="margins">Margins</label>
                                <select id="margins" name="margins">
                                    <option value="@FormMargins.Normal" selected="@(_design.Margins == FormMargins.Normal)">Normal</option>
                                    <option value="@FormMargins.Narrow" selected="@(_design.Margins == FormMargins.Narrow)">Narrow (more room for lines)</option>
                                    <option value="@FormMargins.Wide" selected="@(_design.Margins == FormMargins.Wide)">Wide</option>
                                </select>
                            </div>
                            <div class="field">
                                <label for="textSize">Text size</label>
                                <select id="textSize" name="textSize">
                                    <option value="@FormTextSize.Small" selected="@(_design.TextSize == FormTextSize.Small)">Small</option>
                                    <option value="@FormTextSize.Medium" selected="@(_design.TextSize == FormTextSize.Medium)">Medium</option>
                                    <option value="@FormTextSize.Large" selected="@(_design.TextSize == FormTextSize.Large)">Large</option>
                                </select>
                            </div>
                            <div class="field">
                                <label for="logoPosition">Logo</label>
                                <select id="logoPosition" name="logoPosition">
                                    <option value="@FormLogoPosition.Left" selected="@(_design.LogoPosition == FormLogoPosition.Left)">Above the company name</option>
                                    <option value="@FormLogoPosition.Right" selected="@(_design.LogoPosition == FormLogoPosition.Right)">Above the title, on the right</option>
                                    <option value="@FormLogoPosition.Center" selected="@(_design.LogoPosition == FormLogoPosition.Center)">Centered at the top</option>
                                </select>
                                <span class="hint"><a href="#logo">Upload or remove the logo</a></span>
                            </div>
                            <div class="field">
                                <label for="logoSize">Logo size</label>
                                <select id="logoSize" name="logoSize">
                                    @foreach (var size in Enum.GetValues<FormLogoSize>())
                                    {
                                        <option value="@size" selected="@(size == _design.LogoSize)">@size</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <label class="check"><input type="checkbox" name="landscape" value="true" checked="@_design.Landscape" /> <span>Landscape pages <span class="muted">(wider, for many columns)</span></span></label>
                    </details>

                    <details class="design-section" open>
                        <summary>Fonts</summary>
                        <div class="row">
                            <div class="field">
                                <label for="font">Font</label>
                                <select id="font" name="fontKey">
                                    @foreach (var group in _fonts.GroupBy(f => f.Group))
                                    {
                                        <optgroup label="@group.Key">
                                            @foreach (var font in group)
                                            {
                                                <option value="@(font.Key ?? "")" selected="@(font.Key == _design.FontKey)">@font.Family</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label for="companyFont">Your company's name and details</label>
                                <select id="companyFont" name="companyFontKey">
                                    <option value="" selected="@(_design.CompanyFontKey is null)">The same font</option>
                                    @foreach (var group in _fonts.GroupBy(f => f.Group))
                                    {
                                        <optgroup label="@group.Key">
                                            @foreach (var font in group)
                                            {
                                                var key = font.Key ?? FormDesign.BuiltInFont;
                                                <option value="@key" selected="@(key == _design.CompanyFontKey)">@font.Family</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </div>
                        </div>
                        <p class="hint">
                            The company font prints your name, address, phone and email at the top. A light font for the rest
                            (EB Garamond, Lato, Source Sans 3) uses less ink. <ActionLink Href="/settings/forms#fonts">Add a Google font or your own</ActionLink>.
                        </p>
                    </details>

                    <details class="design-section" open>
                        <summary>Columns</summary>
                        <p class="hint">
                            Tick the columns to print and number them in the order you want, left to right (at most @FormColumns.MaxColumns).
                            Widths are shares of the page: a column of 20 is twice as wide as one of 10. <strong>Fit</strong> makes a column
                            just as wide as its heading and longest entry; the other columns share what's left. Columns marked
                            "when used" are left out of a document where every line is blank.
                        </p>
                        <div class="table-wrap">
                            <table class="data design-columns">
                                <thead><tr><th>Print</th><th>Order</th><th>Column</th><th>Heading</th><th>Width</th><th>Align</th></tr></thead>
                                <tbody>
                                    @foreach (var row in _rows)
                                    {
                                        <tr class="@(row.Position is null ? "unused" : null)">
                                            <td>
                                                <input type="hidden" name="columnKey" value="@row.Key" />
                                                <input type="checkbox" name="col:@row.Key" value="true" checked="@(row.Position is not null)" aria-label="Print @row.Name" />
                                            </td>
                                            <td><input type="number" name="order:@row.Key" min="1" max="99" value="@row.Position" aria-label="Order of @row.Name" /></td>
                                            <td>
                                                <span class="column-name">@row.Name</span>
                                                @if (row.Field is not null)
                                                {
                                                    <span class="badge">item field@(row.Field.IsActive ? "" : ", off")</span>
                                                }
                                                @if (row.Optional)
                                                {
                                                    <span class="badge">when used</span>
                                                }
                                                <span class="hint">@row.Help</span>
                                            </td>
                                            <td><input name="label:@row.Key" maxlength="@FormColumns.MaxLabelLength" value="@row.Label" placeholder="@row.Name" aria-label="Heading of @row.Name" /></td>
                                            <td class="column-width">
                                                <input type="number" name="width:@row.Key" min="1" max="@FormColumns.MaxWidth" value="@row.Width" aria-label="Width of @row.Name" />
                                                <label class="fit"><input type="checkbox" name="auto:@row.Key" value="true" checked="@row.Auto" /> Fit</label>
                                            </td>
                                            <td>
                                                <select name="align:@row.Key" aria-label="Alignment of @row.Name">
                                                    @foreach (var align in Enum.GetValues<ColumnAlign>())
                                                    {
                                                        <option value="@align" selected="@(align == row.Align)">@align</option>
                                                    }
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <label class="check"><input type="checkbox" name="autoFieldColumns" value="true" checked="@_design.AutoFieldColumns" /> <span>Add a column after the description for item custom fields set to print as a column <span class="muted">(otherwise they print under the description)</span></span></label>
                        @if (_rows.All(r => r.Field is null))
                        {
                            <p class="hint">To print more about each item (pack size, color, warranty…), <ActionLink Href="/settings/custom-fields">add an item custom field</ActionLink>; it then appears here.</p>
                        }
                    </details>

                    <details class="design-section" open>
                        <summary>What's shown</summary>
                        @foreach (var (part, label) in Parts)
                        {
                            <label class="check"><input type="checkbox" name="show" value="@part" checked="@_design.Show.HasFlag(part)" /> <span>@label</span></label>
                        }
                        <p class="hint">Fields of your own on customers and documents (PO number, ship via, sales rep…) print under the title when they're set to print on forms.</p>
                    </details>

                    <details class="design-section" open="@(_design.Footer is not null)">
                        <summary>Footer</summary>
                        <div class="field">
                            <label for="footer">Footer <span class="muted">(optional)</span></label>
                            <textarea id="footer" name="footer" rows="3" maxlength="1000">@_design.Footer</textarea>
                            <span class="hint">Printed at the bottom of every page, e.g. how to pay: bank details, or "Make checks payable to…".</span>
                        </div>
                    </details>

                    <details class="design-section" open>
                        <summary>Email look</summary>
                        <fieldset class="field">
                            <legend>Emails sent with this design</legend>
                            <label class="check"><input type="radio" name="emailStyle" value="Branded" checked="@(_design.EmailStyle == EmailStyle.Branded)" /> <span>With the logo, over a band of the accent color</span></label>
                            <label class="check"><input type="radio" name="emailStyle" value="Simple" checked="@(_design.EmailStyle == EmailStyle.Simple)" /> <span>Simple: the company name in the accent color</span></label>
                            <label class="check"><input type="radio" name="emailStyle" value="Plain" checked="@(_design.EmailStyle == EmailStyle.Plain)" /> <span>Plain text only</span></label>
                            <span class="hint">The footer above closes every email too. The wording is in <ActionLink Href="/settings/email-templates">Email messages</ActionLink>, where the preview shows this look.</span>
                        </fieldset>
                    </details>

                    <details class="design-section" open="@(_design.Texts.Count > 0)">
                        <summary>Titles and messages</summary>
                        <p class="hint">Blank keeps the usual title and adds no message.</p>
                        @foreach (var document in FormDesign.Each(FormDesign.AllDocuments))
                        {
                            var usual = FormDesignService.UsualTitle(document);
                            <div class="row">
                                <div class="field">
                                    <label for="title-@document">@usual title</label>
                                    <input id="title-@document" name="title:@document" maxlength="@FormDesignText.MaxTitleLength" placeholder="@usual" value="@(_design.TitleFor(document, usual) is var t && t != usual ? t : null)" />
                                </div>
                                <div class="field">
                                    <label for="message-@document">Message on every @usual.ToLowerInvariant()</label>
                                    <textarea id="message-@document" name="message:@document" rows="2" maxlength="@FormDesignText.MaxMessageLength">@_design.MessageFor(document)</textarea>
                                </div>
                            </div>
                        }
                    </details>

                    <div class="design-save">
                        <button type="submit">Save design</button>
                        <span class="muted">The preview shows your changes now; they're kept once you save.</span>
                    </div>
                </form>

                <div class="card" id="logo">
                    <h2>Logo</h2>
                    @if (_design.Logo is not null)
                    {
                        <p class="muted">A @(_design.LogoContentType == "image/png" ? "PNG" : "JPEG") of @((_design.Logo.Length / 1024.0).ToString("0")) KB. Uploading another replaces it.</p>
                    }
                    else
                    {
                        <p class="muted">A PNG or JPEG of at most 1 MB. A wide logo on a white or transparent background prints best.</p>
                    }
                    <PostForm Action="@($"/settings/forms/{_design.Id}/logo")" enctype="multipart/form-data" data-enhance="false" class="inline-actions">
                        <AntiforgeryToken />
                        <input type="file" name="logo" accept="image/png,image/jpeg" required />
                        <button type="submit" class="secondary">Upload</button>
                    </PostForm>
                    @if (_design.Logo is not null)
                    {
                        <PostForm Action="@($"/settings/forms/{_design.Id}/logo/remove")" data-enhance="false">
                            <AntiforgeryToken />
                            <button type="submit" class="link">Remove the logo</button>
                        </PostForm>
                    }
                </div>

                <div class="card">
                    <h2>Where it's used</h2>
                    @if (_design.IsDefault)
                    {
                        <p class="muted">This is the default design: documents print with it unless another design is chosen below or for the customer.</p>
                    }
                    else if (_design.IsActive)
                    {
                        <PostForm Action="@($"/settings/forms/{_design.Id}/default")" data-enhance="false">
                            <AntiforgeryToken />
                            <button type="submit" class="secondary">Make it the default</button>
                        </PostForm>
                    }
                    @if (_design.IsActive)
                    {
                        <PostForm Action="@($"/settings/forms/{_design.Id}/documents")" data-enhance="false">
                            <AntiforgeryToken />
                            <p>Use it for every:</p>
                            <ul class="check-list">
                                @foreach (var document in FormDesign.Each(FormDesign.AllDocuments))
                                {
                                    var other = _designs.FirstOrDefault(d => d.Id != _design.Id && d.DefaultFor.HasFlag(document));
                                    <li>
                                        <label class="check">
                                            <input type="checkbox" name="doc" value="@document" checked="@_design.DefaultFor.HasFlag(document)" />
                                            <span>@FormDesignService.UsualTitle(document).ToLowerInvariant()@if (other is not null) { <span class="muted"> (now @other.Name)</span> }</span>
                                        </label>
                                    </li>
                                }
                            </ul>
                            <button type="submit" class="secondary">Save</button>
                        </PostForm>
                        <p class="muted">To use it for one customer's documents, choose it on the customer's page.</p>
                    }
                    @if (!_design.IsDefault)
                    {
                        <PostForm Action="@($"/settings/forms/{_design.Id}/active")" data-enhance="false">
                            <AntiforgeryToken />
                            <input type="hidden" name="active" value="@(_design.IsActive ? "false" : "true")" />
                            <button type="submit" class="secondary">@(_design.IsActive ? "Switch it off" : "Switch it on")</button>
                        </PostForm>
                    }
                </div>
            </div>

            <section class="design-preview" data-preview-pane="design-preview" aria-label="Preview">
                <div class="preview-bar">
                    <h2>Preview</h2>
                    <select id="design-preview-document" aria-label="Document to preview" data-preview-document="design-preview">
                        @foreach (var document in FormDesign.Each(FormDesign.AllDocuments))
                        {
                            <option value="@document">@FormDesignService.UsualTitle(document)</option>
                        }
                    </select>
                    <span class="preview-buttons">
                        <span class="segmented" role="group" aria-label="Zoom">
                            <button type="button" class="secondary" data-preview-fit="FitH" aria-pressed="true" title="Fit the page's width">Page width</button>
                            <button type="button" class="secondary" data-preview-fit="Fit" aria-pressed="false" title="Show the whole page">Whole page</button>
                        </span>
                        <button type="button" class="secondary preview-larger" data-preview-larger aria-pressed="false" title="Give the preview more of the screen">Larger preview</button>
                        <button type="button" class="secondary" data-preview-full aria-pressed="false" title="Fill the window with the preview (Esc to close)">Full screen</button>
                    </span>
                </div>
                <p class="preview-status muted" role="status" data-preview-status></p>
                <div class="preview-frames">
                    <iframe id="design-preview" class="current" title="Preview of a sample document with these settings" src="@PreviewUrl()"></iframe>
                </div>
                <p class="muted preview-note">A sample document with your company's details. It follows the settings as you change them; nothing is saved until you press Save design.</p>
            </section>
        </div>
    }
</div>

@code {
    private FormDesign? _design;
    private IReadOnlyList<FormDesign> _designs = [];
    private IReadOnlyList<FormFontChoice> _fonts = [];
    private List<ColumnRow> _rows = [];

    /// <summary>The "What's shown" boxes, in order.</summary>
    private static readonly (FormParts Part, string Label)[] Parts =
    [
        (FormParts.CompanyAddress, "Your company's address"),
        (FormParts.CompanyPhone, "Your phone number"),
        (FormParts.CompanyEmail, "Your email address"),
        (FormParts.CustomerContact, "The customer's (or vendor's) email and phone"),
        (FormParts.ShipTo, "The customer's shipping address, beside the bill-to address"),
        (FormParts.Terms, "Due date and terms"),
        (FormParts.Totals, "Totals: subtotal, tax, total and balance due (untick for a packing slip)"),
        (FormParts.Savings, "\"You saved\" when price levels or rules took something off"),
        (FormParts.Acceptance, "\"Accepted by\" and date lines to sign, on estimates"),
        (FormParts.AccountBalance, "On invoices, the customer's previous balance, the total now owed and any retainer held"),
        (FormParts.StripedRows, "Shade every other line"),
        (FormParts.PageNumbers, "Page numbers"),
    ];

    /// <summary>A row of the column table: a built-in column or an item custom field, chosen (with its position) or not.</summary>
    private sealed record ColumnRow(
        string Key, string Name, string Help, bool Optional, int? Position, string? Label, int Width, bool Auto, ColumnAlign Align, CustomField? Field);

    [Parameter] public Guid Id { get; set; }

    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? Done { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _designs = await Designs.ListAsync();
        _design = _designs.FirstOrDefault(d => d.Id == Id);
        _fonts = await Fonts.ChoicesAsync();
        if (_design is not null)
            _rows = Rows(_design, await CustomFields.ListAsync(CustomFieldTarget.Item));
    }

    /// <summary>The design's columns in order, then the other built-in columns, then active item fields it doesn't use.</summary>
    private static List<ColumnRow> Rows(FormDesign design, IReadOnlyList<CustomField> fields)
    {
        ColumnRow Row(string key, FormColumn? chosen)
        {
            var field = FormColumns.FieldId(key) is { } id ? fields.FirstOrDefault(f => f.Id == id) : null;
            var choice = FormColumns.Find(key);
            var align = chosen?.Align ?? FormColumns.UsualAlign(key) ?? (field is null ? ColumnAlign.Left : FormDesignService.UsualAlign(field));
            return new ColumnRow(key, field?.Name ?? choice?.Label ?? key, field is null ? choice?.Help ?? "" : $"Each item's {field.Name.ToLowerInvariant()}",
                FormColumns.IsOptional(key), chosen?.Position, chosen?.Label, chosen?.Width ?? FormColumns.DefaultWidth(key), chosen?.AutoWidth == true, align, field);
        }

        var rows = design.Columns.Where(c => FormColumns.FieldId(c.Key) is null || fields.Any(f => FormColumns.Field(f.Id) == c.Key))
            .Select(c => Row(c.Key, c)).ToList();
        rows.AddRange(FormColumns.BuiltIn.Where(b => rows.All(r => r.Key != b.Key)).Select(b => Row(b.Key, null)));
        rows.AddRange(fields.Where(f => f.IsActive && rows.All(r => r.Key != FormColumns.Field(f.Id))).Select(f => Row(FormColumns.Field(f.Id), null)));
        return rows;
    }

    /// <summary>The first preview, from the saved design; forms.js replaces it from the form as it changes.</summary>
    private string PreviewUrl() => $"/settings/forms/preview?design={_design!.Id}&document={FormDocuments.Invoice}#navpanes=0&view=FitH";
}
