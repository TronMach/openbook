@page "/nonprofit/gifts"
@using System.Globalization
@using OpenBook.Application.Nonprofit
@using OpenBook.Domain.Nonprofit
@inject GiftService GiftService
@inject CustomerService CustomerService

<PageTitle>Gifts · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Gifts</h1>
        <ActionLink Class="button" Href="@(Donor is { } d ? $"/nonprofit/gifts/new?donor={d}" : "/nonprofit/gifts/new")">Record a gift</ActionLink>
        <ActionLink Class="button secondary" Href="/nonprofit/gifts/batch">Enter a batch</ActionLink>
        <ActionLink Class="button secondary" Href="/nonprofit/gifts/import">Import gifts</ActionLink>
        <ActionLink Class="button secondary" Href="/nonprofit/pledges">Pledges</ActionLink>
        <ActionLink Class="button secondary" Href="/nonprofit/recurring">Recurring gifts</ActionLink>
        <ActionLink Class="button secondary" Href="/nonprofit/thanks">Thank donors</ActionLink>
        <ActionLink Class="button secondary" Href="/reports/giving-by-donor">Giving by donor</ActionLink>
    </div>

    @if (Donor is { } donorId)
    {
        <p>Gifts from <a href="/customers/@donorId">@_names.GetValueOrDefault(donorId)</a>. <a href="/nonprofit/gifts">Everyone's gifts</a></p>
    }

    <form method="get" class="inline">
        @if (Donor is { } kept)
        {
            <input type="hidden" name="donor" value="@kept" />
        }
        <label>From <input type="date" name="from" value="@_from.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" /></label>
        <label>To <input type="date" name="to" value="@_to.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" /></label>
        <button type="submit" class="secondary">Show</button>
    </form>

    @if (_gifts.Count == 0)
    {
        <div class="card"><p>No gifts in this period.</p></div>
    }
    else
    {
        <table class="data">
            <thead><tr><th>No.</th><th>Date</th><th>Donor</th><th>Kind</th><th class="num">Amount</th><th>Thanked</th></tr></thead>
            <tbody>
                @foreach (var g in _gifts)
                {
                    <tr class="@(g.Status == DocumentStatus.Voided ? "muted" : "")">
                        <td><a href="/nonprofit/gifts/@g.Id">@g.Number</a></td>
                        <td>@Labels.Date(g.Date)</td>
                        <td><a href="/customers/@g.DonorId">@_names.GetValueOrDefault(g.DonorId)</a></td>
                        <td>@(g.Kind == GiftKind.InKind ? "In kind" : g.PledgeId is null ? "Money" : "Pledge payment")@(g.Status == DocumentStatus.Voided ? " (voided)" : "")</td>
                        <td class="num">@Labels.Amount(g.Amount)</td>
                        <td>@(g.AcknowledgedAt is { } at ? Labels.Date(DateOnly.FromDateTime(at.InCompanyTime().DateTime)) : "")</td>
                    </tr>
                }
            </tbody>
            <tfoot><tr><td colspan="4">Total</td><td class="num">@Labels.Amount(_gifts.Where(g => g.Status == DocumentStatus.Posted).Sum(g => g.Amount))</td><td></td></tr></tfoot>
        </table>
    }
</div>

@code {
    private DateOnly _from;
    private DateOnly _to;
    private IReadOnlyList<Donation> _gifts = [];
    private Dictionary<Guid, string> _names = [];

    [SupplyParameterFromQuery] private string? From { get; set; }
    [SupplyParameterFromQuery] private string? To { get; set; }

    /// <summary>One donor's gifts, from every date unless a period is chosen.</summary>
    [SupplyParameterFromQuery] private Guid? Donor { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var today = CompanyTime.Today;
        var yearStart = new DateOnly(today.Year, 1, 1);
        _from = DateOnly.TryParseExact(From, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var f) ? f : Donor is null ? yearStart : new DateOnly(2000, 1, 1);
        _to = DateOnly.TryParseExact(To, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var t) ? t : today;
        _gifts = await GiftService.ListAsync(_from, _to, Donor);
        _names = (await CustomerService.ListRecordsAsync()).ToDictionary(c => c.Customer.Id, c => c.FullName ?? c.Customer.DisplayName);
    }
}
