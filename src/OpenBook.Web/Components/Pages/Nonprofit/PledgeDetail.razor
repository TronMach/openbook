@page "/nonprofit/pledges/{Id:guid}"
@using OpenBook.Application.Nonprofit
@using OpenBook.Application.Segments
@using OpenBook.Domain.Nonprofit
@inject GiftService GiftService
@inject AccountService AccountService
@inject SegmentService Segments

<PageTitle>Pledge · OpenBook</PageTitle>

<div class="wide">
    @if (_pledge is null)
    {
        <h1>Pledge not found</h1>
        <p><a href="/nonprofit/pledges">Back to pledges</a></p>
    }
    else
    {
        var p = _pledge.Pledge;
        <div class="toolbar">
            <h1>Pledge @p.Number</h1>
            @if (p.Status == DocumentStatus.Voided)
            {
                <span class="badge">Voided</span>
            }
            else if (_pledge.Balance > 0m)
            {
                <ActionLink Class="button" Href="@($"/nonprofit/gifts/new?pledge={p.Id}")">Record a payment</ActionLink>
            }
            @if (p.Status == DocumentStatus.Posted)
            {
                <a class="button secondary" href="/nonprofit/pledges/@p.Id/statement" target="_blank">Pledge statement (PDF)</a>
            }
            <ActionLink Class="button secondary" Href="@($"/journal/{p.JournalEntryId}")">Journal entry</ActionLink>
            <ActionLink Class="button secondary" Href="@($"/audit?entityId={p.Id}")">History</ActionLink>
            <ActionLink Class="button secondary" Href="/nonprofit/pledges">Pledges</ActionLink>
        </div>
        @if (Error is not null)
        {
            <div class="alert error" role="alert">@Error</div>
        }
        <dl class="facts">
            <dt>Donor</dt><dd><a href="/customers/@p.DonorId">@_pledge.Donor</a></dd>
            <dt>Date</dt><dd>@Labels.Date(p.Date)</dd>
            @if (p.DueDate is { } due)
            {
                <dt>Due by</dt><dd>@Labels.Date(due)</dd>
            }
            <dt>Promised</dt><dd>@Labels.Amount(p.Amount)</dd>
            <dt>Paid</dt><dd>@Labels.Amount(_pledge.Paid)</dd>
            @if (p.CancelledOn is { } cancelledOn)
            {
                <dt>Cancelled</dt><dd>@Labels.Amount(p.CancelledAmount) on @Labels.Date(cancelledOn)</dd>
            }
            <dt>Left</dt><dd>@Labels.Amount(_pledge.Balance)</dd>
            <dt>Contribution account</dt><dd>@_chart.FullName(p.IncomeAccountId)</dd>
            @if (_purpose is not null)
            {
                <dt>Purpose</dt><dd>@_purpose</dd>
            }
            @if (p.Memo is { } memo)
            {
                <dt>Memo</dt><dd>@memo</dd>
            }
        </dl>

        @if (_payments.Count > 0)
        {
            <h2>Payments</h2>
            <table class="data">
                <thead><tr><th>Gift</th><th>Date</th><th class="num">Amount</th></tr></thead>
                <tbody>
                    @foreach (var g in _payments)
                    {
                        <tr class="@(g.Status == DocumentStatus.Voided ? "muted" : "")">
                            <td><a href="/nonprofit/gifts/@g.Id">@g.Number@(g.Status == DocumentStatus.Voided ? " (voided)" : "")</a></td>
                            <td>@Labels.Date(g.Date)</td>
                            <td class="num">@Labels.Amount(g.Amount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (p.Status == DocumentStatus.Posted)
        {
            <div class="card" style="margin-top: 1.5rem" id="installments">
                <h2>Installments</h2>
                @if (p.Installments.Count > 0)
                {
                    var today = CompanyTime.Today;
                    var overdue = Math.Max(0m, Math.Min(p.DueBy(today), p.Amount - p.CancelledAmount) - _pledge.Paid);
                    <table class="data">
                        <thead><tr><th>Due</th><th class="num">Amount</th></tr></thead>
                        <tbody>
                            @foreach (var i in p.Installments)
                            {
                                <tr><td>@Labels.Date(i.DueDate)</td><td class="num">@Labels.Amount(i.Amount)</td></tr>
                            }
                        </tbody>
                    </table>
                    @if (overdue > 0m)
                    {
                        <p class="out-of-balance">@Labels.Amount(overdue) was due by today and hasn't been paid.</p>
                    }
                    <PostForm Action="@($"/nonprofit/pledges/{p.Id}/installments")" data-enhance="false" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="clear" value="true" />
                        <button type="submit" class="secondary">Clear the schedule</button>
                    </PostForm>
                }
                else
                {
                    <p class="muted">Paid all at once@(p.DueDate is { } dueOn ? $", due {Labels.Date(dueOn)}" : "")? Or spread it out:</p>
                }
                <PostForm Action="@($"/nonprofit/pledges/{p.Id}/installments")" data-enhance="false" class="inline-actions">
                    <AntiforgeryToken />
                    <label>Installments <input name="count" type="number" min="1" max="@Pledge.MaxInstallments" value="12" style="width: 5rem" /></label>
                    <label>every
                        <select name="months">
                            <option value="1">month</option>
                            <option value="3">3 months</option>
                            <option value="6">6 months</option>
                            <option value="12">year</option>
                        </select>
                    </label>
                    <label>from <input name="first" type="date" value="@((p.DueDate ?? p.Date).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" /></label>
                    <button type="submit" class="secondary">@(p.Installments.Count > 0 ? "Replace the schedule" : "Make the schedule")</button>
                </PostForm>
                <p class="hint">Equal amounts, the last taking any cents left over. The schedule posts nothing: it says what's due when, for the open pledges report's overdue column. Gifts naming the pledge pay it, whenever they come.</p>
            </div>
        }

        @if (p.Status == DocumentStatus.Posted && _pledge.Balance > 0m && p.CancelEntryId is null)
        {
            <div class="card" style="margin-top: 1.5rem">
                <h2>Cancel the rest</h2>
                <p class="muted">When the donor won't pay the @Labels.Amount(_pledge.Balance) left: it comes off the contribution income (accrual basis) and out of Pledges Receivable.</p>
                <PostForm Action="@($"/nonprofit/pledges/{p.Id}/cancel")" data-enhance="false" class="inline">
                    <AntiforgeryToken />
                    <label>On <input type="date" name="date" value="@CompanyTime.Today.ToString("yyyy-MM-dd")" /></label>
                    <ClosedPeriodPassword Visible="Password" Interactive="false" />
                    <button type="submit" class="secondary">Cancel the rest</button>
                </PostForm>
            </div>
        }
        else if (p.CancelEntryId is not null)
        {
            <div class="card" style="margin-top: 1.5rem">
                <h2>Undo the cancellation</h2>
                <PostForm Action="@($"/nonprofit/pledges/{p.Id}/uncancel")" data-enhance="false">
                    <AntiforgeryToken />
                    <div class="field"><label for="undo-reason">Reason</label><input id="undo-reason" name="reason" required maxlength="500" /></div>
                    <ClosedPeriodPassword Visible="Password" Interactive="false" />
                    <div class="actions"><button type="submit" class="secondary">Undo</button></div>
                </PostForm>
            </div>
        }

        @if (p.Status == DocumentStatus.Posted && _pledge.Paid == 0m && p.CancelEntryId is null)
        {
            <div class="card" style="margin-top: 1.5rem">
                <h2>Void</h2>
                <p class="muted">For a pledge recorded by mistake or withdrawn before anything was paid.</p>
                <PostForm Action="@($"/nonprofit/pledges/{p.Id}/void")" data-enhance="false">
                    <AntiforgeryToken />
                    <div class="field"><label for="reason">Reason</label><input id="reason" name="reason" required maxlength="500" /></div>
                    <ClosedPeriodPassword Visible="Password" Interactive="false" />
                    <div class="actions"><button type="submit" class="danger">Void</button></div>
                </PostForm>
            </div>
        }

        <Attachments EntityType="pledge" EntityId="p.Id" />
        <Notes EntityType="pledge" EntityId="p.Id" />
    }
</div>

@code {
    private PledgeBalance? _pledge;
    private IReadOnlyList<Donation> _payments = [];
    private string? _purpose;
    private ChartOfAccounts _chart = new([]);

    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private bool Password { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _pledge = await GiftService.GetPledgeAsync(Id);
        if (_pledge is null)
            return;
        _chart = await AccountService.GetChartAsync();
        _payments = (await GiftService.ListAsync(donorId: _pledge.Pledge.DonorId)).Where(g => g.PledgeId == Id).ToList();
        if (_pledge.Pledge.ClassId is { } classId)
            _purpose = (await Segments.NamesAsync()).GetValueOrDefault(classId);
    }
}
