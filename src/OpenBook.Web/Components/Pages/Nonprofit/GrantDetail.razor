@page "/nonprofit/grants/{Id:guid}"
@using System.Globalization
@using OpenBook.Application.Nonprofit
@using OpenBook.Domain.Nonprofit
@inject GrantService GrantService
@inject AccountService AccountService

<PageTitle>@(_position?.Grant.Name ?? "Grant") · OpenBook</PageTitle>

<div class="wide">
    @if (_position is null)
    {
        <h1>Grant not found</h1>
        <p><a href="/nonprofit/grants">Back to grants</a></p>
    }
    else
    {
        var g = _position.Grant;
        <div class="toolbar">
            <h1>@g.Name</h1>
            @if (g.Status != GrantStatus.Active)
            {
                <span class="badge">@g.Status</span>
            }
            <ActionLink Class="button secondary" Href="@($"/reports/profit-and-loss?classId={g.ClassId}&preset=Custom&from={Iso(g.StartsOn)}&to={Iso(g.EndsOn)}")">Profit and loss for its class</ActionLink>
            <ActionLink Class="button secondary" Href="@($"/audit?entityId={g.Id}")">History</ActionLink>
            <ActionLink Class="button secondary" Href="/nonprofit/grants">Grants</ActionLink>
        </div>
        @if (Error is not null)
        {
            <div class="alert error" role="alert">@Error</div>
        }

        <dl class="facts">
            <dt>Funder</dt><dd><a href="/customers/@g.FunderId">@_position.Funder</a></dd>
            @if (g.Reference is { } reference)
            {
                <dt>Award number</dt><dd>@reference</dd>
            }
            <dt>Awarded</dt><dd>@Labels.Amount(g.Amount) on @Labels.Date(g.AwardedOn)@(g.Conditional ? " (conditional)" : "")@(g.NetAward != g.Amount ? $"; now {Labels.Amount(g.NetAward)} after amendments" : "")</dd>
            <dt>Period</dt><dd>@Labels.Date(g.StartsOn) – @Labels.Date(g.EndsOn)</dd>
            <dt>Class</dt><dd><a href="/segments/@g.ClassId">@_position.ClassName</a></dd>
            <dt>Income account</dt><dd>@_chart.FullName(g.IncomeAccountId)</dd>
            <dt>Income so far</dt><dd>@Labels.Amount(g.Recognized)</dd>
            @if (g.Conditional && g.FundingSharePercent != 100m)
            {
                <dt>Funder's share</dt><dd>@g.FundingSharePercent.ToString("0.####", System.Globalization.CultureInfo.CurrentCulture)% of spending; your match so far @Labels.Amount(_position.Match)</dd>
            }
            <dt>Received</dt><dd>@Labels.Amount(g.Received)</dd>
            <dt>Due from funder</dt><dd>@Labels.Amount(Math.Max(0m, g.Due))</dd>
            @if (g.Advance > 0m)
            {
                <dt>Paid ahead</dt><dd>@Labels.Amount(g.Advance) held in @_chart.FullName(g.AdvanceAccountId!.Value) until earned</dd>
            }
            <dt>Spent so far</dt><dd>@Labels.Amount(_position.Spent) (@Labels.Amount(_position.Unspent) left)</dd>
            @if (g.Terms is { } terms)
            {
                <dt>Terms</dt><dd style="white-space: pre-line">@terms</dd>
            }
        </dl>

        <h2>Budget and spending</h2>
        <table class="data">
            <thead><tr><th>Expense account</th><th class="num">Budget</th><th class="num">Spent</th><th class="num">Left</th></tr></thead>
            <tbody>
                @foreach (var row in _position.Rows)
                {
                    <tr>
                        <td>@row.Account</td>
                        <td class="num">@(row.Budget == 0m ? "" : Labels.Amount(row.Budget))</td>
                        <td class="num">@Labels.Amount(row.Spent)</td>
                        <td class="num @(row.Left < 0m ? "negative" : "")">@Labels.Amount(row.Left)</td>
                    </tr>
                }
            </tbody>
            <tfoot><tr><td>Total</td><td class="num">@Labels.Amount(_position.Rows.Sum(r => r.Budget))</td><td class="num">@Labels.Amount(_position.Spent)</td><td class="num">@Labels.Amount(_position.Rows.Sum(r => r.Left))</td></tr></tfoot>
        </table>

        @if (g.Status == GrantStatus.Active)
        {
            @if (g.Conditional)
            {
                <div class="card" style="margin-top: 1.5rem">
                    <h2>Recognize income earned</h2>
                    <p class="muted">@Labels.Amount(_position.ReadyToRecognize) spent through today hasn't been recognized yet. Recognizing posts it as grant income on its date.</p>
                    <PostForm Action="@($"/nonprofit/grants/{g.Id}/recognize")" data-enhance="false" class="inline">
                        <AntiforgeryToken />
                        <label>Through <input type="date" name="through" value="@Iso(CompanyTime.Today)" /></label>
                        <ClosedPeriodPassword Visible="Password" Interactive="false" />
                        <button type="submit">Recognize</button>
                    </PostForm>
                </div>
            }

            <div class="card" style="margin-top: 1.5rem">
                <h2>Asking the funder</h2>
                <p class="muted"><a href="/reports/grant-budget-vs-actual?grantId=@g.Id">Grant budget vs. actual</a> is the report for the funder. A reimbursement request is a letter with the spending for a period; it posts nothing.</p>
                @if (g.Requests.Count > 0)
                {
                    <table class="data">
                        <thead><tr><th>No.</th><th>Date</th><th>Period</th><th class="num">Amount</th><th>Paid</th><th><span class="visually-hidden">@L["Actions"]</span></th></tr></thead>
                        <tbody>
                            @foreach (var r in g.Requests)
                            {
                                <tr class="@(r.IsVoided ? "muted" : null)">
                                    <td>@r.LineNumber</td>
                                    <td>@Labels.Date(r.Date)</td>
                                    <td>@OpenBook.Application.Reporting.Comparisons.Describe(r.PeriodFrom, r.PeriodTo)</td>
                                    <td class="num">@Labels.Amount(r.Amount)</td>
                                    <td>@(r.IsVoided ? "Taken back" : r.ReceiptLine is { } paid ? $"Payment {paid}" : "Waiting")</td>
                                    <td>
                                        <a href="/nonprofit/grants/@g.Id/requests/@r.LineNumber/letter" data-enhance="false">Letter</a>
                                        @if (!r.IsVoided && r.ReceiptLine is null)
                                        {
                                            <PostForm Action="@($"/nonprofit/grants/{g.Id}/requests/{r.LineNumber}/void")" Class="inline">
                                                <AntiforgeryToken />
                                                <button type="submit" class="link">Take back</button>
                                            </PostForm>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <PostForm Action="@($"/nonprofit/grants/{g.Id}/requests")" data-enhance="false">
                    <AntiforgeryToken />
                    <div class="row">
                        <div class="field"><label for="request-date">Date</label><input id="request-date" name="date" type="date" value="@Iso(CompanyTime.Today)" /></div>
                        <div class="field"><label for="request-from">Spending from</label><input id="request-from" name="from" type="date" value="@Iso(g.StartsOn)" /></div>
                        <div class="field"><label for="request-to">To</label><input id="request-to" name="to" type="date" value="@Iso(CompanyTime.Today)" /></div>
                        <div class="field"><label for="request-amount">Amount <span class="muted">(blank: what's spent and not yet asked for)</span></label><input id="request-amount" name="amount" class="amount" inputmode="decimal" /></div>
                    </div>
                    <div class="actions"><button type="submit" class="secondary">Make a request</button></div>
                </PostForm>
            </div>

            <div class="card" style="margin-top: 1.5rem">
                <h2>Money from the funder</h2>
                <PostForm Action="@($"/nonprofit/grants/{g.Id}/receive")" data-enhance="false">
                    <AntiforgeryToken />
                    <div class="row">
                        <div class="field"><label for="amount">Amount</label><input id="amount" name="amount" class="amount" inputmode="decimal" required /></div>
                        <div class="field"><label for="date">Date</label><input id="date" name="date" type="date" value="@Iso(CompanyTime.Today)" /></div>
                        <div class="field">
                            <label for="bank">Deposited to</label>
                            <select id="bank" name="bankAccountId">
                                @foreach (var a in _receiveInto)
                                {
                                    <option value="@a.Id">@_chart.FullName(a.Id)</option>
                                }
                            </select>
                        </div>
                        @if (g.Requests.Any(r => !r.IsVoided && r.ReceiptLine is null))
                        {
                            <div class="field">
                                <label for="request">Pays request</label>
                                <select id="request" name="requestLine">
                                    <option value="">None</option>
                                    @foreach (var r in g.Requests.Where(r => !r.IsVoided && r.ReceiptLine is null))
                                    {
                                        <option value="@r.LineNumber">@r.LineNumber · @Labels.Amount(r.Amount)</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                    <ClosedPeriodPassword Visible="Password" Interactive="false" />
                    <div class="actions"><button type="submit">Record payment</button></div>
                </PostForm>
            </div>

            <div class="card" style="margin-top: 1.5rem">
                <h2>Budget</h2>
                <PostForm Action="@($"/nonprofit/grants/{g.Id}/budget")" data-enhance="false">
                    <AntiforgeryToken />
                    <table class="data">
                        <thead><tr><th>Expense account</th><th class="num">Amount</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < g.Budget.Count + 5; i++)
                            {
                                var line = i < g.Budget.Count ? g.Budget[i] : null;
                                <tr>
                                    <td>
                                        <select name="account:@i" aria-label="Account @(i + 1)">
                                            <option value="">(none)</option>
                                            @foreach (var a in _expenses)
                                            {
                                                <option value="@a.Id" selected="@(line?.AccountId == a.Id)">@_chart.FullName(a.Id)</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="num"><input name="amount:@i" class="amount" inputmode="decimal" value="@(line?.Amount.ToString("0.00", CultureInfo.InvariantCulture))" aria-label="Amount @(i + 1)" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="actions"><button type="submit" class="secondary">Save budget</button></div>
                </PostForm>
            </div>
        }

        @if (g.Status != GrantStatus.Voided)
        {
            <details class="card" style="margin-top: 1.5rem">
                <summary>Change the grant: name, period, terms, or an amendment</summary>
                <PostForm Action="@($"/nonprofit/grants/{g.Id}/edit")" data-enhance="false">
                    <AntiforgeryToken />
                    <div class="row">
                        <div class="field"><label for="edit-name">Name</label><input id="edit-name" name="name" required maxlength="@Grant.MaxNameLength" value="@g.Name" /></div>
                        <div class="field"><label for="edit-ref">Award number</label><input id="edit-ref" name="reference" maxlength="100" value="@g.Reference" /></div>
                        <div class="field"><label for="edit-start">Period starts</label><input id="edit-start" name="startsOn" type="date" value="@Iso(g.StartsOn)" /></div>
                        <div class="field"><label for="edit-end">Ends</label><input id="edit-end" name="endsOn" type="date" value="@Iso(g.EndsOn)" /></div>
                    </div>
                    <div class="field"><label for="edit-terms">Terms</label><textarea id="edit-terms" name="terms" rows="3" maxlength="@Grant.MaxTextLength">@g.Terms</textarea></div>
                    <div class="actions"><button type="submit" class="secondary">Save changes</button></div>
                </PostForm>
                @if (g.Conditional)
                {
                    <PostForm Action="@($"/nonprofit/grants/{g.Id}/share")" data-enhance="false" class="inline-actions" style="margin-top: 1rem">
                        <AntiforgeryToken />
                        <label for="share">Funder pays (% of spending)</label>
                        <input id="share" name="percent" class="short" inputmode="decimal" value="@g.FundingSharePercent.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)" />
                        <button type="submit" class="secondary">Save</button>
                        <span class="hint">For a matching grant: recognition counts only this share of what's spent; the rest is your match.</span>
                    </PostForm>
                }
                <PostForm Action="@($"/nonprofit/grants/{g.Id}/amend")" data-enhance="false" style="margin-top: 1rem">
                    <AntiforgeryToken />
                    <p class="muted">@(g.Conditional ? "An amendment raises the award, so more can be recognized and paid. Nothing posts." : "An amendment raises the award: the extra is income and receivable on the date.")</p>
                    <div class="row">
                        <div class="field"><label for="amend-amount">Raise the award by</label><input id="amend-amount" name="amount" class="amount" inputmode="decimal" required /></div>
                        <div class="field"><label for="amend-date">Date</label><input id="amend-date" name="date" type="date" value="@Iso(CompanyTime.Today)" /></div>
                        <div class="field"><label for="amend-reason">Reason</label><input id="amend-reason" name="reason" required maxlength="500" placeholder="Amendment 2" /></div>
                    </div>
                    <ClosedPeriodPassword Visible="Password" Interactive="false" />
                    <div class="actions"><button type="submit" class="secondary">Amend the award</button></div>
                </PostForm>
            </details>
        }

        @if (g.Status != GrantStatus.Voided && (g.Reducible > 0m || g.Advance > 0m))
        {
            <div class="card" style="margin-top: 1.5rem">
                <h2>When the funder won't pay it all</h2>
                @if (g.Reducible > 0m)
                {
                    <PostForm Action="@($"/nonprofit/grants/{g.Id}/reduce")" data-enhance="false">
                        <AntiforgeryToken />
                        <p class="muted">@(g.Conditional
                            ? "Brings the award down, so no more than the rest is recognized as income. Nothing posts."
                            : "Writes off what the funder won't pay: the income and the receivable come down on the date.") Up to @Labels.Amount(g.Reducible).</p>
                        <div class="row">
                            <div class="field"><label for="reduce-amount">Reduce the award by</label><input id="reduce-amount" name="amount" class="amount" inputmode="decimal" required value="@g.Reducible.ToString("0.00")" /></div>
                            <div class="field"><label for="reduce-date">Date</label><input id="reduce-date" name="date" type="date" value="@Iso(CompanyTime.Today)" /></div>
                            <div class="field"><label for="reduce-reason">Reason</label><input id="reduce-reason" name="reason" required maxlength="500" placeholder="Funder's letter of 3 June" /></div>
                        </div>
                        <ClosedPeriodPassword Visible="Password" Interactive="false" />
                        <div class="actions"><button type="submit" class="secondary">Reduce the award</button></div>
                    </PostForm>
                }
                @if (g.Advance > 0m)
                {
                    <PostForm Action="@($"/nonprofit/grants/{g.Id}/return-advance")" data-enhance="false" style="margin-top: 1rem">
                        <AntiforgeryToken />
                        <p class="muted">Pays back advance money not spent on the grant: @Labels.Amount(g.Advance) is held.</p>
                        <div class="row">
                            <div class="field"><label for="return-amount">Paid back</label><input id="return-amount" name="amount" class="amount" inputmode="decimal" required value="@g.Advance.ToString("0.00")" /></div>
                            <div class="field"><label for="return-date">Date</label><input id="return-date" name="date" type="date" value="@Iso(CompanyTime.Today)" /></div>
                            <div class="field">
                                <label for="return-bank">From</label>
                                <select id="return-bank" name="bankAccountId">
                                    @foreach (var a in _banks)
                                    {
                                        <option value="@a.Id">@_chart.FullName(a.Id)</option>
                                    }
                                </select>
                            </div>
                            <div class="field"><label for="return-reason">Reason</label><input id="return-reason" name="reason" required maxlength="500" /></div>
                        </div>
                        <ClosedPeriodPassword Visible="Password" Interactive="false" />
                        <div class="actions"><button type="submit" class="secondary">Return the advance</button></div>
                    </PostForm>
                }
            </div>
        }

        @if (g.Status != GrantStatus.Voided)
        {
            <div class="card" style="margin-top: 1.5rem" id="reports-due">
                <h2>Reports due to the funder</h2>
                @if (g.ReportsDue.Count > 0)
                {
                    <table class="data">
                        <thead><tr><th>Due</th><th>Report</th><th>Sent</th><th><span class="visually-hidden">@L["Actions"]</span></th></tr></thead>
                        <tbody>
                            @foreach (var r in g.ReportsDue.OrderBy(r => r.DueOn))
                            {
                                <tr class="@(r.SentOn is null && r.DueOn < CompanyTime.Today ? "warn" : r.SentOn is not null ? "muted" : "")">
                                    <td>@Labels.Date(r.DueOn)</td>
                                    <td>@r.Title</td>
                                    <td>
                                        <PostForm Action="@($"/nonprofit/grants/{g.Id}/reports/{r.LineNumber}/sent")" class="inline" data-enhance="false">
                                            <AntiforgeryToken />
                                            @if (r.SentOn is { } sent)
                                            {
                                                <span>@Labels.Date(sent)</span>
                                                <input type="hidden" name="undo" value="true" />
                                                <button type="submit" class="link">Not sent after all</button>
                                            }
                                            else
                                            {
                                                <input name="sentOn" type="date" aria-label="Sent on" value="@Iso(CompanyTime.Today)" />
                                                <button type="submit" class="secondary">Mark sent</button>
                                            }
                                        </PostForm>
                                    </td>
                                    <td>
                                        <PostForm Action="@($"/nonprofit/grants/{g.Id}/reports/{r.LineNumber}/remove")" class="inline" data-enhance="false">
                                            <AntiforgeryToken />
                                            <button type="submit" class="link">Remove</button>
                                        </PostForm>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <PostForm Action="@($"/nonprofit/grants/{g.Id}/reports")" data-enhance="false">
                    <AntiforgeryToken />
                    <div class="row">
                        <div class="field"><label for="report-due">Due on</label><input id="report-due" name="dueOn" type="date" required /></div>
                        <div class="field"><label for="report-title">Report</label><input id="report-title" name="title" required maxlength="200" placeholder="Interim narrative and financial report" /></div>
                    </div>
                    <div class="actions"><button type="submit" class="secondary">Add a report due</button></div>
                </PostForm>
                <p class="hint">Reports due within two weeks, and late ones, show on the home page's to-do list.</p>
            </div>
        }

        @if (g.Receipts.Count + g.Recognitions.Count + g.Adjustments.Count > 0)
        {
            <h2 style="margin-top: 1.5rem">Payments and income recognized</h2>
            <table class="data">
                <thead><tr><th>Date</th><th>What</th><th class="num">Amount</th><th><span class="visually-hidden">@L["Actions"]</span></th></tr></thead>
                <tbody>
                    @foreach (var r in g.Receipts)
                    {
                        <tr class="@(r.IsVoided ? "muted" : "")">
                            <td>@Labels.Date(r.Date)</td>
                            <td><a href="/journal/@r.EntryId">Payment</a> to @_chart.FullName(r.BankAccountId)@(r.IsVoided ? " (voided)" : "")@if (r.DepositId is { } deposit) { <span>, <a href="/banking/deposits/@deposit">deposited</a></span> }</td>
                            <td class="num">@Labels.Amount(r.Amount)</td>
                            <td>@if (!r.IsVoided) { <VoidLine Action="@($"/nonprofit/grants/{g.Id}/receipts/{r.LineNumber}/void")" Password="Password" /> }</td>
                        </tr>
                    }
                    @foreach (var r in g.Recognitions)
                    {
                        <tr class="@(r.IsVoided ? "muted" : "")">
                            <td>@Labels.Date(r.Date)</td>
                            <td><a href="/journal/@r.EntryId">Income recognized</a>@(r.IsVoided ? " (voided)" : "")</td>
                            <td class="num">@Labels.Amount(r.Amount)</td>
                            <td>@if (!r.IsVoided) { <VoidLine Action="@($"/nonprofit/grants/{g.Id}/recognitions/{r.LineNumber}/void")" Password="Password" /> }</td>
                        </tr>
                    }
                    @foreach (var a in g.Adjustments)
                    {
                        <tr class="@(a.IsVoided ? "muted" : "")">
                            <td>@Labels.Date(a.Date)</td>
                            <td>
                                @if (a.EntryId is { } entry)
                                {
                                    <a href="/journal/@entry">@(a.Kind switch { GrantAdjustmentKind.Reduction => "Award reduced", GrantAdjustmentKind.Increase => "Award increased", _ => "Advance paid back" })</a>
                                }
                                else
                                {
                                    <span>@(a.Kind == GrantAdjustmentKind.Increase ? "Award increased" : "Award reduced")</span>
                                }
                                <span class="muted">· @a.Reason</span>@(a.IsVoided ? " (voided)" : "")
                            </td>
                            <td class="num">@Labels.Amount(a.Kind == GrantAdjustmentKind.Increase ? a.Amount : -a.Amount)</td>
                            <td>@if (!a.IsVoided) { <VoidLine Action="@($"/nonprofit/grants/{g.Id}/adjustments/{a.LineNumber}/void")" Password="Password" /> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="card" style="margin-top: 1.5rem">
            <h2>Status</h2>
            @if (g.Status == GrantStatus.Active)
            {
                <PostForm Action="@($"/nonprofit/grants/{g.Id}/close")" data-enhance="false" class="inline">
                    <AntiforgeryToken />
                    <button type="submit" class="secondary">Close the grant</button>
                    <span class="hint">When it's finished: nothing more is expected.</span>
                </PostForm>
            }
            else if (g.Status == GrantStatus.Closed)
            {
                <PostForm Action="@($"/nonprofit/grants/{g.Id}/reopen")" data-enhance="false" class="inline">
                    <AntiforgeryToken />
                    <button type="submit" class="secondary">Reopen</button>
                </PostForm>
            }
            @if (g.Status != GrantStatus.Voided)
            {
                <PostForm Action="@($"/nonprofit/grants/{g.Id}/void")" data-enhance="false" style="margin-top: 1rem">
                    <AntiforgeryToken />
                    <p class="muted">Void a grant recorded by mistake (after voiding its payments and recognized income).</p>
                    <div class="field"><label for="reason">Reason</label><input id="reason" name="reason" required maxlength="500" /></div>
                    <ClosedPeriodPassword Visible="Password" Interactive="false" />
                    <div class="actions"><button type="submit" class="danger">Void grant</button></div>
                </PostForm>
            }
        </div>

        <Attachments EntityType="grant" EntityId="g.Id" />
        <Notes EntityType="grant" EntityId="g.Id" />
    }
</div>

@code {
    private GrantPosition? _position;
    private ChartOfAccounts _chart = new([]);
    private List<Account> _banks = [];
    private List<Account> _receiveInto = [];
    private List<Account> _expenses = [];

    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private bool Password { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _position = await GrantService.PositionAsync(Id, CompanyTime.Today);
        _chart = await AccountService.GetChartAsync();
        var active = _chart.Ordered(includeInactive: false).Select(x => x.Account).ToList();
        _banks = active.Where(a => a.Type == AccountType.Bank).ToList();
        // A bank, or a holding account such as Undeposited Funds to go into a deposit with other money.
        _receiveInto = [.. _banks, .. active.Where(a => a.Type == AccountType.OtherCurrentAsset && a.Name.Contains("Undeposited", StringComparison.OrdinalIgnoreCase))];
        _expenses = active.Where(a => a.Type.ClassOf() == AccountClass.Expense).ToList();
    }

    private static string Iso(DateOnly date) => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}
