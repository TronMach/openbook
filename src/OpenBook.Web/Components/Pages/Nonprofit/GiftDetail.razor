@page "/nonprofit/gifts/{Id:guid}"
@using OpenBook.Application.Forms
@using OpenBook.Application.Nonprofit
@using OpenBook.Application.Segments
@using OpenBook.Domain.Nonprofit
@inject GiftService GiftService
@inject CustomerService CustomerService
@inject AccountService AccountService
@inject SegmentService Segments
@inject SoftCreditService SoftCredits

<PageTitle>Gift · OpenBook</PageTitle>

<div class="wide">
    @if (_gift is null)
    {
        <h1>Gift not found</h1>
        <p><a href="/nonprofit/gifts">Back to gifts</a></p>
    }
    else
    {
        <div class="toolbar">
            <h1>Gift @_gift.Number</h1>
            @if (_gift.Status == DocumentStatus.Voided)
            {
                <span class="badge">Voided</span>
            }
            else if (_gift.ReturnedOn is not null)
            {
                <span class="badge warn">Returned by the bank</span>
            }
            else
            {
                <a class="button secondary" href="/nonprofit/gifts/@_gift.Id/letter" target="_blank">Acknowledgment (PDF)</a>
            }
            @if (_gift.Status == DocumentStatus.Posted && _gift.PledgeId is null)
            {
                <ActionLink Class="button secondary" Href="@($"/nonprofit/gifts/{_gift.Id}/edit")">Change</ActionLink>
            }
            <ActionLink Class="button secondary" Href="@($"/journal/{_gift.JournalEntryId}")">Journal entry</ActionLink>
            <ActionLink Class="button secondary" Href="@($"/audit?entityId={_gift.Id}")">History</ActionLink>
            <ActionLink Class="button secondary" Href="/nonprofit/gifts">Gifts</ActionLink>
        </div>
        @if (Error is not null)
        {
            <div class="alert error" role="alert">@Error</div>
        }
        @if (Sent)
        {
            <div class="alert notice" role="status">Acknowledgment sent.</div>
        }
        @if (_gift.ReturnedOn is { } returnedOn)
        {
            <div class="alert notice" role="status">
                Came back from the bank on @Labels.Date(returnedOn): @_gift.ReturnReason.@(_gift.ReturnFee > 0m ? $" The bank's fee of {Labels.Amount(_gift.ReturnFee)} was recorded with it." : "")
                It no longer counts on the donor's statements and letters@(_gift.PledgeId is null ? "" : ", and the pledge is owed again").
                <a href="/journal/@_gift.ReturnEntryId">The entry</a>.
            </div>
        }
        @if (Split is > 1)
        {
            <div class="alert success" role="status">The check was recorded as @Split gifts, one per purpose; this is the first. The others are on <a href="/customers/@_gift.DonorId">the donor's page</a>.</div>
        }
        <dl class="facts">
            <dt>Donor</dt><dd><a href="/customers/@_gift.DonorId">@_donor?.DisplayName</a></dd>
            <dt>Date</dt><dd>@Labels.Date(_gift.Date)</dd>
            <dt>Amount</dt><dd>@Labels.Amount(_gift.Amount)</dd>
            <dt>Kind</dt><dd>@(_gift.Kind == GiftKind.InKind ? $"In kind: {_gift.Description}" : "Money")</dd>
            <dt>@(_gift.Kind == GiftKind.InKind ? "Recorded to" : "Deposited to")</dt><dd>@_chart.FullName(_gift.DebitAccountId)</dd>
            <dt>Contribution account</dt><dd>@_chart.FullName(_gift.IncomeAccountId)</dd>
            @if (_gift.ExchangeAccountId is { } exchange && _gift.ExchangePart > 0m)
            {
                <dt>Value received</dt><dd>@Labels.Amount(_gift.ExchangePart) to @_chart.FullName(exchange); @Labels.Amount(_gift.Amount - _gift.ExchangePart) is the contribution</dd>
            }
            @if (_gift.PledgeId is { } pledge)
            {
                <dt>Pays</dt><dd><a href="/nonprofit/pledges/@pledge">pledge</a></dd>
            }
            @if (_purpose is not null)
            {
                <dt>Purpose</dt><dd>@_purpose</dd>
            }
            @if (_gift.Reference is { } reference)
            {
                <dt>Reference</dt><dd>@reference</dd>
            }
            @if (_gift.GoodsValue > 0m)
            {
                <dt>Received in return</dt><dd>@_gift.GoodsDescription (@Labels.Amount(_gift.GoodsValue)); deductible @Labels.Amount(_gift.Deductible)</dd>
            }
            @if (_gift.Memo is { } memo)
            {
                <dt>Memo</dt><dd>@memo</dd>
            }
            <dt>Thanked</dt><dd>@(_gift.AcknowledgedAt is { } at ? Labels.Date(DateOnly.FromDateTime(at.InCompanyTime().DateTime)) : "Not yet")</dd>
            <dt>Campaign</dt>
            <dd>
                <PostForm Action="@($"/nonprofit/gifts/{_gift.Id}/campaign")" class="inline" data-enhance="false">
                    <AntiforgeryToken />
                    <input name="campaign" aria-label="Campaign or appeal" value="@_gift.Campaign" maxlength="@Donation.MaxCampaignLength" list="campaigns" placeholder="None" />
                    <datalist id="campaigns">
                        @foreach (var c in _campaigns)
                        {
                            <option value="@c"></option>
                        }
                    </datalist>
                    <button type="submit" class="secondary">Save</button>
                </PostForm>
            </dd>
        </dl>

        @if (_gift.Status == DocumentStatus.Posted)
        {
            <div class="card" style="margin-top: 1.5rem">
                <h2>Send the acknowledgment</h2>
                <p><ActionLink Class="button" Href="@($"/nonprofit/gifts/{_gift.Id}/email")">Email the letter</ActionLink></p>
                @if (_gift.AcknowledgedAt is null)
                {
                    <PostForm Action="/nonprofit/thanks/mark" data-enhance="false" style="margin-top: 0.75rem">
                        <AntiforgeryToken />
                        <input type="hidden" name="id" value="@_gift.Id" />
                        <input type="hidden" name="back" value="/nonprofit/gifts/@_gift.Id" />
                        <button type="submit" class="secondary">Mark as thanked (printed or sent another way)</button>
                    </PostForm>
                }
            </div>

            <EmailHistory EntityType="donation" EntityId="_gift.Id" />

            @if (_gift.Kind == GiftKind.Cash && _gift.PayoutId is null)
            {
                <div class="card" style="margin-top: 1.5rem">
                    @if (_gift.ReturnedOn is null)
                    {
                        <h2>Returned by the bank</h2>
                        <p class="muted">For a check that bounced after it was deposited: takes the money out of the bank and the gift out of the donor's giving on the day it came back@(_gift.PledgeId is null ? "" : ", and the pledge is owed again"). The gift and its deposit stay as they happened. A gift still in Undeposited Funds is voided instead.</p>
                        <PostForm Action="@($"/nonprofit/gifts/{_gift.Id}/return")" data-enhance="false">
                            <AntiforgeryToken />
                            <div class="row">
                                <div class="field"><label for="return-date">Came back on</label><input id="return-date" name="date" type="date" value="@CompanyTime.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" /></div>
                                <div class="field"><label for="return-fee">Bank's fee <span class="muted">(optional)</span></label><input id="return-fee" name="fee" class="amount" inputmode="decimal" placeholder="0.00" /></div>
                                <div class="field"><label for="return-reason">Why</label><input id="return-reason" name="reason" required maxlength="500" placeholder="Insufficient funds" /></div>
                            </div>
                            <ClosedPeriodPassword Visible="Password" Interactive="false" />
                            <div class="actions"><button type="submit" class="secondary" data-confirm="Record that this gift came back from the bank?">Record the return</button></div>
                        </PostForm>
                    }
                    else
                    {
                        <h2>Take the return back</h2>
                        <p class="muted">If the check cleared after all: the return's entries are voided and the gift counts again.</p>
                        <PostForm Action="@($"/nonprofit/gifts/{_gift.Id}/return/undo")" data-enhance="false">
                            <AntiforgeryToken />
                            <div class="field"><label for="undo-reason">Reason</label><input id="undo-reason" name="reason" required maxlength="500" /></div>
                            <ClosedPeriodPassword Visible="Password" Interactive="false" />
                            <div class="actions"><button type="submit" class="secondary">Take the return back</button></div>
                        </PostForm>
                    }
                </div>
            }

            <div class="card" style="margin-top: 1.5rem">
                <h2>Void</h2>
                <p class="muted">Takes the gift out of the books on its date@(_gift.PledgeId is null ? "" : ", and puts it back on the pledge").</p>
                <PostForm Action="@($"/nonprofit/gifts/{_gift.Id}/void")" data-enhance="false">
                    <AntiforgeryToken />
                    <div class="field"><label for="reason">Reason</label><input id="reason" name="reason" required maxlength="500" /></div>
                    <ClosedPeriodPassword Visible="Password" Interactive="false" />
                    <div class="actions"><button type="submit" class="danger">Void</button></div>
                </PostForm>
            </div>
        }

        <div class="card" id="soft-credits" style="margin-top: 1.5rem">
            <h2>Soft credits</h2>
            <p class="muted">
                Recognition for someone besides the donor: a spouse, a fundraiser who brought the gift in. It shows on donor reports and recognition
                lists, never on receipts or giving statements, which are the donor's.
            </p>
            @if (_credits.Count > 0)
            {
                <table class="data">
                    <thead><tr><th>Credited</th><th>Why</th><th class="num">Amount</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                    <tbody>
                        @foreach (var c in _credits)
                        {
                            <tr>
                                <td><a href="/customers/@c.Credit.DonorId">@c.Credited</a></td>
                                <td>@c.Credit.Note</td>
                                <td class="num">@Labels.Amount(c.Credit.Amount)</td>
                                <td>
                                    <PostForm Action="@($"/nonprofit/gifts/{_gift.Id}/soft-credits/{c.Credit.Id}/remove")" data-enhance="false" class="inline">
                                        <AntiforgeryToken />
                                        <button type="submit" class="secondary" data-confirm="Take this soft credit off?" aria-label="Take off @c.Credited's soft credit">Take off</button>
                                    </PostForm>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (_gift.Status == DocumentStatus.Posted)
            {
                <PostForm Action="@($"/nonprofit/gifts/{_gift.Id}/soft-credits")" data-enhance="false">
                    <AntiforgeryToken />
                    <div class="row">
                        <div class="field">
                            <label for="credit-donor">Credit</label>
                            <select id="credit-donor" name="donorId" data-search required>
                                <option value="">Choose someone…</option>
                                @foreach (var c in _people.Where(p => p.Customer.Id != _gift.DonorId))
                                {
                                    <option value="@c.Customer.Id">@c.FullName</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label for="credit-amount">Amount <span class="muted">(blank: all of it)</span></label>
                            <input id="credit-amount" name="amount" inputmode="decimal" class="short" />
                        </div>
                        <div class="field">
                            <label for="credit-note">Why <span class="muted">(optional)</span></label>
                            <input id="credit-note" name="note" maxlength="@SoftCredit.MaxNoteLength" placeholder="Spouse" />
                        </div>
                    </div>
                    <div class="actions"><button type="submit" class="secondary">Add soft credit</button></div>
                </PostForm>
            }
        </div>

        <Attachments EntityType="donation" EntityId="_gift.Id" />
        <Notes EntityType="donation" EntityId="_gift.Id" />
    }
</div>

@code {
    private Donation? _gift;
    private Customer? _donor;
    private string? _purpose;
    private ChartOfAccounts _chart = new([]);

    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private bool Password { get; set; }
    [SupplyParameterFromQuery] private bool Sent { get; set; }
    [SupplyParameterFromQuery] private int? Split { get; set; }

    private IReadOnlyList<string> _campaigns = [];
    private IReadOnlyList<SoftCreditView> _credits = [];
    private IReadOnlyList<CustomerEntry> _people = [];

    protected override async Task OnInitializedAsync()
    {
        _campaigns = await GiftService.CampaignsAsync();
        _gift = await GiftService.GetAsync(Id);
        if (_gift is null)
            return;
        _donor = await CustomerService.GetAsync(_gift.DonorId);
        _credits = await SoftCredits.ListAsync(_gift.Id);
        _people = await CustomerService.ListRecordsAsync();
        _chart = await AccountService.GetChartAsync();
        if (_gift.ClassId is { } classId)
            _purpose = (await Segments.NamesAsync()).GetValueOrDefault(classId);
    }
}
