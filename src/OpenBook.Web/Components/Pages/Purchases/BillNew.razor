@page "/purchases/bills/new"
@rendermode InteractiveServer
@inject Operations Ops
@inject NavigationManager Navigation

<PageTitle>New bill · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>New bill</h1>
        <ActionLink Class="button secondary" Href="/purchases">Back to purchases</ActionLink>
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    @if (_loaded)
    {
        <FormDraft @ref="_draft" T="Draft" Key="bill-new" Snapshot="TakeDraft" OnRestore="RestoreAsync" />
        <div class="card">
            <div class="row">
                <div class="field">
                    <label for="vendor">Vendor</label>
                    <SearchSelect Id="vendor" Options="PickerOptions.Vendors(_vendors)" VendorAdded="v => _vendors = [.. _vendors, v]" Value="_vendor?.Id" OnChange="PickVendor" Placeholder="Choose a vendor…" />
                </div>
                <div class="field">
                    <label for="reference">Bill no. <span class="muted">(the vendor's invoice number, optional)</span></label>
                    <input id="reference" @bind="_reference" maxlength="30" />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="date">Bill date</label>
                    <input id="date" type="date" value="@_date.ToString("yyyy-MM-dd")" @onchange="ChangeDate" />
                </div>
                <div class="field">
                    <label for="due">Due date @(_vendor is { } v2 ? $"({Labels.Terms(v2.PaymentTermsDays)})" : "")</label>
                    <input id="due" type="date" @bind="_dueDate" />
                </div>
            </div>

            <BillLinesEditor Classes="_segments.ClassColumn" Lines="_lines" Categories="_categories" Chart="_chart" UseNumbers="_useNumbers" Items="_stockItems" Changed="StateHasChanged" />

            <MoreOptions HasContent="@(_segments.Locations.Count > 0 || _warehouses.Count > 1)" Open="@(_locationId is not null || _warehouseId is not null)">
                <LocationField Options="_segments" @bind-Value="_locationId" />
                <WarehouseField Warehouses="_warehouses" @bind-Value="_warehouseId" />
            </MoreOptions>
            <MoreOptions HasContent="@(_customers.Count > 0)" Open="@(_billTo is not null)" Title="Billing a customer">
                <BillableToField Customers="_customers" @bind-Value="_billTo" @bind-Markup="_billMarkup" />
            </MoreOptions>
            <div class="field" style="margin-top: 1rem">
                <label for="memo">Memo <span class="muted">(optional)</span></label>
                <input id="memo" @bind="_memo" maxlength="1000" />
            </div>

            <ClosedPeriodPassword Visible="_needsClosingPassword" @bind-Value="_closingPassword" />


            @if (_duplicates.Count > 0)
            {
                <div class="alert notice" role="alert">
                    <p>@(_duplicates.Count == 1 ? "This may already be entered:" : "These may already be entered:")
                        @foreach (var (d, i) in _duplicates.Select((d, i) => (d, i)))
                        {
                            @(i > 0 ? "; " : " ")<a href="/purchases/bills/@d.Id" target="_blank">bill @(d.Reference ?? "without a number") of @Labels.Date(d.Date)</a>
                        }
                        , from the same vendor for the same amount. Save anyway if it's a different bill.</p>
                </div>
            }
            <div class="actions">
                <button type="button" @onclick="SaveAsync" disabled="@(!CanSave || _busy)">@(_duplicates.Count > 0 ? "Save anyway" : "Save bill")</button>
                <a href="/purchases">Cancel</a>
            </div>
        </div>
    }
</div>

@code {
    // What's typed so far, kept in the tab in case the connection goes.
    internal sealed record Draft(Guid? VendorId, string? Reference, DateOnly Date, DateOnly DueDate, string? Memo, Guid? LocationId, Guid? WarehouseId, List<BillLineModel> Lines);

    private FormDraft<Draft>? _draft;

    private Draft? TakeDraft() => _vendor is null && !_lines.Any(BillLineModel.IsFilledLine) ? null
        : new Draft(_vendor?.Id, _reference, _date, _dueDate, _memo, _locationId, _warehouseId, _lines);

    private void RestoreAsync(Draft draft)
    {
        _vendor = _vendors.FirstOrDefault(v => v.Id == draft.VendorId);
        (_reference, _date, _dueDate, _memo, _locationId, _warehouseId) = (draft.Reference, draft.Date, draft.DueDate, draft.Memo, draft.LocationId, draft.WarehouseId);
        _lines = draft.Lines.Count > 0 ? draft.Lines : [new()];
    }

    private IReadOnlyList<Vendor> _vendors = [];
    private IReadOnlyList<Customer> _customers = [];
    private Guid? _billTo;
    private decimal? _billMarkup;
    private ChartOfAccounts _chart = new([]);
    private List<Account> _categories = [];
    private IReadOnlyList<Item> _stockItems = [];
    private bool _useNumbers;
    private Vendor? _vendor;
    private string? _reference;
    private DateOnly _date = CompanyTime.Today;
    private DateOnly _dueDate = CompanyTime.Today;
    private string? _memo;
    private List<BillLineModel> _lines = [new()];
    private bool _loaded;
    private bool _busy;
    private string? _error;
    private bool _needsClosingPassword;
    private string? _closingPassword;

    [SupplyParameterFromQuery(Name = "vendor")]
    private Guid? PresetVendor { get; set; }

    /// <summary>A bill to start from ("Copy" on its page).</summary>
    [SupplyParameterFromQuery(Name = "copy")]
    private Guid? Copy { get; set; }

    private bool CanSave => _vendor is not null && BillLineModel.IsComplete(_lines);

    private SegmentOptions _segments = SegmentOptions.None;
    private IReadOnlyList<Warehouse> _warehouses = [];
    private Guid? _warehouseId;

    private Guid? _locationId;


    protected override async Task OnInitializedAsync()
    {

        _segments = await Ops.RunAsync(SegmentOptions.LoadAsync);
        _warehouses = await Ops.RunAsync(sp => sp.GetRequiredService<OpenBook.Application.Inventory.WarehouseService>().ListAsync());
        (_vendors, _chart, _useNumbers) = await Ops.RunAsync(async sp => (
            (IReadOnlyList<Vendor>)(await sp.GetRequiredService<VendorService>().ListAsync(_date)).Select(s => s.Vendor).ToList(),
            await sp.GetRequiredService<AccountService>().GetChartAsync(),
            (await sp.GetRequiredService<CompanySettingsService>().GetAsync()).UseAccountNumbers));
        _categories = BillLineModel.Categories(_chart);
        _customers = await Ops.RunAsync(async sp => (IReadOnlyList<Customer>)(await sp.GetRequiredService<CustomerService>().ListAsync(_date)).Select(s => s.Customer).ToList());
        _stockItems = await Ops.RunAsync(async sp =>
            (IReadOnlyList<Item>)(await sp.GetRequiredService<ItemService>().ListAsync()).Where(i => i.IsInventory).ToList());
        if (Copy is { } copyId && await Ops.RunAsync(sp => sp.GetRequiredService<BillService>().GetAsync(copyId)) is { PurchaseOrderId: null } source)
        {
            // "Copy": the same vendor, lines and settings, dated today; the vendor's bill number is theirs to give.
            _lines = BillLineModel.CopiesOf(source.Lines);
            SetVendor(source.VendorId);
            _memo = source.Memo;
            _locationId = source.LocationId;
            _warehouseId = source.WarehouseId;
        }
        else if (PresetVendor is { } preset)
            SetVendor(preset);
        _loaded = true;
    }

    private void PickVendor(ChangeEventArgs e) => SetVendor(Guid.TryParse(e.Value as string, out var id) ? id : null);

    private void SetVendor(Guid? id)
    {
        _vendor = _vendors.FirstOrDefault(v => v.Id == id);
        if (_vendor is null)
            return;
        _dueDate = _vendor.DueDateFor(_date);
        if (_vendor.DefaultExpenseAccountId is { } category && _lines[0].AccountId is null)
            _lines[0].AccountId = category;
    }

    private void ChangeDate(ChangeEventArgs e)
    {
        if (!DateOnly.TryParse(e.Value as string, System.Globalization.CultureInfo.InvariantCulture, out var date))
            return;
        _date = date;
        _dueDate = _vendor?.DueDateFor(date) ?? (_dueDate < date ? date : _dueDate);
    }

    private IReadOnlyList<Bill> _duplicates = [];

    /// <summary>The total and vendor the duplicate warning was given for: saving again with them unchanged goes ahead.</summary>
    private static readonly TimeSpan ReadTheWarning = TimeSpan.FromSeconds(1.5);

    private (Guid Vendor, decimal Total, DateOnly Date)? _warnedFor;
    private DateTimeOffset _warnedAt;

    private async Task SaveAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            var lines = BillLineModel.Drafts(_lines);
            var check = (_vendor!.Id, lines.Sum(l => l.Amount), _date);
            if (_warnedFor != check)
            {
                _duplicates = await Ops.RunAsync<BillService, IReadOnlyList<Bill>>(s => s.PossibleDuplicatesAsync(check.Item1, check.Item3, check.Item2));
                _warnedFor = check;
                _warnedAt = DateTimeOffset.UtcNow;
                if (_duplicates.Count > 0)
                    return;
            }
            else if (_duplicates.Count > 0 && DateTimeOffset.UtcNow - _warnedAt < ReadTheWarning)
            {
                // The second click of a double click, before anyone could have read the list.
                return;
            }

            var command = new CreateBillCommand(_vendor!.Id, _date, lines, _dueDate, _reference, _memo, LocationId: _locationId, WarehouseId: _warehouseId);
            var (billTo, markup) = (_billTo, _billMarkup);
            var bill = await Ops.RunAsync(async sp =>
            {
                // The marks go in with the bill, or neither does.
                await using var tx = await sp.GetRequiredService<OpenBook.Application.IUnitOfWork>().BeginAsync(default);
                var saved = await sp.GetRequiredService<BillService>().CreateAsync(command);
                if (billTo is { } customer && saved.Lines.Any(l => l.ItemId is null && l.Amount > 0m))
                    await sp.GetRequiredService<BillableExpenseService>().MarkAllAsync(BillableSource.Bill, saved.Id, customer, markup);
                await tx.CommitAsync(default);
                return saved;
            }, _closingPassword);
            await _draft!.ClearAsync();
            Navigation.NavigateTo($"/purchases/bills/{bill.Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword |= ClosedPeriod.NeedsPassword(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
