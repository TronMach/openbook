@page "/purchases/recurring/new"
@page "/purchases/recurring/{Id:guid}"
@rendermode InteractiveServer
@inject Operations Ops
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? L["New recurring bill"].Value : _name) · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>@(Id is null ? L["New recurring bill"].Value : _name)</h1>
        <ActionLink Class="button secondary" Href="/purchases/recurring">@L["Back to recurring bills"]</ActionLink>
        @if (Id is { } id)
        {
            <ActionLink Class="button secondary" Href="@($"/audit?entityId={id}")">@L["History"]</ActionLink>
        }
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (_saved)
    {
        <div class="alert notice" role="status">@L["Saved."]</div>
    }

    @if (_notFound)
    {
        <div class="card"><p>That recurring bill doesn't exist. <a href="/purchases/recurring">Back to recurring bills</a>.</p></div>
    }
    else if (_loaded)
    {
        @if (!_active)
        {
            <div class="alert notice" role="status">@L["This recurring bill is inactive, so no bills are entered from it."]</div>
        }

        <div class="card">
            <div class="row">
                <div class="field">
                    <label for="name">@L["Name"]</label>
                    <input id="name" @bind="_name" maxlength="100" />
                </div>
                <div class="field">
                    <label for="vendor">@L["Vendor"]</label>
                    <SearchSelect Id="vendor" Options="PickerOptions.Vendors(_vendors)" VendorAdded="v => _vendors = [.. _vendors, v]" @bind-Value="_vendorId" Placeholder="Choose a vendor…" />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="interval">@L["Repeat every"]</label>
                    <div class="inline">
                        <input id="interval" class="short" type="number" min="1" max="99" @bind="_interval" />
                        <select aria-label="Frequency" @bind="_frequency">
                            @foreach (var frequency in Enum.GetValues<RecurrenceFrequency>())
                            {
                                <option value="@frequency">@RecurrenceLabels.Unit(frequency, _interval)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="field">
                    <label for="start">@L["First bill date"]</label>
                    <input id="start" type="date" @bind="_startDate" />
                </div>
                <div class="field">
                    <label for="end">@L["End date"] <span class="muted">@L["(optional)"]</span></label>
                    <input id="end" type="date" @bind="_endDate" />
                </div>
                <div class="field">
                    <label for="max">@L["Times"] <span class="muted">@L["(optional)"]</span></label>
                    <input id="max" class="short" type="number" min="1" @bind="_maxOccurrences" />
                </div>
            </div>
            <label class="check">
                <input type="checkbox" @bind="_autoCreate" />
                <span>@L["Enter bills automatically when due"]</span>
            </label>

            <div class="row">
                <LocationField Options="_segments" @bind-Value="_locationId" />
            </div>
            <TagChecks Options="_segments" Value="_tags" />

            <BillLinesEditor Classes="_segments.ClassColumn" Lines="_lines" Categories="_categories" Chart="_chart" UseNumbers="_useNumbers" Changed="StateHasChanged" />

            <div class="field" style="margin-top: 1rem">
                <label for="memo">@L["Memo"] <span class="muted">@L["(optional; defaults to the name)"]</span></label>
                <input id="memo" @bind="_memo" maxlength="1000" />
            </div>

            <div class="actions">
                <button type="button" @onclick="SaveAsync" disabled="@(_vendorId is null || string.IsNullOrWhiteSpace(_name) || !BillLineModel.IsComplete(_lines) || _busy)">@L["Save"]</button>
                @if (Id is not null)
                {
                    <button type="button" class="secondary" @onclick="() => ToggleActiveAsync(false)" disabled="@_busy" title="@(_active ? null : "Dates it missed while inactive are passed over")">@(_active ? "Make inactive" : "Make active")</button>
                    @if (!_active)
                    {
                        <button type="button" class="secondary" @onclick="() => ToggleActiveAsync(true)" disabled="@_busy">Make active and catch up</button>
                    }
                }
                @if (_created > 0)
                {
                    <span class="muted">@_created entered so far. Changes apply to future bills only.</span>
                }
            </div>
        </div>
    }
</div>

@code {
    // Noted when the form opens, so a save can tell if the record has moved on.
    private int? _version;

    private IReadOnlyList<Vendor> _vendors = [];
    private ChartOfAccounts _chart = new([]);
    private List<Account> _categories = [];
    private bool _useNumbers;
    private bool _loaded;
    private bool _notFound;
    private bool _busy;
    private bool _saved;
    private string? _error;

    private string _name = string.Empty;
    private Guid? _vendorId;
    private string? _memo;
    private int _interval = 1;
    private RecurrenceFrequency _frequency = RecurrenceFrequency.Monthly;
    private DateOnly _startDate = CompanyTime.Today;
    private DateOnly? _endDate;
    private int? _maxOccurrences;
    private bool _autoCreate;
    private bool _active = true;
    private int _created;
    private List<BillLineModel> _lines = [new()];
    private SegmentOptions _segments = SegmentOptions.None;
    private Guid? _locationId;
    private HashSet<Guid> _tags = [];

    [Parameter]
    public Guid? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id is { } versionOf)
            _version = await Ops.VersionAsync<RecurringBill>(versionOf);
        RecurringBill? template;
        (_vendors, _chart, _useNumbers, template) = await Ops.RunAsync(async sp => (
            (IReadOnlyList<Vendor>)(await sp.GetRequiredService<VendorService>().ListRecordsAsync()).ToList(),
            await sp.GetRequiredService<AccountService>().GetChartAsync(),
            (await sp.GetRequiredService<CompanySettingsService>().GetAsync()).UseAccountNumbers,
            Id is { } id ? await sp.GetRequiredService<RecurringBillService>().GetAsync(id) : null));
        _categories = BillLineModel.Categories(_chart);
        _segments = await Ops.RunAsync(SegmentOptions.LoadAsync);

        if (Id is not null)
        {
            if (template is null)
            {
                _notFound = true;
                return;
            }

            Show(template);
        }

        _loaded = true;
    }

    private void Show(RecurringBill t)
    {
        _name = t.Name;
        _vendorId = t.VendorId;
        _memo = t.Memo;
        _interval = t.Interval;
        _frequency = t.Frequency;
        _startDate = t.StartDate;
        _endDate = t.EndDate;
        _maxOccurrences = t.MaxOccurrences;
        _autoCreate = t.AutoCreate;
        _active = t.IsActive;
        _created = t.OccurrencesPosted;
        _lines = t.Lines.OrderBy(l => l.LineNumber).Select(l => BillLineModel.From(l.ToDraft())).ToList();
        _locationId = t.LocationId;
        _tags = t.TagIds.ToHashSet();
    }

    private async Task SaveAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        _saved = false;
        try
        {
            var details = new RecurringBillDetails(_name, _vendorId!.Value, BillLineModel.Drafts(_lines), _frequency, _startDate, _interval,
                _endDate, _maxOccurrences, _autoCreate, _memo, _locationId, _tags.ToList());
            if (Id is { } id)
            {
                Show(await Ops.ChangeAsync<RecurringBill, RecurringBillService, RecurringBill>(id, _version, s => s.UpdateAsync(id, details)));
                _version = await Ops.VersionAsync<RecurringBill>(id);
                _saved = true;
            }
            else
            {
                var created = await Ops.RunAsync<RecurringBillService, RecurringBill>(s => s.CreateAsync(details));
                Navigation.NavigateTo($"/purchases/recurring/{created.Id}");
            }
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleActiveAsync(bool catchUp)
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            _active = (await Ops.RunAsync<RecurringBillService, RecurringBill>(s => s.SetActiveAsync(Id!.Value, !_active, catchUp))).IsActive;
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
