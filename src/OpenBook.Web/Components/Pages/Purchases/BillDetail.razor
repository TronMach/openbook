@page "/purchases/bills/{Id:guid}"
@using System.ComponentModel.DataAnnotations
@inject BillService Bills
@inject VendorService VendorService
@inject AccountService AccountService
@inject CompanySettingsService Settings
@inject NavigationManager Navigation
@inject ClosedPeriodOverride ClosingOverride
@inject OpenBook.Application.Inventory.WarehouseService WarehouseService

<PageTitle>Bill · OpenBook</PageTitle>

@if (_bill is null || _vendor is null)
{
    <div class="card"><p>That bill doesn't exist. <a href="/purchases">Back to purchases</a>.</p></div>
    return;
}

<div class="wide">
    @{
        var status = Labels.Status(_bill, DateOnly.FromDateTime(DateTime.Today));
    }
    <div class="toolbar">
        <h1>Bill from @_vendor.DisplayName</h1>
        <span class="badge @(status == "Overdue" ? "warn" : status == "Paid" ? "ok" : null)">@status</span>
        <a class="button secondary" href="/purchases">Back to purchases</a>
        <a class="button secondary" href="/audit?entityId=@_bill.Id">History</a>
        @if (_bill.IsOpen)
        {
            <a class="button secondary" href="/purchases/vendor-credits/apply?vendor=@_vendor.Id">Apply credit</a>
            <a class="button" href="/purchases/pay-bills?vendor=@_vendor.Id">Pay bills</a>
        }
    </div>
    @if (_bill.RecurringBillId is { } recurringId)
    {
        <p class="muted">Entered by a <a href="/purchases/recurring/@recurringId">recurring bill</a>.</p>
    }

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    <div class="card">
        <dl class="facts">
            <dt>Vendor</dt><dd><a href="/vendors/@_vendor.Id">@_vendor.DisplayName</a></dd>
            @if (_bill.Reference is not null) { <dt>Bill no.</dt><dd>@_bill.Reference</dd> }
            <dt>Date</dt><dd>@Labels.Date(_bill.Date)</dd>
            <dt>Due</dt><dd>@Labels.Date(_bill.DueDate)</dd>
            @if (_bill.WarehouseId is { } warehouseId)
            {
                <dt>Warehouse</dt><dd>@_place(new StockPlace(warehouseId, null))</dd>
            }
            @if (_bill.Memo is not null) { <dt>Memo</dt><dd>@_bill.Memo</dd> }
            @if (_bill.PurchaseOrderId is { } orderId) { <dt>Purchase order</dt><dd><a href="/purchases/orders/@orderId">View</a></dd> }
            @if (_bill.Approval != BillApproval.NotRequired)
            {
                <dt>Approval</dt>
                <dd>
                    @PurchaseOrderDetail.Approval(_bill.Approval)@(_bill.ApprovedBy is { } by ? $" by {by}" : "")@(_bill.ApprovalNote is { } note ? $": {note}" : "")
                    @if (_bill.Approval is BillApproval.Pending or BillApproval.Rejected)
                    {
                        <span> · <a href="/purchases/approvals">Approvals</a></span>
                    }
                </dd>
                @if (_bill.Approval is BillApproval.Pending or BillApproval.Rejected) { <dt>Held because</dt><dd style="white-space: pre-line">@_bill.HoldReason</dd> }
            }
            @if (_bill.EnteredBy is { } enteredBy) { <dt>Entered by</dt><dd>@enteredBy</dd> }
            <dt>Journal entry</dt><dd><a href="/journal/@_bill.JournalEntryId">View</a></dd>
        </dl>
    </div>

    <table class="data">
        <thead><tr><th>Category</th><th>Description</th><th class="num">Amount</th></tr></thead>
        <tbody>
            @foreach (var line in _bill.Lines.OrderBy(l => l.LineNumber))
            {
                <tr>
                    <td>@Labels.AccountName(_chart, line.AccountId, _useNumbers)</td>
                    <td>
                        @line.Description
                        @if (line.Lots is { } lots)
                        {
                            <div class="muted">@lots</div>
                        }
                        @if (line.ItemId is { } itemId && line.Quantity is { } quantity)
                        {
                            <span class="muted"> · <a href="/items/@itemId">@Labels.Quantity(quantity) received</a></span>
                        }
                        <LineFields DocumentId="_bill.Id" LineNumber="line.LineNumber" />
                    </td>
                    <td class="num">@Labels.Amount(line.Amount)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr><td colspan="2">Total</td><td class="num">@Labels.Amount(_bill.Total)</td></tr>
            @if (_bill.AmountPaid > 0m)
            {
                <tr><td colspan="2">Paid and credited</td><td class="num">-@Labels.Amount(_bill.AmountPaid)</td></tr>
            }
            <tr><td colspan="2">Balance due</td><td class="num">@Labels.Amount(_bill.Balance)</td></tr>
        </tfoot>
    </table>

    @if (_payments.Count > 0)
    {
        <h2 style="margin-top: 1.5rem">Payments</h2>
        <table class="data">
            <thead><tr><th>Date</th><th>Ref</th><th class="num">Applied to this bill</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in _payments)
                {
                    <tr class="@(p.Status == DocumentStatus.Voided ? "inactive" : null)">
                        <td><a href="/purchases/payments/@p.Id">@Labels.Date(p.Date)</a></td>
                        <td>@p.Reference</td>
                        <td class="num">@Labels.Amount(p.Applications.Single(a => a.BillId == _bill.Id).Amount)</td>
                        <td>@(p.Status == DocumentStatus.Voided ? "Voided" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_credits.Count > 0)
    {
        <h2 style="margin-top: 1.5rem">Vendor credits applied</h2>
        <table class="data">
            <thead><tr><th>Credit</th><th>Applied on</th><th class="num">Applied to this bill</th></tr></thead>
            <tbody>
                @foreach (var c in _credits)
                {
                    var application = c.Applications.Single(a => a.BillId == _bill.Id);
                    <tr>
                        <td><a href="/purchases/vendor-credits/@c.Id">@(c.Reference ?? Labels.Date(c.Date))</a></td>
                        <td>@Labels.Date(application.AppliedOn)</td>
                        <td class="num">@Labels.Amount(application.Amount)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_bill.Status == DocumentStatus.Posted)
    {
        <div class="card" style="margin-top: 1.5rem">
            <h2>Void this bill</h2>
            <p class="muted">
                @(_bill.AmountPaid > 0m
                    ? "This bill has payments or vendor credits applied, so it can't be voided."
                    : "Voiding reverses its journal entry on the same date and removes it from what you owe.")
            </p>
            @if (_bill.AmountPaid == 0m)
            {
                <EditForm Model="VoidInput" FormName="void" OnValidSubmit="VoidAsync" method="post">
                    <DataAnnotationsValidator />
                    <div class="field">
                        <label for="reason">Reason</label>
                        <InputText id="reason" @bind-Value="VoidInput.Reason" />
                        <ValidationMessage For="() => VoidInput.Reason" />
                    </div>
                    <ClosedPeriodPassword Visible="_needsClosingPassword" Interactive="false" Name="VoidInput.ClosingPassword" />
                    <button type="submit" class="danger">Void bill</button>
                </EditForm>
            }
        </div>
    }

    <EntryTags EntryId="_bill.JournalEntryId" />

    <BillableLinesPanel Kind="BillableSource.Bill" DocumentId="_bill.Id" Back="@($"/purchases/bills/{_bill.Id}")"
                        Active="@(_bill.Status == DocumentStatus.Posted)" Error="@BillableError" />

    <Attachments EntityType="bill" EntityId="_bill.Id" />

    <CustomFieldPanel EntityType="bill" EntityId="_bill.Id" />

    <Notes EntityType="bill" EntityId="_bill.Id" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "billableError")] private string? BillableError { get; set; }

    private Func<StockPlace, string> _place = _ => "";
    private Bill? _bill;
    private Vendor? _vendor;
    private IReadOnlyList<BillPayment> _payments = [];
    private IReadOnlyList<VendorCredit> _credits = [];
    private ChartOfAccounts _chart = new([]);
    private bool _useNumbers;
    private string? _error;
    private bool _needsClosingPassword;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "void")]
    private VoidModel VoidInput { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        VoidInput ??= new();
        _place = await WarehouseService.NamerAsync();
        _bill = await Bills.GetAsync(Id);
        if (_bill is null)
            return;
        _vendor = await VendorService.GetAsync(_bill.VendorId);
        _payments = await Bills.ListPaymentsAsync(Id);
        _credits = await Bills.ListCreditsAsync(Id);
        _chart = await AccountService.GetChartAsync();
        _useNumbers = (await Settings.GetAsync()).UseAccountNumbers;
    }

    private async Task VoidAsync()
    {
        try
        {
            ClosingOverride.Password = VoidInput.ClosingPassword;
            await Bills.VoidAsync(Id, VoidInput.Reason);
            Navigation.NavigateTo($"/purchases/bills/{Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword = ClosedPeriod.NeedsPassword(ex);
        }
    }

    private sealed class VoidModel
    {
        [Required(ErrorMessage = "Say why the bill is being voided.")]
        [StringLength(500)]
        public string Reason { get; set; } = string.Empty;

        public string? ClosingPassword { get; set; }
    }
}
