@page "/purchases/vendor-credits/new"
@rendermode InteractiveServer
@inject Operations Ops
@inject NavigationManager Navigation

<PageTitle>New vendor credit · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>New vendor credit</h1>
        <ActionLink Class="button secondary" Href="/purchases?show=credits">Back to vendor credits</ActionLink>
    </div>
    <p class="muted">For returns and billing corrections: reduces what you owe the vendor. Apply it to their bills afterwards, or record the refund when they pay you back.</p>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    @if (_loaded)
    {
        <div class="card">
            <div class="row">
                <div class="field">
                    <label for="vendor">Vendor</label>
                    <SearchSelect Id="vendor" Options="PickerOptions.Vendors(_vendors)" VendorAdded="v => _vendors = [.. _vendors, v]" Value="_vendorId" OnChange="PickVendor" Placeholder="Choose a vendor…" />
                </div>
                <div class="field">
                    <label for="reference">Credit no. <span class="muted">(the vendor's, optional)</span></label>
                    <input id="reference" @bind="_reference" maxlength="30" />
                </div>
                <div class="field">
                    <label for="date">Date</label>
                    <input id="date" type="date" @bind="_date" />
                </div>
            </div>

            <BillLinesEditor Classes="_segments.ClassColumn" Lines="_lines" Categories="_categories" Chart="_chart" UseNumbers="_useNumbers" Items="_stockItems" Changed="StateHasChanged" />
            <p class="hint">Sending stock back? Choose the item and its quantity on a line: the stock leaves at its cost, and any difference from the amount credited goes to Purchase Price Variance.</p>

            <LocationField Options="_segments" @bind-Value="_locationId" />
            <div class="field" style="margin-top: 1rem">
                <label for="memo">Memo <span class="muted">(optional)</span></label>
                <input id="memo" @bind="_memo" maxlength="1000" />
            </div>

            <ClosedPeriodPassword Visible="_needsClosingPassword" @bind-Value="_closingPassword" />

            <div class="actions">
                <button type="button" @onclick="SaveAsync" disabled="@(_vendorId is null || !BillLineModel.IsComplete(_lines) || _busy)">Save vendor credit</button>
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<Vendor> _vendors = [];
    private ChartOfAccounts _chart = new([]);
    private List<Account> _categories = [];
    private IReadOnlyList<Item> _stockItems = [];
    private bool _useNumbers;
    private Guid? _vendorId;
    private string? _reference;
    private DateOnly _date = CompanyTime.Today;
    private string? _memo;
    private List<BillLineModel> _lines = [new()];
    private bool _loaded;
    private bool _busy;
    private string? _error;
    private bool _needsClosingPassword;
    private string? _closingPassword;

    [SupplyParameterFromQuery(Name = "vendor")]
    private Guid? PresetVendor { get; set; }

    private SegmentOptions _segments = SegmentOptions.None;

    private Guid? _locationId;


    protected override async Task OnInitializedAsync()
    {

        _segments = await Ops.RunAsync(SegmentOptions.LoadAsync);
        (_vendors, _chart, _useNumbers) = await Ops.RunAsync(async sp => (
            (IReadOnlyList<Vendor>)(await sp.GetRequiredService<VendorService>().ListAsync(_date)).Select(s => s.Vendor).ToList(),
            await sp.GetRequiredService<AccountService>().GetChartAsync(),
            (await sp.GetRequiredService<CompanySettingsService>().GetAsync()).UseAccountNumbers));
        _categories = BillLineModel.Categories(_chart);
        _stockItems = await Ops.RunAsync(async sp =>
            (IReadOnlyList<Item>)(await sp.GetRequiredService<ItemService>().ListAsync()).Where(i => i.IsInventory && i.Tracking == ItemTracking.None).ToList());
        if (PresetVendor is { } preset)
            SetVendor(preset);
        _loaded = true;
    }

    private void PickVendor(ChangeEventArgs e) => SetVendor(Guid.TryParse(e.Value as string, out var id) ? id : null);

    private void SetVendor(Guid? id)
    {
        _vendorId = _vendors.Any(v => v.Id == id) ? id : null;
        if (_vendors.FirstOrDefault(v => v.Id == id)?.DefaultExpenseAccountId is { } category && _lines[0].AccountId is null)
            _lines[0].AccountId = category;
    }

    private async Task SaveAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            var command = new CreateVendorCreditCommand(_vendorId!.Value, _date, BillLineModel.Drafts(_lines), _reference, _memo, LocationId: _locationId);
            var credit = await Ops.RunAsync<VendorCreditService, VendorCredit>(s => s.CreateAsync(command), _closingPassword);
            Navigation.NavigateTo($"/purchases/vendor-credits/{credit.Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword |= ClosedPeriod.NeedsPassword(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
