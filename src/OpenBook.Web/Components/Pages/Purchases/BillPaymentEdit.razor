@page "/purchases/payments/{Id:guid}/edit"
@rendermode InteractiveServer
@inject Operations Ops
@inject NavigationManager Navigation

<PageTitle>Change bill payment · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Change bill payment@(_vendor is null ? "" : $" to {_vendor.DisplayName}")</h1>
        <ActionLink Class="button secondary" Href="@($"/purchases/payments/{Id}")">Back to the payment</ActionLink>
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    @if (_loaded && (_payment is null || _payment.Status == DocumentStatus.Voided))
    {
        <div class="card"><p>Only posted payments can be changed. <a href="/purchases/payments/@Id">Back to the payment</a></p></div>
    }
    else if (_loaded && _payment is not null && _vendor is not null)
    {
        <p class="muted">Saving reverses the payment's journal entry on its original date and posts the corrected one, then pays the bills again as shown below. Payments reconciled at the bank can't be changed, and a check that's been printed, sent by ACH or in a positive pay file keeps its amount, account and number. Changes in a closed period need the closing date password.</p>

        <div class="card">
            <div class="row">
                <div class="field">
                    <label>Vendor</label>
                    <div>@_vendor.DisplayName</div>
                    <span class="hint">To pay another vendor, void this payment and pay again.</span>
                </div>
                <div class="field">
                    <label for="date">Payment date</label>
                    <input id="date" type="date" @bind="_date" />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="account">Paid from</label>
                    <select id="account" @bind="_accountId">
                        @foreach (var a in _accounts)
                        {
                            <option value="@a.Id">@_chart.FullName(a.Id)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="reference">Check no. / reference <span class="muted">(optional)</span></label>
                    <input id="reference" @bind="_reference" maxlength="30" />
                </div>
            </div>
            <div class="field">
                <label for="memo">Memo <span class="muted">(optional)</span></label>
                <input id="memo" @bind="_memo" maxlength="1000" />
            </div>
        </div>

        <div class="table-wrap">
            <table class="data entry">
                <thead><tr><th>Bill</th><th>Date</th><th>Due</th><th class="num">Open without this payment</th><th class="num">Payment</th></tr></thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr @key="row.Bill.Id">
                            <td><a href="/purchases/bills/@row.Bill.Id" target="_blank">@(row.Bill.Reference ?? "(no number)")</a></td>
                            <td>@Labels.Date(row.Bill.Date)</td>
                            <td>@Labels.Date(row.Bill.DueDate)</td>
                            <td class="num">@Labels.Amount(row.Open)</td>
                            <td><input class="amount" type="number" step="0.01" min="0" aria-label="Payment for bill @row.Bill.Reference" @bind="row.Amount" /></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><td colspan="4">Total paid</td><td class="num">@Labels.Amount(Total)</td></tr>
                </tfoot>
            </table>
        </div>

        <div class="card">
            <div class="field">
                <label for="reason">Why are you changing it?</label>
                <input id="reason" @bind="_reason" @bind:event="oninput" maxlength="400" />
                <span class="hint">Kept in the payment's history and the audit log.</span>
            </div>

            <ClosedPeriodPassword Visible="_needsClosingPassword" @bind-Value="_closingPassword" />

            <div class="actions">
                <button type="button" @onclick="SaveAsync" disabled="@(!CanSave || _busy)">Save changes</button>
                <a href="/purchases/payments/@Id">Cancel</a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private BillPayment? _payment;
    private Vendor? _vendor;
    private ChartOfAccounts _chart = new([]);
    private List<Account> _accounts = [];
    private Guid _accountId;
    private DateOnly _date;
    private string? _reference;
    private string? _memo;
    private string? _reason;
    private List<RowModel> _rows = [];
    private bool _loaded;
    private bool _busy;
    private string? _error;
    private bool _needsClosingPassword;
    private string? _closingPassword;

    private decimal Total => _rows.Sum(r => r.Amount ?? 0m);
    private bool CanSave => Total > 0m && _rows.All(r => (r.Amount ?? 0m) >= 0m && (r.Amount ?? 0m) <= r.Open) && !string.IsNullOrWhiteSpace(_reason);

    protected override async Task OnInitializedAsync()
    {
        _payment = await Ops.RunAsync<BillPaymentService, BillPayment?>(s => s.GetAsync(Id));
        if (_payment is not null)
        {
            IReadOnlyList<Bill> bills;
            (_vendor, _chart, bills) = await Ops.RunAsync(async sp => (
                await sp.GetRequiredService<VendorService>().GetAsync(_payment.VendorId),
                await sp.GetRequiredService<AccountService>().GetChartAsync(),
                await sp.GetRequiredService<BillService>().ListAsync(_payment.VendorId)));
            _accounts = _chart.Ordered(includeInactive: false).Select(x => x.Account)
                .Where(a => a.Type is AccountType.Bank or AccountType.CreditCard || a.Id == _payment.PaymentAccountId)
                .ToList();

            var paid = _payment.Applications.ToDictionary(a => a.BillId, a => a.Amount);
            _rows = bills
                .Where(b => paid.ContainsKey(b.Id) || b.IsOpen && b.CanBePaid && b.PayableAccountId == _payment.PayableAccountId)
                .OrderBy(b => b.DueDate).ThenBy(b => b.Date)
                .Select(b => new RowModel(b, b.Balance + paid.GetValueOrDefault(b.Id)) { Amount = paid.TryGetValue(b.Id, out var a) ? a : null })
                .ToList();
            _accountId = _payment.PaymentAccountId;
            _date = _payment.Date;
            _reference = _payment.Reference;
            _memo = _payment.Memo;
        }

        _loaded = true;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var command = new ChangeBillPaymentCommand(_date,
                _rows.Where(r => (r.Amount ?? 0m) > 0m).Select(r => new ApplyToBill(r.Bill.Id, r.Amount!.Value)).ToList(),
                _reason!, _accountId, _reference ?? "", _memo ?? "");
            await Ops.RunAsync<BillPaymentService, BillPayment>(s => s.ChangeAsync(Id, command), _closingPassword);
            Navigation.NavigateTo($"/purchases/payments/{Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword |= ClosedPeriod.NeedsPassword(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class RowModel(Bill bill, decimal open)
    {
        public Bill Bill { get; } = bill;

        /// <summary>The bill's balance if this payment didn't pay any of it.</summary>
        public decimal Open { get; } = open;

        public decimal? Amount { get; set; }
    }
}
