@page "/documents"
@using OpenBook.Application.Documents
@using OpenBook.Domain.Documents
@inject DocumentCaptureService DocumentService
@inject VendorService VendorService
@inject CustomerService CustomerService
@inject PurchaseOrderService Orders

<PageTitle>Document inbox · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Document inbox</h1>
        <a class="button secondary" href="@(ShowAll ? "/documents" : "/documents?showAll=true")">@(ShowAll ? "Waiting only" : "Show all")</a>
        @if (_admin)
        {
            <ActionLink Class="button secondary" Href="/settings/document-reading">Reading settings</ActionLink>
        }
    </div>
    <p class="muted">
        Upload a vendor's invoice, a customer's purchase order, a packing slip or a vendor's quote as a PDF, scan or photo. OpenBook reads
        who it's from, its number, dates, totals and lines, matches them to your vendors or customers, purchase orders and items, and you
        check them against the document before turning it into a record. Already paid it on the spot? Upload it under
        <ActionLink Href="/purchases/receipts">Receipts</ActionLink> instead, to record it as an expense.
        @if (_settings.IsReady)
        {
            <span>Reading with Claude is on: files you tick below are sent to Anthropic to read.</span>
        }
        else
        {
            <span>Documents are read on this server only@(DocumentService.CanReadImages ? "" : "; photos and scans aren't read until an OCR engine is installed or an admin switches on reading with Claude").</span>
        }
    </p>

    @if (Error is not null)
    {
        <div class="alert error" role="alert">@Error</div>
    }
    @if (Uploaded is > 0 and var uploaded)
    {
        <div class="alert notice" role="status">@(uploaded == 1 ? "1 document was" : $"{uploaded} documents were") uploaded and read. Check each one below.</div>
    }

    <div class="card">
        <PostForm Action="/documents/upload" enctype="multipart/form-data" data-enhance="false">
            <AntiforgeryToken />
            @if (_order is not null)
            {
                <input type="hidden" name="purchaseOrderId" value="@_order.Id" />
                <p>For purchase order <a href="/purchases/orders/@_order.Id">@_order.Number</a>@(_names.GetValueOrDefault(_order.VendorId) is { } vendor ? $" to {vendor}" : ""): what's read is matched to it unless the document names another.</p>
            }
            <div class="row">
                <div class="field">
                    <label for="kind">What is it?</label>
                    <select id="kind" name="kind" required>
                        @foreach (var kind in Enum.GetValues<DocumentKind>().Where(k => _order is null || DocumentKinds.IsFromVendor(k)))
                        {
                            <option value="@kind" selected="@(kind == Kind)">@DocumentKinds.Label(kind)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="file">Files</label>
                    <input id="file" type="file" name="file" accept=".pdf,.png,.jpg,.jpeg,.gif,.webp,.tif,.tiff,.txt,.csv" multiple required />
                    <span class="hint">Choose several at once if you like (up to @OpenBook.Web.Endpoints.DocumentEndpoints.MaxFiles, all of the same kind).</span>
                </div>
            </div>
            @if (_settings.IsReady)
            {
                <label class="check">
                    <input type="checkbox" name="claude" value="true" checked />
                    <span>Read it with Claude (sent to Anthropic)</span>
                </label>
            }
            <div class="actions"><button type="submit">Upload and read</button></div>
        </PostForm>
    </div>

    @if (_documents.Count == 0)
    {
        <div class="card"><p>@(ShowAll ? "No documents yet." : "Nothing waiting to be checked.")</p></div>
    }
    else
    {
        <table class="data">
            <thead><tr><th>Uploaded</th><th>Kind</th><th>File</th><th>From</th><th>Number</th><th>Date</th><th class="num">Total</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var d in _documents)
                {
                    <tr class="@(d.Status == CapturedDocumentStatus.Dismissed ? "inactive" : null)">
                        <td>@d.CreatedAt.InCompanyTime().ToString("g")</td>
                        <td>@DocumentKinds.Label(d.Kind)</td>
                        <td><a href="/documents/@d.Id">@d.FileName</a></td>
                        <td>@From(d)</td>
                        <td>@d.Number</td>
                        <td>@(d.Date is { } date ? Labels.Date(date) : "")</td>
                        <td class="num">@(d.Total is { } t ? Labels.Amount(t) : "")</td>
                        <td>@(d.Status switch { CapturedDocumentStatus.New => "To check", CapturedDocumentStatus.Done => "Done", _ => "Dismissed" })</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IReadOnlyList<CapturedDocument> _documents = [];
    private DocumentReadingSettings _settings = default!;
    private Dictionary<Guid, string> _names = [];

    private bool _admin;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromQuery] private bool ShowAll { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private int? Uploaded { get; set; }

    /// <summary>The kind to start with (a purchase order's page asks for a vendor invoice or a packing slip).</summary>
    [SupplyParameterFromQuery(Name = "kind")] private string? KindText { get; set; }

    /// <summary>Uploading for one of our purchase orders, from its page.</summary>
    [SupplyParameterFromQuery(Name = "order")] private Guid? OrderId { get; set; }

    private PurchaseOrder? _order;

    private DocumentKind Kind => Enum.TryParse<DocumentKind>(KindText, out var k) ? k : DocumentKind.VendorInvoice;

    protected override async Task OnInitializedAsync()
    {
        _order = OrderId is { } orderId ? await Orders.GetAsync(orderId) : null;
        _admin = AuthState is not null && (await AuthState).User.CanReach("/settings/document-reading");
        _settings = await DocumentService.GetSettingsAsync();
        _documents = (await DocumentService.ListAsync()).Where(d => ShowAll || d.Status == CapturedDocumentStatus.New).ToList();
        var today = CompanyTime.Today;
        foreach (var v in await VendorService.ListAsync(today))
            _names[v.Vendor.Id] = v.Vendor.DisplayName;
        foreach (var c in await CustomerService.ListAsync(today))
            _names[c.Customer.Id] = c.Customer.DisplayName;
    }

    private string? From(CapturedDocument d) =>
        (d.VendorId ?? d.CustomerId) is { } id && _names.TryGetValue(id, out var name) ? name : d.Party;
}
