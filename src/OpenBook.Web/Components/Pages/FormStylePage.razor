@page "/settings/forms"
@using OpenBook.Domain.Companies
@inject FormDesignService Designs

<PageTitle>Invoice style · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Invoice and form designs</h1>
        <a class="button secondary" href="/settings">Settings</a>
        <a class="button secondary" href="/audit?entityType=form_style">History</a>
    </div>
    <p class="muted">
        How printed invoices, estimates, credit memos, sales receipts, statements and purchase orders look. Every document uses the
        default design, unless another design is chosen for that kind of document or for the customer. Your company name, address,
        email and phone come from Settings.
    </p>

    @if (Error is not null)
    {
        <div class="alert error" role="alert">@Error</div>
    }

    <div class="card">
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Design</th><th>Used for</th><th>Template</th><th>Paper</th><th>Logo</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var design in _designs)
                    {
                        <tr class="@(design.IsActive ? null : "inactive")">
                            <td>
                                <a href="/settings/forms/@design.Id">@design.Name</a>
                                @if (design.IsDefault)
                                {
                                    <span class="badge ok">Default</span>
                                }
                            </td>
                            <td>@UsedFor(design)</td>
                            <td class="muted">@Labels.For(design.Template)</td>
                            <td class="muted">@design.PaperSize</td>
                            <td class="muted">@(design.Logo is null ? "" : "Yes")</td>
                            <td class="muted">@(design.IsActive ? "" : "Switched off")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <h2>New design</h2>
        <form method="post" action="/settings/forms/new" data-enhance="false">
            <AntiforgeryToken />
            <div class="row">
                <div class="field">
                    <label for="name">Name</label>
                    <input id="name" name="name" required maxlength="@FormDesign.MaxNameLength" placeholder="e.g. Quotes, or Acme's invoices" />
                </div>
                <div class="field">
                    <label for="copyFrom">Start from</label>
                    <select id="copyFrom" name="copyFrom">
                        <option value="">A blank design</option>
                        @foreach (var design in _designs)
                        {
                            <option value="@design.Id" selected="@design.IsDefault">A copy of @design.Name</option>
                        }
                    </select>
                </div>
            </div>
            <button type="submit">Create</button>
        </form>
    </div>
</div>

@code {
    private IReadOnlyList<FormDesign> _designs = [];

    [SupplyParameterFromQuery] private string? Error { get; set; }

    protected override async Task OnInitializedAsync() => _designs = await Designs.ListAsync();

    private static string UsedFor(FormDesign design)
    {
        var documents = FormDesign.Each(design.DefaultFor).Select(FormDesign.Label).ToList();
        if (design.IsDefault)
            documents.Insert(0, documents.Count == 0 ? "Everything" : "Everything else");
        return documents.Count == 0 ? "Customers who have it" : string.Join(", ", documents);
    }
}
