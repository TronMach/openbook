@page "/settings/forms"
@using OpenBook.Domain.Companies
@using OpenBook.Web.Endpoints
@inject FormDesignService Designs
@inject FormFontService Fonts

<PageTitle>Invoice style · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Invoice and form designs</h1>
        <ActionLink Class="button secondary" Href="/settings">Settings</ActionLink>
        <ActionLink Class="button secondary" Href="/audit?entityType=form_style">History</ActionLink>
    </div>
    <p class="muted">
        How printed invoices, estimates, credit memos, sales receipts, statements and purchase orders look. Every document uses the
        default design, unless another design is chosen for that kind of document or for the customer. Your company name, address,
        email and phone come from Settings.
    </p>

    @if (Error is not null)
    {
        <div class="alert error" role="alert">@Error</div>
    }

    <div class="card">
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Design</th><th>Used for</th><th>Template</th><th>Font</th><th>Paper</th><th>Columns</th><th>Logo</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var design in _designs)
                    {
                        <tr class="@(design.IsActive ? null : "inactive")">
                            <td>
                                <ActionLink Href="@($"/settings/forms/{design.Id}")">@design.Name</ActionLink>@(design.IsDefault ? " " : "")
                                @if (design.IsDefault)
                                {
                                    <span class="badge ok">Default</span>
                                }
                            </td>
                            <td>@UsedFor(design)</td>
                            <td class="muted">@Labels.For(design.Template)</td>
                            <td class="muted">@FontName(design.FontKey)</td>
                            <td class="muted">@design.PaperSize@(design.Landscape ? ", landscape" : "")</td>
                            <td class="muted">@design.Columns.Count</td>
                            <td class="muted">@(design.Logo is null ? "" : "Yes")</td>
                            <td class="muted">@(design.IsActive ? "" : "Switched off")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <section class="card" id="ready-made">
        <h2>Ready-made designs</h2>
        <p class="muted">
            Start from one of these and change anything: colors, font, logo, columns, what's shown. Each becomes a design of your own;
            nothing changes until you make it the default or choose it for some documents or customers.
        </p>
        <div class="preset-gallery">
            <ul class="preset-list">
                @foreach (var preset in FormDesignPresets.All)
                {
                    var details = preset.Details;
                    <li class="preset">
                        <div class="preset-swatch preset-@details.Template.ToString().ToLowerInvariant()" style="--swatch: @(details.AccentColor ?? Company.DefaultAccentColor)" aria-hidden="true">
                            <span class="bar"></span><span class="line"></span><span class="line short"></span><span class="line"></span>
                        </div>
                        <div class="preset-text">
                            <strong>@details.Name</strong>
                            <span class="muted">@preset.Description</span>
                            <span class="hint">@Labels.For(details.Template) · @FontName(details.FontKey)@(details.CompanyFontKey is { } company ? $" · company name in {FontName(company)}" : "")@(details.Landscape ? " · landscape" : "")</span>
                            <span class="inline-actions">
                                <a href="@PresetPreview(preset.Key, FormDocuments.Invoice)" target="preset-preview">Preview</a>
                                <a href="@PresetPreview(preset.Key, FormDocuments.Estimate)" target="preset-preview">as an estimate</a>
                                <PostForm Action="/settings/forms/new" class="inline-form" data-enhance="false">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="copyFrom" value="@(FormDesignEndpoints.PresetPrefix + preset.Key)" />
                                    <button type="submit" class="secondary">Use this design</button>
                                </PostForm>
                            </span>
                        </div>
                    </li>
                }
            </ul>
            <div class="design-preview">
                <iframe name="preset-preview" title="Preview of a ready-made design" src="@PresetPreview(FormDesignPresets.All[0].Key, FormDocuments.Invoice)"></iframe>
                <p class="muted">A sample document with your company's details. <a class="preset-back" href="#ready-made">Back to the designs</a></p>
            </div>
        </div>
    </section>

    <section class="card" id="fonts">
        <h2>Fonts</h2>
        @if (FontError is not null)
        {
            <div class="alert error" role="alert">@FontError</div>
        }
        @if (FontsDone is not null)
        {
            <div class="alert notice" role="status">@FontsDone</div>
        }
        <p class="muted">
            Designs can use the built-in font, any of the @_fonts.Count(f => f.Group is not ("Built in" or "Uploaded" or "Added from Google Fonts")) fonts that come
            with OpenBook (all under the SIL Open Font License), or a font you add. Added fonts are kept in the company file, so backups include them.
        </p>
        @{
            var added = _fonts.Where(f => f.Group is "Uploaded" or "Added from Google Fonts").ToList();
        }
        @if (added.Count > 0)
        {
            <ul class="note-list">
                @foreach (var font in added)
                {
                    <li>
                        <strong>@font.Family</strong> <span class="muted">· @font.Group</span>
                        @if (font.CanRemove)
                        {
                            <PostForm Action="@($"/settings/forms/fonts/{font.Key}/remove")" class="inline-form" data-enhance="false">
                                <AntiforgeryToken />
                                <button type="submit" class="link">Remove</button>
                            </PostForm>
                        }
                        else
                        {
                            <span class="muted">· in use</span>
                        }
                    </li>
                }
            </ul>
        }
        <div class="row">
            <PostForm Action="/settings/forms/fonts/google" data-enhance="false">
                <AntiforgeryToken />
                <div class="field">
                    <label for="google-family">Add from Google Fonts</label>
                    <input id="google-family" name="family" required maxlength="@FormFont.MaxFamilyLength" placeholder="e.g. Work Sans" />
                    <span class="hint">The family's name as fonts.google.com shows it. The server downloads its regular and bold weights once.</span>
                </div>
                <button type="submit" class="secondary">Add</button>
            </PostForm>
            <PostForm Action="/settings/forms/fonts/upload" enctype="multipart/form-data" data-enhance="false">
                <AntiforgeryToken />
                <div class="field">
                    <label for="upload-family">Upload your own</label>
                    <input id="upload-family" name="family" required maxlength="@FormFont.MaxFamilyLength" placeholder="Family name" />
                </div>
                <div class="field">
                    <label for="upload-regular">Regular (.ttf)</label>
                    <input id="upload-regular" type="file" name="regular" accept=".ttf,font/ttf" required />
                </div>
                <div class="field">
                    <label for="upload-bold">Bold (.ttf, optional)</label>
                    <input id="upload-bold" type="file" name="bold" accept=".ttf,font/ttf" />
                    <span class="hint">Check that the font's license lets you embed it in PDFs.</span>
                </div>
                <button type="submit" class="secondary">Upload</button>
            </PostForm>
        </div>
    </section>

    <div class="card">
        <h2>New design</h2>
        <PostForm Action="/settings/forms/new" data-enhance="false">
            <AntiforgeryToken />
            <div class="row">
                <div class="field">
                    <label for="name">Name</label>
                    <input id="name" name="name" required maxlength="@FormDesign.MaxNameLength" placeholder="e.g. Quotes, or Acme's invoices" />
                </div>
                <div class="field">
                    <label for="copyFrom">Start from</label>
                    <select id="copyFrom" name="copyFrom">
                        <option value="">A blank design</option>
                        <optgroup label="Your designs">
                            @foreach (var design in _designs)
                            {
                                <option value="@design.Id" selected="@design.IsDefault">A copy of @design.Name</option>
                            }
                        </optgroup>
                        <optgroup label="Ready-made">
                            @foreach (var preset in FormDesignPresets.All)
                            {
                                <option value="@(FormDesignEndpoints.PresetPrefix + preset.Key)">@preset.Details.Name</option>
                            }
                        </optgroup>
                    </select>
                </div>
            </div>
            <button type="submit">Create</button>
        </PostForm>
    </div>
</div>

@code {
    private IReadOnlyList<FormDesign> _designs = [];

    private IReadOnlyList<FormFontChoice> _fonts = [];

    /// <summary>A ready-made design on a sample document, opened fitted to the page's width without the viewer's thumbnails.</summary>
    private static string PresetPreview(string key, FormDocuments document) => $"/settings/forms/preview?preset={key}&document={document}#navpanes=0&view=FitH";

    /// <summary>A font key's family name; null and unknown keys are the built-in font.</summary>
    private string FontName(string? key) => _fonts.FirstOrDefault(f => f.Key == key && key != FormDesign.BuiltInFont)?.Family ?? FormFontService.BuiltInName;

    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? FontError { get; set; }
    [SupplyParameterFromQuery(Name = "fonts")] private string? FontsDone { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _designs = await Designs.ListAsync();
        _fonts = await Fonts.ChoicesAsync();
    }

    private static string UsedFor(FormDesign design)
    {
        var documents = FormDesign.Each(design.DefaultFor).Select(FormDesign.Label).ToList();
        if (design.IsDefault)
            documents.Insert(0, documents.Count == 0 ? "Everything" : "Everything else");
        return documents.Count == 0 ? "Customers who have it" : string.Join(", ", documents);
    }
}
