@page "/account/password"
@using System.ComponentModel.DataAnnotations
@using OpenBook.Domain.Companies
@inject AuthService Auth

<PageTitle>Change password · OpenBook</PageTitle>

<div class="card narrow">
    <h1>Change password</h1>
    <p class="muted">Other signed-in sessions are signed out when the password changes. Programs can sign in with <a href="/settings/api-keys">API keys</a> instead.</p>

    @if (_changed)
    {
        <div class="alert notice" role="status">Password changed.</div>
    }
    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    <EditForm Model="Input" FormName="change-password" OnValidSubmit="ChangeAsync" method="post">
        <DataAnnotationsValidator />
        <div class="field">
            <label for="current">Current password</label>
            <InputText id="current" type="password" @bind-Value="Input.CurrentPassword" autocomplete="current-password" />
            <ValidationMessage For="() => Input.CurrentPassword" />
        </div>
        <div class="field">
            <label for="new">New password</label>
            <InputText id="new" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" />
            <span class="hint">At least @User.MinPasswordLength characters.</span>
            <ValidationMessage For="() => Input.NewPassword" />
        </div>
        <div class="field">
            <label for="confirm">Confirm new password</label>
            <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
            <ValidationMessage For="() => Input.ConfirmPassword" />
        </div>
        <button type="submit">Change password</button>
    </EditForm>
</div>

@code {
    private string? _error;
    private bool _changed;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private PasswordModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task ChangeAsync()
    {
        try
        {
            var user = await Auth.ChangePasswordAsync(HttpContext.User.GetUserId(), Input.CurrentPassword, Input.NewPassword, HttpContext.RequestAborted);
            // The security stamp changed, so re-issue this browser's cookie to keep it signed in.
            await WebSecurity.SignInAsync(HttpContext, user);
            _changed = true;
            Input = new();
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }

    private sealed class PasswordModel
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter a new password.")]
        [StringLength(User.MaxPasswordLength, MinimumLength = User.MinPasswordLength, ErrorMessage = "Passwords need 8 to 128 characters.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Repeat the new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The passwords don't match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
