@page "/account/password"
@using System.ComponentModel.DataAnnotations
@using OpenBook.Domain.Companies
@inject AuthService Auth
@inject UserService Users
@inject SingleSignOnService SingleSignOn

<PageTitle>@L["Change password"] · OpenBook</PageTitle>

<div class="card narrow">
    <h1>@L["Change password"]</h1>
    <p class="muted">Other signed-in sessions are signed out when the password changes. Programs can sign in with <a href="/settings/api-keys">API keys</a> instead.</p>
    <p>@L["Two-factor sign-in:"] <a href="/account/two-factor">@(_twoFactor ? L["on"] : L["off, set it up"])</a></p>
    @if (_sso is { IsSsoReady: true })
    {
        @if (Sso == "linked")
        {
            <div class="alert notice" role="status">@L["Your account is linked: you can sign in with \"{0}\".", _sso.ButtonText]</div>
        }
        else if (Sso is not null)
        {
            <div class="alert error" role="alert">@(Sso == "sso.linked_elsewhere" ? L["That account already signs in as someone else."] : L["Linking didn't work. Try again."])</div>
        }
        <p>
            @L["Single sign-on:"]
            @if (_linked)
            {
                @L["linked."]
            }
            else
            {
                <a href="/login/sso?link=true&returnUrl=%2Faccount%2Fpassword" data-enhance-nav="false">@L["link your account"]</a>
            }
        </p>
    }

    @if (_changed)
    {
        <div class="alert notice" role="status">@L["Password changed."]</div>
    }
    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    <EditForm Model="Input" FormName="change-password" OnValidSubmit="ChangeAsync" method="post">
        <DataAnnotationsValidator />
        <div class="field">
            <label for="current">@L["Current password"]</label>
            <InputText id="current" type="password" @bind-Value="Input.CurrentPassword" autocomplete="current-password" />
            <ValidationMessage For="() => Input.CurrentPassword" />
        </div>
        <div class="field">
            <label for="new">@L["New password"]</label>
            <InputText id="new" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" />
            <span class="hint">At least @User.MinPasswordLength characters.</span>
            <ValidationMessage For="() => Input.NewPassword" />
        </div>
        <div class="field">
            <label for="confirm">@L["Confirm new password"]</label>
            <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
            <ValidationMessage For="() => Input.ConfirmPassword" />
        </div>
        <button type="submit">@L["Change password"]</button>
    </EditForm>
</div>

<div class="card narrow" style="margin-top: 1.5rem">
    <h2>@L["Where you're signed in"]</h2>
    @if (SignedOut)
    {
        <div class="alert notice" role="status">@L["Every other session is signed out. This browser stays signed in."]</div>
    }
    @if (Ended)
    {
        <div class="alert notice" role="status">@L["That session is signed out."]</div>
    }
    <p class="muted">Each browser, phone or capture page you sign in on. Sign one out if you don't recognise it or no longer use it: it's refused on its next request. API keys aren't listed; revoke those under <a href="/settings/api-keys">API keys</a>.</p>
    <div class="table-wrap">
        <table class="data">
            <thead><tr><th>@L["Device"]</th><th>@L["Address"]</th><th>@L["Signed in"]</th><th>@L["Last active"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in _sessions)
                {
                    <tr>
                        <td>@(s.Device ?? "Unknown device")</td>
                        <td>@(s.Address ?? "")</td>
                        <td>@s.CreatedAt.InCompanyTime().ToString("g")</td>
                        <td>@s.LastSeenAt.InCompanyTime().ToString("g")</td>
                        <td>
                            @if (s.Id == _current)
                            {
                                <span class="badge">@L["This browser"]</span>
                            }
                            else
                            {
                                <form method="post" action="/account/sessions/@s.Id/end" data-enhance="false" class="inline">
                                    <AntiforgeryToken />
                                    <button type="submit" class="link">@L["Sign out"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted">@L["Or sign out everywhere except here at once, without changing your password: use it for a lost or shared device."]</p>
    <form method="post" action="/account/sessions/end-others" data-enhance="false">
        <AntiforgeryToken />
        <input type="hidden" name="back" value="/account/password" />
        <button type="submit" class="secondary">@L["Sign out all other sessions"]</button>
    </form>
</div>

@code {
    private string? _error;
    private bool _changed;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private PasswordModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private bool SignedOut { get; set; }

    [SupplyParameterFromQuery]
    private bool Ended { get; set; }

    private IReadOnlyList<UserSession> _sessions = [];
    private Guid? _current;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _current = HttpContext.User.GetSessionId();
        _sessions = await Auth.ListSessionsAsync(HttpContext.User.GetUserId(), HttpContext.RequestAborted);
        var me = await Users.GetAsync(HttpContext.User.GetUserId(), HttpContext.RequestAborted);
        _twoFactor = me?.HasTwoFactor == true;
        _linked = me?.ExternalLogin is not null;
        _sso = await SingleSignOn.SettingsAsync(HttpContext.RequestAborted);
    }

    private bool _twoFactor;
    private bool _linked;
    private OpenBook.Domain.Companies.SignInSettings? _sso;

    [SupplyParameterFromQuery(Name = "sso")]
    private string? Sso { get; set; }

    private async Task ChangeAsync()
    {
        try
        {
            var user = await Auth.ChangePasswordAsync(HttpContext.User.GetUserId(), Input.CurrentPassword, Input.NewPassword, HttpContext.RequestAborted);
            // The security stamp changed, so re-issue this browser's cookie to keep it signed in.
            await WebSecurity.SignInAsync(HttpContext, user);
            _changed = true;
            _sessions = await Auth.ListSessionsAsync(user.Id, HttpContext.RequestAborted);
            Input = new();
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }

    private sealed class PasswordModel
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter a new password.")]
        [StringLength(User.MaxPasswordLength, MinimumLength = User.MinPasswordLength, ErrorMessage = "Passwords need 8 to 128 characters.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Repeat the new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The passwords don't match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
