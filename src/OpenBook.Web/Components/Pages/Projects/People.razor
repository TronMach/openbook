@page "/time/people"
@inject WorkerService WorkerService
@inject OpenBook.Application.Segments.SegmentService Segments
@inject VendorService VendorService
@inject UserService UserService

<PageTitle>People and rates · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>People and rates</h1>
        <ActionLink Class="button secondary" Href="/time">Time</ActionLink>
        <ActionLink Class="button secondary" Href="/time/rates">Rate card</ActionLink>
        <ActionLink Class="button secondary" Href="/time/people/import">Import</ActionLink>
    </div>
    <p class="muted">
        Everyone whose time you track: employees, owners and contractors. The cost rate is what an hour of their time costs the business
        and counts toward project profitability; the bill rate is what clients pay by default (blank uses the service's price), unless
        the <a href="/time/rates">rate card</a> has a rate for the client, their role or the service. Hours a week feed the utilization report.
        Link a person to their OpenBook user so their own timer knows them.
    </p>
    @if (Error is not null)
    {
        <div class="alert error" role="alert">@Error</div>
    }

    @if (_workers.Count > 0)
    {
        <table class="data">
            <thead><tr><th>Name</th><th>Role</th>@if (_seesCosts) { <th class="num">Cost rate</th> }<th class="num">Bill rate</th><th class="num">Hours a week</th><th>User</th><th>Vendor</th><th></th></tr></thead>
            <tbody>
                @foreach (var w in _workers)
                {
                    <tr class="@(w.IsActive ? "" : "muted")">
                        <td>@w.Name@(w.IsActive ? "" : " (inactive)")</td>
                        <td>@w.Role</td>
                        @if (_seesCosts)
                        {
                            <td class="num">@Labels.Price(w.CostRate)</td>
                        }
                        <td class="num">@(w.BillRate is { } b ? Labels.Price(b) : "")</td>
                        <td class="num">@w.WeeklyHours?.ToString("0.##")</td>
                        <td>@w.Username</td>
                        <td>@(w.VendorId is { } v ? _vendors.FirstOrDefault(x => x.Id == v)?.DisplayName : "")</td>
                        <td><a href="/time/people?edit=@w.Id#edit">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="card" id="edit" style="margin-top: 1.5rem">
        <h2>@(_editing is null ? "Add a person" : $"Edit {_editing.Name}")</h2>
        <PostForm Action="@(_editing is null ? "/time/people" : $"/time/people/{_editing.Id}")" data-enhance="false">
            <AntiforgeryToken />
            <div class="row">
                <div class="field">
                    <label for="name">Name</label>
                    <input id="name" name="name" maxlength="100" required value="@_editing?.Name" />
                </div>
                @if (_seesCosts)
                {
                    <div class="field">
                        <label for="cost">Cost rate per hour</label>
                        <input id="cost" name="costRate" class="amount" inputmode="decimal" value="@_editing?.CostRate.ToString("0.00##")" />
                    </div>
                }
                <div class="field">
                    <label for="bill">Bill rate per hour <span class="muted">(optional)</span></label>
                    <input id="bill" name="billRate" class="amount" inputmode="decimal" value="@_editing?.BillRate?.ToString("0.00##")" />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="role">Role <span class="muted">(optional, e.g. Partner)</span></label>
                    <input id="role" name="role" maxlength="50" list="roles" value="@_editing?.Role" />
                    <datalist id="roles">
                        @foreach (var r in _workers.Select(w => w.Role).OfType<string>().Distinct(StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@r"></option>
                        }
                    </datalist>
                </div>
                <div class="field">
                    <label for="weekly">Hours a week <span class="muted">(optional, for utilization)</span></label>
                    <input id="weekly" name="weeklyHours" class="amount" inputmode="decimal" value="@_editing?.WeeklyHours?.ToString("0.##")" />
                </div>
                @if (_classes.Count > 0)
                {
                    <div class="field">
                        <label for="worker-class">Class <span class="muted">(their billed time's income)</span></label>
                        <select id="worker-class" name="classId">
                            <option value="">None</option>
                            @foreach (var c in _classes)
                            {
                                <option value="@c.Segment.Id" selected="@(c.Segment.Id == _editing?.ClassId)">@c.FullName</option>
                            }
                        </select>
                    </div>
                }
            </div>
            <div class="row">
                <div class="field">
                    <label for="user">OpenBook user <span class="muted">(optional)</span></label>
                    <select id="user" name="username">
                        <option value="">None</option>
                        @foreach (var u in _users)
                        {
                            <option value="@u" selected="@(string.Equals(u, _editing?.Username, StringComparison.OrdinalIgnoreCase))">@u</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="vendor">Vendor <span class="muted">(contractors, optional)</span></label>
                    <select id="vendor" name="vendorId" data-search>
                        <option value="">None</option>
                        @foreach (var v in _vendors)
                        {
                            <option value="@v.Id" selected="@(v.Id == _editing?.VendorId)">@v.DisplayName</option>
                        }
                    </select>
                </div>
                @if (_editing is not null)
                {
                    <div class="field">
                        <label><input type="checkbox" name="active" value="true" checked="@_editing.IsActive" /> Active</label>
                    </div>
                }
            </div>
            <div class="actions"><button type="submit">@(_editing is null ? "Add" : "Save")</button></div>
        </PostForm>
    </div>
</div>

@code {
    private IReadOnlyList<Worker> _workers = [];
    private IReadOnlyList<Vendor> _vendors = [];
    private IReadOnlyList<string> _users = [];
    private Worker? _editing;

    [SupplyParameterFromQuery] private Guid? Edit { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }

    private bool _seesCosts;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<OpenBook.Application.Segments.SegmentChoice> _classes = [];

    protected override async Task OnInitializedAsync()
    {
        _classes = await Segments.ListAsync(OpenBook.Domain.Segments.SegmentKind.Class, includeInactive: false);
        _seesCosts = AuthState is not null && (await AuthState).User.CanPost("/time/people");
        _workers = await WorkerService.ListAsync(includeInactive: true);
        _editing = _workers.FirstOrDefault(w => w.Id == Edit);
        _vendors = (await VendorService.ListRecordsAsync(includeInactive: true)).ToList();
        _users = (await UserService.ListAsync()).Where(u => u.IsActive).Select(u => u.Username).ToList();
    }
}
