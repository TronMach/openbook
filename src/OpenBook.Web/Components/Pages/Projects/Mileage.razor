@page "/mileage"
@inject MileageService MileageService
@inject WorkerService WorkerService
@inject CustomerService CustomerService

<PageTitle>Mileage · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Mileage</h1>
        <ActionLink Class="button secondary" Href="@($"/reports/mileage-log?year={_year}")">Mileage log report</ActionLink>
        <ActionLink Class="button secondary" Href="/projects">Projects</ActionLink>
    </div>
    <p class="muted">
        Business trips by car. The log shows what they're worth at the standard mileage rate for the year (for your tax return; nothing is
        posted). Billable trips can be added to the customer's next invoice at a rate per mile.
    </p>
    @if (Error is not null)
    {
        <div class="alert error" role="alert">@Error</div>
    }

    @if (_workers.Any(w => w.VendorId is not null))
    {
        <div class="card" id="pay-back">
            <h2>Pay people back for their trips</h2>
            <p class="muted">For trips in their own cars: a bill to the person's vendor record for their trips not paid back yet, each at its year's mileage rate, to pay like any bill.</p>
            <PostForm Action="/mileage/pay-back" data-enhance="false" class="inline-actions">
                <AntiforgeryToken />
                <label for="pay-back-person">Person</label>
                <select id="pay-back-person" name="workerId">
                    @foreach (var w in _workers.Where(w => w.VendorId is not null))
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                </select>
                <label for="pay-back-through">Trips through</label>
                <input id="pay-back-through" name="through" type="date" value="@CompanyTime.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
                <button type="submit" class="secondary">Enter the bill</button>
            </PostForm>
        </div>
    }

    <div class="card">
        <h2>Add a trip</h2>
        <PostForm Action="/mileage" data-enhance="false">
            <AntiforgeryToken />
            <div class="row">
                <div class="field">
                    <label for="date">Date</label>
                    <input id="date" name="date" type="date" value="@CompanyTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="field">
                    <label for="miles">Miles</label>
                    <input id="miles" name="miles" class="short" inputmode="decimal" required />
                </div>
                <div class="field">
                    <label for="purpose">Business purpose</label>
                    <input id="purpose" name="purpose" maxlength="500" required placeholder="Site visit" />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="from">From <span class="muted">(optional)</span></label>
                    <input id="from" name="fromPlace" maxlength="200" />
                </div>
                <div class="field">
                    <label for="to">To <span class="muted">(optional)</span></label>
                    <input id="to" name="toPlace" maxlength="200" />
                </div>
                <div class="field">
                    <label for="vehicle">Vehicle <span class="muted">(optional)</span></label>
                    <input id="vehicle" name="vehicle" maxlength="100" />
                </div>
                <div class="field">
                    <label for="worker">Driver <span class="muted">(optional)</span></label>
                    <select id="worker" name="workerId">
                        <option value="">—</option>
                        @foreach (var w in _workers)
                        {
                            <option value="@w.Id">@w.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="customer">Customer or project <span class="muted">(optional)</span></label>
                    <select id="customer" name="customerId" data-search>
                        <option value="">None</option>
                        @foreach (var c in _customers)
                        {
                            <option value="@c.Customer.Id">@c.FullName</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="rate">Bill per mile</label>
                    <input id="rate" name="billRate" class="amount" inputmode="decimal" value="@OpenBook.Domain.Projects.MileageRate.For(_rates, CompanyTime.Today.Year).ToString("0.00##")" />
                </div>
                <div class="field">
                    <label><input type="checkbox" name="billable" value="true" /> Billable</label>
                </div>
            </div>
            <div class="actions"><button type="submit">Add trip</button></div>
        </PostForm>
    </div>

    <form method="get" class="inline" style="margin: 1.5rem 0 1rem">
        <label>Year <input type="number" name="year" class="short" value="@_year" /></label>
        <button type="submit" class="secondary">Show</button>
    </form>

    @if (_log is null || _log.Trips.Count == 0)
    {
        <p class="muted">No trips in @_year.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>Date</th><th>Purpose</th><th>Route</th><th>Customer</th><th class="num">Miles</th><th class="num">Billable</th><th></th></tr></thead>
            <tbody>
                @foreach (var t in _log.Trips)
                {
                    <tr>
                        <td>@Labels.Date(t.Date)</td>
                        <td>@t.Purpose</td>
                        <td>@string.Join(" → ", new[] { t.FromPlace, t.ToPlace }.Where(p => p is not null))</td>
                        <td>@(t.CustomerId is { } c ? _names.GetValueOrDefault(c) : "")</td>
                        <td class="num">@Labels.Quantity(t.Miles)</td>
                        <td class="num">@(t.Billable ? Labels.Amount(t.Amount) : "")</td>
                        <td>
                            @if (t.InvoiceId is { } invoiceId)
                            {
                                <a href="/sales/invoices/@invoiceId">invoiced</a>
                            }
                            else
                            {
                                <PostForm Action="@($"/mileage/{t.Id}/delete")" data-enhance="false" class="inline">
                                    <AntiforgeryToken />
                                    <button type="submit" class="secondary">Delete</button>
                                </PostForm>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><td colspan="4">@_year at @_log.Rate.ToString("0.###") per mile: @Labels.Amount(_log.Deduction)</td><td class="num">@Labels.Quantity(_log.Miles)</td><td colspan="2"></td></tr>
            </tfoot>
        </table>
    }

    <div class="card" style="margin-top: 1.5rem">
        <h2>Standard mileage rates</h2>
        @if (!_rates.ContainsKey(CompanyTime.Today.Year))
        {
            <div class="alert notice" role="status">There's no rate for @CompanyTime.Today.Year yet, so the latest one is being used. Add this year's when it's announced.</div>
        }
        <table class="data">
            <thead><tr><th>Year</th><th class="num">Per mile</th></tr></thead>
            <tbody>
                @foreach (var (year, rate) in _rates.Reverse())
                {
                    <tr><td>@year</td><td class="num">@rate.ToString("0.000#")</td></tr>
                }
            </tbody>
        </table>
        <p class="hint">The IRS business rates are filled in; check them before filing, and add later years as they're announced.</p>
        <PostForm Action="/mileage/rates" data-enhance="false" class="inline">
            <AntiforgeryToken />
            <input name="year" type="number" class="short" value="@CompanyTime.Today.Year" aria-label="Year" />
            <input name="rate" class="short" inputmode="decimal" placeholder="0.725" aria-label="Rate per mile" />
            <button type="submit" class="secondary">Set rate</button>
        </PostForm>
    </div>
</div>

@code {
    private int _year;
    private MileageYear? _log;
    private IReadOnlyDictionary<int, decimal> _rates = new Dictionary<int, decimal>();
    private IReadOnlyList<Worker> _workers = [];
    private IReadOnlyList<CustomerEntry> _customers = [];
    private IReadOnlyDictionary<Guid, string> _names = new Dictionary<Guid, string>();

    [SupplyParameterFromQuery] private int? Year { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _year = Year is >= 2000 and <= 2100 ? Year.Value : CompanyTime.Today.Year;
        _log = await MileageService.YearAsync(_year);
        _rates = await MileageService.RatesAsync();
        _workers = await WorkerService.ListAsync();
        _customers = await CustomerService.ListRecordsAsync();
        _names = await CustomerService.FullNamesAsync();
    }
}
