@page "/time"
@inject TimeService TimeService
@inject WorkerService WorkerService
@inject CustomerService CustomerService
@inject ItemService ItemService

<PageTitle>Time · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Time</h1>
        <ActionLink Class="button secondary" Href="/time/week">Week grid</ActionLink>
        <ActionLink Class="button secondary" Href="/time/review">Review time</ActionLink>
        <ActionLink Class="button secondary" Href="/time/people">People and rates</ActionLink>
        <ActionLink Class="button secondary" Href="/capture">Capture on a phone</ActionLink>
        <ActionLink Class="button secondary" Href="/projects">Projects</ActionLink>
        <ActionLink Class="button secondary" Href="/reports/time-by-customer">Time by customer</ActionLink>
    </div>
    @if (Error is not null)
    {
        <div class="alert error" role="alert">@Error</div>
    }

    @if (_missing.Count > 0)
    {
        <div class="card">
            <h2>Missing time last week</h2>
            <p class="muted">People with weekly hours set who entered fewer than that in the week of @Labels.Date(_lastMonday):</p>
            <ul>
                @foreach (var (w, hours) in _missing)
                {
                    <li><a href="/time/week?worker=@w.Id&week=@_lastMonday.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">@w.Name</a>: @Labels.Quantity(hours) of @Labels.Quantity(w.WeeklyHours ?? 0m) hours</li>
                }
            </ul>
        </div>
    }

    @if (_workers.Count > 0)
    {
        <div class="card" id="lock">
            <h2>Time settings</h2>
            <p class="muted">@(_locked is { } l ? $"Time is locked through {Labels.Date(l)}: hours dated then can't be added, changed or deleted. Billing it still works." : "Nothing is locked. Lock time once a period's hours are reviewed, so they can't change afterwards.")</p>
            <PostForm Action="/time/defaults" data-enhance="false" class="inline-actions" style="margin-bottom: 1rem">
                <AntiforgeryToken />
                <label class="check"><input type="checkbox" name="billable" value="true" checked="@_defaults.BillableByDefault" /> <span>New time starts billable</span></label>
                <label for="increment">Round time up to</label>
                <select id="increment" name="increment">
                    @foreach (var m in OpenBook.Domain.Companies.Company.TimeIncrements)
                    {
                        <option value="@m" selected="@(m == _defaults.IncrementMinutes)">@(m == 0 ? "Don't round" : $"{m} minutes")</option>
                    }
                </select>
                <button type="submit" class="secondary">Save</button>
            </PostForm>
            <PostForm Action="/time/lock" data-enhance="false" class="inline-actions">
                <AntiforgeryToken />
                <label>Lock through <input type="date" name="through" value="@(_locked?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" /></label>
                <button type="submit" class="secondary">Save</button>
                <span class="hint">Leave the date blank to unlock.</span>
            </PostForm>
        </div>
    }

    @if (_workers.Count == 0)
    {
        <div class="card"><p>Time is tracked per person. <a href="/time/people">Add the people</a> who do the work first.</p></div>
    }
    else
    {
        @if (_running.Count > 0)
        {
            <div class="card">
                <h2>Running</h2>
                @foreach (var t in _running)
                {
                    <PostForm Action="@($"/time/{t.Id}/stop")" data-enhance="false" class="inline" style="display:block; margin-bottom: .5rem">
                        <AntiforgeryToken />
                        <strong>@Worker(t.WorkerId)</strong>
                        <span>@(t.CustomerId is { } c ? _customerNames.GetValueOrDefault(c) : "no customer")@(t.Notes is { } n ? $" · {n}" : "")</span>
                        <span class="muted">since @t.StartedAt!.Value.InCompanyTime().ToString(DateOnly.FromDateTime(t.StartedAt.Value.InCompanyTime().DateTime) == CompanyTime.Today ? "t" : "g")</span>
                        <button type="submit">Stop</button>
                    </PostForm>
                }
            </div>
        }

        <div class="card">
            <h2>Start a timer or add time</h2>
            <PostForm Action="/time" data-enhance="false">
                <AntiforgeryToken />
                <div class="row">
                    <div class="field">
                        <label for="worker">Person</label>
                        <select id="worker" name="workerId">
                            @foreach (var w in _workers)
                            {
                                <option value="@w.Id" selected="@(w.Id == (WorkerId ?? _me?.Id))">@w.Name</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="customer">Customer or project <span class="muted">(optional)</span></label>
                        <select id="customer" name="customerId" data-search>
                            <option value="">None</option>
                            @foreach (var c in _customers)
                            {
                                <option value="@c.Customer.Id" selected="@(c.Customer.Id == Customer)">@c.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="item">Service <span class="muted">(needed to bill)</span></label>
                        <select id="item" name="itemId" data-search>
                            <option value="">None</option>
                            @foreach (var i in _services)
                            {
                                <option value="@i.Id">@i.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="field">
                        <label for="date">Date</label>
                        <input id="date" name="date" type="date" value="@CompanyTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="field">
                        <label for="hours">Hours</label>
                        <input id="hours" name="hours" class="short" inputmode="decimal" placeholder="1.5" />
                    </div>
                    <div class="field">
                        <label for="rate">Rate per hour <span class="muted">(blank: from the <a href="/time/rates">rate card</a>)</span></label>
                        <input id="rate" name="rate" class="amount" inputmode="decimal" />
                    </div>
                    <div class="field">
                        <label><input type="checkbox" name="billable" value="true" checked="@_defaults.BillableByDefault" /> Billable</label>
                    </div>
                </div>
                <div class="field">
                    <label for="notes">Notes <span class="muted">(optional; shown on the invoice)</span></label>
                    <input id="notes" name="notes" maxlength="1000" />
                </div>
                <div class="actions">
                    <button type="submit" name="mode" value="add">Add time</button>
                    <button type="submit" name="mode" value="start" class="secondary">Start timer</button>
                </div>
            </PostForm>
        </div>
    }

    <form method="get" class="inline" style="margin: 1.5rem 0 1rem">
        <label>From <input type="date" name="from" value="@_from.ToString("yyyy-MM-dd")" /></label>
        <label>To <input type="date" name="to" value="@_to.ToString("yyyy-MM-dd")" /></label>
        <select name="worker" aria-label="Person">
            <option value="">Everyone</option>
            @foreach (var w in _workers)
            {
                <option value="@w.Id" selected="@(w.Id == WorkerId)">@w.Name</option>
            }
        </select>
        <select name="customer" aria-label="Customer" data-search>
            <option value="">All customers</option>
            @foreach (var c in _customers)
            {
                <option value="@c.Customer.Id" selected="@(c.Customer.Id == Customer)">@c.FullName</option>
            }
        </select>
        <button type="submit" class="secondary">Show</button>
    </form>

    @if (_entries.Count == 0)
    {
        <p class="muted">No time in this period.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>Date</th><th>Person</th><th>Customer</th><th>Service</th><th>Notes</th><th class="num">Hours</th><th class="num">Billable</th><th></th></tr></thead>
            <tbody>
                @foreach (var t in _entries)
                {
                    <tr>
                        <td>@Labels.Date(t.Date)</td>
                        <td>@Worker(t.WorkerId)</td>
                        <td>@(t.CustomerId is { } c ? _customerNames.GetValueOrDefault(c) : "")</td>
                        <td>@(t.ItemId is { } i ? _itemNames.GetValueOrDefault(i) : "")</td>
                        <td>@t.Notes</td>
                        <td class="num">@(t.IsRunning ? "running" : Labels.Quantity(t.Hours))</td>
                        <td class="num" title="@(t.Billable ? $"{Labels.Price(t.BillRate)} an hour: {t.RateSource ?? "rate"}" : null)">@(t.Billable ? Labels.Amount(t.Amount) : "")</td>
                        <td>
                            @if (t.InvoiceId is { } invoiceId)
                            {
                                <a href="/sales/invoices/@invoiceId">invoiced</a>
                            }
                            else
                            {
                                <ActionLink Href="@($"/time/{t.Id}/edit")">Edit</ActionLink>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><td colspan="5">Total</td><td class="num">@Labels.Quantity(_entries.Sum(t => t.Hours))</td><td class="num">@Labels.Amount(_entries.Sum(t => t.Amount))</td><td></td></tr>
            </tfoot>
        </table>
    }
</div>

@code {
    private IReadOnlyList<Worker> _workers = [];
    private IReadOnlyList<(Worker Worker, decimal Hours)> _missing = [];
    private DateOnly _lastMonday;
    private DateOnly? _locked;
    private (bool BillableByDefault, int IncrementMinutes) _defaults;
    private Worker? _me;
    private IReadOnlyList<TimeEntry> _running = [];
    private IReadOnlyList<TimeEntry> _entries = [];
    private IReadOnlyList<CustomerEntry> _customers = [];
    private IReadOnlyDictionary<Guid, string> _customerNames = new Dictionary<Guid, string>();
    private List<Item> _services = [];
    private Dictionary<Guid, string> _itemNames = [];
    private Dictionary<Guid, string> _allWorkers = [];
    private DateOnly _from;
    private DateOnly _to;

    [SupplyParameterFromQuery] private string? From { get; set; }
    [SupplyParameterFromQuery] private string? To { get; set; }
    [SupplyParameterFromQuery(Name = "worker")] private Guid? WorkerId { get; set; }
    [SupplyParameterFromQuery] private Guid? Customer { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var today = CompanyTime.Today;
        var monday = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        _from = DateOnly.TryParse(From, out var f) ? f : monday;
        _to = DateOnly.TryParse(To, out var t) ? t : monday.AddDays(6);
        _workers = await WorkerService.ListAsync();
        _lastMonday = monday.AddDays(-7);
        _missing = await TimeService.MissingAsync(_lastMonday);
        _locked = await TimeService.LockedThroughAsync();
        _defaults = await TimeService.DefaultsAsync();
        _allWorkers = (await WorkerService.ListAsync(includeInactive: true)).ToDictionary(w => w.Id, w => w.Name);
        _me = await WorkerService.ForCurrentUserAsync();
        _running = await TimeService.RunningAsync();
        _entries = await TimeService.ListAsync(new TimeFilter(_from, _to, WorkerId, Customer));
        _customers = await CustomerService.ListRecordsAsync();
        _customerNames = await CustomerService.FullNamesAsync();
        var items = await ItemService.ListAsync(includeInactive: true);
        _itemNames = items.ToDictionary(i => i.Id, i => i.Name);
        _services = items.Where(i => i.IsActive && i.Type is ItemType.Service or ItemType.NonInventory).ToList();
    }

    private string Worker(Guid id) => _allWorkers.GetValueOrDefault(id) ?? "";
}
