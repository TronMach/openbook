@page "/projects/{Id:guid}"
@inject ProjectService ProjectService
@inject ProjectReports Reports
@inject TimeService TimeService
@inject WorkerService WorkerService
@inject BillableExpenseService Billables
@inject MileageService MileageService
@inject ProjectMilestoneService Milestones
@inject ProjectBudgetService BudgetLines
@inject OpenBook.Application.Sales.ItemService Items

<PageTitle>@(_project?.FullName ?? "Project") · OpenBook</PageTitle>

<div class="wide">
    @if (_project is null || _figures is null)
    {
        <h1>Project not found</h1>
        <p><a href="/projects">Back to projects</a></p>
    }
    else
    {
        var p = _project.Project;
        <div class="toolbar">
            <h1>@_project.FullName</h1>
            <span class="badge">@ProjectReports.Status(p.Status)</span>
            <ActionLink Class="button" Href="@($"/sales/invoices/new?customer={_project.Customer.Id}")">Invoice</ActionLink>
            <ActionLink Class="button secondary" Href="@($"/time?customer={_project.Customer.Id}")">Time</ActionLink>
            <ActionLink Class="button secondary" Href="@($"/customers/{_project.Customer.Id}")">Customer record</ActionLink>
            <ActionLink Class="button secondary" Href="/projects">Projects</ActionLink>
        </div>
        @if (Error is not null)
        {
            <div class="alert error" role="alert">@Error</div>
        }
        @if (p.Description is { } description)
        {
            <p>@description</p>
        }

        @if (p.Arrangement != BillingArrangement.TimeAndMaterials)
        {
            <p>
                <strong>@(p.Arrangement == BillingArrangement.FixedFee ? "Fixed fee" : "Not to exceed") @Labels.Amount(p.Fee ?? 0m).</strong>
                Billed so far @Labels.Amount(_figures.Income), worked @Labels.Amount(_worked)
                @if (p.Fee is { } fee)
                {
                    <span class="@(_worked > fee ? "out-of-balance" : "muted")">(@(_worked > fee ? $"{Labels.Amount(_worked - fee)} of effort beyond it" : $"{Labels.Amount(fee - _worked)} of it left in effort"))</span>
                }
            </p>
        }

        @if (p.Arrangement == BillingArrangement.FixedFee)
        {
            <h2 id="milestones">@L["Milestones"]</h2>
            <p class="muted">@L["The fee in parts, each billed when the work reaches it. Together they can be at most the fee."]</p>
            @if (_milestones.Count > 0)
            {
                <div class="table-wrap">
                    <table class="data">
                        <thead><tr><th>@L["Milestone"]</th><th>@L["Due"]</th><th class="num">@L["Amount"]</th><th>@L["Billed"]</th><th><span class="visually-hidden">@L["Actions"]</span></th></tr></thead>
                        <tbody>
                            @foreach (var ms in _milestones)
                            {
                                <tr>
                                    <td>@ms.Milestone.Name</td>
                                    <td>@(ms.Milestone.DueOn is { } due ? Labels.Date(due) : "")</td>
                                    <td class="num">@Labels.Amount(ms.Milestone.Amount)</td>
                                    <td>
                                        @if (ms.Billed)
                                        {
                                            <a href="/sales/invoices/@ms.Invoice!.Id">@L["Invoice {0}", ms.Invoice.Number]</a>
                                        }
                                    </td>
                                    <td>
                                        @if (!ms.Billed)
                                        {
                                            <PostForm Action="@($"/projects/{p.Id}/milestones/{ms.Milestone.LineNumber}/bill")" data-enhance="false" class="inline">
                                                <AntiforgeryToken />
                                                <select name="itemId" aria-label="@L["Bill it as"]" data-search required>
                                                    <option value="">@L["Bill it as…"]</option>
                                                    @foreach (var item in _services)
                                                    {
                                                        <option value="@item.Id">@item.Name</option>
                                                    }
                                                </select>
                                                <input type="date" name="date" aria-label="@L["Invoice date"]" value="@OpenBook.Application.CompanyTime.Today.ToString("yyyy-MM-dd")" />
                                                <button type="submit" class="secondary">@L["Bill it"]</button>
                                            </PostForm>
                                            <PostForm Action="@($"/projects/{p.Id}/milestones/{ms.Milestone.LineNumber}/remove")" data-enhance="false" class="inline">
                                                <AntiforgeryToken />
                                                <button type="submit" class="link">@L["Remove"]</button>
                                            </PostForm>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="muted">@L["Milestones total {0} of the {1} fee; billed {2}.", Labels.Amount(_milestones.Sum(x => x.Milestone.Amount)), Labels.Amount(p.Fee ?? 0m), Labels.Amount(_milestones.Where(x => x.Billed).Sum(x => x.Milestone.Amount))]</p>
            }
            <PostForm Action="@($"/projects/{p.Id}/milestones")" data-enhance="false" class="inline">
                <AntiforgeryToken />
                <input name="name" aria-label="@L["Milestone"]" placeholder="@L["Milestone (e.g. Design approved)"]" maxlength="200" required />
                <input name="amount" aria-label="@L["Amount"]" placeholder="@L["Amount"]" inputmode="decimal" class="short" required />
                <input type="date" name="dueOn" aria-label="@L["Due"]" />
                <button type="submit" class="secondary">@L["Add milestone"]</button>
            </PostForm>
        }

        @foreach (var warning in _figures.BudgetWarnings())
        {
            <div class="alert notice" role="status">@warning</div>
        }
        <table class="data">
            <thead><tr><th><span class="visually-hidden">@L["Line"]</span></th><th class="num">Actual</th><th class="num">Budget</th><th class="num">Left</th></tr></thead>
            <tbody>
                <tr><td>Income</td><td class="num">@Labels.Amount(_figures.Income)</td>@Budget(p.BudgetRevenue, _figures.Income)</tr>
                <tr><td class="indent">Expenses</td><td class="num">@Labels.Amount(_figures.ExpenseCost)</td><td></td><td></td></tr>
                <tr><td class="indent">Labor</td><td class="num">@Labels.Amount(_figures.LaborCost)</td><td></td><td></td></tr>
                <tr><td class="indent">Mileage</td><td class="num">@Labels.Amount(_figures.MileageCost)</td><td></td><td></td></tr>
                <tr><td>Costs</td><td class="num">@Labels.Amount(_figures.Cost)</td>@Budget(p.BudgetCost, _figures.Cost)</tr>
                <tr class="total"><td>Profit</td><td class="num">@Labels.Amount(_figures.Profit)</td><td class="num">@(p.BudgetRevenue is { } r && p.BudgetCost is { } c ? Labels.Amount(r - c) : "")</td><td class="num">@(_figures.Margin is { } m ? Labels.Percent(m) + " margin" : "")</td></tr>
                <tr><td>Hours</td><td class="num">@Labels.Quantity(_figures.Hours)</td>@Hours(p.BudgetHours, _figures.Hours)</tr>
            </tbody>
        </table>
        @if (_withSubProjects is { } all)
        {
            <p>With its sub-projects: income @Labels.Amount(all.Income), costs @Labels.Amount(all.Cost), profit @Labels.Amount(all.Profit), @Labels.Quantity(all.Hours) hours, @Labels.Amount(all.Unbilled) not billed yet.</p>
        }
        @if (_figures.Unbilled > 0m)
        {
            <p>Not billed yet: @Labels.Amount(_figures.Unbilled) (time @Labels.Amount(_figures.UnbilledTime), expenses @Labels.Amount(_figures.UnbilledExpenses), mileage @Labels.Amount(_figures.UnbilledMileage)). <ActionLink Href="@($"/sales/invoices/new?customer={_project.Customer.Id}")">Put it on an invoice</ActionLink>.</p>
        }

        <details class="card" id="budget-lines" open="@(_budgetLines.Count > 0)">
            <summary><h2 style="display: inline">@L["Budget by role or service"]</h2></summary>
            <p class="muted">@L["Hours and cost for each role (as on People and rates) or each service, the project's phases as time is entered. Time counts by the person's role or the entry's service, at each entry's cost rate."]</p>
            @if (_budgetLines.Count > 0)
            {
                <div class="table-wrap">
                    <table class="data">
                        <thead><tr><th>@L["Budget line"]</th><th class="num">@L["Hours"]</th><th class="num">@L["Budget"]</th><th class="num">@L["Cost"]</th><th class="num">@L["Budget"]</th><th><span class="visually-hidden">@L["Status"]</span></th></tr></thead>
                        <tbody>
                            @foreach (var b in _budgetLines)
                            {
                                <tr>
                                    <td>@b.Label</td>
                                    <td class="num">@Labels.Quantity(b.Hours)</td>
                                    <td class="num">@(b.Line.Hours is { } budgetHours ? Labels.Quantity(budgetHours) : "")</td>
                                    <td class="num">@Labels.Amount(b.Cost)</td>
                                    <td class="num">@(b.Line.Cost is { } budgetCost ? Labels.Amount(budgetCost) : "")</td>
                                    <td>@if (b.Warn) {<span class="badge warn">@L["90% or more used"]</span>}</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <PostForm Action="@($"/projects/{_project.Project.Id}/budget-lines")" data-enhance="false">
                <AntiforgeryToken />
                <datalist id="worker-roles">
                    @foreach (var role in _roles)
                    {
                        <option value="@role"></option>
                    }
                </datalist>
                <div class="table-wrap">
                    <table class="data entry">
                        <thead><tr><th>@L["Role"]</th><th>@L["or service"]</th><th class="num">@L["Hours"]</th><th class="num">@L["Cost"]</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < _project.Project.BudgetLines.Count + 3; i++)
                            {
                                var line = i < _project.Project.BudgetLines.Count ? _project.Project.BudgetLines[i] : null;
                                <tr>
                                    <td><input name="role:@i" list="worker-roles" maxlength="@Worker.MaxRoleLength" value="@line?.Role" aria-label="@L["Role of budget line {0}", i + 1]" /></td>
                                    <td>
                                        <select name="item:@i" aria-label="@L["Service of budget line {0}", i + 1]">
                                            <option value="">@L["(none)"]</option>
                                            @foreach (var s in _allServices)
                                            {
                                                <option value="@s.Id" selected="@(s.Id == line?.ItemId)">@s.Name</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="num"><input name="hours:@i" class="short" inputmode="decimal" value="@line?.Hours?.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture)" aria-label="@L["Hours of budget line {0}", i + 1]" /></td>
                                    <td class="num"><input name="cost:@i" class="short" inputmode="decimal" value="@line?.Cost?.ToString("0.00", System.Globalization.CultureInfo.CurrentCulture)" aria-label="@L["Cost of budget line {0}", i + 1]" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="actions"><button type="submit" class="secondary">@L["Save budget lines"]</button></div>
            </PostForm>
        </details>

        <ResponsibleCard CustomerId="_project.Customer.Id" Back="@($"/projects/{_project.Project.Id}")" />

        <h2>Time</h2>
        @if (_time.Count == 0)
        {
            <p class="muted">No time yet. <a href="/time?customer=@_project.Customer.Id">Add time</a>.</p>
        }
        else
        {
            <table class="data">
                <thead><tr><th>Date</th><th>Person</th><th>Notes</th><th class="num">Hours</th><th class="num">Cost</th><th class="num">Billable</th><th><span class="visually-hidden">@L["Actions"]</span></th></tr></thead>
                <tbody>
                    @foreach (var t in _time)
                    {
                        <tr>
                            <td>@Labels.Date(t.Date)</td>
                            <td>@_workers.GetValueOrDefault(t.WorkerId)</td>
                            <td>@t.Notes</td>
                            <td class="num">@(t.IsRunning ? "running" : Labels.Quantity(t.Hours))</td>
                            <td class="num">@Labels.Amount(t.Cost)</td>
                            <td class="num">@(t.Billable ? Labels.Amount(t.Amount) : "")</td>
                            <td>@if (t.InvoiceId is { } invoiceId) { <a href="/sales/invoices/@invoiceId">invoiced</a> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h2>Expenses</h2>
        @if (_expenses.Count == 0)
        {
            <p class="muted">No bill or expense lines are marked to this project. Mark them from the bill or expense page.</p>
        }
        else
        {
            <table class="data">
                <thead><tr><th>Date</th><th>Cost</th><th class="num">Cost</th><th class="num">To bill</th><th><span class="visually-hidden">@L["Actions"]</span></th></tr></thead>
                <tbody>
                    @foreach (var e in _expenses)
                    {
                        <tr>
                            <td>@Labels.Date(e.Date)</td>
                            <td><a href="@(e.Kind == BillableSource.Bill ? $"/purchases/bills/{e.DocumentId}" : $"/banking/transactions/{e.DocumentId}")">@e.Description</a></td>
                            <td class="num">@Labels.Amount(e.Cost)</td>
                            <td class="num">@(e.IsBillable ? Labels.Amount(e.Amount) : "not billed")</td>
                            <td>@if (e.InvoiceId is { } invoiceId) { <a href="/sales/invoices/@invoiceId">invoiced</a> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (_trips.Count > 0)
        {
            <h2>Mileage</h2>
            <table class="data">
                <thead><tr><th>Date</th><th>Purpose</th><th class="num">Miles</th><th class="num">Billable</th><th><span class="visually-hidden">@L["Actions"]</span></th></tr></thead>
                <tbody>
                    @foreach (var trip in _trips)
                    {
                        <tr>
                            <td>@Labels.Date(trip.Date)</td>
                            <td>@trip.Purpose</td>
                            <td class="num">@Labels.Quantity(trip.Miles)</td>
                            <td class="num">@(trip.Billable ? Labels.Amount(trip.Amount) : "")</td>
                            <td>@if (trip.InvoiceId is { } invoiceId) { <a href="/sales/invoices/@invoiceId">invoiced</a> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="card" style="margin-top: 1.5rem">
            <h2>Status and budget</h2>
            <PostForm Action="@($"/projects/{p.Id}")" data-enhance="false">
                <AntiforgeryToken />
                <ProjectFields Project="p" />
                <div class="actions"><button type="submit">Save</button></div>
            </PostForm>
        </div>

        <Attachments EntityType="project" EntityId="_project.Project.Id" />
        <Notes EntityType="project" EntityId="_project.Project.Id" />
    }
</div>

@code {
    private decimal _worked;

    private ProjectSummary? _project;
    private ProjectFigures? _figures;
    private ProjectFigures? _withSubProjects;
    private IReadOnlyList<TimeEntry> _time = [];
    private IReadOnlyList<BillableExpense> _expenses = [];
    private IReadOnlyList<MileageTrip> _trips = [];
    private Dictionary<Guid, string> _workers = [];
    private IReadOnlyList<MilestoneStatus> _milestones = [];
    private IReadOnlyList<OpenBook.Domain.Sales.Item> _services = [];
    private IReadOnlyList<OpenBook.Domain.Sales.Item> _allServices = [];
    private IReadOnlyList<BudgetLineStatus> _budgetLines = [];
    private IReadOnlyList<string> _roles = [];

    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _project = await ProjectService.GetAsync(Id);
        if (_project is null)
            return;
        _figures = await Reports.FiguresAsync(_project, null, DateOnly.MaxValue);
        _withSubProjects = await Reports.WithSubProjectsAsync(_figures, null, DateOnly.MaxValue);
        _worked = (await TimeService.ListAsync(new TimeFilter(CustomerId: _project.Customer.Id))).Where(t => !t.IsRunning).Sum(t => t.Worked);
        var customerId = _project.Customer.Id;
        _time = await TimeService.ListAsync(new TimeFilter(CustomerId: customerId));
        _expenses = await Billables.ListAsync(customerId);
        _trips = await MileageService.ListAsync(customerId: customerId);
        var people = await WorkerService.ListAsync(includeInactive: true);
        _workers = people.ToDictionary(w => w.Id, w => w.Name);
        _roles = [.. people.Select(w => w.Role).OfType<string>().Distinct(StringComparer.CurrentCultureIgnoreCase).Order(StringComparer.CurrentCultureIgnoreCase)];
        _budgetLines = await BudgetLines.StatusAsync(_project.Project.Id);
        _allServices = (await Items.ListAsync()).Where(i => i.Type is OpenBook.Domain.Sales.ItemType.Service or OpenBook.Domain.Sales.ItemType.NonInventory).ToList();
        if (_project.Project.Arrangement == BillingArrangement.FixedFee)
        {
            _milestones = await Milestones.ListAsync(_project.Project.Id);
            _services = (await Items.ListAsync()).Where(i => i.Type is OpenBook.Domain.Sales.ItemType.Service or OpenBook.Domain.Sales.ItemType.NonInventory).ToList();
        }
    }

    private static RenderFragment Budget(decimal? budget, decimal actual) => budget is { } b
        ? @<text><td class="num">@Labels.Amount(b)</td><td class="num">@Labels.Amount(b - actual)</td></text>
        : @<text><td></td><td></td></text>;

    private static RenderFragment Hours(decimal? budget, decimal actual) => budget is { } b
        ? @<text><td class="num">@Labels.Quantity(b)</td><td class="num">@Labels.Quantity(b - actual)</td></text>
        : @<text><td></td><td></td></text>;
}
