@page "/inventory"
@using OpenBook.Application.Inventory
@using OpenBook.Domain.Inventory
@inject InventoryService Inventory
@inject InventoryAdjustmentService Adjustments
@inject AssemblyBuildService Builds
@inject LandedCostService LandedCosts
@inject ItemService Items
@inject StockTransferService Transfers
@inject WarehouseService WarehouseService

<PageTitle>Inventory · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Inventory</h1>
        <ActionLink Class="button secondary" Href="/inventory/count">Count stock</ActionLink>
        <ActionLink Class="button" Href="/inventory/adjustments/new">Adjust quantities</ActionLink>
    </div>
    <div class="hub-actions">
        <div class="hub-group"><span class="hub-label">Create</span>
            <ActionLink Class="button secondary" Href="/items/new">New item</ActionLink>
            <ActionLink Class="button secondary" Href="/inventory/transfers/new">Transfer stock</ActionLink>
            <ActionLink Class="button secondary" Href="/inventory/builds/new">Build assemblies</ActionLink>
            <ActionLink Class="button secondary" Href="/inventory/landed-costs/new">Landed cost</ActionLink>
        </div>
        <div class="hub-group"><span class="hub-label">Reports</span>
            <ActionLink Class="button secondary" Href="/reports/inventory-valuation">Valuation</ActionLink>
            <ActionLink Class="button secondary" Href="/reports/inventory-stock">Stock status</ActionLink>
            <ActionLink Class="button secondary" Href="/reports/physical-inventory-worksheet">Count sheet</ActionLink>
        </div>
        <div class="hub-group"><span class="hub-label">Tools</span>
            <ActionLink Class="button secondary" Href="/purchases/reorder">Reorder stock</ActionLink>
            <ActionLink Class="button secondary" Href="/inventory/labels">Labels</ActionLink>
        </div>
        <div class="hub-group"><span class="hub-label">Set up</span>
            <ActionLink Class="button secondary" Href="/inventory/warehouses">Warehouses and bins</ActionLink>
        </div>
    </div>
    <p class="muted">
        Inventory products and assemblies are counted and costed first in, first out (or at weighted average, per item): bills add stock
        at what you paid, builds turn components into assemblies, sales take the cost into cost of goods sold, and credit memos put
        returns back. Bundles sell their components together. Adjust quantities for counts, damage or starting stock; add freight and
        duty with a landed cost.
    </p>

    @if (_stock.Count == 0)
    {
        <div class="card"><p>No inventory products yet. <ActionLink Href="/items/new">Add one</ActionLink> with the type "Inventory product".</p></div>
    }
    else
    {
        @if (_stock.Count(s => s.NeedsReorder) is > 0 and var low)
        {
            <div class="alert notice" role="status">@(low == 1 ? "1 item is" : $"{low} items are") at or below the reorder point. <ActionLink Href="/purchases/reorder">Reorder stock</ActionLink></div>
        }
        <table class="data">
            <thead><tr><th>Item</th><th class="num">On hand</th><th class="num">Reorder point</th><th class="num">Average cost</th><th class="num">Asset value</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in _stock)
                {
                    <tr class="@(s.Item.IsActive ? null : "inactive")">
                        <td><a href="/items/@s.Item.Id">@s.Item.Name</a></td>
                        <td class="num">@Labels.Quantity(s.Quantity)</td>
                        <td class="num">@(s.Item.ReorderPoint is { } point ? Labels.Quantity(point) : "")</td>
                        <td class="num">@(s.AverageCost is { } average ? Labels.Amount(average) : "")</td>
                        <td class="num">@Labels.Amount(s.Value)</td>
                        <td>
                            @if (s.NeedsReorder)
                            {
                                <span class="badge warn">Reorder</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><td colspan="4">Total</td><td class="num">@Labels.Amount(_stock.Sum(s => s.Value))</td><td></td></tr>
            </tfoot>
        </table>
    }

    <h2>Quantity adjustments</h2>
    @if (_adjustments.Count == 0)
    {
        <p class="muted">None yet.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>Date</th><th>Reference</th><th>Memo</th><th class="num">Items</th><th class="num">Value change</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var a in _adjustments.Take(50))
                {
                    <tr class="@(a.Status == DocumentStatus.Voided ? "inactive" : null)">
                        <td><a href="/inventory/adjustments/@a.Id">@Labels.Date(a.Date)</a></td>
                        <td>@a.Reference</td>
                        <td class="muted">@a.Memo</td>
                        <td class="num">@a.Lines.Count</td>
                        <td class="num">@Labels.Amount(a.ValueChange)</td>
                        <td>@(a.Status == DocumentStatus.Voided ? "Voided" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_expiring.Count > 0)
    {
        <h2>Lots expiring within @ExpiryDays days</h2>
        <table class="data">
            <thead><tr><th>Item</th><th>Lot</th><th>Expires</th><th class="num">On hand</th></tr></thead>
            <tbody>
                @foreach (var lot in _expiring)
                {
                    <tr>
                        <td><a href="/items/@lot.Item.Id#lots">@lot.Item.Name</a></td>
                        <td><a href="/inventory?lot=@Uri.EscapeDataString(lot.Lot)">@lot.Lot</a></td>
                        <td>
                            @Labels.Date(lot.ExpiresOn)
                            @if (lot.ExpiresOn < _today)
                            {
                                <span class="badge warn">Expired</span>
                            }
                        </td>
                        <td class="num">@Labels.Quantity(lot.Quantity)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <form class="card filters" method="get" data-enhance="false">
        <div class="row">
            <div class="field">
                <label for="lot">Find a lot or serial number</label>
                <input id="lot" name="lot" value="@Lot" maxlength="@LotText.MaxLotLength" />
            </div>
        </div>
        <div class="actions"><button type="submit" class="secondary">Find</button></div>
        @if (Lot is { Length: > 0 })
        {
            @if (_lotHistory.Count == 0)
            {
                <p class="muted">No stock has moved under @Lot.</p>
            }
            else
            {
                <table class="data">
                    <thead><tr><th>Date</th><th>Item</th><th>Where</th><th>From</th><th class="num">Quantity</th></tr></thead>
                    <tbody>
                        @foreach (var m in _lotHistory)
                        {
                            <tr class="@(m.ReversalOf is null ? null : "inactive")">
                                <td>@Labels.Date(m.Date)</td>
                                <td><a href="/items/@m.ItemId">@(_names.GetValueOrDefault(m.ItemId) ?? "Item")</a></td>
                                <td>@_place(m.Place)</td>
                                <td><a href="@Links.ForAuditEntity(m.SourceType, m.SourceId)">@SourceName(m.SourceType)</a></td>
                                <td class="num">@Labels.Quantity(m.Quantity)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="muted">On hand now: @Labels.Quantity(_lotHistory.Sum(m => m.Quantity)).</p>
            }
        }
    </form>

    <h2>Transfers</h2>
    @if (_transfers.Count == 0)
    {
        <p class="muted">None yet.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>Date</th><th>Reference</th><th>Memo</th><th class="num">Lines</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var t in _transfers.Take(50))
                {
                    <tr class="@(t.Status == DocumentStatus.Voided ? "inactive" : null)">
                        <td><a href="/inventory/transfers/@t.Id">@Labels.Date(t.Date)</a></td>
                        <td>@t.Reference</td>
                        <td class="muted">@t.Memo</td>
                        <td class="num">@t.Lines.Count</td>
                        <td>@(t.Status == DocumentStatus.Voided ? "Voided" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2 id="pending">Pending builds</h2>
    @if (PendingNote is not null)
    {
        <div class="alert success" role="status">@(PendingNote == "cancelled" ? "Pending build cancelled." : "Saved as a pending build.")</div>
    }
    @if (PendingError is not null)
    {
        <div class="alert error" role="alert">@PendingError</div>
    }
    @if (_pending.Count == 0)
    {
        <p class="muted">None waiting.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>Saved</th><th>Assembly</th><th class="num">Quantity</th><th>Components today</th><th></th></tr></thead>
            <tbody>
                @foreach (var (pending, assembly, preview) in _pending)
                {
                    <tr>
                        <td>@pending.CreatedAt.InCompanyTime().ToString("d") @pending.Reference</td>
                        <td><a href="/items/@assembly.Id#components">@assembly.Name</a></td>
                        <td class="num">@Labels.Quantity(pending.Quantity)</td>
                        <td>
                            @if (preview is null)
                            {
                                <span class="muted">Check the bill of materials</span>
                            }
                            else if (preview.Requirements.Any(r => r.Stops))
                            {
                                <span class="badge warn">Short</span>
                                <span class="muted">@string.Join(", ", preview.Requirements.Where(r => r.IsShort).Select(r => $"{r.Component.Name}: {Labels.Quantity(r.OnHand)} of {Labels.Quantity(r.Needed)}"))</span>
                            }
                            else
                            {
                                <span class="badge ok">Ready</span>
                            }
                        </td>
                        <td class="inline">
                            <ActionLink Class="button secondary" Href="@($"/inventory/builds/new?pending={pending.Id}")">Build now</ActionLink>
                            <PostForm Action="@($"/inventory/pending-builds/{pending.Id}/cancel")" data-enhance="false">
                                <AntiforgeryToken />
                                <button type="submit" class="link">Cancel</button>
                            </PostForm>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>Assembly builds</h2>
    @if (_builds.Count == 0)
    {
        <p class="muted">None yet.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>Date</th><th>Assembly</th><th class="num">Quantity</th><th class="num">Cost</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var b in _builds.Take(50))
                {
                    <tr class="@(b.Status == DocumentStatus.Voided ? "inactive" : null)">
                        <td><a href="/inventory/builds/@b.Id">@Labels.Date(b.Date)</a></td>
                        <td>@(_names.GetValueOrDefault(b.ItemId) ?? "Item")</td>
                        <td class="num">@Labels.Quantity(b.Quantity)</td>
                        <td class="num">@Labels.Amount(b.Cost)</td>
                        <td>@(b.Status == DocumentStatus.Voided ? "Voided" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>Landed costs</h2>
    @if (_landed.Count == 0)
    {
        <p class="muted">None yet.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>Date</th><th>Memo</th><th class="num">Bills</th><th class="num">Amount</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var l in _landed.Take(50))
                {
                    <tr class="@(l.Status == DocumentStatus.Voided ? "inactive" : null)">
                        <td><a href="/inventory/landed-costs/@l.Id">@Labels.Date(l.Date)</a></td>
                        <td class="muted">@l.Memo</td>
                        <td class="num">@l.BillIds.Count</td>
                        <td class="num">@Labels.Amount(l.Amount)</td>
                        <td>@(l.Status == DocumentStatus.Voided ? "Voided" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IReadOnlyList<StockLevel> _stock = [];
    private IReadOnlyList<InventoryAdjustment> _adjustments = [];
    private IReadOnlyList<AssemblyBuild> _builds = [];
    private IReadOnlyList<LandedCost> _landed = [];
    private Dictionary<Guid, string> _names = [];
    private IReadOnlyList<StockTransfer> _transfers = [];
    private IReadOnlyList<ExpiringLot> _expiring = [];
    private IReadOnlyList<(PendingBuild Pending, Item Assembly, BuildPreview? Preview)> _pending = [];

    [SupplyParameterFromQuery(Name = "pending")] private string? PendingNote { get; set; }
    [SupplyParameterFromQuery] private string? PendingError { get; set; }
    private readonly DateOnly _today = CompanyTime.Today;
    private const int ExpiryDays = 30;
    private IReadOnlyList<InventoryMovement> _lotHistory = [];
    private Func<StockPlace, string> _place = _ => "";

    [SupplyParameterFromQuery] private string? Lot { get; set; }

    private static string SourceName(string sourceType) => sourceType switch
    {
        InventorySources.Bill => "Bill",
        InventorySources.Invoice => "Invoice",
        InventorySources.SalesReceipt => "Sales receipt",
        InventorySources.CreditMemo => "Credit memo",
        InventorySources.Adjustment => "Adjustment",
        InventorySources.AssemblyBuild => "Assembly build",
        InventorySources.Transfer => "Transfer",
        _ => "Document",
    };

    protected override async Task OnInitializedAsync()
    {
        _stock = (await Inventory.StockAsync()).Where(s => s.Item.IsActive || s.Quantity != 0m).ToList();
        _adjustments = await Adjustments.ListAsync();
        _builds = await Builds.ListAsync();
        _pending = await Builds.ListPendingAsync(_today);
        _landed = await LandedCosts.ListAsync();
        _names = (await Items.ListAsync(includeInactive: true)).ToDictionary(i => i.Id, i => i.Name);
        _transfers = await Transfers.ListAsync();
        _expiring = await Inventory.ExpiringAsync(_today.AddDays(ExpiryDays));
        _place = await WarehouseService.NamerAsync();
        if (Lot is { Length: > 0 } lot)
            _lotHistory = await Inventory.LotHistoryAsync(lot);
    }
}
