@page "/inventory/adjustments/new"
@using OpenBook.Application.Inventory
@using OpenBook.Domain.Inventory
@inject InventoryAdjustmentService Adjustments
@inject InventoryService Inventory
@inject AccountService AccountService
@inject NavigationManager Navigation
@inject ClosedPeriodOverride ClosingOverride

<PageTitle>Adjust inventory quantities · OpenBook</PageTitle>

<div class="wide">
    <h1>Adjust inventory quantities</h1>
    <p class="muted">
        Enter the change in quantity: positive to add stock (at the unit cost you give, or the item's purchase cost), negative to
        remove it (at FIFO cost). The value change posts between each item's inventory asset account and the adjustment account.
        For starting stock, choose Opening Balance Equity.
    </p>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (_stock.Count == 0)
    {
        <div class="alert notice" role="status">There are no active inventory products. <a href="/items/new">Add one</a> first.</div>
    }

    <EditForm Model="Input" FormName="adjustment" OnValidSubmit="SaveAsync" method="post">
        <DataAnnotationsValidator />
        <div class="row">
            <div class="field">
                <label for="date">Date</label>
                <InputDate id="date" @bind-Value="Input.Date" />
            </div>
            <div class="field">
                <label for="reference">Reference <span class="muted">(optional)</span></label>
                <InputText id="reference" @bind-Value="Input.Reference" />
            </div>
            <div class="field">
                <label for="account">Adjustment account</label>
                <InputSelect id="account" @bind-Value="Input.AccountId" data-search>
                    <option value="">Inventory Shrinkage (default)</option>
                    @foreach (var account in _accounts)
                    {
                        <option value="@account.Id">@_chart.FullName(account.Id) (@Labels.For(account.Type))</option>
                    }
                </InputSelect>
            </div>
        </div>

        <table class="data entry">
            <thead><tr><th>Item</th><th class="num">On hand</th><th class="num">Quantity change</th><th class="num">Unit cost (increases)</th></tr></thead>
            <tbody>
                @for (var i = 0; i < Input.Lines.Count; i++)
                {
                    var index = i;
                    <tr>
                        <td>
                            <InputSelect @bind-Value="Input.Lines[index].ItemId" data-search aria-label="@($"Item {index + 1}")">
                                <option value="">Choose an item…</option>
                                @foreach (var s in _stock)
                                {
                                    <option value="@s.Item.Id">@s.Item.Name</option>
                                }
                            </InputSelect>
                        </td>
                        <td class="num muted">@(Input.Lines[index].ItemId is { } id && _stock.FirstOrDefault(s => s.Item.Id == id) is { } level ? Labels.Quantity(level.Quantity) : "")</td>
                        <td><InputNumber class="amount" step="any" @bind-Value="Input.Lines[index].QuantityChange" aria-label="@($"Quantity change {index + 1}")" /></td>
                        <td><InputNumber class="amount" step="any" @bind-Value="Input.Lines[index].UnitCost" aria-label="@($"Unit cost {index + 1}")" /></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="field">
            <label for="memo">Memo <span class="muted">(optional)</span></label>
            <InputText id="memo" @bind-Value="Input.Memo" />
        </div>
        <ClosedPeriodPassword Visible="_needsClosingPassword" Interactive="false" Name="Input.ClosingPassword" />
        <div class="actions">
            <button type="submit">Save adjustment</button>
            <a href="/inventory">Cancel</a>
        </div>
    </EditForm>
</div>

@code {
    private const int Rows = 8;

    private IReadOnlyList<StockLevel> _stock = [];
    private ChartOfAccounts _chart = new([]);
    private List<Account> _accounts = [];
    private bool _needsClosingPassword;
    private string? _error;

    [SupplyParameterFromForm(FormName = "adjustment")]
    private AdjustmentModel Input { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "item")]
    private Guid? PresetItem { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _stock = (await Inventory.StockAsync()).Where(s => s.Item.IsActive).ToList();
        _chart = await AccountService.GetChartAsync();
        _accounts = _chart.Ordered(includeInactive: false).Select(x => x.Account)
            .Where(a => a.Type is AccountType.CostOfGoodsSold or AccountType.Expense or AccountType.OtherExpense or AccountType.Equity or AccountType.OtherIncome)
            .ToList();
        Input ??= new AdjustmentModel { Date = DateOnly.FromDateTime(DateTime.Today) };
        while (Input.Lines.Count < Rows)
            Input.Lines.Add(new LineModel());
        if (PresetItem is { } preset && Input.Lines.All(l => l.ItemId is null))
            Input.Lines[0].ItemId = preset;
    }

    private async Task SaveAsync()
    {
        try
        {
            var lines = Input.Lines
                .Where(l => l.ItemId is not null || l.QuantityChange is not null)
                .Select(l => new InventoryAdjustmentLineDraft(l.ItemId ?? Guid.Empty, l.QuantityChange ?? 0m, l.UnitCost))
                .ToList();
            ClosingOverride.Password = Input.ClosingPassword;
            var adjustment = await Adjustments.CreateAsync(new CreateInventoryAdjustmentCommand(Input.Date, lines, Input.AccountId, Input.Reference, Input.Memo));
            Navigation.NavigateTo($"/inventory/adjustments/{adjustment.Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword = ClosedPeriod.NeedsPassword(ex);
        }
    }

    private sealed class AdjustmentModel
    {
        public DateOnly Date { get; set; }
        public string? Reference { get; set; }
        public Guid? AccountId { get; set; }
        public string? Memo { get; set; }
        public string? ClosingPassword { get; set; }
        public List<LineModel> Lines { get; set; } = [];
    }

    private sealed class LineModel
    {
        public Guid? ItemId { get; set; }
        public decimal? QuantityChange { get; set; }
        public decimal? UnitCost { get; set; }
    }
}
