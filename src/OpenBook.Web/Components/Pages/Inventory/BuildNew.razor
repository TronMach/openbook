@page "/inventory/builds/new"
@using System.ComponentModel.DataAnnotations
@using OpenBook.Application.Inventory
@using OpenBook.Domain.Inventory
@inject AssemblyBuildService Builds
@inject ItemService Items
@inject WarehouseService WarehouseService
@inject NavigationManager Navigation
@inject ClosedPeriodOverride ClosingOverride

<PageTitle>Build assemblies · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Build assemblies</h1>
        <a href="/inventory">Inventory</a>
    </div>
    <p class="muted">
        A build takes each component in the assembly's bill of materials out of stock, at its own cost, and adds the finished
        assemblies to stock at the total. Voiding the build undoes it while none of those assemblies has been used.
    </p>

    @if (_assemblies.Count == 0)
    {
        <div class="card"><p>No assemblies yet. <ActionLink Href="/items/new">Add an item</ActionLink> with the type "Assembly" and list its components.</p></div>
        return;
    }

    <form class="card filters" method="get" data-enhance="false">
        <div class="row">
            <div class="field">
                <label for="item">Assembly</label>
                <select id="item" name="item" data-search>
                    @foreach (var a in _assemblies)
                    {
                        <option value="@a.Id" selected="@(a.Id == _itemId)">@a.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="quantity">Quantity</label>
                <input id="quantity" name="quantity" class="amount" inputmode="decimal" value="@_quantity.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)" />
            </div>
            <div class="field">
                <label for="date">Date</label>
                <input id="date" type="date" name="date" value="@_date.ToString("yyyy-MM-dd")" />
            </div>
            @if (_warehouses.Count > 1)
            {
                <div class="field">
                    <label for="warehouse">Warehouse</label>
                    <select id="warehouse" name="warehouse">
                        @foreach (var w in _warehouses)
                        {
                            <option value="@(w.IsDefault ? "" : w.Id.ToString())" selected="@(w.Key == _warehouseId)">@w.Name</option>
                        }
                    </select>
                </div>
            }
        </div>
        <div class="actions"><button type="submit" class="secondary">Check stock</button></div>
    </form>

    @if (_preview is not null)
    {
        @if (_preview.Requirements.Count == 0)
        {
            <div class="card"><p>@_preview.Assembly.Name has no components yet. <a href="/items/@_preview.Assembly.Id#components">Add its bill of materials</a>.</p></div>
        }
        else
        {
            <table class="data">
                <thead><tr><th>Component</th><th class="num">Per unit</th><th class="num">Needed</th><th class="num">On hand @Labels.Date(_date)</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in _preview.Requirements)
                    {
                        <tr>
                            <td><a href="/items/@r.Component.Id">@r.Component.Name</a></td>
                            <td class="num">@Labels.Quantity(r.PerUnit)</td>
                            <td class="num">@Labels.Quantity(r.Needed)</td>
                            <td class="num">@Labels.Quantity(r.OnHand)</td>
                            <td>@if (r.IsShort) { <span class="badge warn">Short</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="muted">Enough on hand to build @Labels.Quantity(_preview.MaxBuildable).</p>

            <div class="card">
                @if (_error is not null)
                {
                    <div class="alert error" role="alert">@_error</div>
                }
                <EditForm Model="Input" FormName="build" OnValidSubmit="BuildAsync" method="post">
                    <DataAnnotationsValidator />
                    <input type="hidden" name="Input.ItemId" value="@_itemId" />
                    <input type="hidden" name="Input.Quantity" value="@_quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                    <input type="hidden" name="Input.Date" value="@_date.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="Input.WarehouseId" value="@_warehouseId" />
                    <input type="hidden" name="Input.PendingId" value="@_pendingId" />
                    @if (_preview.Assembly.Tracking != ItemTracking.None)
                    {
                        <div class="field">
                            <label for="lots">@(_preview.Assembly.Tracking == ItemTracking.Serial ? "Serial numbers for the assemblies built" : "Lot for the assemblies built")</label>
                            <InputText id="lots" @bind-Value="Input.Lots" placeholder="@(_preview.Assembly.Tracking == ItemTracking.Serial ? "SN1, SN2" : "A-1")" />
                        </div>
                    }
                    <div class="row">
                        <div class="field">
                            <label for="reference">Reference <span class="muted">(optional)</span></label>
                            <InputText id="reference" @bind-Value="Input.Reference" />
                        </div>
                        <div class="field">
                            <label for="memo">Memo <span class="muted">(optional)</span></label>
                            <InputText id="memo" @bind-Value="Input.Memo" />
                        </div>
                    </div>
                    <ClosedPeriodPassword Visible="_needsClosingPassword" Interactive="false" Name="Input.ClosingPassword" />
                    @{
                        var shortOfStock = _preview.Requirements.Any(r => r.IsShort);
                        var now = Math.Min(_quantity, _preview.MaxBuildable);
                    }
                    <div class="actions">
                        @if (_pendingId is not null)
                        {
                            <button type="submit" name="Input.Mode" value="finish" disabled="@shortOfStock">Finish the pending build: @Labels.Quantity(_quantity) @_preview.Assembly.Name</button>
                        }
                        else
                        {
                            <button type="submit" name="Input.Mode" value="build" disabled="@shortOfStock">Build @Labels.Quantity(_quantity) @_preview.Assembly.Name</button>
                            @if (shortOfStock && now > 0m)
                            {
                                <button type="submit" name="Input.Mode" value="partial" class="secondary">Build @Labels.Quantity(now) now, leave @Labels.Quantity(_quantity - now) pending</button>
                            }
                            @if (shortOfStock)
                            {
                                <button type="submit" name="Input.Mode" value="pending" class="secondary">Save all @Labels.Quantity(_quantity) as pending</button>
                            }
                        }
                    </div>
                    @if (shortOfStock)
                    {
                        <p class="muted">A pending build posts nothing and doesn't hold the components; finish it from the inventory page once they arrive.</p>
                    }
                </EditForm>
            </div>
        }
    }
</div>

@code {
    private List<Item> _assemblies = [];
    private Guid _itemId;
    private decimal _quantity = 1m;
    private DateOnly _date = CompanyTime.Today;
    private BuildPreview? _preview;
    private IReadOnlyList<Warehouse> _warehouses = [];
    private Guid? _warehouseId;
    private bool _needsClosingPassword;
    private string? _error;

    [SupplyParameterFromQuery] private Guid? Item { get; set; }
    [SupplyParameterFromQuery] private string? Quantity { get; set; }
    [SupplyParameterFromQuery] private string? Date { get; set; }
    [SupplyParameterFromQuery] private Guid? Warehouse { get; set; }
    [SupplyParameterFromQuery(Name = "pending")] private Guid? PendingQuery { get; set; }

    private Guid? _pendingId;

    [SupplyParameterFromForm(FormName = "build")]
    private BuildModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _assemblies = (await Items.ListAsync()).Where(i => i.IsAssembly).ToList();
        _warehouses = await WarehouseService.ListAsync();
        _warehouseId = Input.WarehouseId ?? _warehouses.FirstOrDefault(w => w.Id == Warehouse)?.Key;
        if (_assemblies.Count == 0)
            return;

        // Finishing a pending build: its assembly, quantity, warehouse and notes.
        _pendingId = Input.PendingId ?? PendingQuery;
        if (_pendingId is { } pendingId && Input.ItemId is null && await Builds.GetPendingAsync(pendingId) is { Status: PendingBuildStatus.Open } pending)
        {
            Input.ItemId = pending.ItemId;
            Input.Quantity = pending.Quantity;
            Input.Reference ??= pending.Reference;
            Input.Memo ??= pending.Memo;
            _warehouseId = pending.WarehouseId;
        }

        // A posted build carries its own choices; otherwise the query string (or the first assembly).
        _itemId = Input.ItemId ?? (Item is { } chosen && _assemblies.Any(a => a.Id == chosen) ? chosen : _assemblies[0].Id);
        if (Input.Quantity is { } q)
            _quantity = q;
        else if (decimal.TryParse(Quantity, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var parsed) && parsed > 0m)
            _quantity = parsed;
        if (Input.Date is { } d)
            _date = d;
        else if (DateOnly.TryParseExact(Date, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsedDate))
            _date = parsedDate;

        try
        {
            _preview = await Builds.PreviewAsync(_itemId, _quantity, _date, _warehouseId);
        }
        catch (DomainException ex) when (ex.Code == "build.no_components")
        {
            _preview = new BuildPreview(_assemblies.First(a => a.Id == _itemId), _quantity, [], 0m);
        }
    }

    private async Task BuildAsync()
    {
        try
        {
            ClosingOverride.Password = Input.ClosingPassword;
            var command = new BuildAssemblyCommand(_itemId, _quantity, _date, Input.Reference, Input.Memo, _warehouseId, Input.Lots);
            switch (Input.Mode)
            {
                case "pending":
                    await Builds.SavePendingAsync(command);
                    Navigation.NavigateTo("/inventory?pending=saved#pending");
                    break;
                case "partial":
                    var (built, _) = await Builds.BuildWhatYouCanAsync(command);
                    Navigation.NavigateTo(built is null ? "/inventory?pending=saved#pending" : $"/inventory/builds/{built.Id}");
                    break;
                case "finish" when _pendingId is { } pendingId:
                    var finished = await Builds.FinishPendingAsync(pendingId, _date, Input.Lots);
                    Navigation.NavigateTo($"/inventory/builds/{finished.Id}");
                    break;
                default:
                    var build = await Builds.CreateAsync(command);
                    Navigation.NavigateTo($"/inventory/builds/{build.Id}");
                    break;
            }
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword = ClosedPeriod.NeedsPassword(ex);
        }
    }

    private sealed class BuildModel
    {
        public Guid? ItemId { get; set; }
        public decimal? Quantity { get; set; }
        public DateOnly? Date { get; set; }
        public Guid? WarehouseId { get; set; }
        public Guid? PendingId { get; set; }

        /// <summary>Which button: build, partial, pending or finish.</summary>
        public string? Mode { get; set; }

        [StringLength(1000)]
        public string? Lots { get; set; }

        [StringLength(30)]
        public string? Reference { get; set; }

        [StringLength(1000)]
        public string? Memo { get; set; }

        public string? ClosingPassword { get; set; }
    }
}
