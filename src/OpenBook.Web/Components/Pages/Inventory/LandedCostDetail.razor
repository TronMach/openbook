@page "/inventory/landed-costs/{Id:guid}"
@using System.ComponentModel.DataAnnotations
@using OpenBook.Application.Inventory
@using OpenBook.Domain.Inventory
@inject LandedCostService LandedCosts
@inject ItemService Items
@inject AccountService AccountService
@inject NavigationManager Navigation
@inject ClosedPeriodOverride ClosingOverride

<PageTitle>Landed cost · OpenBook</PageTitle>

@if (_landed is null)
{
    <div class="card"><p>That landed cost doesn't exist. <a href="/inventory">Back to inventory</a>.</p></div>
    return;
}

<div class="wide">
    <div class="toolbar">
        <h1>Landed cost @Labels.Amount(_landed.Amount)</h1>
        @if (_landed.Status == DocumentStatus.Voided)
        {
            <span class="badge">Voided</span>
        }
        <a href="/inventory">Inventory</a>
    </div>

    <div class="card">
        <dl class="facts">
            <dt>Date</dt><dd>@Labels.Date(_landed.Date)</dd>
            <dt>Came out of</dt><dd>@_chart.FullName(_landed.FromAccountId)</dd>
            <dt>Spread by</dt><dd>@(_landed.Method == LandedCostMethod.ByQuantity ? "Quantity" : "Value")</dd>
            @if (_landed.Memo is { } memo)
            {
                <dt>Memo</dt><dd>@memo</dd>
            }
            <dt>Journal entry</dt><dd><a href="/journal/@_landed.JournalEntryId">View</a></dd>
        </dl>
    </div>

    <table class="data">
        <thead><tr><th>Item</th><th>Bill</th><th class="num">Share</th><th class="num">To stock on hand</th><th class="num">To cost of goods sold</th></tr></thead>
        <tbody>
            @foreach (var line in _landed.Lines.OrderBy(l => l.LineNumber))
            {
                <tr>
                    <td><a href="/items/@line.ItemId">@(_items.GetValueOrDefault(line.ItemId)?.Name ?? "Item")</a></td>
                    <td><a href="/purchases/bills/@line.BillId">View bill</a></td>
                    <td class="num">@Labels.Amount(line.Amount)</td>
                    <td class="num">@Labels.Amount(line.ToStock)</td>
                    <td class="num">@Labels.Amount(line.ToCostOfSales)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="2">Total</td>
                <td class="num">@Labels.Amount(_landed.Amount)</td>
                <td class="num">@Labels.Amount(_landed.Lines.Sum(l => l.ToStock))</td>
                <td class="num">@Labels.Amount(_landed.Lines.Sum(l => l.ToCostOfSales))</td>
            </tr>
        </tfoot>
    </table>

    <Attachments EntityType="landed_cost" EntityId="_landed.Id" />

    <Notes EntityType="landed_cost" EntityId="_landed.Id" />

    @if (_landed.Status == DocumentStatus.Posted)
    {
        <div class="card">
            <h2>Void this landed cost</h2>
            <p class="muted">Voiding takes the cost back off the stock and puts it back where it came from. It's refused once stock it went on has been sold or adjusted since.</p>
            @if (_error is not null)
            {
                <div class="alert error" role="alert">@_error</div>
            }
            <EditForm Model="VoidInput" FormName="void" OnValidSubmit="VoidAsync" method="post"><FormAccess>
                <DataAnnotationsValidator />
                <div class="field">
                    <label for="reason">Reason</label>
                    <InputText id="reason" @bind-Value="VoidInput.Reason" />
                    <ValidationMessage For="() => VoidInput.Reason" />
                </div>
                <ClosedPeriodPassword Visible="_needsClosingPassword" Interactive="false" Name="VoidInput.ClosingPassword" />
                <button type="submit" class="danger">Void landed cost</button>
            </FormAccess>
            </EditForm>
        </div>
    }
</div>

@code {
    private LandedCost? _landed;
    private Dictionary<Guid, Item> _items = [];
    private ChartOfAccounts _chart = new([]);
    private bool _needsClosingPassword;
    private string? _error;

    [Parameter] public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "void")]
    private VoidModel VoidInput { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        VoidInput ??= new();
        _landed = await LandedCosts.GetAsync(Id);
        _items = (await Items.ListAsync(includeInactive: true)).ToDictionary(i => i.Id);
        _chart = await AccountService.GetChartAsync();
    }

    private async Task VoidAsync()
    {
        try
        {
            ClosingOverride.Password = VoidInput.ClosingPassword;
            await LandedCosts.VoidAsync(Id, VoidInput.Reason);
            Navigation.NavigateTo($"/inventory/landed-costs/{Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword = ClosedPeriod.NeedsPassword(ex);
        }
    }

    private sealed class VoidModel
    {
        [Required(ErrorMessage = "Say why it's being voided.")]
        public string Reason { get; set; } = string.Empty;

        public string? ClosingPassword { get; set; }
    }
}
