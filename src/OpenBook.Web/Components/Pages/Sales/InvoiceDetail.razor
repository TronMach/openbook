@page "/sales/invoices/{Id:guid}"
@using System.ComponentModel.DataAnnotations
@inject InvoiceService Invoices
@inject CustomerService CustomerService
@inject CompanySettingsService Settings
@inject NavigationManager Navigation
@inject ClosedPeriodOverride ClosingOverride
@inject OpenBook.Application.Inventory.WarehouseService WarehouseService
@inject WriteOffService WriteOffs
@inject ReminderService Reminders
@inject ScheduledEmailService ScheduledEmails

<PageTitle>Invoice @(_invoice?.Number) · OpenBook</PageTitle>

@if (_invoice is null || _customer is null || _company is null)
{
    <div class="card"><p>That invoice doesn't exist. <a href="/sales">Back to sales</a>.</p></div>
    return;
}

<div class="wide">
    @{
        var today = CompanyTime.Today;
        var status = Labels.Status(_invoice, today);
    }
    <div class="toolbar">
        <h1>Invoice @_invoice.Number</h1>
        <span class="badge @(status == "Overdue" ? "warn" : status == "Paid" ? "ok" : null)">@status</span>
        <ActionLink Class="button secondary" Href="/sales">@L["Back to sales"]</ActionLink>
        <a class="button secondary" href="/api/sales/invoices/@_invoice.Id/pdf" target="_blank">@L["PDF"]</a>
        <PrintButtons Document="OpenBook.Domain.Companies.FormDocuments.Invoice" Id="_invoice.Id" PdfUrl="@($"/api/sales/invoices/{_invoice.Id}/pdf")" />
        @if (_invoice.Status == DocumentStatus.Posted)
        {
            <ActionLink Class="button secondary" Href="@($"/sales/email/invoices/{_invoice.Id}")">@L["Email"]</ActionLink>
        }
        <ActionLink Class="button secondary" Href="@($"/sales/invoices/new?copy={_invoice.Id}")">@L["Copy"]</ActionLink>
        <ActionLink Class="button secondary" Href="@($"/audit?entityId={_invoice.Id}")">@L["History"]</ActionLink>
        @if (_invoice.Status == DocumentStatus.Posted)
        {
            <ActionLink Class="button secondary" Href="@($"/sales/invoices/{_invoice.Id}/edit")">@L["Change"]</ActionLink>
        }
        @if (_invoice.IsOpen)
        {
            <ActionLink Class="button secondary" Href="@($"/sales/credits/apply?customer={_customer.Id}")">@L["Apply credit"]</ActionLink>
            <ActionLink Class="button secondary" Href="@($"/sales/write-offs/new?invoice={_invoice.Id}")">@L["Write off"]</ActionLink>
            <ActionLink Class="button" Href="@($"/sales/payments/new?customer={(_billTo ?? _customer.Id)}")">@L["Receive payment"]</ActionLink>
        }
    </div>

    @if (_changes.Count > 0)
    {
        var last = _changes[^1];
        <p class="muted no-print">@L["Changed {0} by {1}: {2}", last.At.InCompanyTime().ToString("g"), last.By, last.Reason]</p>
    }

    @if (_invoice.LastEmailedAt is { } emailed)
    {
        <p class="muted no-print">Emailed @emailed.InCompanyTime().ToString("g").</p>
    }

    @if (_error is not null)
    {
        <div class="alert error no-print" role="alert">@_error</div>
    }

    <div class="card">
        <div class="split-grid">
            <div>
                <strong>@(_company.LegalName ?? _company.Name)</strong>
                @if (_company.Address is not null) { <div style="white-space: pre-line">@_company.Address</div> }
                @if (_company.Email is not null) { <div>@_company.Email</div> }
                @if (_company.Phone is not null) { <div>@_company.Phone</div> }
            </div>
            <dl class="facts">
                <dt>@L["Invoice"]</dt><dd>@_invoice.Number</dd>
                <dt>@L["Date"]</dt><dd>@Labels.Date(_invoice.Date)</dd>
                <dt>@L["Due"]</dt><dd>@Labels.Date(_invoice.DueDate)</dd>
            @if (_invoice.WarehouseId is { } warehouseId)
            {
                <dt>@L["Warehouse"]</dt><dd>@_place(new StockPlace(warehouseId, null))</dd>
            }
                <dt>@L["Terms"]</dt><dd>@Terms.Label</dd>
                @if (_invoice.EarlyPaymentDiscountDate is { } discountDate)
                {
                    <dt>Discount</dt><dd>@Terms.DiscountPercent.ToString("0.##")% if paid by @Labels.Date(discountDate)</dd>
                }
                @if (_invoice.EstimateId is { } estimateId)
                {
                    <dt class="no-print">@L["From"]</dt><dd class="no-print"><a href="/sales/estimates/@estimateId">@L["Estimate"]</a></dd>
                }
                @if (_lateFees.Count > 0)
                {
                    <dt class="no-print">Late fees on this invoice</dt>
                    <dd class="no-print">
                        @foreach (var fee in _lateFees)
                        {
                            <a href="/sales/invoices/@fee.Id">@fee.Number</a>@(fee.Status == DocumentStatus.Voided ? " (void)" : "") @(" ")
                        }
                    </dd>
                }
                @if (_invoice.LateFeeForInvoiceId is { } overdueId)
                {
                    <dt class="no-print">@L["Late fee on"]</dt><dd class="no-print"><a href="/sales/invoices/@overdueId">@L["Overdue invoice"]</a></dd>
                }
                @if (_invoice.RecurringInvoiceId is { } recurringId)
                {
                    <dt class="no-print">@L["Created by"]</dt><dd class="no-print"><ActionLink Href="@($"/sales/recurring/{recurringId}")">@L["Recurring invoice"]</ActionLink></dd>
                }
            </dl>
        </div>
        <div style="margin-top: 1rem">
            <span class="muted">@L["Bill to"]</span>
            <div><a href="/customers/@_customer.Id">@_customer.DisplayName</a></div>
            @if (_customer.CompanyName is not null && _customer.CompanyName != _customer.DisplayName) { <div>@_customer.CompanyName</div> }
            @if (_customer.BillingAddress is not null) { <div style="white-space: pre-line">@_customer.BillingAddress</div> }
        </div>

        <table class="data" style="margin-top: 1rem">
            <thead><tr><th>@L["Description"]</th><th class="num">@L["Qty"]</th><th class="num">@L["Rate"]</th><th class="num">@L["Amount"]</th></tr></thead>
            <tbody>
                @foreach (var shown in SalesLineGroups.Arrange(_invoice.Lines))
                {
                    if (shown.Line is not { } line)
                    {
                        <tr class="@(shown.Subtotal is null ? "section" : "subtotal")">
                            <td colspan="3"><strong>@shown.Heading</strong></td>
                            <td class="num">@(shown.Subtotal is { } subtotal ? Labels.Amount(subtotal) : "")</td>
                        </tr>
                        continue;
                    }
                    <tr>
                        <td>
                            @line.Description
                            @if (line.Lots is { } lots)
                            {
                                <div class="muted">@lots</div>
                            }
                            <LineFields DocumentId="_invoice.Id" LineNumber="line.LineNumber" />
                        </td>
                        <td class="num">@(line.ItemId is null ? "" : line.Quantity.ToString("0.####"))</td>
                        <td class="num">@(line.ItemId is null ? "" : line.Rate.ToString("#,##0.00##"))<PriceNote Line="line" /></td>
                        <td class="num">@Labels.AmountOrBlank(line.Amount)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @foreach (var t in FormService.TaxTotals(_invoice.Lines, _invoice.TaxCodeId, _invoice.TaxExemption))
                {
                    <tr><td colspan="3">@t.Label</td><td class="num">@Labels.Amount(t.Amount)</td></tr>
                }
                <tr><td colspan="3">@L["Total"]</td><td class="num">@Labels.Amount(_invoice.Total)</td></tr>
                @if (_invoice.AmountPaid > 0m)
                {
                    <tr><td colspan="3">@L["Paid and credited"]</td><td class="num">-@Labels.Amount(_invoice.AmountPaid)</td></tr>
                }
                <tr><td colspan="3">@L["Balance due"]</td><td class="num">@Labels.Amount(_invoice.Balance)</td></tr>
                @if (FormService.Savings(_invoice.Lines) is var saved and > 0m)
                {
                    <tr class="muted"><td colspan="3">@L["You saved"]</td><td class="num">@Labels.Amount(saved)</td></tr>
                }
            </tfoot>
        </table>
        @if (_invoice.Memo is not null)
        {
            <p style="white-space: pre-line; margin-top: 1rem">@_invoice.Memo</p>
        }
    </div>

    @if (_payments.Count > 0)
    {
        <div class="no-print">
            <h2>@L["Payments"]</h2>
            <table class="data">
                <thead><tr><th>@L["Date"]</th><th>@L["Ref"]</th><th class="num">@L["Applied to this invoice"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in _payments)
                    {
                        <tr class="@(p.Status == DocumentStatus.Voided ? "inactive" : null)">
                            <td><a href="/sales/payments/@p.Id">@Labels.Date(p.Date)</a></td>
                            <td>@p.Reference</td>
                            <td class="num">@Labels.Amount(p.Applications.Single(a => a.InvoiceId == _invoice.Id).Settled)</td>
                            <td>@(p.Status == DocumentStatus.Voided ? "Voided" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_credits.Count > 0)
    {
        <div class="no-print">
            <h2>@L["Credits applied"]</h2>
            <table class="data">
                <thead><tr><th>@L["Credit memo"]</th><th>@L["Applied on"]</th><th class="num">@L["Applied to this invoice"]</th></tr></thead>
                <tbody>
                    @foreach (var c in _credits)
                    {
                        var application = c.Applications.Single(a => a.InvoiceId == _invoice.Id);
                        <tr>
                            <td><a href="/sales/credit-memos/@c.Id">@c.Number</a></td>
                            <td>@Labels.Date(application.AppliedOn)</td>
                            <td class="num">@Labels.Amount(application.Amount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_writeOffs.Count > 0)
    {
        <div class="no-print">
            <h2>@L["Written off"]</h2>
            <table class="data">
                <thead><tr><th>@L["Date"]</th><th>@L["Status"]</th><th class="num">@L["Amount"]</th></tr></thead>
                <tbody>
                    @foreach (var w in _writeOffs)
                    {
                        <tr class="@(w.Status == DocumentStatus.Voided ? "inactive" : null)">
                            <td><a href="/sales/write-offs/@w.Id">@Labels.Date(w.Date)</a></td>
                            <td>@(w.Status == DocumentStatus.Voided ? "Voided" : "Bad debt")</td>
                            <td class="num">@Labels.Amount(w.Amount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_reminders.Count > 0)
    {
        <p class="muted no-print">
            Payment reminders sent: @string.Join("; ", _reminders.Select(r => $"{r.SentAt.InCompanyTime():g} to {r.To}")).
        </p>
    }

    @if (_scheduled.Count > 0)
    {
        <section class="no-print" id="scheduled-emails">
            <h2>Scheduled emails</h2>
            @if (EmailError is not null)
            {
                <div class="alert error" role="alert">@EmailError</div>
            }
            <ScheduledEmailTable Emails="_scheduled" Back="@($"/sales/invoices/{Id}")" />
        </section>
    }

    <DocumentChangeList Changes="_changes" />

    <p class="muted no-print" style="margin-top: 1rem"><a href="/journal/@_invoice.JournalEntryId">@L["Journal entry"]</a></p>

    @if (_invoice.Status == DocumentStatus.Posted)
    {
        <div class="card no-print">
            <h2>@L["Void this invoice"]</h2>
            <p class="muted">
                @(_invoice.AmountPaid > 0m
                    ? "This invoice has payments, credits or write-offs applied. Void or remove those first."
                    : "Voiding reverses its journal entry on the same date and removes it from the customer's balance.")
            </p>
            @if (_invoice.AmountPaid == 0m)
            {
                <EditForm Model="VoidInput" FormName="void" OnValidSubmit="VoidAsync" method="post">
                    <DataAnnotationsValidator />
                    <div class="field">
                        <label for="reason">@L["Reason"]</label>
                        <InputText id="reason" @bind-Value="VoidInput.Reason" />
                        <ValidationMessage For="() => VoidInput.Reason" />
                    </div>
                    <ClosedPeriodPassword Visible="_needsClosingPassword" Interactive="false" Name="VoidInput.ClosingPassword" />
                    <button type="submit" class="danger">@L["Void invoice"]</button>
                </EditForm>
            }
        </div>
    }

    <OnlinePaymentPanel InvoiceId="_invoice.Id" IsOpen="_invoice.IsOpen" />

    <EntryTags EntryId="_invoice.JournalEntryId" />

    <Attachments EntityType="invoice" EntityId="_invoice.Id" />

    <CustomFieldPanel EntityType="invoice" EntityId="_invoice.Id" />

    <EmailHistory EntityType="invoice" EntityId="_invoice.Id" />

    <Notes EntityType="invoice" EntityId="_invoice.Id" />
</div>

@code {
    private IReadOnlyList<Invoice> _lateFees = [];
    private Func<StockPlace, string> _place = _ => "";
    private Invoice? _invoice;
    private Customer? _customer;
    private OpenBook.Domain.Companies.Company? _company;
    private IReadOnlyList<CustomerPayment> _payments = [];
    private string? _error;
    private IReadOnlyList<CreditMemo> _credits = [];
    private IReadOnlyList<BadDebtWriteOff> _writeOffs = [];
    private IReadOnlyList<InvoiceReminder> _reminders = [];
    private IReadOnlyList<ScheduledEmail> _scheduled = [];
    private IReadOnlyList<DocumentChange> _changes = [];

    [SupplyParameterFromQuery(Name = "error")] private string? EmailError { get; set; }
    private Guid? _billTo;
    private bool _needsClosingPassword;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "void")]
    private VoidModel VoidInput { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        VoidInput ??= new();
        _place = await WarehouseService.NamerAsync();
        _invoice = await Invoices.GetAsync(Id);
        _lateFees = await Invoices.LateFeesOnAsync(Id);
        if (_invoice is null)
            return;
        _customer = await CustomerService.GetAsync(_invoice.CustomerId);
        _company = await Settings.GetAsync();
        _payments = await Invoices.ListPaymentsAsync(Id);
        _credits = await Invoices.ListCreditsAsync(Id);
        _writeOffs = await WriteOffs.ListForInvoiceAsync(Id);
        _reminders = await Reminders.ForInvoiceAsync(Id);
        _scheduled = await ScheduledEmails.ListAsync(Id);
        _changes = await Invoices.ChangesAsync(Id);
        if (_customer is { BillWithParent: true, ParentId: { } parentId })
            _billTo = parentId;
    }

    private PaymentTerms Terms => new(
        _invoice!.DueDate.DayNumber - _invoice.Date.DayNumber,
        _invoice.EarlyPaymentDiscountPercent,
        _invoice.EarlyPaymentDiscountDate is { } d ? d.DayNumber - _invoice.Date.DayNumber : 0);

    private async Task VoidAsync()
    {
        try
        {
            ClosingOverride.Password = VoidInput.ClosingPassword;
            await Invoices.VoidAsync(Id, VoidInput.Reason);
            Navigation.NavigateTo($"/sales/invoices/{Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword = ClosedPeriod.NeedsPassword(ex);
        }
    }

    private sealed class VoidModel
    {
        [Required(ErrorMessage = "Say why the invoice is being voided.")]
        [StringLength(500)]
        public string Reason { get; set; } = string.Empty;

        public string? ClosingPassword { get; set; }
    }
}
