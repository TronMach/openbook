@page "/sales/billable"
@inject BillableExpenseService Billables
@inject CustomerService CustomerService

<PageTitle>Billable expenses · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Billable expenses</h1>
        <ActionLink Class="button secondary" Href="/sales">Back to sales</ActionLink>
    </div>
    <p class="muted">
        Costs on bills and expenses marked to be passed on to a customer. Make a line billable from its bill or expense page; add it to an
        invoice by ticking it on a new invoice for that customer.
    </p>

    @if (_open.Count == 0)
    {
        <div class="card"><p>Nothing waiting to be billed.</p></div>
    }
    else
    {
        @foreach (var group in _open.GroupBy(b => b.CustomerId).OrderBy(g => _names.GetValueOrDefault(g.Key)))
        {
            <h2>@_names.GetValueOrDefault(group.Key)</h2>
            <table class="data">
                <thead><tr><th>Date</th><th>Cost</th><th>From</th><th class="num">Cost</th><th class="num">Markup</th><th class="num">To bill</th></tr></thead>
                <tbody>
                    @foreach (var b in group)
                    {
                        <tr>
                            <td>@Labels.Date(b.Date)</td>
                            <td>@b.Description</td>
                            <td><a href="@(b.Kind == BillableSource.Bill ? $"/purchases/bills/{b.DocumentId}" : $"/banking/transactions/{b.DocumentId}")#billable">@(b.Kind == BillableSource.Bill ? "Bill" : "Expense")</a></td>
                            <td class="num">@Labels.Amount(b.Cost)</td>
                            <td class="num">@(b.MarkupPercent > 0m ? $"{b.MarkupPercent:0.####}%" : "")</td>
                            <td class="num">@Labels.Amount(b.Amount)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><td colspan="5"><ActionLink Href="@($"/sales/invoices/new?customer={group.Key}")">Invoice them</ActionLink></td><td class="num">@Labels.Amount(group.Sum(b => b.Amount))</td></tr>
                </tfoot>
            </table>
        }
    }
</div>

@code {
    private IReadOnlyList<BillableExpense> _open = [];
    private IReadOnlyDictionary<Guid, string> _names = new Dictionary<Guid, string>();

    protected override async Task OnInitializedAsync()
    {
        _open = (await Billables.ListAsync()).Where(b => b.InvoiceId is null && b.IsBillable).ToList();
        _names = await CustomerService.FullNamesAsync();
    }
}
