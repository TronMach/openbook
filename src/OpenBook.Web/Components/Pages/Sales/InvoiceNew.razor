@page "/sales/invoices/new"
@rendermode InteractiveServer
@inject Operations Ops
@inject NavigationManager Navigation

<PageTitle>@L["New invoice"] · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>@L["New invoice"]</h1>
        <ActionLink Class="button secondary" Href="/sales">@L["Back to sales"]</ActionLink>
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    @if (_loaded && (_customers.Count == 0 || _items.Count == 0))
    {
        <div class="card">
            <p>
                Invoices need a customer and at least one product or service.
                @if (_customers.Count == 0) { <ActionLink Href="/customers/new">Add a customer</ActionLink> }
                @if (_customers.Count == 0 && _items.Count == 0) { <span> and </span> }
                @if (_items.Count == 0) { <ActionLink Href="/items/new">add a product or service</ActionLink> }.
            </p>
        </div>
    }
    else if (_loaded)
    {
        <div class="card">
            <div class="row">
                <div class="field">
                    <label for="customer">@L["Customer"]</label>
                    <SearchSelect Id="customer" Options="PickerOptions.Customers(_customers)" Value="_customerId" OnChange="PickCustomer" Placeholder="Choose a customer…" />
                    @if (_customer?.BillingAddress is { } address)
                    {
                        <span class="hint" style="white-space: pre-line">@address</span>
                    }
                </div>
                <div class="field">
                    <label for="number">@L["Invoice number"]</label>
                    <input id="number" @bind="_number" maxlength="20" />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="date">@L["Invoice date"]</label>
                    <input id="date" type="date" value="@_date.ToString("yyyy-MM-dd")" @onchange="ChangeDate" />
                </div>
                <div class="field">
                    <label for="due">Due date @(_customer is { } c2 ? $"({c2.Terms.Label})" : "")</label>
                    <input id="due" type="date" @bind="_dueDate" />
                </div>
            </div>

            <SalesTaxField Choices="_taxCodes" @bind-Value="_taxCodeId" CustomerCodeOff="@(TaxCustomer?.TaxCodeId is { } own && _taxCodes.All(c => c.Code.Id != own))" Exemption="@TaxExemption" Expired="TaxExemptionExpired" />

            <SalesLinesEditor Classes="_segments.ClassColumn" Lines="_lines" Items="_items" OnChange="StateHasChanged" CustomerId="_customerId" Date="_date" Tax="SelectedTax" Exempt="@(TaxExemption is not null)" />

            @if (_billable.Count > 0)
            {
                <fieldset style="margin-top: 1rem">
                    <legend>@L["Billable expenses for this customer"]</legend>
                    @foreach (var b in _billable)
                    {
                        <label class="check">
                            <input type="checkbox" checked="@_chosenBillable.Contains(b.Id)" @onchange="e => ToggleBillable(b.Id, e)" />
                            <span>@Whose(b.CustomerId)@Labels.Date(b.Date) · @b.Description · @Labels.Amount(b.Amount)@(b.MarkupPercent > 0m ? $" (cost {Labels.Amount(b.Cost)} + {b.MarkupPercent:0.####}%)" : "")</span>
                        </label>
                    }
                    <span class="hint">Ticked costs are added as "Billable Expenses" lines when you save: @Labels.Amount(BillableTotal) more on this invoice.</span>
                </fieldset>
            }

            @if (_time.Count > 0 || _trips.Count > 0)
            {
                <fieldset style="margin-top: 1rem">
                    <legend>@L["Billable time and mileage for this customer"]</legend>
                    @foreach (var t in _time)
                    {
                        <label class="check">
                            <input type="checkbox" checked="@_chosenTime.Contains(t.Id)" @onchange="e => Toggle(_chosenTime, t.Id, e)" />
                            <span>@Whose(t.CustomerId)@Labels.Date(t.Date) · @(_workerNames.GetValueOrDefault(t.WorkerId)) · @Labels.Quantity(t.Hours) h × @Labels.Price(t.BillRate) = @Labels.Amount(t.Amount)@(t.Notes is { } n ? $" · {n}" : "")</span>
                        </label>
                    }
                    @foreach (var m in _trips)
                    {
                        <label class="check">
                            <input type="checkbox" checked="@_chosenTrips.Contains(m.Id)" @onchange="e => Toggle(_chosenTrips, m.Id, e)" />
                            <span>@Whose(m.CustomerId)@Labels.Date(m.Date) · @m.Purpose · @Labels.Quantity(m.Miles) mi × @Labels.Price(m.BillRate) = @Labels.Amount(m.Amount)</span>
                        </label>
                    }
                    <span class="hint">Ticked time and trips are added as lines when you save: @Labels.Amount(ProjectTotal) more on this invoice. Work for more than one project is grouped by project, each with a subtotal.</span>
                </fieldset>
            }

            <MoreOptions HasContent="@(_segments.Locations.Count > 0 || _warehouses.Count > 1)" Open="@(_locationId is not null || _warehouseId is not null)">
                <LocationField Options="_segments" @bind-Value="_locationId" />
                <WarehouseField Warehouses="_warehouses" @bind-Value="_warehouseId" />
            </MoreOptions>
            <div class="field" style="margin-top: 1rem">
                <label for="memo">@L["Message to customer"] <span class="muted">@L["(optional, printed on the invoice)"]</span></label>
                <textarea id="memo" rows="2" @bind="_memo" maxlength="1000"></textarea>
            </div>

            <ClosedPeriodPassword Visible="_needsClosingPassword" @bind-Value="_closingPassword" />


            <div class="actions">
                <button type="button" @onclick="SaveAsync" disabled="@(!CanSave || _busy)">@L["Save invoice"]</button>
                <a href="/sales">@L["Cancel"]</a>
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<Customer> _customers = [];
    private IReadOnlyList<Item> _items = [];
    private Customer? _customer;
    private Guid? _customerId;
    private string? _number;
    private DateOnly _date = CompanyTime.Today;
    private DateOnly _dueDate = CompanyTime.Today;
    private string? _memo;
    private List<SalesLineModel> _lines = [new()];
    private bool _loaded;
    private bool _busy;
    private string? _error;
    private bool _needsClosingPassword;
    private string? _closingPassword;

    private IReadOnlyList<TaxCodeChoice> _taxCodes = [];
    private Guid? _taxCodeId;

    private TaxCodeChoice? SelectedTax => _taxCodes.FirstOrDefault(c => c.Code.Id == _taxCodeId);
    private Customer? TaxCustomer => _customer;
    private string? TaxExemption => SelectedTax is null ? null : CustomerTree.ExemptionOn(TaxCustomer, _date, _customers);
    private bool TaxExemptionExpired => SelectedTax is not null && TaxCustomer?.ExemptionCertificate is not null && TaxExemption is null;

    /// <summary>Starts the document with the customer's tax code, when it can be charged.</summary>
    private void DefaultTaxCode() =>
        _taxCodeId = TaxCustomer?.TaxCodeId is { } code && _taxCodes.Any(c => c.Code.Id == code) ? code : null;

    private Task<IReadOnlyList<TaxCodeChoice>> LoadTaxCodesAsync() =>
        Ops.RunAsync(sp => sp.GetRequiredService<SalesTaxService>().ListChoicesAsync());

    [SupplyParameterFromQuery(Name = "customer")]
    private Guid? PresetCustomer { get; set; }

    /// <summary>An item to start the first line with ("New transaction" in the Item Center).</summary>
    [SupplyParameterFromQuery(Name = "item")]
    private Guid? PresetItem { get; set; }

    /// <summary>An invoice to start from ("Copy" on its page).</summary>
    [SupplyParameterFromQuery(Name = "copy")]
    private Guid? Copy { get; set; }

    private bool CanSave => _customer is not null && SalesLineModel.Total(_lines) + BillableTotal + ProjectTotal > 0m && !string.IsNullOrWhiteSpace(_number);

    private IReadOnlyList<BillableExpense> _billable = [];
    private readonly HashSet<Guid> _chosenBillable = [];

    private decimal BillableTotal => _billable.Where(b => _chosenBillable.Contains(b.Id)).Sum(b => b.Amount);

    private IReadOnlyList<TimeEntry> _time = [];
    private IReadOnlyList<MileageTrip> _trips = [];
    private IReadOnlyDictionary<Guid, string> _workerNames = new Dictionary<Guid, string>();
    private readonly HashSet<Guid> _chosenTime = [];
    private readonly HashSet<Guid> _chosenTrips = [];

    private decimal ProjectTotal => _time.Where(t => _chosenTime.Contains(t.Id)).Sum(t => t.Amount) + _trips.Where(m => _chosenTrips.Contains(m.Id)).Sum(m => m.Amount);

    private static void Toggle(HashSet<Guid> chosen, Guid id, ChangeEventArgs e)
    {
        if (e.Value is true)
            chosen.Add(id);
        else
            chosen.Remove(id);
    }

    private void ToggleBillable(Guid id, ChangeEventArgs e)
    {
        if (e.Value is true)
            _chosenBillable.Add(id);
        else
            _chosenBillable.Remove(id);
    }

    private SegmentOptions _segments = SegmentOptions.None;
    private IReadOnlyList<Warehouse> _warehouses = [];
    private Guid? _warehouseId;

    private Guid? _locationId;


    protected override async Task OnInitializedAsync()
    {

        _segments = await Ops.RunAsync(SegmentOptions.LoadAsync);
        _warehouses = await Ops.RunAsync(sp => sp.GetRequiredService<OpenBook.Application.Inventory.WarehouseService>().ListAsync());
        _taxCodes = await LoadTaxCodesAsync();
        (_customers, _items, _number) = await Ops.RunAsync(async sp => (
            (IReadOnlyList<Customer>)(await sp.GetRequiredService<CustomerService>().ListAsync(_date)).Select(s => s.Customer).ToList(),
            await sp.GetRequiredService<ItemService>().ListAsync(),
            await sp.GetRequiredService<InvoiceService>().SuggestNumberAsync()));
        if (Copy is { } copyId && await Ops.RunAsync(sp => sp.GetRequiredService<InvoiceService>().GetAsync(copyId)) is { } source)
        {
            // "Copy": the same customer, lines and settings, dated today with the next number.
            await SetCustomerAsync(source.CustomerId);
            _lines = SalesLineModel.CopiesOf(source.Lines);
            _memo = source.Memo;
            _taxCodeId = source.TaxCodeId is { } code && _taxCodes.Any(c => c.Code.Id == code) ? code : _taxCodeId;
            _locationId = source.LocationId;
            _warehouseId = source.WarehouseId;
        }
        else if (PresetCustomer is { } preset)
            await SetCustomerAsync(preset);
        if (Copy is null && _items.FirstOrDefault(i => i.Id == PresetItem && i.IsActive) is { } presetItem)
            _lines = [SalesLineModel.ForItem(presetItem)];
        _loaded = true;
    }

    private Task PickCustomer(ChangeEventArgs e) => SetCustomerAsync(Guid.TryParse(e.Value as string, out var id) ? id : null);

    /// <summary>"Remodel · " before a project's work on its client's invoice (lines are grouped by project).</summary>
    private string Whose(Guid? customerId) =>
        customerId is { } c && c != _customerId ? (_customers.FirstOrDefault(x => x.Id == c)?.DisplayName ?? "Project") + " · " : "";

    private async Task SetCustomerAsync(Guid? id)
    {
        _customerId = id;
        _customer = _customers.FirstOrDefault(c => c.Id == id);
        if (_customer is not null)
            _dueDate = _customer.DueDateFor(_date);
        DefaultTaxCode();
        _chosenBillable.Clear();
        _billable = id is { } customerId
            ? await Ops.RunAsync(sp => sp.GetRequiredService<BillableExpenseService>().OpenAsync(customerId))
            : [];
        _chosenTime.Clear();
        _chosenTrips.Clear();
        if (id is { } forCustomer)
        {
            (_time, _trips, _workerNames) = await Ops.RunAsync(async sp => (
                await sp.GetRequiredService<TimeService>().OpenAsync(forCustomer),
                await sp.GetRequiredService<MileageService>().OpenAsync(forCustomer),
                (IReadOnlyDictionary<Guid, string>)(await sp.GetRequiredService<WorkerService>().ListAsync(includeInactive: true)).ToDictionary(w => w.Id, w => w.Name)));
        }
        else
        {
            (_time, _trips) = ([], []);
        }
    }

    private void ChangeDate(ChangeEventArgs e)
    {
        if (!DateOnly.TryParse(e.Value as string, System.Globalization.CultureInfo.InvariantCulture, out var date))
            return;
        _date = date;
        _dueDate = _customer?.DueDateFor(date) ?? (_dueDate < date ? date : _dueDate);
    }

    private async Task SaveAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            var command = new CreateInvoiceCommand(_customer!.Id, _date, SalesLineModel.Drafts(_lines), _dueDate, _number, _memo, TaxCodeId: _taxCodeId ?? Guid.Empty, LocationId: _locationId, WarehouseId: _warehouseId,
                BillableExpenseIds: [.. _chosenBillable], TimeEntryIds: [.. _chosenTime], MileageTripIds: [.. _chosenTrips]);
            var invoice = await Ops.RunAsync<InvoiceService, Invoice>(s => s.CreateAsync(command), _closingPassword);
            Navigation.NavigateTo($"/sales/invoices/{invoice.Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword |= ClosedPeriod.NeedsPassword(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
