@page "/sales/orders"
@inject SalesOrderService Orders
@inject CustomerService CustomerService

<PageTitle>Sales orders · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Sales orders</h1>
        <a class="button secondary" href="/sales">Back to sales</a>
        <a class="button secondary" href="@(ShowAll ? "/sales/orders" : "/sales/orders?showAll=true")">@(ShowAll ? "Open only" : "Show all")</a>
        <a class="button" href="/sales/orders/new">New sales order</a>
    </div>
    <p class="muted">Orders post nothing. Invoice them in full or in parts as you deliver; an order closes once every line is invoiced.</p>

    @if (_orders.Count == 0)
    {
        <div class="card"><p>@(ShowAll ? "No sales orders yet." : "No open sales orders.") <a href="/sales/orders/new">Enter one</a>.</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>No.</th><th>Date</th><th>Customer</th><th>Customer PO</th><th>Expected</th><th>Status</th><th class="num">Total</th></tr></thead>
                <tbody>
                    @foreach (var o in _orders)
                    {
                        <tr class="@(o.Status == SalesOrderStatus.Cancelled ? "inactive" : null)">
                            <td><a href="/sales/orders/@o.Id">@o.Number</a></td>
                            <td>@Labels.Date(o.Date)</td>
                            <td>@_names.GetValueOrDefault(o.CustomerId)</td>
                            <td>@o.CustomerReference</td>
                            <td>@(o.ExpectedDate is { } e ? Labels.Date(e) : "")</td>
                            <td>@o.Status</td>
                            <td class="num">@Labels.Amount(o.Total)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<SalesOrder> _orders = [];
    private IReadOnlyDictionary<Guid, string> _names = new Dictionary<Guid, string>();

    [SupplyParameterFromQuery] private bool ShowAll { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _orders = (await Orders.ListAsync()).Where(o => ShowAll || o.Status == SalesOrderStatus.Open).ToList();
        _names = await CustomerService.FullNamesAsync();
    }
}
