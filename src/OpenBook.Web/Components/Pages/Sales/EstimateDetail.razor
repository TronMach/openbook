@page "/sales/estimates/{Id:guid}"
@inject EstimateService Estimates
@inject CustomerService CustomerService
@inject CompanySettingsService Settings
@inject NavigationManager Navigation

<PageTitle>Estimate @(_estimate?.Number) · OpenBook</PageTitle>

@if (_estimate is null || _customer is null || _company is null || _progress is null)
{
    <div class="card"><p>That estimate doesn't exist. <a href="/sales?show=estimates">Back to estimates</a>.</p></div>
    return;
}

<div class="wide">
    @{
        var today = CompanyTime.Today;
        var open = _estimate.Status is EstimateStatus.Pending or EstimateStatus.Accepted;
    }
    <div class="toolbar">
        <h1>Estimate @_estimate.Number</h1>
        <span class="badge @(_estimate.Status == EstimateStatus.Accepted ? "ok" : _estimate.IsExpired(today) || _estimate.Status == EstimateStatus.Declined ? "warn" : null)">
            @(_estimate.IsExpired(today) ? "Expired" : Labels.For(_estimate.Status))
        </span>
        <ActionLink Class="button secondary" Href="/sales?show=estimates">Back to estimates</ActionLink>
        <a class="button secondary" href="/api/sales/estimates/@_estimate.Id/pdf" target="_blank">PDF</a>
        <PrintButtons Document="OpenBook.Domain.Companies.FormDocuments.Estimate" Id="_estimate.Id" PdfUrl="@($"/api/sales/estimates/{_estimate.Id}/pdf")" />
        <ActionLink Class="button secondary" Href="@($"/sales/email/estimates/{_estimate.Id}")">Email</ActionLink>
        <ActionLink Class="button secondary" Href="@($"/audit?entityId={_estimate.Id}")">History</ActionLink>
        @if (_estimate.Status != EstimateStatus.Closed && !_progress.Started)
        {
            <ActionLink Class="button secondary" Href="@($"/sales/estimates/{_estimate.Id}/edit")">Edit</ActionLink>
        }
    </div>

    @if ((_error ?? Error) is { } error)
    {
        <div class="alert error no-print" role="alert">@error</div>
    }
    @if (_estimate.InvoiceId is { } invoiceId && !_progress.Started)
    {
        <div class="alert notice no-print" role="status">Invoiced: <a href="/sales/invoices/@invoiceId">see the invoice</a>.</div>
    }
    @if (_estimate.LastEmailedAt is { } emailed)
    {
        <p class="muted no-print">Emailed @emailed.InCompanyTime().ToString("g").</p>
    }

    <SalesDocument DocumentId="_estimate.Id" Company="_company" Customer="_customer" CustomerLabel="Prepared for" Facts="Facts" Lines="_estimate.Lines"
                   Totals="Totals" Memo="@_estimate.Memo" />

    @if (_progress.Invoices.Count > 0)
    {
        <h2 class="no-print">Invoices</h2>
        <table class="data no-print">
            <thead><tr><th>Invoice</th><th>Date</th><th>Status</th><th class="num">Before tax</th></tr></thead>
            <tbody>
                @foreach (var i in _progress.Invoices)
                {
                    <tr class="@(i.Status == DocumentStatus.Voided ? "inactive" : null)">
                        <td><a href="/sales/invoices/@i.Id">@i.Number</a></td>
                        <td>@Labels.Date(i.Date)</td>
                        <td>@(i.Status == DocumentStatus.Voided ? "Voided" : Labels.Status(i, today))</td>
                        <td class="num">@Labels.Amount(i.Subtotal)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><td colspan="3">Invoiced so far, of @Labels.Amount(_estimate.Subtotal)</td><td class="num">@Labels.Amount(_progress.InvoicedSubtotal)</td></tr>
            </tfoot>
        </table>
    }

    @if (open)
    {
        <PartialInvoiceForm Lines="_estimate.Lines" Progress="_progress" Action="@($"/sales/estimates/{_estimate.Id}/invoice")" AllowPercent="true"
                            Title="Turn into an invoice" Password="Password"
                            Hint="Invoice it all at once, or in progress invoices (a percentage, or the quantities done so far). The estimate closes once everything is invoiced, and can't be edited after the first progress invoice." />
    }
    @if (_estimate.Status != EstimateStatus.Closed)
    {
        <form method="post" @formname="status" @onsubmit="SetStatusAsync" class="no-print actions">
            <AntiforgeryToken />
            <span class="muted">Mark as</span>
            @foreach (var status in new[] { EstimateStatus.Pending, EstimateStatus.Accepted, EstimateStatus.Declined }.Where(s => s != _estimate.Status))
            {
                <button type="submit" class="secondary" name="NewStatus" value="@status">@Labels.For(status)</button>
            }
        </form>
    }

    <Attachments EntityType="estimate" EntityId="_estimate.Id" />

    <CustomFieldPanel EntityType="estimate" EntityId="_estimate.Id" />

    <Notes EntityType="estimate" EntityId="_estimate.Id" />
</div>

@code {
    private Estimate? _estimate;
    private Customer? _customer;
    private OpenBook.Domain.Companies.Company? _company;
    private string? _error;
    private InvoicingProgress? _progress;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private bool Password { get; set; }

    [SupplyParameterFromForm(FormName = "status")]
    private EstimateStatus? NewStatus { get; set; }

    private List<(string, decimal)> Totals =>
        [.. FormService.TaxTotals(_estimate!.Lines, _estimate.TaxCodeId, _estimate.TaxExemption).Select(t => (t.Label, t.Amount)), ("Total", _estimate.Total)];

    private List<(string, string)> Facts
    {
        get
        {
            var facts = new List<(string, string)> { ("Estimate", _estimate!.Number), ("Date", Labels.Date(_estimate.Date)) };
            if (_estimate.ExpirationDate is { } expires)
                facts.Add(("Valid until", Labels.Date(expires)));
            return facts;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _estimate = await Estimates.GetAsync(Id);
        if (_estimate is null)
            return;
        _customer = await CustomerService.GetAsync(_estimate.CustomerId);
        _company = await Settings.GetAsync();
        _progress = await Estimates.ProgressAsync(Id);
    }

    private async Task SetStatusAsync()
    {
        try
        {
            if (NewStatus is { } status)
                await Estimates.SetStatusAsync(Id, status);
            Navigation.NavigateTo($"/sales/estimates/{Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }
}
