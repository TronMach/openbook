@page "/sales"
@inject ISalesStore Store
@inject OpenBook.Application.Companies.ICompanyStore Companies

<PageTitle>Sales · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Sales</h1>
        <ActionLink Class="button secondary" Href="/sales/payments/new">Receive payment</ActionLink>
        <ActionLink Class="button" Href="/sales/invoices/new">New invoice</ActionLink>
    </div>
    <div class="hub-actions">
        <div class="hub-group"><span class="hub-label">Create</span>
            <ActionLink Class="button secondary" Href="/sales/estimates/new">Estimate</ActionLink>
            <ActionLink Class="button secondary" Href="/sales/receipts/new">Sales receipt</ActionLink>
            <ActionLink Class="button secondary" Href="/sales/credit-memos/new">Credit memo</ActionLink>
        </div>
        <div class="hub-group"><span class="hub-label">Lists</span>
            <ActionLink Class="button secondary" Href="/customers">@_terms.Customers</ActionLink>
            <ActionLink Class="button secondary" Href="/items">Products and services</ActionLink>
            <ActionLink Class="button secondary" Href="/sales/orders">Sales orders</ActionLink>
            <ActionLink Class="button secondary" Href="/sales/retainers">Retainers</ActionLink>
            <ActionLink Class="button secondary" Href="/sales/recurring">Recurring invoices</ActionLink>
            <ActionLink Class="button secondary" Href="/sales/billable">Billable expenses</ActionLink>
            <ActionLink Class="button secondary" Href="/sales/scheduled-emails">Scheduled emails</ActionLink>
        </div>
        <div class="hub-group"><span class="hub-label">Tools</span>
            <ActionLink Class="button secondary" Href="/sales/collections">Collections</ActionLink>
            <ActionLink Class="button secondary" Href="/sales/channels">Sales channels</ActionLink>
            <ActionLink Class="button secondary" Href="/documents">Document inbox</ActionLink>
            <ActionLink Class="button secondary" Href="/print">Print</ActionLink>
        </div>
        <div class="hub-group"><span class="hub-label">Set up</span>
            <ActionLink Class="button secondary" Href="/pricing">Pricing</ActionLink>
            <ActionLink Class="button secondary" Href="/sales-tax">Sales tax</ActionLink>
        </div>
    </div>

    <div class="summary-bar">
        <div><span class="label">Unpaid invoices</span><span class="value">@Labels.Amount(_open.Sum(i => i.Balance))</span></div>
        <div><span class="label">Overdue</span><span class="value @(Overdue > 0m ? "off" : null)">@Labels.Amount(Overdue)</span></div>
        <div><span class="label">Paid in the last 30 days</span><span class="value">@Labels.Amount(_paidLately)</span></div>
    </div>

    <nav class="toolbar" aria-label="Show">
        @foreach (var (key, label) in Tabs)
        {
            <a class="button @(Show == key ? null : "secondary")" href="/sales?show=@key">@label</a>
        }
    </nav>

    @switch (Show)
    {
        case "estimates":
            @if (_estimates.Count == 0)
            {
                <div class="card"><p>No estimates yet. <ActionLink Href="/sales/estimates/new">Create one</ActionLink>.</p></div>
            }
            else
            {
                <table class="data">
                    <thead><tr><th>No.</th><th>Customer</th><th>Date</th><th>Valid until</th><th>Status</th><th class="num">Total</th></tr></thead>
                    <tbody>
                        @foreach (var e in _estimates)
                        {
                            <tr class="@(e.Status is EstimateStatus.Closed or EstimateStatus.Declined ? "inactive" : null)">
                                <td><a href="/sales/estimates/@e.Id">@e.Number</a></td>
                                <td>@Customer(e.CustomerId)</td>
                                <td>@Labels.Date(e.Date)</td>
                                <td>@(e.ExpirationDate is { } x ? Labels.Date(x) : "")</td>
                                <td><span class="badge @(e.IsExpired(_today) ? "warn" : e.Status == EstimateStatus.Accepted ? "ok" : null)">@(e.IsExpired(_today) ? "Expired" : Labels.For(e.Status))</span></td>
                                <td class="num">@Labels.Amount(e.Total)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <ShowMore Shown="_estimates.Count" Total="_total" Href="/sales?show=estimates" />
            }
            break;
        case "credits":
            <table class="data">
                <thead><tr><th>Date</th><th>Credit memo</th><th>Customer</th><th class="num">Total</th><th class="num">Available</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in _creditMemos)
                    {
                        <tr class="@(c.Status == DocumentStatus.Voided ? "inactive" : null)">
                            <td>@Labels.Date(c.Date)</td>
                            <td><a href="/sales/credit-memos/@c.Id">@c.Number</a></td>
                            <td>@Customer(c.CustomerId)</td>
                            <td class="num">@Labels.Amount(c.Total)</td>
                            <td class="num">@Labels.AmountOrBlank(c.Balance)</td>
                            <td>@(c.Status == DocumentStatus.Voided ? "Voided" : "")</td>
                        </tr>
                    }
                    @if (_creditMemos.Count == 0)
                    {
                        <tr><td colspan="6" class="muted">No credit memos.</td></tr>
                    }
                </tbody>
            </table>
            <ShowMore Shown="_creditMemos.Count" Total="_total" Href="/sales?show=credits" />
            @if (_refunds.Count > 0)
            {
                <h2>Refunds</h2>
                <table class="data">
                    <thead><tr><th>Date</th><th>Customer</th><th>Ref</th><th class="num">Amount</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in _refunds)
                        {
                            <tr class="@(r.Status == DocumentStatus.Voided ? "inactive" : null)">
                                <td><a href="/sales/refunds/@r.Id">@Labels.Date(r.Date)</a></td>
                                <td>@Customer(r.CustomerId)</td>
                                <td>@r.Reference</td>
                                <td class="num">@Labels.Amount(r.Amount)</td>
                                <td>@(r.Status == DocumentStatus.Voided ? "Voided" : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <ShowMore Shown="_refunds.Count" Total="_refundTotal" Href="/sales?show=credits" />
            }
            break;
        case "payments":
            <table class="data">
                <thead><tr><th>Date</th><th>Customer</th><th>Ref</th><th class="num">Invoices</th><th class="num">Amount</th><th class="num">Unapplied</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in _payments)
                    {
                        <tr class="@(p.Status == DocumentStatus.Voided ? "inactive" : null)">
                            <td><a href="/sales/payments/@p.Id">@Labels.Date(p.Date)</a></td>
                            <td>@Customer(p.CustomerId)</td>
                            <td>@p.Reference</td>
                            <td class="num">@p.Applications.Count</td>
                            <td class="num">@Labels.Amount(p.Amount)</td>
                            <td class="num">@Labels.AmountOrBlank(p.Unapplied)</td>
                            <td>@(p.Status == DocumentStatus.Voided ? "Voided" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <ShowMore Shown="_payments.Count" Total="_total" Href="/sales?show=payments" />
            break;
        case "receipts":
            <table class="data">
                <thead><tr><th>Date</th><th>No.</th><th>Customer</th><th class="num">Total</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in _receipts)
                    {
                        <tr class="@(r.Status == DocumentStatus.Voided ? "inactive" : null)">
                            <td>@Labels.Date(r.Date)</td>
                            <td><a href="/sales/receipts/@r.Id">@r.Number</a></td>
                            <td>@(r.CustomerId is { } c ? Customer(c) : "")</td>
                            <td class="num">@Labels.Amount(r.Total)</td>
                            <td>@(r.Status == DocumentStatus.Voided ? "Voided" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <ShowMore Shown="_receipts.Count" Total="_total" Href="/sales?show=receipts" />
            break;
        default:
            var shown = Show == "all-invoices" ? _invoices : _open;
            @if (shown.Count == 0)
            {
                <div class="card"><p>@(Show == "all-invoices" ? "No invoices yet." : "Nothing unpaid.") <ActionLink Href="/sales/invoices/new">Create an invoice</ActionLink>.</p></div>
            }
            else
            {
                <table class="data">
                    <thead><tr><th>No.</th><th>Customer</th><th>Date</th><th>Due</th><th>Status</th><th class="num">Total</th><th class="num">Balance</th></tr></thead>
                    <tbody>
                        @foreach (var i in shown)
                        {
                            var status = Labels.Status(i, _today);
                            <tr class="@(i.Status == DocumentStatus.Voided ? "inactive" : null)">
                                <td><a href="/sales/invoices/@i.Id">@i.Number</a></td>
                                <td>@Customer(i.CustomerId)</td>
                                <td>@Labels.Date(i.Date)</td>
                                <td>@Labels.Date(i.DueDate)</td>
                                <td><span class="badge @(status == "Overdue" ? "warn" : status == "Paid" ? "ok" : null)">@status</span></td>
                                <td class="num">@Labels.Amount(i.Total)</td>
                                <td class="num">@Labels.Amount(i.Balance)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Show == "all-invoices")
                {
                    <ShowMore Shown="_invoices.Count" Total="_total" Href="/sales?show=all-invoices" />
                }
            }
            break;
    }
</div>

@code {
    private EditionTerms _terms = EditionTerms.Default;

    private static readonly (string Key, string Label)[] Tabs =
        [("open", "Unpaid invoices"), ("all-invoices", "All invoices"), ("estimates", "Estimates"), ("payments", "Payments"), ("credits", "Credits and refunds"), ("receipts", "Sales receipts")];

    private readonly DateOnly _today = CompanyTime.Today;
    private IReadOnlyList<Invoice> _open = [];
    private decimal _paidLately;
    private int _total;
    private int _refundTotal;
    private IReadOnlyList<Invoice> _invoices = [];
    private IReadOnlyList<CustomerPayment> _payments = [];
    private IReadOnlyList<SalesReceipt> _receipts = [];
    private IReadOnlyList<Estimate> _estimates = [];
    private IReadOnlyList<CreditMemo> _creditMemos = [];
    private IReadOnlyList<CustomerRefund> _refunds = [];
    private Dictionary<Guid, string> _customers = [];

    [SupplyParameterFromQuery]
    private string? Show { get; set; }

    /// <summary>How many of the newest documents a tab shows ("Show more" adds a page).</summary>
    [SupplyParameterFromQuery]
    private int? Count { get; set; }

    private decimal Overdue => _open.Where(i => i.IsOverdue(_today)).Sum(i => i.Balance);

    protected override async Task OnInitializedAsync()
    {
        _terms = await Editions.TermsAsync(Companies);
        Show ??= "open";
        var ct = HttpContext?.RequestAborted ?? default;
        var take = RecentDocuments.Clamp(Count);

        // Only what the summary and the chosen tab show: whole histories would make this page slower every year.
        _open = await Store.ListOpenInvoicesAsync(null, ct);
        _paidLately = (await Store.ListPostedPaymentsAsync(_today.AddDays(-29), DateOnly.MaxValue, ct)).Sum(p => p.Amount);
        switch (Show)
        {
            case "all-invoices":
                (_invoices, _total) = await Store.ListRecentInvoicesAsync(0, take, ct);
                break;
            case "estimates":
                (_estimates, _total) = await Store.ListRecentEstimatesAsync(0, take, ct);
                break;
            case "payments":
                (_payments, _total) = await Store.ListRecentPaymentsAsync(0, take, ct);
                break;
            case "credits":
                (_creditMemos, _total) = await Store.ListRecentCreditMemosAsync(0, take, ct);
                (_refunds, _refundTotal) = await Store.ListRecentRefundsAsync(0, take, ct);
                break;
            case "receipts":
                (_receipts, _total) = await Store.ListRecentReceiptsAsync(0, take, ct);
                break;
        }

        _customers = (await Store.ListCustomersAsync(ct)).ToDictionary(c => c.Id, c => c.DisplayName);
    }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string Customer(Guid id) => _customers.GetValueOrDefault(id, "(unknown)");
}
