@page "/sales/receipts/new"
@rendermode InteractiveServer
@inject Operations Ops
@inject NavigationManager Navigation

<PageTitle>New sales receipt · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>New sales receipt</h1>
        <ActionLink Class="button secondary" Href="/sales?show=receipts">Back to sales receipts</ActionLink>
    </div>
    <p class="muted">For sales paid on the spot. To bill now and be paid later, <ActionLink Href="/sales/invoices/new">create an invoice</ActionLink> instead.</p>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    @if (_loaded)
    {
        <FormDraft @ref="_draft" T="Draft" Key="receipt-new" Snapshot="TakeDraft" OnRestore="RestoreAsync" />
        <div class="card">
            <div class="row">
                <div class="field">
                    <label for="customer">Customer <span class="muted">(optional)</span></label>
                    <SearchSelect Id="customer" Options="PickerOptions.Customers(_customers)" CustomerAdded="c => _customers = [.. _customers, c]" @bind-Value="_customerId" @bind-Value:after="DefaultTaxCode" EmptyText="No customer" Placeholder="Type a name or leave blank" />
                </div>
                <div class="field">
                    <label for="number">Receipt number</label>
                    <input id="number" @bind="_number" maxlength="20" />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="date">Date</label>
                    <input id="date" type="date" @bind="_date" />
                </div>
                <div class="field">
                    <label for="reference">Reference / check no. <span class="muted">(optional)</span></label>
                    <input id="reference" @bind="_reference" maxlength="30" />
                </div>
                <PaymentMethodField @bind-Value="_method" />
            </div>

            <SalesTaxField Choices="_taxCodes" @bind-Value="_taxCodeId" CustomerCodeOff="@(TaxCustomer?.TaxCodeId is { } own && _taxCodes.All(c => c.Code.Id != own))" Exemption="@TaxExemption" Expired="TaxExemptionExpired" />

            <SalesLinesEditor Classes="_segments.ClassColumn" Lines="_lines" Items="_items" OnItemAdded="i => _items = [.. _items, i]" OnChange="StateHasChanged" CustomerId="_customerId" Date="_date" Tax="SelectedTax" Exempt="@(TaxExemption is not null)" />

            <MoreOptions Open="@(_depositAccountId != _defaultDepositId || _locationId is not null || _warehouseId is not null)">
                <div class="field">
                    <label for="deposit">Deposit to</label>
                    <select id="deposit" @bind="_depositAccountId">
                        @foreach (var a in _depositAccounts)
                        {
                            <option value="@a.Id">@_chart.FullName(a.Id)</option>
                        }
                    </select>
                </div>
                <LocationField Options="_segments" @bind-Value="_locationId" />
                <WarehouseField Warehouses="_warehouses" @bind-Value="_warehouseId" />
            </MoreOptions>
            <div class="field" style="margin-top: 1rem">
                <label for="memo">Memo <span class="muted">(optional)</span></label>
                <input id="memo" @bind="_memo" maxlength="1000" />
            </div>

            <ClosedPeriodPassword Visible="_needsClosingPassword" @bind-Value="_closingPassword" />


            <div class="actions">
                <button type="button" @onclick="SaveAsync" disabled="@(!CanSave || _busy)">Save sales receipt</button>
                <a href="/sales?show=receipts">Cancel</a>
            </div>
        </div>
    }
</div>

@code {
    // What's typed so far, kept in the tab in case the connection goes.
    internal sealed record Draft(Guid? CustomerId, Guid DepositAccountId, string? Number, DateOnly Date, string? Reference, PaymentMethod? Method, string? Memo,
        Guid? TaxCodeId, Guid? LocationId, Guid? WarehouseId, List<SalesLineModel> Lines);

    private FormDraft<Draft>? _draft;

    private Draft? TakeDraft() => _lines.All(l => l.IsBlank) ? null
        : new Draft(_customerId, _depositAccountId, _number, _date, _reference, _method, _memo, _taxCodeId, _locationId, _warehouseId, _lines);

    private void RestoreAsync(Draft draft)
    {
        _customerId = _customers.Any(c => c.Id == draft.CustomerId) ? draft.CustomerId : null;
        _depositAccountId = _depositAccounts.Any(a => a.Id == draft.DepositAccountId) ? draft.DepositAccountId : _depositAccountId;
        (_number, _date, _reference, _method, _memo, _locationId, _warehouseId) = (draft.Number, draft.Date, draft.Reference, draft.Method, draft.Memo, draft.LocationId, draft.WarehouseId);
        _taxCodeId = _taxCodes.Any(c => c.Code.Id == draft.TaxCodeId) ? draft.TaxCodeId : null;
        _lines = draft.Lines.Count > 0 ? draft.Lines : [new()];
    }

    private IReadOnlyList<Customer> _customers = [];
    private IReadOnlyList<Item> _items = [];
    private ChartOfAccounts _chart = new([]);
    private List<Account> _depositAccounts = [];
    private Guid? _customerId;
    private Guid _depositAccountId;
    private string? _number;
    private DateOnly _date = CompanyTime.Today;
    private string? _reference;
    private PaymentMethod? _method;
    private string? _memo;
    private List<SalesLineModel> _lines = [new()];
    private bool _loaded;
    private bool _busy;
    private string? _error;
    private bool _needsClosingPassword;
    private string? _closingPassword;

    private IReadOnlyList<TaxCodeChoice> _taxCodes = [];
    private Guid? _taxCodeId;

    private TaxCodeChoice? SelectedTax => _taxCodes.FirstOrDefault(c => c.Code.Id == _taxCodeId);
    private Customer? TaxCustomer => _customers.FirstOrDefault(c => c.Id == _customerId);
    private string? TaxExemption => SelectedTax is null ? null : CustomerTree.ExemptionOn(TaxCustomer, _date, _customers);
    private bool TaxExemptionExpired => SelectedTax is not null && TaxCustomer?.ExemptionCertificate is not null && TaxExemption is null;

    /// <summary>Starts the document with the customer's tax code, when it can be charged.</summary>
    private void DefaultTaxCode() =>
        _taxCodeId = TaxCustomer?.TaxCodeId is { } code && _taxCodes.Any(c => c.Code.Id == code) ? code : null;

    private Task<IReadOnlyList<TaxCodeChoice>> LoadTaxCodesAsync() =>
        Ops.RunAsync(sp => sp.GetRequiredService<SalesTaxService>().ListChoicesAsync());

    private bool CanSave => SalesLineModel.Total(_lines) > 0m && _depositAccountId != Guid.Empty && !string.IsNullOrWhiteSpace(_number);

    private SegmentOptions _segments = SegmentOptions.None;
    private IReadOnlyList<Warehouse> _warehouses = [];
    private Guid? _warehouseId;

    private Guid? _locationId;


    protected override async Task OnInitializedAsync()
    {

        _segments = await Ops.RunAsync(SegmentOptions.LoadAsync);
        _warehouses = await Ops.RunAsync(sp => sp.GetRequiredService<OpenBook.Application.Inventory.WarehouseService>().ListAsync());
        _taxCodes = await LoadTaxCodesAsync();
        (_customers, _items, _chart, _number) = await Ops.RunAsync(async sp => (
            (IReadOnlyList<Customer>)(await sp.GetRequiredService<CustomerService>().ListRecordsAsync()).Select(s => s.Customer).ToList(),
            await sp.GetRequiredService<ItemService>().ListAsync(),
            await sp.GetRequiredService<AccountService>().GetChartAsync(),
            await sp.GetRequiredService<SalesReceiptService>().SuggestNumberAsync()));
        _depositAccounts = _chart.Ordered(includeInactive: false).Select(x => x.Account)
            .Where(a => a.Type is AccountType.Bank or AccountType.OtherCurrentAsset)
            .OrderBy(a => a.Type != AccountType.Bank)
            .ToList();
        _depositAccountId = (_depositAccounts.FirstOrDefault(a => string.Equals(a.Name, SalesAccounts.UndepositedFundsName, StringComparison.OrdinalIgnoreCase))
            ?? _depositAccounts.FirstOrDefault())?.Id ?? Guid.Empty;
        _defaultDepositId = _depositAccountId;
        _customerId = PresetCustomer;
        DefaultTaxCode();
        if (Copy is { } copyId && await Ops.RunAsync(sp => sp.GetRequiredService<SalesReceiptService>().GetAsync(copyId)) is { } source)
        {
            // "Copy": the same customer, lines and settings, dated today with the next number.
            _customerId = source.CustomerId;
            DefaultTaxCode();
            _lines = SalesLineModel.CopiesOf(source.Lines);
            _memo = source.Memo;
            _taxCodeId = source.TaxCodeId is { } code && _taxCodes.Any(c => c.Code.Id == code) ? code : _taxCodeId;
            if (_depositAccounts.Any(a => a.Id == source.DepositAccountId))
                _depositAccountId = source.DepositAccountId;
            _locationId = source.LocationId;
            _warehouseId = source.WarehouseId;
            _method = source.Method;
        }
        else if (_items.FirstOrDefault(i => i.Id == PresetItem && i.IsActive) is { } presetItem)
        {
            _lines = [SalesLineModel.ForItem(presetItem)];
        }

        _loaded = true;
    }

    [SupplyParameterFromQuery(Name = "customer")]
    private Guid? PresetCustomer { get; set; }

    /// <summary>An item to start the first line with ("New transaction" in the Item Center).</summary>
    [SupplyParameterFromQuery(Name = "item")]
    private Guid? PresetItem { get; set; }

    /// <summary>A sales receipt to start from ("Copy" on its page).</summary>
    [SupplyParameterFromQuery(Name = "copy")]
    private Guid? Copy { get; set; }

    // Undeposited Funds when the chart has it: the simple view folds the choice away while it's this.
    private Guid _defaultDepositId;

    private async Task SaveAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            var command = new CreateSalesReceiptCommand(_customerId, _date, _depositAccountId, SalesLineModel.Drafts(_lines), _number, _reference, _memo, _taxCodeId ?? Guid.Empty, LocationId: _locationId, WarehouseId: _warehouseId, Method: _method);
            var receipt = await Ops.RunAsync<SalesReceiptService, SalesReceipt>(s => s.CreateAsync(command), _closingPassword);
            await _draft!.ClearAsync();
            Navigation.NavigateTo($"/sales/receipts/{receipt.Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword |= ClosedPeriod.NeedsPassword(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
