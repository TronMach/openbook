@page "/sales/estimates/new"
@page "/sales/estimates/{Id:guid}/edit"
@rendermode InteractiveServer
@inject Operations Ops
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "New estimate" : $"Estimate {_number}") · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>@(Id is null ? "New estimate" : $"Edit estimate {_number}")</h1>
        <a class="button secondary" href="@(Id is { } id ? $"/sales/estimates/{id}" : "/sales?show=estimates")">Cancel</a>
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    @if (_notEditable)
    {
        <div class="card"><p>That estimate doesn't exist or is already invoiced. <a href="/sales?show=estimates">Back to estimates</a>.</p></div>
    }
    else if (_loaded)
    {
        @if (Id is null)
        {
            <FormDraft @ref="_draft" T="Draft" Key="estimate-new" Snapshot="TakeDraft" OnRestore="RestoreAsync" />
        }
        <div class="card">
            <div class="row">
                <div class="field">
                    <label for="customer">Customer</label>
                    <SearchSelect Id="customer" Options="PickerOptions.Customers(_customers)" CustomerAdded="c => _customers = [.. _customers, c]" @bind-Value="_customerId" @bind-Value:after="DefaultTaxCode" Placeholder="Choose a customer…" />
                </div>
                <div class="field">
                    <label for="number">Estimate number</label>
                    <input id="number" @bind="_number" maxlength="20" disabled="@(Id is not null)" />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="date">Date</label>
                    <input id="date" type="date" @bind="_date" />
                </div>
                <div class="field">
                    <label for="expires">Valid until <span class="muted">(optional)</span></label>
                    <input id="expires" type="date" @bind="_expirationDate" />
                </div>
            </div>

            <SalesTaxField Choices="_taxCodes" @bind-Value="_taxCodeId" CustomerCodeOff="@(TaxCustomer?.TaxCodeId is { } own && _taxCodes.All(c => c.Code.Id != own))" Exemption="@TaxExemption" Expired="TaxExemptionExpired" />

            <SalesLinesEditor Classes="_segments.ClassColumn" Lines="_lines" Items="_items" OnItemAdded="i => _items = [.. _items, i]" OnChange="StateHasChanged" CustomerId="_customerId" Date="_date" Tax="SelectedTax" Exempt="@(TaxExemption is not null)" />

            <MoreOptions HasContent="@(_segments.Locations.Count > 0)" Open="@(_locationId is not null)">
                <LocationField Options="_segments" @bind-Value="_locationId" />
            </MoreOptions>
            <div class="field" style="margin-top: 1rem">
                <label for="memo">Message to customer <span class="muted">(optional, printed on the estimate)</span></label>
                <textarea id="memo" rows="2" @bind="_memo" maxlength="1000"></textarea>
            </div>

            <div class="actions">
                <button type="button" @onclick="SaveAsync" disabled="@(!CanSave || _busy)">Save estimate</button>
                <span class="muted">Estimates don't affect the books until you turn them into invoices.</span>
            </div>
        </div>
    }
</div>

@code {
    // Noted when the form opens, so a save can tell if the record has moved on.
    private int? _version;

    // What's typed so far, kept in the tab in case the connection goes (new estimates only).
    internal sealed record Draft(Guid? CustomerId, string? Number, DateOnly Date, DateOnly? ExpirationDate, string? Memo, Guid? TaxCodeId, Guid? LocationId, List<SalesLineModel> Lines);

    private FormDraft<Draft>? _draft;

    private Draft? TakeDraft() => Id is not null || (_customerId is null && _lines.All(l => l.IsBlank)) ? null
        : new Draft(_customerId, _number, _date, _expirationDate, _memo, _taxCodeId, _locationId, _lines);

    private void RestoreAsync(Draft draft)
    {
        _customerId = _customers.Any(c => c.Id == draft.CustomerId) ? draft.CustomerId : null;
        (_number, _date, _expirationDate, _memo, _locationId) = (draft.Number, draft.Date, draft.ExpirationDate, draft.Memo, draft.LocationId);
        _taxCodeId = _taxCodes.Any(c => c.Code.Id == draft.TaxCodeId) ? draft.TaxCodeId : null;
        _lines = draft.Lines.Count > 0 ? draft.Lines : [new()];
    }

    private IReadOnlyList<Customer> _customers = [];
    private IReadOnlyList<Item> _items = [];
    private Guid? _customerId;
    private string? _number;
    private DateOnly _date = CompanyTime.Today;
    private DateOnly? _expirationDate = CompanyTime.Today.AddDays(30);
    private string? _memo;
    private List<SalesLineModel> _lines = [new()];
    private bool _loaded;
    private bool _notEditable;
    private bool _busy;
    private string? _error;

    [Parameter]
    public Guid? Id { get; set; }

    [SupplyParameterFromQuery(Name = "customer")]
    private Guid? PresetCustomer { get; set; }

    /// <summary>An item to start the first line with ("New transaction" in the Item Center).</summary>
    [SupplyParameterFromQuery(Name = "item")]
    private Guid? PresetItem { get; set; }

    /// <summary>An estimate to start a new one from ("Copy" on its page).</summary>
    [SupplyParameterFromQuery(Name = "copy")]
    private Guid? Copy { get; set; }

    private IReadOnlyList<TaxCodeChoice> _taxCodes = [];
    private Guid? _taxCodeId;

    private TaxCodeChoice? SelectedTax => _taxCodes.FirstOrDefault(c => c.Code.Id == _taxCodeId);
    private Customer? TaxCustomer => _customers.FirstOrDefault(c => c.Id == _customerId);
    private string? TaxExemption => SelectedTax is null ? null : CustomerTree.ExemptionOn(TaxCustomer, _date, _customers);
    private bool TaxExemptionExpired => SelectedTax is not null && TaxCustomer?.ExemptionCertificate is not null && TaxExemption is null;

    /// <summary>Starts the document with the customer's tax code, when it can be charged.</summary>
    private void DefaultTaxCode() =>
        _taxCodeId = TaxCustomer?.TaxCodeId is { } code && _taxCodes.Any(c => c.Code.Id == code) ? code : null;

    private Task<IReadOnlyList<TaxCodeChoice>> LoadTaxCodesAsync() =>
        Ops.RunAsync(sp => sp.GetRequiredService<SalesTaxService>().ListChoicesAsync());

    private bool CanSave => _customerId is not null && SalesLineModel.Total(_lines) > 0m && !string.IsNullOrWhiteSpace(_number);

    private SegmentOptions _segments = SegmentOptions.None;

    private Guid? _locationId;


    protected override async Task OnInitializedAsync()
    {
        if (Id is { } versionOf)
            _version = await Ops.VersionAsync<Estimate>(versionOf);

        _segments = await Ops.RunAsync(SegmentOptions.LoadAsync);
        Estimate? estimate;
        _taxCodes = await LoadTaxCodesAsync();
        (_customers, _items, _number, estimate) = await Ops.RunAsync(async sp => (
            (IReadOnlyList<Customer>)(await sp.GetRequiredService<CustomerService>().ListAsync(_date)).Select(s => s.Customer).ToList(),
            await sp.GetRequiredService<ItemService>().ListAsync(),
            await sp.GetRequiredService<EstimateService>().SuggestNumberAsync(),
            (Id ?? Copy) is { } id ? await sp.GetRequiredService<EstimateService>().GetAsync(id) : null));
        _customerId = PresetCustomer;
        DefaultTaxCode();

        if (Id is null && estimate is not null)
        {
            // "Copy": the same customer, lines and settings, dated today with the next number.
            _customerId = estimate.CustomerId;
            _memo = estimate.Memo;
            _lines = SalesLineModel.CopiesOf(estimate.Lines);
            _locationId = estimate.LocationId;
            _taxCodeId = estimate.TaxCodeId is { } code && _taxCodes.Any(c => c.Code.Id == code) ? code : null;
        }
        else if (Id is null && _items.FirstOrDefault(i => i.Id == PresetItem && i.IsActive) is { } presetItem)
        {
            _lines = [SalesLineModel.ForItem(presetItem)];
        }

        if (Id is not null)
        {
            if (estimate is null || estimate.Status == EstimateStatus.Closed)
            {
                _notEditable = true;
                return;
            }

            _customerId = estimate.CustomerId;
            _number = estimate.Number;
            _date = estimate.Date;
            _expirationDate = estimate.ExpirationDate;
            _memo = estimate.Memo;
            _lines = SalesLine.Drafts(estimate.Lines).Select(SalesLineModel.From).ToList();
            _locationId = estimate.LocationId;
            _taxCodeId = estimate.TaxCodeId;
        }

        _loaded = true;
    }

    private async Task SaveAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            var command = new SaveEstimateCommand(_customerId!.Value, _date, SalesLineModel.Drafts(_lines), _expirationDate, _number, _memo, _taxCodeId ?? Guid.Empty, _locationId);
            var estimate = await Ops.ChangeAsync<Estimate, EstimateService, Estimate>(Id ?? Guid.Empty, _version, s => Id is { } id ? s.UpdateAsync(id, command) : s.CreateAsync(command));
            if (_draft is not null)
                await _draft.ClearAsync();
            Navigation.NavigateTo($"/sales/estimates/{estimate.Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
