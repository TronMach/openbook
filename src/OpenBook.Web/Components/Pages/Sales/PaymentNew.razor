@page "/sales/payments/new"
@rendermode InteractiveServer
@inject Operations Ops
@inject NavigationManager Navigation

<PageTitle>Receive payment · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Receive payment</h1>
        <a class="button secondary" href="/sales">Back to sales</a>
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    @if (_loaded)
    {
        <div class="card">
            <div class="row">
                <div class="field">
                    <label for="customer">Customer</label>
                    <SearchSelect Id="customer" Options="@(_customers.Select(c => new PickerOption(c.Customer.Id, c.Customer.DisplayName, $"{Labels.Amount(c.Balance)} open", Keywords: c.Customer.CompanyName)).ToList())" Value="_customerId" OnChange="PickCustomerAsync" Placeholder="Choose a customer…" />
                    @if (_credits.Count > 0)
                    {
                        <span class="hint">
                            This customer has @Labels.Amount(_credits.Sum(c => c.Available)) of unused credit.
                            <a href="/sales/credits/apply?customer=@_customerId">Apply it to invoices</a> instead of, or as well as, a payment.
                        </span>
                    }
                </div>
                <div class="field">
                    <label for="amount">Amount received</label>
                    <input id="amount" type="number" step="0.01" min="0" value="@AmountText" @onchange="AutoApply" disabled="@(_customerId is null)" />
                    <span class="hint">Applied to the oldest invoices first, taking any early payment discount. Anything left over becomes a credit.</span>
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="date">Payment date</label>
                    <input id="date" type="date" value="@_date.ToString("yyyy-MM-dd")" @onchange="ChangeDate" />
                </div>
                <div class="field">
                    <label for="deposit">Deposit to</label>
                    <select id="deposit" @bind="_depositAccountId">
                        @foreach (var a in _depositAccounts)
                        {
                            <option value="@a.Id">@_chart.FullName(a.Id)</option>
                        }
                    </select>
                    @if (_depositAccounts.FirstOrDefault(a => a.Id == _depositAccountId)?.Type == AccountType.OtherCurrentAsset)
                    {
                        <span class="hint">Held until you <a href="/banking/deposits/new" target="_blank">make a deposit</a> that matches the bank statement.</span>
                    }
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="reference">Reference / check no. <span class="muted">(optional)</span></label>
                    <input id="reference" @bind="_reference" maxlength="30" />
                </div>
                <div class="field">
                    <label for="memo">Memo <span class="muted">(optional)</span></label>
                    <input id="memo" @bind="_memo" maxlength="1000" />
                </div>
            </div>
        </div>

        @if (_customerId is not null)
        {
            @if (_rows.Count == 0)
            {
                <div class="card"><p>This customer has no unpaid invoices. A payment you record now is kept as a credit for them.</p></div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data entry">
                        <thead><tr><th>Invoice</th><th>Date</th><th>Due</th><th class="num">Open balance</th><th class="num">Discount</th><th class="num">Payment</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var row in _rows)
                            {
                                var available = row.Invoice.EarlyPaymentDiscountFor(_date);
                                <tr @key="row.Invoice.Id">
                                    <td><a href="/sales/invoices/@row.Invoice.Id" target="_blank">@row.Invoice.Number</a></td>
                                    <td>@Labels.Date(row.Invoice.Date)</td>
                                    <td class="@(row.Invoice.IsOverdue(_date) ? "out-of-balance" : null)">@Labels.Date(row.Invoice.DueDate)</td>
                                    <td class="num">@Labels.Amount(row.Invoice.Balance)</td>
                                    <td>
                                        <input class="amount" type="number" step="0.01" min="0" aria-label="Discount for invoice @row.Invoice.Number" @bind="row.Discount" />
                                        @if (available > 0m)
                                        {
                                            <span class="hint">@Labels.Amount(available) available until @Labels.Date(row.Invoice.EarlyPaymentDiscountDate!.Value)</span>
                                        }
                                    </td>
                                    <td><input class="amount" type="number" step="0.01" min="0" aria-label="Payment for invoice @row.Invoice.Number" @bind="row.Amount" /></td>
                                    <td><button type="button" class="link" @onclick="() => PayInFull(row)">Pay in full</button></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4">Applied to invoices</td>
                                <td class="num">@Labels.Amount(TotalDiscount)</td>
                                <td class="num">@Labels.Amount(TotalApplied)</td>
                                <td class="@(Invalid ? "out-of-balance" : "muted")">@(Invalid ? "A payment and discount are more than the invoice's balance." : "")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }

            <div class="summary-bar">
                <div><span class="label">Amount received</span><span class="value">@Labels.Amount(Received)</span></div>
                <div><span class="label">Applied</span><span class="value">@Labels.Amount(TotalApplied)</span></div>
                <div><span class="label">Credit for the customer</span><span class="value @(Unapplied < 0m ? "off" : null)">@Labels.Amount(Unapplied)</span></div>
            </div>

            <ClosedPeriodPassword Visible="_needsClosingPassword" @bind-Value="_closingPassword" />

            <div class="actions">
                <button type="button" @onclick="SaveAsync" disabled="@(!CanSave || _busy)">Save payment</button>
                <a href="/sales">Cancel</a>
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<CustomerSummary> _customers = [];
    private ChartOfAccounts _chart = new([]);
    private List<Account> _depositAccounts = [];
    private IReadOnlyList<AvailableCredit> _credits = [];
    private Guid? _customerId;
    private Guid _depositAccountId;
    private DateOnly _date = CompanyTime.Today;
    private decimal? _amount;
    private string? _reference;
    private string? _memo;
    private List<RowModel> _rows = [];
    private bool _loaded;
    private bool _busy;
    private string? _error;
    private bool _needsClosingPassword;
    private string? _closingPassword;

    [SupplyParameterFromQuery(Name = "customer")]
    private Guid? PresetCustomer { get; set; }

    private decimal TotalApplied => _rows.Sum(r => r.Amount ?? 0m);
    private decimal TotalDiscount => _rows.Sum(r => r.Discount ?? 0m);

    /// <summary>What was typed, or (until something is typed) what's applied.</summary>
    private decimal Received => _amount ?? TotalApplied;

    private decimal Unapplied => Received - TotalApplied;
    private bool Invalid => _rows.Any(r => (r.Amount ?? 0m) < 0m || (r.Discount ?? 0m) < 0m || (r.Amount ?? 0m) + (r.Discount ?? 0m) > r.Invoice.Balance);
    private bool CanSave => (Received > 0m || TotalDiscount > 0m) && Unapplied >= 0m && !Invalid && _depositAccountId != Guid.Empty;
    private string AmountText => _amount is { } a ? a.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        (_customers, _chart) = await Ops.RunAsync(async sp => (
            await sp.GetRequiredService<CustomerService>().ListAsync(_date),
            await sp.GetRequiredService<AccountService>().GetChartAsync()));
        _depositAccounts = _chart.Ordered(includeInactive: false).Select(x => x.Account)
            .Where(a => a.Type is AccountType.Bank or AccountType.OtherCurrentAsset)
            .OrderBy(a => a.Type != AccountType.Bank)
            .ToList();
        // Undeposited Funds when the chart has it, as in QuickBooks; otherwise the first bank account.
        _depositAccountId = (_depositAccounts.FirstOrDefault(a => string.Equals(a.Name, SalesAccounts.UndepositedFundsName, StringComparison.OrdinalIgnoreCase))
            ?? _depositAccounts.FirstOrDefault())?.Id ?? Guid.Empty;
        if (PresetCustomer is { } preset)
            await LoadInvoicesAsync(preset);
        _loaded = true;
    }

    private Task PickCustomerAsync(ChangeEventArgs e) => LoadInvoicesAsync(Guid.TryParse(e.Value as string, out var id) ? id : null);

    private async Task LoadInvoicesAsync(Guid? customerId)
    {
        _customerId = customerId;
        _amount = null;
        if (customerId is not { } id)
        {
            _rows = [];
            _credits = [];
            return;
        }

        (var invoices, _credits) = await Ops.RunAsync(async sp => (
            await sp.GetRequiredService<PaymentService>().OpenInvoicesAsync(id),
            await sp.GetRequiredService<CreditService>().AvailableAsync(id)));
        _rows = invoices.Select(i => new RowModel(i)).ToList();
    }

    private void ChangeDate(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value as string, System.Globalization.CultureInfo.InvariantCulture, out var date))
            _date = date;
    }

    private void PayInFull(RowModel row)
    {
        row.Discount = row.Invoice.EarlyPaymentDiscountFor(_date) is > 0m and var d ? d : row.Discount;
        row.Amount = row.Invoice.Balance - (row.Discount ?? 0m);
    }

    /// <summary>Spreads the amount over the oldest invoices, taking early payment discounts that are still available.</summary>
    private void AutoApply(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value as string, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var received))
        {
            _amount = null;
            return;
        }

        _amount = received;
        var remaining = received;
        foreach (var row in _rows)
        {
            var discount = row.Invoice.EarlyPaymentDiscountFor(_date);
            var due = row.Invoice.Balance - discount;
            if (remaining >= due && due > 0m)
            {
                row.Amount = due;
                row.Discount = discount > 0m ? discount : null;
                remaining -= due;
            }
            else
            {
                var amount = Math.Min(remaining, row.Invoice.Balance);
                row.Amount = amount > 0m ? amount : null;
                row.Discount = null;
                remaining -= amount;
            }
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var command = new ReceivePaymentCommand(
                _customerId!.Value, _date, _depositAccountId,
                _rows.Where(r => (r.Amount ?? 0m) > 0m || (r.Discount ?? 0m) > 0m)
                    .Select(r => new ApplyToInvoice(r.Invoice.Id, r.Amount ?? 0m, r.Discount ?? 0m)).ToList(),
                _reference, _memo, Received);
            var payment = await Ops.RunAsync<PaymentService, CustomerPayment>(s => s.ReceiveAsync(command), _closingPassword);
            Navigation.NavigateTo($"/sales/payments/{payment.Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword |= ClosedPeriod.NeedsPassword(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class RowModel(Invoice invoice)
    {
        public Invoice Invoice { get; } = invoice;
        public decimal? Amount { get; set; }
        public decimal? Discount { get; set; }
    }
}
