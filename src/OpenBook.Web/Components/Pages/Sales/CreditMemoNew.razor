@page "/sales/credit-memos/new"
@rendermode InteractiveServer
@inject Operations Ops
@inject NavigationManager Navigation

<PageTitle>New credit memo · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>New credit memo</h1>
        <ActionLink Class="button secondary" Href="/sales?show=credits">Back to credit memos</ActionLink>
    </div>
    <p class="muted">For returns and allowances: reduces income and what the customer owes. Apply the credit to an invoice afterwards, or refund it.</p>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    @if (_loaded && (_customers.Count == 0 || _items.Count == 0))
    {
        <div class="card"><p>Credit memos need a customer and at least one product or service.</p></div>
    }
    else if (_loaded)
    {
        <div class="card">
            <div class="row">
                <div class="field">
                    <label for="customer">Customer</label>
                    <SearchSelect Id="customer" Options="PickerOptions.Customers(_customers)" @bind-Value="_customerId" @bind-Value:after="DefaultTaxCode" Placeholder="Choose a customer…" />
                </div>
                <div class="field">
                    <label for="number">Credit memo number</label>
                    <input id="number" @bind="_number" maxlength="20" />
                    <span class="hint">Shares the invoice number sequence.</span>
                </div>
                <div class="field">
                    <label for="date">Date</label>
                    <input id="date" type="date" @bind="_date" />
                </div>
            </div>

            <SalesTaxField Choices="_taxCodes" @bind-Value="_taxCodeId" Exemption="@TaxExemption" Expired="TaxExemptionExpired" />

            <SalesLinesEditor Classes="_segments.ClassColumn" Lines="_lines" Items="_items" OnChange="StateHasChanged" CustomerId="_customerId" Date="_date" Tax="SelectedTax" Exempt="@(TaxExemption is not null)" />

            <MoreOptions HasContent="@(_segments.Locations.Count > 0 || _warehouses.Count > 1)" Open="@(_locationId is not null || _warehouseId is not null)">
                <LocationField Options="_segments" @bind-Value="_locationId" />
                <WarehouseField Warehouses="_warehouses" @bind-Value="_warehouseId" />
            </MoreOptions>
            <div class="field" style="margin-top: 1rem">
                <label for="memo">Message to customer <span class="muted">(optional)</span></label>
                <textarea id="memo" rows="2" @bind="_memo" maxlength="1000"></textarea>
            </div>

            <ClosedPeriodPassword Visible="_needsClosingPassword" @bind-Value="_closingPassword" />

            <div class="actions">
                <button type="button" @onclick="SaveAsync" disabled="@(!CanSave || _busy)">Save credit memo</button>
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<Customer> _customers = [];
    private IReadOnlyList<Item> _items = [];
    private Guid? _customerId;
    private string? _number;
    private DateOnly _date = CompanyTime.Today;
    private string? _memo;
    private List<SalesLineModel> _lines = [new()];
    private bool _loaded;
    private bool _busy;
    private string? _error;
    private bool _needsClosingPassword;
    private string? _closingPassword;

    private IReadOnlyList<TaxCodeChoice> _taxCodes = [];
    private Guid? _taxCodeId;

    private TaxCodeChoice? SelectedTax => _taxCodes.FirstOrDefault(c => c.Code.Id == _taxCodeId);
    private Customer? TaxCustomer => _customers.FirstOrDefault(c => c.Id == _customerId);
    private string? TaxExemption => SelectedTax is null ? null : TaxCustomer?.ExemptionOn(_date);
    private bool TaxExemptionExpired => SelectedTax is not null && TaxCustomer?.ExemptionCertificate is not null && TaxExemption is null;

    /// <summary>Starts the document with the customer's tax code, when it can be charged.</summary>
    private void DefaultTaxCode() =>
        _taxCodeId = TaxCustomer?.TaxCodeId is { } code && _taxCodes.Any(c => c.Code.Id == code) ? code : null;

    private Task<IReadOnlyList<TaxCodeChoice>> LoadTaxCodesAsync() =>
        Ops.RunAsync(sp => sp.GetRequiredService<SalesTaxService>().ListChoicesAsync());

    [SupplyParameterFromQuery(Name = "customer")]
    private Guid? PresetCustomer { get; set; }

    private bool CanSave => _customerId is not null && SalesLineModel.Total(_lines) > 0m && !string.IsNullOrWhiteSpace(_number);

    private SegmentOptions _segments = SegmentOptions.None;
    private IReadOnlyList<Warehouse> _warehouses = [];
    private Guid? _warehouseId;

    private Guid? _locationId;


    protected override async Task OnInitializedAsync()
    {

        _segments = await Ops.RunAsync(SegmentOptions.LoadAsync);
        _warehouses = await Ops.RunAsync(sp => sp.GetRequiredService<OpenBook.Application.Inventory.WarehouseService>().ListAsync());
        _taxCodes = await LoadTaxCodesAsync();
        (_customers, _items, _number) = await Ops.RunAsync(async sp => (
            (IReadOnlyList<Customer>)(await sp.GetRequiredService<CustomerService>().ListAsync(_date)).Select(s => s.Customer).ToList(),
            await sp.GetRequiredService<ItemService>().ListAsync(),
            await sp.GetRequiredService<InvoiceService>().SuggestNumberAsync()));
        _customerId = PresetCustomer;
        DefaultTaxCode();
        _loaded = true;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var command = new CreateCreditMemoCommand(_customerId!.Value, _date, SalesLineModel.Drafts(_lines), _number, _memo, _taxCodeId ?? Guid.Empty, LocationId: _locationId, WarehouseId: _warehouseId);
            var credit = await Ops.RunAsync<CreditService, CreditMemo>(s => s.CreateCreditMemoAsync(command), _closingPassword);
            Navigation.NavigateTo($"/sales/credit-memos/{credit.Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword |= ClosedPeriod.NeedsPassword(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
