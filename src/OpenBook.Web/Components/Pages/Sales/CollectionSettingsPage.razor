@page "/sales/collections/settings"
@inject CollectionService CollectionService

<PageTitle>Collection settings · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Collection settings</h1>
        <a class="button secondary" href="/sales/collections">Collections</a>
        <a class="button secondary" href="/audit?entityType=collection_settings">History</a>
    </div>

    @if (Error is not null)
    {
        <div class="alert error" role="alert">@Error</div>
    }
    @if (Done == "saved")
    {
        <div class="alert notice" role="status">Saved.</div>
    }

    <div class="card" id="late-fees">
        <h2>Late fees</h2>
        <form method="post" action="/sales/collections/settings/late-fees" data-enhance="false">
            <AntiforgeryToken />
            <label class="check">
                <input type="checkbox" name="enabled" value="true" checked="@_settings.LateFeesEnabled" />
                <span>Charge late fees on overdue invoices</span>
            </label>
            <div class="row">
                <div class="field">
                    <label for="percent">Percent of the overdue balance</label>
                    <input id="percent" name="percent" class="amount" inputmode="decimal" value="@_settings.LateFeePercent.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
                <div class="field">
                    <label for="amount">Plus a flat amount</label>
                    <input id="amount" name="amount" class="amount" inputmode="decimal" value="@_settings.LateFeeAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="grace">Grace period (days after the due date)</label>
                    <input id="grace" name="graceDays" type="number" min="0" max="365" value="@_settings.LateFeeGraceDays" />
                </div>
                <div class="field">
                    <label for="repeat">Charge again every (days)</label>
                    <input id="repeat" name="repeatDays" type="number" min="0" max="365" value="@_settings.LateFeeRepeatDays" />
                    <span class="hint">0 charges once per invoice. 30 is a monthly finance charge.</span>
                </div>
            </div>
            <label class="check">
                <input type="checkbox" name="automatic" value="true" checked="@_settings.LateFeesAutomatic" />
                <span>Charge them automatically (otherwise review and charge them on the collections page)</span>
            </label>
            <p class="hint">
                Each fee is an invoice of its own for the "Late Fee" service item (income account "Late Fee Income", created on the first
                charge), not taxed and due on receipt. Fees are never charged on fee invoices, or to customers marked "don't charge late fees".
                Check that your state allows the rate you set.
            </p>
            <div class="actions"><button type="submit">Save late fees</button></div>
        </form>
    </div>

    <div class="card" id="reminders" style="margin-top: 1.5rem">
        <h2>Payment reminders</h2>
        <form method="post" action="/sales/collections/settings/reminders" data-enhance="false">
            <AntiforgeryToken />
            <label class="check">
                <input type="checkbox" name="enabled" value="true" checked="@_settings.RemindersEnabled" />
                <span>Send reminders automatically (otherwise review and send them on the collections page)</span>
            </label>
            <div class="field">
                <label for="schedule">When, in days from the due date</label>
                <input id="schedule" name="schedule" value="@string.Join(", ", _settings.ReminderSteps)" placeholder="-3, 7, 30" />
                <span class="hint">
                    Negative is before the due date. At most @CollectionSettings.MaxReminderSteps. Each invoice gets each reminder once; if several
                    are due at once (say, after a holiday), only the latest is sent.
                </span>
            </div>
            <div class="field">
                <label for="subject">Subject</label>
                <input id="subject" name="subject" maxlength="300" value="@_settings.ReminderSubject" />
            </div>
            <div class="field">
                <label for="body">Message</label>
                <textarea id="body" name="body" rows="8" maxlength="4000">@_settings.ReminderBody</textarea>
                <span class="hint">
                    Placeholders: {customer}, {invoice}, {balance}, {due}, {days} (days late), {when} ("is due on …" or "was due on …, 9 days ago")
                    and {company}. The invoice PDF is attached. Uses the <a href="/settings/email">email settings</a>.
                </span>
            </div>
            <div class="actions"><button type="submit">Save reminders</button></div>
        </form>
    </div>
</div>

@code {
    private CollectionSettings _settings = default!;

    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? Done { get; set; }

    protected override async Task OnInitializedAsync() => _settings = await CollectionService.GetAsync();
}
