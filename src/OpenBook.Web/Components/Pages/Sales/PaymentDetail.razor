@page "/sales/payments/{Id:guid}"
@using System.ComponentModel.DataAnnotations
@inject PaymentService Payments
@inject InvoiceService Invoices
@inject CustomerService CustomerService
@inject AccountService AccountService
@inject NavigationManager Navigation
@inject ClosedPeriodOverride ClosingOverride

<PageTitle>Payment · OpenBook</PageTitle>

@if (_payment is null)
{
    <div class="card"><p>That payment doesn't exist. <a href="/sales?show=payments">Back to payments</a>.</p></div>
    return;
}

<div class="wide">
    <div class="toolbar">
        <h1>Payment from @_customer?.DisplayName</h1>
        @if (_payment.Status == DocumentStatus.Voided)
        {
            <span class="badge">Voided</span>
        }
        else if (_payment.ReturnedOn is not null)
        {
            <span class="badge warn">Returned by the bank</span>
        }
        <ActionLink Class="button secondary" Href="/sales?show=payments">Back to payments</ActionLink>
        <ActionLink Class="button secondary" Href="@($"/audit?entityId={_payment.Id}")">History</ActionLink>
        @if (_payment.Status == DocumentStatus.Posted)
        {
            <ActionLink Class="button secondary" Href="@($"/sales/email/payments/{_payment.Id}")">Email receipt</ActionLink>
        }
        @if (_payment.Status == DocumentStatus.Posted && _payment.ReturnedOn is null)
        {
            <ActionLink Class="button secondary" Href="@($"/sales/payments/{_payment.Id}/edit")">Change</ActionLink>
        }
        @if (_payment.Unapplied > 0m)
        {
            <ActionLink Class="button secondary" Href="@($"/sales/credits/apply?customer={_payment.CustomerId}")">Apply credit</ActionLink>
            <ActionLink Class="button secondary" Href="@($"/sales/refunds/new?payment={_payment.Id}")">Refund</ActionLink>
        }
    </div>

    @if (_changes.Count > 0)
    {
        var last = _changes[^1];
        <p class="muted no-print">Changed @last.At.InCompanyTime().ToString("g") by @last.By: @last.Reason</p>
    }

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    <div class="card">
        <dl class="facts">
            <dt>Customer</dt><dd><a href="/customers/@_payment.CustomerId">@_customer?.DisplayName</a></dd>
            <dt>Date</dt><dd>@Labels.Date(_payment.Date)</dd>
            <dt>Amount</dt><dd>@Labels.Amount(_payment.Amount)</dd>
            @if (_payment.DiscountTaken > 0m) { <dt>Discounts taken</dt><dd>@Labels.Amount(_payment.DiscountTaken)</dd> }
            @if (_payment.Unapplied > 0m) { <dt>Unapplied credit</dt><dd>@Labels.Amount(_payment.Unapplied)</dd> }
            @if (_payment.AmountRefunded > 0m) { <dt>Refunded</dt><dd>@Labels.Amount(_payment.AmountRefunded)</dd> }
            <dt>Received into</dt><dd>@_chart.FullName(_payment.DepositAccountId)</dd>
            @if (_payment.DepositId is { } depositId) { <dt>Bank deposit</dt><dd><a href="/banking/deposits/@depositId">View deposit</a></dd> }
            @if (_payment.PayoutId is { } payoutId) { <dt>Payout</dt><dd><a href="/sales/channels/payouts/@payoutId">View payout</a></dd> }
            @if (_payment.Reference is not null) { <dt>Reference</dt><dd>@_payment.Reference</dd> }
            @if (_payment.Method is { } method) { <dt>Payment method</dt><dd>@PaymentMethods.Label(method)</dd> }
            @if (_payment.Memo is not null) { <dt>Memo</dt><dd>@_payment.Memo</dd> }
            <dt>Journal entry</dt><dd><a href="/journal/@_payment.JournalEntryId">View</a></dd>
            @if (_payment.ReturnedOn is { } returned)
            {
                <dt>Returned by the bank</dt><dd>@Labels.Date(returned) · @_payment.ReturnReason</dd>
                <dt>Taken back out of</dt><dd>@_chart.FullName(_payment.ReturnAccountId!.Value)</dd>
                @if (_payment.ReturnFee > 0m) { <dt>Bank's fee</dt><dd>@Labels.Amount(_payment.ReturnFee)</dd> }
                <dt>Return entry</dt><dd><a href="/journal/@_payment.ReturnEntryId">View</a></dd>
            }
        </dl>
        @if (_payment.ReturnedOn is not null)
        {
            <p class="muted">The invoices below are owed again from the day it came back. To charge the customer a fee for it, make an invoice.</p>
        }
    </div>

    <h2>Applied to</h2>
    <table class="data">
        <thead><tr><th>Invoice</th><th>Date</th><th>Applied on</th><th class="num">Invoice total</th><th class="num">Discount</th><th class="num">Applied</th></tr></thead>
        <tbody>
            @foreach (var a in _payment.Applications)
            {
                var invoice = _invoices.GetValueOrDefault(a.InvoiceId);
                <tr>
                    <td><a href="/sales/invoices/@a.InvoiceId">@invoice?.Number</a></td>
                    <td>@(invoice is null ? "" : Labels.Date(invoice.Date))</td>
                    <td>@Labels.Date(a.AppliedOn)</td>
                    <td class="num">@(invoice is null ? "" : Labels.Amount(invoice.Total))</td>
                    <td class="num">@Labels.AmountOrBlank(a.Discount)</td>
                    <td class="num">@Labels.Amount(a.Amount)</td>
                </tr>
            }
        </tbody>
    </table>

    @if (_payment.Status == DocumentStatus.Posted && _payment.ReturnedOn is null && _payment.Amount > 0m && (_payment.DepositId is not null || _inBank))
    {
        <div class="card" style="margin-top: 1.5rem">
            <h2>The payment came back</h2>
            <p class="muted">For a check that bounced or a transfer the bank reversed. The payment and its deposit stay as they happened; on the day it came back the money leaves the bank and the invoices it paid are owed again.</p>
            <EditForm Model="ReturnInput" FormName="return" OnValidSubmit="ReturnAsync" method="post">
                <DataAnnotationsValidator />
                <div class="form-row">
                    <div class="field">
                        <label for="return-date">Came back on</label>
                        <InputDate id="return-date" @bind-Value="ReturnInput.Date" />
                    </div>
                    <div class="field">
                        <label for="return-fee">The bank's fee (optional)</label>
                        <InputText id="return-fee" class="amount" inputmode="decimal" placeholder="0.00" @bind-Value="ReturnInput.Fee" />
                    </div>
                    <div class="field">
                        <label for="return-fee-account">Fee goes to</label>
                        <InputSelect id="return-fee-account" @bind-Value="ReturnInput.FeeAccountId">
                            <option value="">Bank Service Charges</option>
                            @foreach (var account in _expenseAccounts)
                            {
                                <option value="@account.Id">@_chart.FullName(account.Id)</option>
                            }
                        </InputSelect>
                    </div>
                </div>
                <div class="field">
                    <label for="return-reason">Why it came back</label>
                    <InputText id="return-reason" placeholder="Insufficient funds" @bind-Value="ReturnInput.Reason" />
                    <ValidationMessage For="() => ReturnInput.Reason" />
                </div>
                <ClosedPeriodPassword Visible="_needsClosingPassword" Interactive="false" Name="ReturnInput.ClosingPassword" />
                <div class="actions"><button type="submit" class="danger">Record the returned payment</button></div>
            </EditForm>
        </div>
    }

    @if (_payment.ReturnedOn is not null)
    {
        <div class="card" style="margin-top: 1.5rem">
            <h2>Take the return back</h2>
            <p class="muted">If it was recorded by mistake (the check cleared after all): the return's entry is voided and the payment pays its invoices again.</p>
            <EditForm Model="UndoInput" FormName="undo-return" OnValidSubmit="UndoReturnAsync" method="post">
                <DataAnnotationsValidator />
                <div class="field">
                    <label for="undo-reason">Reason</label>
                    <InputText id="undo-reason" @bind-Value="UndoInput.Reason" />
                    <ValidationMessage For="() => UndoInput.Reason" />
                </div>
                <ClosedPeriodPassword Visible="_needsClosingPassword" Interactive="false" Name="UndoInput.ClosingPassword" />
                <div class="actions"><button type="submit" class="secondary">Take the return back</button></div>
            </EditForm>
        </div>
    }

    @if (_payment.Status == DocumentStatus.Posted && _payment.ReturnedOn is null)
    {
        <div class="card" style="margin-top: 1.5rem">
            <h2>Void this payment</h2>
            <p class="muted">Voiding reverses the deposit and reopens the invoices it paid. Payments already reconciled at the bank can't be voided.</p>
            <EditForm Model="VoidInput" FormName="void" OnValidSubmit="VoidAsync" method="post">
                <DataAnnotationsValidator />
                <div class="field">
                    <label for="reason">Reason</label>
                    <InputText id="reason" @bind-Value="VoidInput.Reason" />
                    <ValidationMessage For="() => VoidInput.Reason" />
                </div>
                <ClosedPeriodPassword Visible="_needsClosingPassword" Interactive="false" Name="VoidInput.ClosingPassword" />
                <button type="submit" class="danger">Void payment</button>
            </EditForm>
        </div>
    }

    <DocumentChangeList Changes="_changes" />

    <Attachments EntityType="payment" EntityId="_payment.Id" />

    <Notes EntityType="payment" EntityId="_payment.Id" />
    <EmailHistory EntityType="payment" EntityId="_payment.Id" />
</div>

@code {
    private CustomerPayment? _payment;
    private Customer? _customer;
    private Dictionary<Guid, Invoice> _invoices = [];
    private ChartOfAccounts _chart = new([]);
    private IReadOnlyList<DocumentChange> _changes = [];
    private string? _error;
    private bool _needsClosingPassword;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "void")]
    private VoidModel VoidInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "return")]
    private ReturnModel ReturnInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "undo-return")]
    private VoidModel UndoInput { get; set; } = default!;

    private bool _inBank;
    private List<Account> _expenseAccounts = [];

    protected override async Task OnInitializedAsync()
    {
        VoidInput ??= new();
        ReturnInput ??= new() { Date = CompanyTime.Today };
        UndoInput ??= new();
        _payment = await Payments.GetAsync(Id);
        if (_payment is null)
            return;
        _customer = await CustomerService.GetAsync(_payment.CustomerId);
        _chart = await AccountService.GetChartAsync();
        _invoices = (await Invoices.GetManyAsync(_payment.Applications.Select(a => a.InvoiceId).ToList())).ToDictionary(i => i.Id);
        _changes = await Payments.ChangesAsync(Id);
        _inBank = _chart.Find(_payment.DepositAccountId)?.Type == AccountType.Bank;
        _expenseAccounts = _chart.Ordered(includeInactive: false).Select(x => x.Account).Where(a => a.Type == AccountType.Expense).ToList();
    }

    private async Task ReturnAsync()
    {
        try
        {
            ClosingOverride.Password = ReturnInput.ClosingPassword;
            var fee = OpenBook.Web.Endpoints.FormNumbers.Amount(ReturnInput.Fee) ?? 0m;
            await Payments.ReturnAsync(Id, ReturnInput.Date, fee, ReturnInput.FeeAccountId, ReturnInput.Reason);
            Navigation.NavigateTo($"/sales/payments/{Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword = ClosedPeriod.NeedsPassword(ex);
        }
    }

    private async Task UndoReturnAsync()
    {
        try
        {
            ClosingOverride.Password = UndoInput.ClosingPassword;
            await Payments.UndoReturnAsync(Id, UndoInput.Reason);
            Navigation.NavigateTo($"/sales/payments/{Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword = ClosedPeriod.NeedsPassword(ex);
        }
    }

    private sealed class ReturnModel
    {
        public DateOnly Date { get; set; }

        public string? Fee { get; set; }

        public Guid? FeeAccountId { get; set; }

        [Required(ErrorMessage = "Say why the payment came back.")]
        [StringLength(500)]
        public string Reason { get; set; } = string.Empty;

        public string? ClosingPassword { get; set; }
    }

    private async Task VoidAsync()
    {
        try
        {
            ClosingOverride.Password = VoidInput.ClosingPassword;
            await Payments.VoidAsync(Id, VoidInput.Reason);
            Navigation.NavigateTo($"/sales/payments/{Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword = ClosedPeriod.NeedsPassword(ex);
        }
    }

    private sealed class VoidModel
    {
        [Required(ErrorMessage = "Say why the payment is being voided.")]
        [StringLength(500)]
        public string Reason { get; set; } = string.Empty;

        public string? ClosingPassword { get; set; }
    }
}
