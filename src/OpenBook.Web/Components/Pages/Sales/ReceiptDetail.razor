@page "/sales/receipts/{Id:guid}"
@using System.ComponentModel.DataAnnotations
@inject SalesReceiptService Receipts
@inject CustomerService CustomerService
@inject AccountService AccountService
@inject CompanySettingsService Settings
@inject NavigationManager Navigation

<PageTitle>Sales receipt @(_receipt?.Number) · OpenBook</PageTitle>

@if (_receipt is null || _company is null)
{
    <div class="card"><p>That sales receipt doesn't exist. <a href="/sales?show=receipts">Back to sales receipts</a>.</p></div>
    return;
}

<div class="wide">
    <div class="toolbar">
        <h1>Sales receipt @_receipt.Number</h1>
        @if (_receipt.Status == SalesDocumentStatus.Voided)
        {
            <span class="badge">Voided</span>
        }
        <a class="button secondary" href="/sales?show=receipts">Back to sales receipts</a>
        <button type="button" class="secondary" onclick="window.print()">Print</button>
    </div>

    @if (_error is not null)
    {
        <div class="alert error no-print" role="alert">@_error</div>
    }

    <div class="card">
        <div class="split-grid">
            <div>
                <strong>@(_company.LegalName ?? _company.Name)</strong>
                @if (_company.Address is not null) { <div style="white-space: pre-line">@_company.Address</div> }
            </div>
            <dl class="facts">
                <dt>Receipt</dt><dd>@_receipt.Number</dd>
                <dt>Date</dt><dd>@Labels.Date(_receipt.Date)</dd>
                @if (_customer is not null) { <dt>Customer</dt><dd><a href="/customers/@_customer.Id">@_customer.DisplayName</a></dd> }
                @if (_receipt.Reference is not null) { <dt>Reference</dt><dd>@_receipt.Reference</dd> }
                <dt class="no-print">Deposited to</dt><dd class="no-print">@_chart.FullName(_receipt.DepositAccountId)</dd>
            </dl>
        </div>
        <table class="data" style="margin-top: 1rem">
            <thead><tr><th>Description</th><th class="num">Qty</th><th class="num">Rate</th><th class="num">Amount</th></tr></thead>
            <tbody>
                @foreach (var line in _receipt.Lines.OrderBy(l => l.LineNumber))
                {
                    <tr>
                        <td>@line.Description</td>
                        <td class="num">@(line.ItemId is null ? "" : line.Quantity.ToString("0.####"))</td>
                        <td class="num">@(line.ItemId is null ? "" : line.Rate.ToString("#,##0.00##"))</td>
                        <td class="num">@Labels.AmountOrBlank(line.Amount)</td>
                    </tr>
                }
            </tbody>
            <tfoot><tr><td colspan="3">Total paid</td><td class="num">@Labels.Amount(_receipt.Total)</td></tr></tfoot>
        </table>
        @if (_receipt.Memo is not null)
        {
            <p style="margin-top: 1rem">@_receipt.Memo</p>
        }
    </div>

    <p class="muted no-print"><a href="/journal/@_receipt.JournalEntryId">Journal entry</a></p>

    @if (_receipt.Status == SalesDocumentStatus.Posted)
    {
        <div class="card no-print">
            <h2>Void this sales receipt</h2>
            <p class="muted">Voiding reverses its journal entry on the same date. Receipts already reconciled at the bank can't be voided.</p>
            <EditForm Model="VoidInput" FormName="void" OnValidSubmit="VoidAsync" method="post">
                <DataAnnotationsValidator />
                <div class="field">
                    <label for="reason">Reason</label>
                    <InputText id="reason" @bind-Value="VoidInput.Reason" />
                    <ValidationMessage For="() => VoidInput.Reason" />
                </div>
                <button type="submit" class="danger">Void sales receipt</button>
            </EditForm>
        </div>
    }
</div>

@code {
    private SalesReceipt? _receipt;
    private Customer? _customer;
    private OpenBook.Domain.Companies.Company? _company;
    private ChartOfAccounts _chart = new([]);
    private string? _error;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "void")]
    private VoidModel VoidInput { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        VoidInput ??= new();
        _receipt = await Receipts.GetAsync(Id);
        if (_receipt is null)
            return;
        _customer = _receipt.CustomerId is { } c ? await CustomerService.GetAsync(c) : null;
        _company = await Settings.GetAsync();
        _chart = await AccountService.GetChartAsync();
    }

    private async Task VoidAsync()
    {
        try
        {
            await Receipts.VoidAsync(Id, VoidInput.Reason);
            Navigation.NavigateTo($"/sales/receipts/{Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }

    private sealed class VoidModel
    {
        [Required(ErrorMessage = "Say why the sales receipt is being voided.")]
        [StringLength(500)]
        public string Reason { get; set; } = string.Empty;
    }
}
