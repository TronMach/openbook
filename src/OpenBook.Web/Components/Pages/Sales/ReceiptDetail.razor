@page "/sales/receipts/{Id:guid}"
@using System.ComponentModel.DataAnnotations
@inject SalesReceiptService Receipts
@inject CustomerService CustomerService
@inject AccountService AccountService
@inject CompanySettingsService Settings
@inject NavigationManager Navigation
@inject ClosedPeriodOverride ClosingOverride

<PageTitle>Sales receipt @(_receipt?.Number) · OpenBook</PageTitle>

@if (_receipt is null || _company is null)
{
    <div class="card"><p>That sales receipt doesn't exist. <a href="/sales?show=receipts">Back to sales receipts</a>.</p></div>
    return;
}

<div class="wide">
    <div class="toolbar">
        <h1>Sales receipt @_receipt.Number</h1>
        @if (_receipt.Status == DocumentStatus.Voided)
        {
            <span class="badge">Voided</span>
        }
        <ActionLink Class="button secondary" Href="/sales?show=receipts">Back to sales receipts</ActionLink>
        <a class="button secondary" href="/api/sales/receipts/@_receipt.Id/pdf" target="_blank">PDF</a>
        <PrintButtons Document="OpenBook.Domain.Companies.FormDocuments.SalesReceipt" Id="_receipt.Id" PdfUrl="@($"/api/sales/receipts/{_receipt.Id}/pdf")" />
        @if (_receipt.CustomerId is not null && _receipt.Status == DocumentStatus.Posted)
        {
            <ActionLink Class="button secondary" Href="@($"/sales/email/receipts/{_receipt.Id}")">Email</ActionLink>
        }
        <ActionLink Class="button secondary" Href="@($"/sales/receipts/new?copy={_receipt.Id}")">Copy</ActionLink>
        <ActionLink Class="button secondary" Href="@($"/audit?entityId={_receipt.Id}")">History</ActionLink>
        @if (_receipt.Status == DocumentStatus.Posted)
        {
            <ActionLink Class="button secondary" Href="@($"/sales/receipts/{_receipt.Id}/edit")">Change</ActionLink>
        }
    </div>
    @if (_changes.Count > 0)
    {
        var last = _changes[^1];
        <p class="muted no-print">Changed @last.At.InCompanyTime().ToString("g") by @last.By: @last.Reason</p>
    }
    @if (_receipt.DepositId is { } depositId)
    {
        <p class="muted no-print">Deposited: <a href="/banking/deposits/@depositId">see the bank deposit</a>.</p>
    }

    @if (_error is not null)
    {
        <div class="alert error no-print" role="alert">@_error</div>
    }

    <div class="card">
        <div class="split-grid">
            <div>
                <strong>@(_company.LegalName ?? _company.Name)</strong>
                @if (_company.Address is not null) { <div style="white-space: pre-line">@_company.Address</div> }
            </div>
            <dl class="facts">
                <dt>Receipt</dt><dd>@_receipt.Number</dd>
                <dt>Date</dt><dd>@Labels.Date(_receipt.Date)</dd>
                @if (_customer is not null) { <dt>Customer</dt><dd><a href="/customers/@_customer.Id">@_customer.DisplayName</a></dd> }
                @if (_receipt.Reference is not null) { <dt>Reference</dt><dd>@_receipt.Reference</dd> }
                @if (_receipt.Method is { } method) { <dt>Payment method</dt><dd>@PaymentMethods.Label(method)</dd> }
                <dt class="no-print">Deposited to</dt><dd class="no-print">@_chart.FullName(_receipt.DepositAccountId)</dd>
            </dl>
        </div>
        <table class="data" style="margin-top: 1rem">
            <thead><tr><th>Description</th><th class="num">Qty</th><th class="num">Rate</th><th class="num">Amount</th></tr></thead>
            <tbody>
                @foreach (var line in _receipt.Lines.Where(l => l.Kind != SalesLineKind.Tax).OrderBy(l => l.LineNumber))
                {
                    <tr>
                        <td>@line.Description<LineFields DocumentId="_receipt.Id" LineNumber="line.LineNumber" /></td>
                        <td class="num">@(line.ItemId is null ? "" : line.Quantity.ToString("0.####"))</td>
                        <td class="num">@(line.ItemId is null ? "" : line.Rate.ToString("#,##0.00##"))<PriceNote Line="line" /></td>
                        <td class="num">@Labels.AmountOrBlank(line.Amount)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @foreach (var t in FormService.TaxTotals(_receipt.Lines, _receipt.TaxCodeId, _receipt.TaxExemption))
                {
                    <tr><td colspan="3">@t.Label</td><td class="num">@Labels.Amount(t.Amount)</td></tr>
                }
                <tr><td colspan="3">Total paid</td><td class="num">@Labels.Amount(_receipt.Total)</td></tr>
                @if (FormService.Savings(_receipt.Lines) is var saved and > 0m)
                {
                    <tr class="muted"><td colspan="3">You saved</td><td class="num">@Labels.Amount(saved)</td></tr>
                }
            </tfoot>
        </table>
        @if (_receipt.Memo is not null)
        {
            <p style="margin-top: 1rem">@_receipt.Memo</p>
        }
    </div>

    <p class="muted no-print"><a href="/journal/@_receipt.JournalEntryId">Journal entry</a></p>

    @if (_receipt.Status == DocumentStatus.Posted)
    {
        <div class="card no-print">
            <h2>Void this sales receipt</h2>
            <p class="muted">Voiding reverses its journal entry on the same date. Receipts already reconciled at the bank can't be voided.</p>
            <EditForm Model="VoidInput" FormName="void" OnValidSubmit="VoidAsync" method="post">
                <DataAnnotationsValidator />
                <div class="field">
                    <label for="reason">Reason</label>
                    <InputText id="reason" @bind-Value="VoidInput.Reason" />
                    <ValidationMessage For="() => VoidInput.Reason" />
                </div>
                <ClosedPeriodPassword Visible="_needsClosingPassword" Interactive="false" Name="VoidInput.ClosingPassword" />
                <button type="submit" class="danger">Void sales receipt</button>
            </EditForm>
        </div>
    }

    <DocumentChangeList Changes="_changes" />

    <EntryTags EntryId="_receipt.JournalEntryId" />

    <Attachments EntityType="sales_receipt" EntityId="_receipt.Id" />

    <CustomFieldPanel EntityType="sales_receipt" EntityId="_receipt.Id" />

    <EmailHistory EntityType="sales_receipt" EntityId="_receipt.Id" />

    <Notes EntityType="sales_receipt" EntityId="_receipt.Id" />
</div>

@code {
    private SalesReceipt? _receipt;
    private Customer? _customer;
    private OpenBook.Domain.Companies.Company? _company;
    private ChartOfAccounts _chart = new([]);
    private IReadOnlyList<DocumentChange> _changes = [];
    private string? _error;
    private bool _needsClosingPassword;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "void")]
    private VoidModel VoidInput { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        VoidInput ??= new();
        _receipt = await Receipts.GetAsync(Id);
        if (_receipt is null)
            return;
        _customer = _receipt.CustomerId is { } c ? await CustomerService.GetAsync(c) : null;
        _company = await Settings.GetAsync();
        _chart = await AccountService.GetChartAsync();
        _changes = await Receipts.ChangesAsync(Id);
    }

    private async Task VoidAsync()
    {
        try
        {
            ClosingOverride.Password = VoidInput.ClosingPassword;
            await Receipts.VoidAsync(Id, VoidInput.Reason);
            Navigation.NavigateTo($"/sales/receipts/{Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword = ClosedPeriod.NeedsPassword(ex);
        }
    }

    private sealed class VoidModel
    {
        [Required(ErrorMessage = "Say why the sales receipt is being voided.")]
        [StringLength(500)]
        public string Reason { get; set; } = string.Empty;

        public string? ClosingPassword { get; set; }
    }
}
