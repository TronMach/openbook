@page "/backup"
@using OpenBook.Web.Endpoints
@using OpenBook.Domain.Companies
@using OpenBook.Infrastructure
@using OpenBook.Infrastructure.Persistence
@inject ScheduledBackupService Schedules
@inject OpenBookStorage Storage
@inject OpenBook.Web.Hosting.Installation Install

<PageTitle>Backup &amp; restore · OpenBook</PageTitle>

<h1>Backup &amp; restore</h1>

@if (Storage.Provider == DatabaseProvider.Postgres)
{
    <div class="card">
        <h2>Back up with pg_dump</h2>
        <p class="muted">
            This company is in PostgreSQL, so it's backed up with PostgreSQL's own tools rather than from this page: they copy the
            database consistently while OpenBook runs and restore it whole. Schedule the backup command on the server (cron or a
            scheduled task) and keep copies somewhere else.
        </p>
        <p>With the Docker Compose stack, from the folder with <code>docker-compose.yml</code>:</p>
        <pre class="sample">docker compose exec -T db pg_dump -U @_pg.User -d @_pg.Database -Fc &gt; openbook-$(date +%Y%m%d).dump</pre>
        <p>To restore, stop OpenBook, restore into the emptied database, and start it again:</p>
        <pre class="sample">docker compose stop openbook
docker compose exec -T db dropdb -U @_pg.User @_pg.Database
docker compose exec -T db createdb -U @_pg.User @_pg.Database
docker compose exec -T db pg_restore -U @_pg.User -d @_pg.Database --no-owner &lt; openbook-20261101.dump
docker compose start openbook</pre>
        <p class="muted">
            Elsewhere, run the same <code>pg_dump</code> and <code>pg_restore</code> against database <strong>@_pg.Database</strong> on
            <strong>@_pg.Host</strong>. Keep the Data Protection keys folder with your backups too: stored passwords, two-factor sign-in
            and connection keys can't be read without it.
        </p>
    </div>
}
else
{
<div class="card">
    <h2>Download a backup</h2>
    <p class="muted">
        A complete copy of your company file: every transaction, setting and the audit log. It's a standard
        SQLite database, so any SQLite tool can open it. Keep copies somewhere other than this computer.
    </p>
    <a class="button" href="/backup/download">Download backup</a>
</div>

<div class="card">
    <h2>Scheduled backups</h2>
    @if (Install.IsDesktop)
    {
        <p class="muted">OpenBook Desktop backs up every day to the Backups folder beside your company file until you change it here. Backups run while OpenBook is running: when the computer was off at the time, the next start makes one.</p>
    }
    <p class="muted">
        Backs up automatically to a folder (a network share, an attached drive, or a folder your cloud storage syncs) or to S3-compatible
        storage (Amazon S3, Backblaze B2, Cloudflare R2, Wasabi, MinIO), keeping the newest ones. Times are the company's time zone.
    </p>
    @if (ScheduleError is not null)
    {
        <div class="alert error" role="alert">@ScheduleError</div>
    }
    else if (Scheduled is not null)
    {
        <div class="alert success" role="status">@(Scheduled == "ran" ? "Backup made." : "Saved.")</div>
    }
    @if (_schedule.LastAttemptAt is { } last)
    {
        <p>
            Last run @last.InCompanyTime().ToString("g") ·
            @if (_schedule.LastError is { } failure)
            {
                <span class="out-of-balance">failed: @failure</span>
            }
            else if (_schedule.LastFileName is { } name)
            {
                <span>saved @name</span>
            }
        </p>
    }

    <form method="post" action="/backup/schedule">
        <AntiforgeryToken />
        <label class="check"><input type="checkbox" name="enabled" value="true" checked="@_schedule.Enabled" /> <span>Back up automatically</span></label>
        <div class="row">
            <div class="field">
                <label for="frequency">How often</label>
                <select id="frequency" name="frequency">
                    <option value="Daily" selected="@(_schedule.Frequency == BackupFrequency.Daily)">Every day</option>
                    <option value="Weekly" selected="@(_schedule.Frequency == BackupFrequency.Weekly)">Every week</option>
                </select>
            </div>
            <div class="field">
                <label for="weekday">On (weekly)</label>
                <select id="weekday" name="weekday">
                    @foreach (var day in Enum.GetValues<DayOfWeek>())
                    {
                        <option value="@day" selected="@(_schedule.Weekday == day)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(day)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="hour">From</label>
                <select id="hour" name="hour">
                    @for (var h = 0; h < 24; h++)
                    {
                        <option value="@h" selected="@(_schedule.Hour == h)">@($"{h:00}:00")</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="keep">Keep the newest</label>
                <input id="keep" name="keep" type="number" min="1" max="365" value="@_schedule.Keep" />
            </div>
        </div>
        <div class="row">
            <div class="field">
                <label for="destination">Save to</label>
                <select id="destination" name="destination">
                    <option value="Folder" selected="@(_schedule.Destination == BackupDestination.Folder)">@(Install.IsDesktop ? "A folder on this computer" : "A folder on the server")</option>
                    <option value="S3" selected="@(_schedule.Destination == BackupDestination.S3)">S3-compatible storage</option>
                </select>
            </div>
            <div class="field">
                <label for="folder">Folder (full path)</label>
                <input id="folder" name="folderPath" value="@_schedule.FolderPath" placeholder="D:\Backups\OpenBook or /mnt/backups" />
            </div>
        </div>
        <fieldset>
            <legend>S3-compatible storage</legend>
            <div class="row">
                <div class="field">
                    <label for="serviceUrl">Service URL</label>
                    <input id="serviceUrl" name="serviceUrl" value="@_schedule.ServiceUrl" placeholder="https://s3.us-east-1.amazonaws.com" />
                </div>
                <div class="field">
                    <label for="region">Region</label>
                    <input id="region" name="region" value="@_schedule.Region" placeholder="us-east-1 (auto for R2)" />
                </div>
                <div class="field">
                    <label for="bucket">Bucket</label>
                    <input id="bucket" name="bucket" value="@_schedule.Bucket" />
                </div>
                <div class="field">
                    <label for="prefix">Folder in the bucket</label>
                    <input id="prefix" name="prefix" value="@_schedule.Prefix" placeholder="openbook/" />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="accessKeyId">Access key ID</label>
                    <input id="accessKeyId" name="accessKeyId" value="@_schedule.AccessKeyId" autocomplete="off" />
                </div>
                <div class="field">
                    <label for="secretKey">Secret access key</label>
                    <input id="secretKey" name="secretKey" type="password" autocomplete="new-password"
                           placeholder="@(_schedule.ProtectedSecretKey is null ? "" : "Saved; leave blank to keep it")" />
                </div>
            </div>
            <span class="hint">Use a key that can only put, list and delete objects in this bucket. It's stored encrypted.</span>
        </fieldset>
        <div class="actions">
            <button type="submit">Save schedule</button>
        </div>
    </form>
    @if (_schedule.LastAttemptAt is not null || _schedule.FolderPath is not null || _schedule.Bucket is not null)
    {
        <form method="post" action="/backup/schedule/run" style="margin-top: 0.75rem">
            <AntiforgeryToken />
            <button type="submit" class="secondary">Back up now</button>
        </form>
    }
</div>
}

<div class="card">
    <h2>Export all data</h2>
    <p class="muted">
        Everything in plain files, to keep or to move to another system: a ZIP with one CSV file per table (as stored), every attachment,
        and a README that explains each file and column. Works with SQLite and PostgreSQL. Passwords, API keys, secrets and full tax IDs
        are left out.
    </p>
    <a class="button secondary" href="/export/download">Download export (ZIP)</a>
</div>

@if (Storage.Provider != DatabaseProvider.Postgres)
{
<div class="card">
    <h2>Restore from a backup</h2>
    <p class="muted">
        Replaces <strong>all</strong> current data with the backup. A safety copy of the current data is saved
        to the backups folder first. You'll be signed out and must sign in with an account from the backup.
    </p>

    @if (Error is not null)
    {
        <div class="alert error" role="alert">@Message(Error)</div>
    }

    <form method="post" action="/backup/restore" enctype="multipart/form-data">
        <AntiforgeryToken />
        <div class="field">
            <label for="file">Backup file</label>
            <input id="file" name="file" type="file" accept=".db,.sqlite,.sqlite3" required />
            <span class="hint">Up to @(AccountEndpoints.MaxBackupUploadBytes / 1024 / 1024) MB.</span>
        </div>
        <div class="field">
            <label for="password">Your password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required />
        </div>
        <label class="check">
            <input name="confirm" type="checkbox" value="true" required />
            <span>I understand that restoring replaces all current data.</span>
        </label>
        <button type="submit" class="danger">Restore backup</button>
    </form>
</div>
}

@code {
    private BackupSchedule _schedule = BackupSchedule.Default();

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    [SupplyParameterFromQuery]
    private string? ScheduleError { get; set; }

    [SupplyParameterFromQuery]
    private string? Scheduled { get; set; }

    private (string Host, string Database, string User) _pg;

    protected override async Task OnInitializedAsync()
    {
        if (Storage.Provider == DatabaseProvider.Postgres)
        {
            // Names only, never the password.
            var parts = new System.Data.Common.DbConnectionStringBuilder { ConnectionString = Storage.ConnectionString };
            string Part(string key, string fallback) => parts.TryGetValue(key, out var value) && value?.ToString() is { Length: > 0 } text ? text : fallback;
            var user = Part("Username", Part("User ID", "openbook"));
            _pg = (Part("Host", "localhost"), Part("Database", user), user);
        }
        else
            _schedule = await Schedules.GetAsync();
    }

    private static string Message(string code) => code switch
    {
        "backup.file_required" => "Choose a backup file to restore.",
        "backup.confirm_required" => "Tick the box to confirm you want to replace the current data.",
        "auth.wrong_password" => "That password is incorrect. Repeated failures lock the account for a few minutes.",
        "backup.invalid_file" => "That file isn't an OpenBook backup, or it's encrypted with a different key.",
        "backup.not_supported" => "This company is in PostgreSQL: back it up with pg_dump (or your server's backups) and restore with pg_restore.",
        "backup.integrity" => "The backup file is damaged and can't be restored.",
        "backup.newer_version" => "That backup was made by a newer version of OpenBook. Update OpenBook first.",
        "backup.missing_safeguards" => "That backup has been altered outside OpenBook, so it can't be trusted.",
        "backup.no_company" => "That backup doesn't contain a set-up company.",
        "backup.ledger_corrupt" => "That backup contains journal entries that don't balance.",
        _ => "The backup couldn't be restored.",
    };
}
