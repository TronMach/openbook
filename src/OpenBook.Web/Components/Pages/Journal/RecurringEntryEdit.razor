@page "/journal/recurring/new"
@page "/journal/recurring/{Id:guid}"
@rendermode InteractiveServer
@inject Operations Ops
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? L["New recurring entry"].Value : _name) · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>@(Id is null ? L["New recurring entry"].Value : _name)</h1>
        <ActionLink Class="button secondary" Href="/journal/recurring">@L["Back to recurring entries"]</ActionLink>
        @if (Id is { } id)
        {
            <ActionLink Class="button secondary" Href="@($"/audit?entityId={id}")">@L["History"]</ActionLink>
        }
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (_saved)
    {
        <div class="alert notice" role="status">@L["Saved."]</div>
    }

    @if (_notFound)
    {
        <div class="card"><p>That recurring entry doesn't exist. <a href="/journal/recurring">Back to recurring entries</a>.</p></div>
    }
    else if (_loaded && _accounts.Count == 0)
    {
        <div class="card"><p>There are no active accounts yet. <ActionLink Href="/accounts/new">Add accounts</ActionLink> first.</p></div>
    }
    else if (_loaded)
    {
        @if (!_active)
        {
            <div class="alert notice" role="status">@L["This recurring entry is inactive, so nothing posts from it."]</div>
        }

        <div class="card">
            <div class="row">
                <div class="field">
                    <label for="name">@L["Name"]</label>
                    <input id="name" @bind="_name" maxlength="100" />
                </div>
                <div class="field">
                    <label for="memo">@L["Entry memo"] <span class="muted">@L["(optional)"]</span></label>
                    <input id="memo" @bind="_memo" maxlength="1000" />
                    <span class="hint">@L["Defaults to the name."]</span>
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="interval">@L["Repeat every"]</label>
                    <div class="inline">
                        <input id="interval" class="short" type="number" min="1" max="99" @bind="_interval" />
                        <select aria-label="Frequency" @bind="_frequency">
                            @foreach (var frequency in Enum.GetValues<RecurrenceFrequency>())
                            {
                                <option value="@frequency">@RecurrenceLabels.Unit(frequency, _interval)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="field">
                    <label for="start">@L["First date"]</label>
                    <input id="start" type="date" @bind="_startDate" />
                    <span class="hint">@L["Later dates keep its day of the month (the 31st falls back to the month's last day)."]</span>
                </div>
                <div class="field">
                    <label for="end">@L["End date"] <span class="muted">@L["(optional)"]</span></label>
                    <input id="end" type="date" @bind="_endDate" />
                </div>
                <div class="field">
                    <label for="max">@L["Times"] <span class="muted">@L["(optional)"]</span></label>
                    <input id="max" class="short" type="number" min="1" @bind="_maxOccurrences" />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="basis">@L["Counts toward"]</label>
                    <select id="basis" @bind="_basis">
                        @foreach (var basis in Enum.GetValues<EntryBasis>())
                        {
                            <option value="@basis">@Labels.For(basis)</option>
                        }
                    </select>
                </div>
            </div>
            <label class="check">
                <input type="checkbox" @bind="_autoPost" />
                <span>@L["Post automatically when due"]</span>
            </label>

            <div class="row">
                <LocationField Options="_segments" @bind-Value="_locationId" />
            </div>
            <TagChecks Options="_segments" Value="_tags" />

            <JournalLinesEditor Classes="_segments.ClassColumn" Lines="_lines" Accounts="_accounts" Chart="_chart" UseNumbers="_useNumbers" Changed="StateHasChanged" />

            <div class="actions">
                <button type="button" @onclick="SaveAsync" disabled="@(!JournalLines.IsComplete(_lines) || _busy)">@L["Save"]</button>
                @if (Id is not null)
                {
                    <button type="button" class="secondary" @onclick="() => ToggleActiveAsync(false)" disabled="@_busy" title="@(_active ? null : "Dates it missed while inactive are passed over")">@(_active ? "Make inactive" : "Make active")</button>
                    @if (!_active)
                    {
                        <button type="button" class="secondary" @onclick="() => ToggleActiveAsync(true)" disabled="@_busy">Make active and catch up</button>
                    }
                }
                @if (_occurrencesPosted > 0)
                {
                    <span class="muted">@_occurrencesPosted posted so far. Changes apply to future entries only.</span>
                }
            </div>
        </div>

        @if (_posted.Count > 0)
        {
            <h2 style="margin-top: 1.5rem">@L["Posted entries"]</h2>
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr><th>@L["Entry"]</th><th>@L["Date"]</th><th class="num">@L["Amount"]</th><th>@L["Status"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _posted)
                        {
                            <tr>
                                <td><a href="/journal/@entry.Id">#@entry.Number</a></td>
                                <td>@Labels.Date(entry.Date)</td>
                                <td class="num">@Labels.Amount(entry.TotalDebits.Amount)</td>
                                <td>@(entry.Status == JournalEntryStatus.Voided ? "Voided" : "Posted")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    // Noted when the form opens, so a save can tell if the record has moved on.
    private int? _version;

    private List<Account> _accounts = [];
    private ChartOfAccounts _chart = new([]);
    private bool _useNumbers;
    private bool _loaded;
    private bool _notFound;
    private bool _busy;
    private bool _saved;
    private string? _error;

    private string _name = string.Empty;
    private string? _memo;
    private int _interval = 1;
    private RecurrenceFrequency _frequency = RecurrenceFrequency.Monthly;
    private DateOnly _startDate = CompanyTime.Today;
    private DateOnly? _endDate;
    private int? _maxOccurrences;
    private EntryBasis _basis = EntryBasis.Both;
    private bool _autoPost;
    private bool _active = true;
    private int _occurrencesPosted;
    private List<JournalLineModel> _lines = [new(), new()];
    private IReadOnlyList<JournalEntry> _posted = [];
    private SegmentOptions _segments = SegmentOptions.None;
    private Guid? _locationId;
    private HashSet<Guid> _tags = [];

    [Parameter]
    public Guid? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id is { } versionOf)
            _version = await Ops.VersionAsync<RecurringEntry>(versionOf);
        (_chart, _useNumbers) = await Ops.RunAsync(async sp => (
            await sp.GetRequiredService<AccountService>().GetChartAsync(),
            (await sp.GetRequiredService<CompanySettingsService>().GetAsync()).UseAccountNumbers));
        _accounts = _chart.Ordered(includeInactive: false).Select(x => x.Account).ToList();
        _segments = await Ops.RunAsync(SegmentOptions.LoadAsync);

        if (Id is { } id)
        {
            var template = await Ops.RunAsync<RecurringEntryService, RecurringEntry?>(s => s.GetAsync(id));
            if (template is null)
            {
                _notFound = true;
                return;
            }

            Show(template);
            var (posted, _) = await Ops.RunAsync<PostingEngine, (IReadOnlyList<JournalEntry>, int)>(e =>
                e.ListAsync(new JournalEntryFilter(Take: 200, Source: JournalEntry.RecurringSource, SourceId: id)));
            _posted = posted;
        }

        _loaded = true;
    }

    private void Show(RecurringEntry template)
    {
        _name = template.Name;
        _memo = template.Memo;
        _interval = template.Interval;
        _frequency = template.Frequency;
        _startDate = template.StartDate;
        _endDate = template.EndDate;
        _maxOccurrences = template.MaxOccurrences;
        _basis = template.Basis;
        _autoPost = template.AutoPost;
        _active = template.IsActive;
        _occurrencesPosted = template.OccurrencesPosted;
        _lines = template.Lines.OrderBy(l => l.LineNumber).Select(l => JournalLineModel.From(l.ToDraft())).ToList();
        _locationId = template.LocationId;
        _tags = template.TagIds.ToHashSet();
    }

    private async Task SaveAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        _saved = false;
        try
        {
            var details = new RecurringEntryDetails(_name, JournalLines.Drafts(_lines), _frequency, _startDate, _interval, _endDate, _maxOccurrences, _autoPost, _memo, _basis,
                _locationId, _tags.ToList());
            if (Id is { } id)
            {
                Show(await Ops.ChangeAsync<RecurringEntry, RecurringEntryService, RecurringEntry>(id, _version, s => s.UpdateAsync(id, details)));
                _version = await Ops.VersionAsync<RecurringEntry>(id);
                _saved = true;
            }
            else
            {
                var created = await Ops.RunAsync<RecurringEntryService, RecurringEntry>(s => s.CreateAsync(details));
                Navigation.NavigateTo($"/journal/recurring/{created.Id}");
            }
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleActiveAsync(bool catchUp)
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            var template = await Ops.RunAsync<RecurringEntryService, RecurringEntry>(s => s.SetActiveAsync(Id!.Value, !_active, catchUp));
            _active = template.IsActive;
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
