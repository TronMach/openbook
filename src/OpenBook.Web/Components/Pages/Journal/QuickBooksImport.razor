@page "/import/quickbooks"
@rendermode InteractiveServer
@using OpenBook.Application.Import
@inject Operations Ops

<PageTitle>Import from QuickBooks · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Import from QuickBooks (IIF)</h1>
        <a class="button secondary" href="/journal/import">CSV import</a>
    </div>

    <div class="card">
        <p>
            Upload an IIF file from QuickBooks Desktop (<em>File › Utilities › Export › Lists to IIF Files</em> for lists; transactions as exported
            by QuickBooks or another tool). OpenBook reads the chart of accounts, customers, vendors, products and services, and transactions.
            Anything already in OpenBook with the same name is left as it is. Nothing is imported unless every row is valid.
        </p>
        <p class="muted">
            Transactions come in as journal entries, one per transaction, so balances and reports are right; they don't become invoices or bills,
            so A/R and A/P aging won't list them. Estimates and orders are skipped. Inventory parts come in as non-inventory products.
        </p>
        <div class="field" style="margin-top: 1rem">
            <label for="file">IIF file</label>
            <InputFile id="file" accept=".iif,text/plain" OnChange="LoadAsync" disabled="@_busy" />
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (_imported is not null)
    {
        <div class="alert notice" role="status">
            Imported @_imported.NewCount record(s): @Summary(_imported). <a href="/accounts">Chart of accounts</a> · <a href="/journal">Journal</a>
        </div>
    }

    @if (_preview is not null && _imported is null)
    {
        <div class="card">
            <h2>Preview of @_fileName</h2>
            @foreach (var warning in _preview.Warnings)
            {
                <div class="alert notice" role="status">@warning</div>
            }
            <table class="data">
                <thead><tr><th></th><th class="num">New</th><th class="num">Already in OpenBook</th><th class="num">Skipped</th><th class="num">Errors</th></tr></thead>
                <tbody>
                    @foreach (var kind in Enum.GetValues<IifKind>())
                    {
                        <tr>
                            <td>@Plural(kind)</td>
                            <td class="num">@_preview.Count(kind, IifRowStatus.New)</td>
                            <td class="num">@_preview.Count(kind, IifRowStatus.Exists)</td>
                            <td class="num">@_preview.Count(kind, IifRowStatus.Skipped)</td>
                            <td class="num">@_preview.Count(kind, IifRowStatus.Error)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="table-wrap" style="margin-top: 1rem">
                <table class="data">
                    <thead><tr><th class="num">Line</th><th>Kind</th><th>Name</th><th>Detail</th><th>Status</th><th>Note</th></tr></thead>
                    <tbody>
                        @foreach (var row in _preview.Rows.OrderBy(r => r.Status != IifRowStatus.Error).ThenBy(r => r.Line))
                        {
                            <tr class="@(row.Status is IifRowStatus.Exists or IifRowStatus.Skipped ? "inactive" : null)">
                                <td class="num">@row.Line</td>
                                <td>@row.Kind</td>
                                <td>@row.Name</td>
                                <td class="muted">@row.Detail</td>
                                <td><span class="badge @(row.Status switch { IifRowStatus.New => "ok", IifRowStatus.Error => "warn", _ => null })">@row.Status</span></td>
                                <td class="@(row.Status == IifRowStatus.Error ? "out-of-balance" : "muted")">@row.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="actions">
                <button type="button" @onclick="ImportAsync" disabled="@(!_preview.CanImport || _busy)">Import @_preview.NewCount record(s)</button>
                @if (_preview.ErrorCount > 0)
                {
                    <span class="muted">Fix the rows with errors (shown first) and upload the file again.</span>
                }
            </div>
        </div>
    }
</div>

@code {
    private const long MaxFileBytes = 5 * 1024 * 1024;

    private string? _text;
    private string? _fileName;
    private IifImportResult? _preview;
    private IifImportResult? _imported;
    private string? _error;
    private bool _busy;

    private static string Plural(IifKind kind) => kind switch
    {
        IifKind.Account => "Accounts",
        IifKind.Customer => "Customers",
        IifKind.Vendor => "Vendors",
        IifKind.Item => "Products and services",
        _ => "Transactions",
    };

    private static string Summary(IifImportResult result) => string.Join(", ",
        Enum.GetValues<IifKind>().Select(k => (k, n: result.Count(k, IifRowStatus.New))).Where(x => x.n > 0).Select(x => $"{x.n} {Plural(x.k).ToLowerInvariant()}"));

    private async Task LoadAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        _preview = null;
        _imported = null;
        _busy = true;
        try
        {
            if (e.File.Size > MaxFileBytes)
            {
                _error = "That file is larger than 5 MB. Export lists and transactions separately.";
                return;
            }

            _fileName = e.File.Name;
            await using var stream = e.File.OpenReadStream(MaxFileBytes);
            // QuickBooks writes IIF in the Windows code page; UTF-8 BOM files are read as UTF-8.
            using var reader = new StreamReader(stream, System.Text.Encoding.Latin1, detectEncodingFromByteOrderMarks: true);
            _text = await reader.ReadToEndAsync();
            _preview = await Ops.RunAsync<IifImportService, IifImportResult>(s => s.PreviewAsync(_text));
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportAsync()
    {
        if (_text is null)
            return;
        _busy = true;
        _error = null;
        try
        {
            _imported = await Ops.RunAsync<IifImportService, IifImportResult>(s => s.ImportAsync(_text));
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
