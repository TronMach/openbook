@page "/journal/new"
@using OpenBook.Application.Reporting
@rendermode InteractiveServer
@inject Operations Ops
@inject NavigationManager Navigation

<PageTitle>@Title · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>@Title</h1>
        <ActionLink Class="button secondary" Href="/journal">Back to journal</ActionLink>
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    @if (_accounts.Count == 0 && _loaded)
    {
        <div class="card"><p>There are no active accounts yet. <ActionLink Href="/accounts/new">Add accounts</ActionLink> or <ActionLink Href="/accounts/import">import a chart of accounts</ActionLink> first.</p></div>
    }
    else
    {
        <div class="card">
            <div class="row">
                <div class="field">
                    <label for="date">Date</label>
                    <input id="date" type="date" @bind="_date" />
                </div>
                <div class="field">
                    <label for="basis">Counts toward</label>
                    <select id="basis" @bind="_basis">
                        @foreach (var basis in Enum.GetValues<EntryBasis>())
                        {
                            <option value="@basis">@Labels.For(basis)</option>
                        }
                    </select>
                    <span class="hint">Leave on "Both bases" unless this is a cash- or accrual-only adjustment.</span>
                </div>
                @if (Change is null)
                {
                    <div class="field">
                        <label for="reverse-on">Reverse on <span class="muted">(optional)</span></label>
                        <input id="reverse-on" type="date" @bind="_reverseOn" />
                        <span class="hint">For accruals: posts the opposite entry on this date, such as the first day of next month.</span>
                    </div>
                }
            </div>
            <LocationField Options="_segments" @bind-Value="_locationId" />
            <div class="field">
                <label class="check"><input type="checkbox" @bind="_adjusting" /> Adjusting entry <span class="muted">(an accountant's correction; shown apart on the trial balance worksheet)</span></label>
            </div>
            <div class="field">
                <label for="memo">Memo <span class="muted">(optional)</span></label>
                <input id="memo" @bind="_memo" maxlength="1000" />
            </div>

            <JournalLinesEditor Classes="_segments.ClassColumn" Lines="_lines" Accounts="_accounts" Chart="_chart" UseNumbers="_useNumbers" Changed="StateHasChanged" />

            <ClosedPeriodPassword Visible="_needsClosingPassword" @bind-Value="_closingPassword" />

            @if (Change is not null)
            {
                <div class="field">
                    <label for="reason">Why is it changing?</label>
                    <input id="reason" @bind="_reason" @bind:event="oninput" maxlength="500" />
                    <span class="hint">Entry #@_changing voids with this reason, and the changed entry posts with the next number. Both stay in the journal.</span>
                </div>
            }
            <div class="actions">
                <button type="button" @onclick="PostAsync" disabled="@(!CanPost || _busy || (Change is not null && string.IsNullOrWhiteSpace(_reason)))">@(Change is null ? "Post entry" : "Save change")</button>
                @if (Change is null)
                {
                    <span class="muted">To correct an entry later, use Change on its page: the old one is voided and the new one posted together.</span>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<Account> _accounts = [];
    private ChartOfAccounts _chart = new([]);
    private bool _useNumbers;
    private bool _loaded;
    private bool _busy;
    private string? _error;

    private DateOnly _date = CompanyTime.Today;
    private EntryBasis _basis = EntryBasis.Both;
    private string? _memo;
    private DateOnly? _reverseOn;
    private bool _needsClosingPassword;
    private string? _closingPassword;
    private List<JournalLineModel> _lines = [new(), new()];

    private bool CanPost => JournalLines.IsComplete(_lines);

    private SegmentOptions _segments = SegmentOptions.None;

    private Guid? _locationId;

    /// <summary>On when the page is opened for adjusting entries (?adjusting=true, from the accountant page).</summary>
    [SupplyParameterFromQuery(Name = "adjusting")]
    private bool Adjusting { get; set; }

    private bool _adjusting;

    /// <summary>An entry to start from ("Copy" on its page): dated today.</summary>
    [SupplyParameterFromQuery(Name = "copy")]
    private Guid? Copy { get; set; }

    /// <summary>A hand-entered entry being changed ("Change" on its page): voided and replaced when saved.</summary>
    [SupplyParameterFromQuery(Name = "change")]
    private Guid? Change { get; set; }

    private long? _changing;
    private string? _reason;
    private IReadOnlyCollection<Guid> _tagIds = [];

    private string Title => Change is null ? "New journal entry" : $"Change entry #{_changing}";


    protected override async Task OnInitializedAsync()
    {

        _segments = await Ops.RunAsync(SegmentOptions.LoadAsync);
        (_chart, _useNumbers) = await Ops.RunAsync(async sp => (
            await sp.GetRequiredService<AccountService>().GetChartAsync(),
            (await sp.GetRequiredService<CompanySettingsService>().GetAsync()).UseAccountNumbers));
        _accounts = _chart.Ordered(includeInactive: false).Select(x => x.Account).ToList();
        _adjusting = Adjusting;
        if ((Change ?? Copy) is { } sourceId)
        {
            var (draft, entry, adjusting) = await Ops.RunAsync(async sp => (
                await sp.GetRequiredService<PostingEngine>().DraftOfAsync(sourceId),
                await sp.GetRequiredService<PostingEngine>().GetAsync(sourceId),
                (await sp.GetRequiredService<AdjustingEntryService>().MarkedAsync()).Contains(sourceId)));
            if (draft is not null && entry is not null)
            {
                _lines = draft.Lines.Select(JournalLineModel.From).ToList();
                _memo = draft.Memo;
                _basis = draft.Basis;
                _locationId = draft.LocationId;
                _tagIds = draft.TagIds ?? [];
                _adjusting |= adjusting;
                if (Change is not null)
                {
                    _date = entry.Date;
                    _changing = entry.Number;
                }
            }
            else
            {
                Change = null;
            }
        }

        _loaded = true;
    }

    private async Task PostAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            var drafts = JournalLines.Drafts(_lines);
            var entry = await Ops.RunAsync<PostingEngine, JournalEntry>(e => Change is { } changeId
                ? e.ChangeAsync(changeId, new PostJournalEntryCommand(_date, drafts, _memo, Basis: _basis, LocationId: _locationId, TagIds: _tagIds), _reason ?? "")
                : e.PostAsync(new PostJournalEntryCommand(_date, drafts, _memo, Basis: _basis, ReverseOn: _reverseOn, LocationId: _locationId, TagIds: _tagIds)),
                _closingPassword);
            if (_adjusting)
                await Ops.RunAsync<AdjustingEntryService, bool>(async s => { await s.SetAsync(entry.Id, true); return true; });
            Navigation.NavigateTo($"/journal/{entry.Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword |= ClosedPeriod.NeedsPassword(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
