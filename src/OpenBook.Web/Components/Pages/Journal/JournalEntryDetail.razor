@page "/journal/{Id:guid}"
@using OpenBook.Application.Reporting
@using System.ComponentModel.DataAnnotations
@inject PostingEngine Engine
@inject AccountService AccountService
@inject CompanySettingsService Settings
@inject NavigationManager Navigation
@inject ClosedPeriodOverride ClosingOverride
@inject AdjustingEntryService Adjusting
@inject OpenBook.Application.Import.JournalImportService Imports

<PageTitle>Journal entry @(_entry?.Number) · OpenBook</PageTitle>

@if (_entry is null)
{
    <div class="card"><p>That journal entry doesn't exist. <a href="/journal">Back to the journal</a>.</p></div>
    return;
}

<div class="wide">
    <div class="toolbar">
        <h1>Journal entry @_entry.Number</h1>
        @if (JournalEntry.IsJournalSource(_entry.Source) && _entry.Kind == JournalEntryKind.Standard && _entry.Source != JournalEntry.AutoReversalSource)
        {
            <ActionLink Class="button secondary" Href="@($"/journal/new?copy={_entry.Id}")">Copy</ActionLink>
        }
        @if (_entry.Source == JournalEntry.ManualSource && _entry.Kind == JournalEntryKind.Standard && _entry.Status == JournalEntryStatus.Posted && _autoReversal is null)
        {
            <ActionLink Class="button secondary" Href="@($"/journal/new?change={_entry.Id}")">Change</ActionLink>
        }
        <ActionLink Class="button secondary" Href="@($"/audit?entityId={_entry.Id}")">History</ActionLink>
        <ActionLink Class="button secondary" Href="/journal">Back to journal</ActionLink>
        <ActionLink Class="button" Href="/journal/new">New entry</ActionLink>
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (_entry.Status == JournalEntryStatus.Voided)
    {
        <div class="alert notice" role="status">
            Voided on @_entry.VoidedAt?.InCompanyTime().ToString("g"): @_entry.VoidReason.
            @if (_reversalId is { } reversalId)
            {
                <a href="/journal/@reversalId">See the reversing entry</a>
            }
        </div>
    }
    @if (_entry.ReversesEntryId is { } originalId)
    {
        <div class="alert notice" role="status">This entry reverses a voided entry. <a href="/journal/@originalId">See the original</a>.</div>
    }

    <div class="card">
        <dl class="facts">
            <dt>Date</dt>
            <dd>@Labels.Date(_entry.Date)</dd>
            @if (_entry.Memo is not null)
            {
                <dt>Memo</dt>
                <dd>@_entry.Memo</dd>
            }
            <dt>Counts toward</dt>
            <dd>@Labels.For(_entry.Basis)</dd>
            <dt>Posted</dt>
            <dd>@_entry.PostedAt.InCompanyTime().ToString("g")</dd>
        </dl>
    </div>

    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th>Account</th>
                    <th class="num">Debit</th>
                    <th class="num">Credit</th>
                    <th>Memo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in _entry.Lines.OrderBy(l => l.LineNumber))
                {
                    <tr>
                        <td><a href="/accounts/@line.AccountId">@Labels.AccountName(_chart, line.AccountId, _useNumbers)</a></td>
                        <td class="num">@Labels.AmountOrBlank(line.Debit)</td>
                        <td class="num">@Labels.AmountOrBlank(line.Credit)</td>
                        <td>@line.Memo</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td>Total (@_entry.Currency)</td>
                    <td class="num">@Labels.Amount(_entry.TotalDebits.Amount)</td>
                    <td class="num">@Labels.Amount(_entry.TotalCredits.Amount)</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    @if (_entry.Source == JournalEntry.AutoReversalSource && _entry.SourceId is { } reversedId)
    {
        <div class="alert notice" role="status">This entry automatically reverses an accrual. <a href="/journal/@reversedId">See the original</a>.</div>
    }
    @if (_autoReversal is { } autoReversal)
    {
        <div class="alert notice" role="status">
            Reversed automatically on @Labels.Date(autoReversal.Date) by <a href="/journal/@autoReversal.Id">entry @autoReversal.Number</a>.
        </div>
    }
    @if (_entry.Source == JournalEntry.RecurringSource && _entry.SourceId is { } templateId)
    {
        <div class="alert notice" role="status">Posted from a <ActionLink Href="@($"/journal/recurring/{templateId}")">recurring entry</ActionLink>.</div>
    }
    @if (_entry.Source == JournalEntry.OpeningBalanceSource)
    {
        <div class="alert notice" role="status">Opening balances. <ActionLink Href="/journal/opening-balances">Enter more opening balances</ActionLink>.</div>
    }

    @if (JournalEntry.IsJournalSource(_entry.Source) && _entry.Source != JournalEntry.AutoReversalSource && _entry.Kind == JournalEntryKind.Standard)
    {
        <PostForm Action="@($"/journal/{_entry.Id}/adjusting")" data-enhance="false" class="inline no-print" style="margin-top: 1rem">
            <AntiforgeryToken />
            <input type="hidden" name="adjusting" value="@(!_isAdjusting ? "true" : "false")" />
            @if (_isAdjusting)
            {
                <span class="badge">Adjusting entry</span>
            }
            <button type="submit" class="link">@(_isAdjusting ? "Not an adjusting entry" : "Mark as an adjusting entry")</button>
        </PostForm>
    }

    @if (!JournalEntry.IsJournalSource(_entry.Source) && _entry.SourceId is { } documentId)
    {
        <p class="muted" style="margin-top: 1rem">
            Posted by a <a href="@Links.ForEntry(_entry.Source, documentId, _entry.Id)">@Links.DocumentName(_entry.Source)</a>. To correct it, void it there.
        </p>
    }
    else if (_entry.Status == JournalEntryStatus.Posted && _entry.Kind == JournalEntryKind.Standard)
    {
        <div class="card" style="margin-top: 1.5rem">
            <h2>Void this entry</h2>
            <p class="muted">Voiding posts a reversing entry on the same date, so both stay in the books and the effect cancels out.</p>
            <EditForm Model="VoidInput" FormName="void" OnValidSubmit="VoidAsync" method="post">
                <DataAnnotationsValidator />
                <div class="field">
                    <label for="reason">Reason</label>
                    <InputText id="reason" @bind-Value="VoidInput.Reason" />
                    <ValidationMessage For="() => VoidInput.Reason" />
                </div>
                <ClosedPeriodPassword Visible="_needsClosingPassword" Interactive="false" Name="VoidInput.ClosingPassword" />
                <button type="submit" class="danger">Void entry</button>
            </EditForm>
        </div>

        @if (_importStanding > 1)
        {
            <div class="card" style="margin-top: 1.5rem">
                <h2>Undo the whole import</h2>
                <p class="muted">This entry is one of @_importStanding still standing from the same import. Void them all at once: either every one is voided, or none is (for example when one has been reconciled).</p>
                <EditForm Model="ImportInput" FormName="void-import" OnValidSubmit="VoidImportAsync" method="post">
                    <DataAnnotationsValidator />
                    <div class="field">
                        <label for="import-reason">Reason</label>
                        <InputText id="import-reason" @bind-Value="ImportInput.Reason" />
                        <ValidationMessage For="() => ImportInput.Reason" />
                    </div>
                    <ClosedPeriodPassword Visible="_needsClosingPassword" Interactive="false" Name="ImportInput.ClosingPassword" />
                    <button type="submit" class="danger">Void all @_importStanding entries</button>
                </EditForm>
            </div>
        }
    }

    @if (_entry.Kind != JournalEntryKind.Reversal)
    {
        <EntryTags EntryId="_entry.Id" />
    }
    <Attachments EntityType="journal_entry" EntityId="_entry.Id" />

    <Notes EntityType="journal_entry" EntityId="_entry.Id" />
</div>

@code {
    private JournalEntry? _entry;
    private bool _isAdjusting;
    private Guid? _reversalId;
    private JournalEntry? _autoReversal;
    private ChartOfAccounts _chart = new([]);
    private bool _useNumbers;
    private string? _error;
    private bool _needsClosingPassword;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "void")]
    private VoidModel VoidInput { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "void-import")]
    private VoidModel ImportInput { get; set; } = default!;

    /// <summary>For an imported entry: how many entries of its import are still standing (including this one).</summary>
    private int _importStanding;

    protected override async Task OnInitializedAsync()
    {
        _isAdjusting = (await Adjusting.MarkedAsync()).Contains(Id);
        VoidInput ??= new();
        ImportInput ??= new();
        _useNumbers = (await Settings.GetAsync()).UseAccountNumbers;
        _chart = await AccountService.GetChartAsync();
        _entry = await Engine.GetAsync(Id);
        if (_entry?.Status == JournalEntryStatus.Voided)
            _reversalId = await Engine.FindReversalIdAsync(_entry.Id);
        if (_entry is not null && JournalEntry.IsJournalSource(_entry.Source) && _entry.Source != JournalEntry.AutoReversalSource)
        {
            var (reversals, _) = await Engine.ListAsync(new JournalEntryFilter(Take: 1, Source: JournalEntry.AutoReversalSource, SourceId: _entry.Id));
            _autoReversal = reversals.FirstOrDefault();
        }
        if (_entry is { Source: JournalEntry.ImportSource, SourceId: { } batch, Status: JournalEntryStatus.Posted })
            _importStanding = (await Imports.BatchAsync(batch)).Count(e => e.Status == JournalEntryStatus.Posted && e.Kind == JournalEntryKind.Standard);
    }

    private async Task VoidImportAsync()
    {
        try
        {
            ClosingOverride.Password = ImportInput.ClosingPassword;
            await Imports.VoidBatchAsync(_entry!.SourceId!.Value, ImportInput.Reason);
            Navigation.NavigateTo($"/journal/{Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword = ClosedPeriod.NeedsPassword(ex);
        }
    }

    private async Task VoidAsync()
    {
        try
        {
            ClosingOverride.Password = VoidInput.ClosingPassword;
            await Engine.VoidAsync(Id, VoidInput.Reason);
            Navigation.NavigateTo($"/journal/{Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword = ClosedPeriod.NeedsPassword(ex);
        }
    }

    private sealed class VoidModel
    {
        [Required(ErrorMessage = "Say why the entry is being voided.")]
        [StringLength(500)]
        public string Reason { get; set; } = string.Empty;

        public string? ClosingPassword { get; set; }
    }
}
