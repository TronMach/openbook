@page "/reports/1099"
@inject PayablesService Payables
@inject CompanySettingsService Settings
@inject Filing1099Service Filing

<PageTitle>1099 summary · OpenBook</PageTitle>

<div class="wide">
    <form class="card filters no-print" method="get" data-enhance="false">
        <div class="row">
            <div class="field">
                <label for="year">Tax year</label>
                <input id="year" name="year" type="number" min="2000" max="2100" value="@YearValue" />
            </div>
            <div class="field">
                <label for="threshold">Reporting threshold</label>
                <input id="threshold" name="threshold" type="number" step="0.01" min="0" value="@(Threshold?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))"
                       placeholder="@PayablesService.DefaultThreshold(YearValue).ToString("0", System.Globalization.CultureInfo.InvariantCulture)" />
                <span class="hint">$600 through 2025 and $2,000 for 2026. From 2027 it's adjusted for inflation: enter the IRS figure for the year.</span>
            </div>
        </div>
        <div class="actions">
            <button type="submit">Run report</button>
            <button type="button" class="secondary" onclick="window.print()">Print</button>
        </div>
    </form>

    <ReportActions Key="1099" />

    @if (Note is not null)
    {
        <div class="alert notice" role="status">@Note</div>
    }
    @if (Error is not null)
    {
        <div class="alert error" role="alert">@Error</div>
    }

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    else if (_report is not null)
    {
        <div class="report">
            <header class="report-heading">
                <h1>1099 summary for @_report.Year</h1>
                <p>@_companyName</p>
                <p>Vendors tracked for 1099s · threshold @Labels.Amount(_report.Threshold) · refunds @(_report.RefundsNetted ? "taken off the totals" : "shown, not taken off")</p>
            </header>

            @if (_report.HistoryImported)
            {
                <div class="alert warning no-print" role="status">
                    History moved in from another program has journal entries dated in @_report.Year. Payments in them aren't counted here:
                    enter what each vendor was paid before OpenBook below.
                </div>
            }

            @if (_report.Vendors.Count == 0)
            {
                <p class="muted">No vendors are tracked for 1099s. Turn on "Track payments for a 1099" on the vendor's page.</p>
            }
            else
            {
                <table class="data">
                    <thead>
                        <tr>
                            <th>Vendor</th><th>Tax ID</th><th>Form and box</th><th class="num">Paid by cash, check or bank</th><th class="num">Paid by card (1099-K)</th><th class="num">Refunds received</th><th>File a 1099?</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in _report.Vendors)
                        {
                            <tr class="@(v.MeetsThreshold ? null : "inactive")">
                                <td><a href="/vendors/@v.Vendor.Id">@v.Vendor.DisplayName</a></td>
                                <td>@(v.Vendor.MaskedTaxId ?? "Missing")</td>
                                <td>@Labels.For(v.Vendor.Form1099Box)</td>
                                <td class="num">@Labels.Amount(v.Total)@if (v.Prior > 0m) { <br /><span class="muted">incl. @Labels.Amount(v.Prior) before OpenBook</span> }</td>
                                <td class="num">@Labels.AmountOrBlank(v.CardPayments)</td>
                                <td class="num">@Labels.AmountOrBlank(v.Refunds)</td>
                                <td>
                                    @if (v.MeetsThreshold && _filed.GetValueOrDefault(v.Vendor.Id) is { } filing)
                                    {
                                        <span class="badge ok">Filed @Labels.Date(filing.FiledOn)</span>
                                        @if (filing.Amount != v.Total)
                                        {
                                            <span class="badge warn" title="Payments have changed since it was filed: a corrected form may be needed">Filed @Labels.Amount(filing.Amount)</span>
                                        }
                                        @if (filing.CopySentAt is not null)
                                        {
                                            <span class="muted">copy emailed</span>
                                        }
                                    }
                                    else if (v.MeetsThreshold)
                                    {
                                        <span class="badge @(v.Vendor.TaxId is null ? "warn" : "ok")">@(v.Vendor.TaxId is null ? "Yes, tax ID needed" : "Yes")</span>
                                    }
                                    else
                                    {
                                        <span class="muted">Below threshold</span>
                                    }
                                    @if (v.MeetsThreshold && v.Vendor.TaxId is null)
                                    {
                                        <PostForm Action="@($"/accountant/1099/request-w9/{v.Vendor.Id}")" Class="inline no-print">
                                            <input type="hidden" name="year" value="@YearValue" />
                                            <button type="submit" class="link" title="@(v.Vendor.Email is null ? "Add an email address on the vendor's page first" : null)" disabled="@(v.Vendor.Email is null)">Ask for a W-9</button>
                                        </PostForm>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="grand-total">
                            <td colspan="3">Total reportable (@_report.Vendors.Count(v => v.MeetsThreshold) @(_report.Vendors.Count(v => v.MeetsThreshold) == 1 ? "vendor" : "vendors"))</td>
                            <td class="num">@Labels.Amount(_report.Vendors.Where(v => v.MeetsThreshold).Sum(v => v.Total))</td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
                @if (_report.Vendors.Any(v => v.MeetsThreshold))
                {
                    <section class="card no-print" style="margin-top: 1rem">
                        <h2>Copies and filing</h2>
                        @if (_payerTaxId is null)
                        {
                            <p class="alert notice">The forms need your employer ID. <ActionLink Href="/settings/company">Add it under Company details</ActionLink>.</p>
                        }
                        <p class="muted">OpenBook doesn't file with the IRS. Download the filing data for the IRS's IRIS system or your filing service, then note here that it's done.</p>
                        <div class="hub-actions">
                            <ActionLink Class="button secondary" Href="@($"/accountant/1099?year={YearValue}{ThresholdQuery}")">Download filing data</ActionLink>
                            <ActionLink Class="button secondary" Href="@($"/accountant/1099/copies?year={YearValue}{ThresholdQuery}")">Vendors' copies (PDF)</ActionLink>
                        </div>
                        <PostForm Action="/accountant/1099/email-copies" Class="inline">
                            <input type="hidden" name="year" value="@YearValue" />
                            <input type="hidden" name="threshold" value="@ThresholdValue" />
                            <button type="submit" class="secondary" data-confirm="Email every vendor their copy? A vendor needs to have agreed to get it by email.">Email vendors their copies</button>
                        </PostForm>
                        <p class="hint">Sending a copy by email needs the vendor's agreement. Otherwise print the PDF and post it by the IRS's deadline.</p>
                        @if (_filed.Count == 0)
                        {
                            <PostForm Action="/accountant/1099/filed">
                                <input type="hidden" name="year" value="@YearValue" />
                                <input type="hidden" name="threshold" value="@ThresholdValue" />
                                <div class="row">
                                    <div class="field">
                                        <label for="filed-on">Filed on</label>
                                        <input id="filed-on" name="on" type="date" value="@CompanyTime.Today.ToString("yyyy-MM-dd")" />
                                    </div>
                                </div>
                                <button type="submit" class="secondary">Mark @YearValue as filed</button>
                            </PostForm>
                        }
                        else
                        {
                            <PostForm Action="/accountant/1099/filed/clear" Class="inline">
                                <input type="hidden" name="year" value="@YearValue" />
                                <button type="submit" class="secondary" data-confirm="Take back the note that @YearValue was filed?">Take back the filed note</button>
                            </PostForm>
                        }
                    </section>
                }
                <section class="card no-print" style="margin-top: 1rem">
                    <h2>Paid before OpenBook</h2>
                    <p class="muted">For a year you started part-way through: what each vendor was paid by cash, check or bank in your old books. It's added to their total; zero removes it.</p>
                    @if (_prior.Count > 0)
                    {
                        <ul>
                            @foreach (var (vendorId, prior) in _prior)
                            {
                                <li>@(_report.Vendors.FirstOrDefault(v => v.Vendor.Id == vendorId)?.Vendor.DisplayName ?? "A vendor not tracked for 1099s"): @Labels.Amount(prior.Amount)@(prior.Note is { } n ? $" ({n})" : "")</li>
                            }
                        </ul>
                    }
                    <PostForm Action="/accountant/1099/prior" data-enhance="false">
                        <input type="hidden" name="year" value="@YearValue" />
                        <div class="form-row">
                            <div class="field">
                                <label for="prior-vendor">Vendor</label>
                                <select id="prior-vendor" name="vendorId" data-search>
                                    @foreach (var v in _report.Vendors)
                                    {
                                        <option value="@v.Vendor.Id">@v.Vendor.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <div class="field"><label for="prior-amount">Paid before OpenBook</label><input id="prior-amount" name="amount" class="amount" inputmode="decimal" placeholder="0.00" /></div>
                            <div class="field"><label for="prior-note">Note</label><input id="prior-note" name="note" maxlength="200" placeholder="From the old books" /></div>
                        </div>
                        <div class="actions"><button type="submit" class="secondary">Save</button></div>
                    </PostForm>
                </section>
                <p class="hint">
                    Counts bill payments and expenses dated in the year, and what you entered as paid before OpenBook. Card payments are left out because the card company reports
                    them on Form 1099-K. This summary is a starting point: check it with your tax adviser before filing.
                </p>
            }
        </div>
    }
</div>

@code {
    private Report1099? _report;
    private string? _companyName;
    private string? _error;

    [SupplyParameterFromQuery] private int? Year { get; set; }
    [SupplyParameterFromQuery] private decimal? Threshold { get; set; }
    [SupplyParameterFromQuery] private string? Note { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }

    private IReadOnlyDictionary<Guid, OpenBook.Domain.Purchases.Filing1099> _filed = new Dictionary<Guid, OpenBook.Domain.Purchases.Filing1099>();
    private string? _payerTaxId;
    private IReadOnlyDictionary<Guid, OpenBook.Domain.Purchases.Prior1099Payment> _prior = new Dictionary<Guid, OpenBook.Domain.Purchases.Prior1099Payment>();

    private string? ThresholdValue => Threshold?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    private string ThresholdQuery => Threshold is null ? "" : $"&threshold={ThresholdValue}";

    /// <summary>Last year by default: 1099s are filed early in the following year.</summary>
    private int YearValue => Year ?? CompanyTime.Today.Year - 1;

    protected override async Task OnParametersSetAsync()
    {
        var company = await Settings.GetAsync();
        (_companyName, _payerTaxId) = (company.Name, company.TaxId);
        try
        {
            _report = await Payables.Report1099Async(YearValue, Threshold);
            _filed = await Filing.FiledAsync(YearValue);
            _prior = await Filing.PriorAsync(YearValue);
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }
}
