@page "/reports/general-ledger"
@using OpenBook.Application.Reporting
@inject FinancialReports Reports
@inject AccountService AccountService
@inject CompanySettingsService Settings
@inject ReportLedger Ledger

<PageTitle>General ledger · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <ReportFilter Action="/reports/general-ledger" Query="_query" Basis="_query.Basis">
            <div class="field">
                <label for="account">Account</label>
                <select id="account" name="accountId" data-search>
                    <option value="">All accounts</option>
                    @foreach (var (account, _) in _chart.Ordered())
                    {
                        <option value="@account.Id" selected="@(account.Id == AccountId)">@Labels.AccountName(_chart, account.Id, _useNumbers)</option>
                    }
                </select>
            </div>
            <SegmentFilterFields ClassId="@ClassId" LocationId="@LocationId" TagId="@TagId" />
        </ReportFilter>
    </div>

    <ReportActions Key="general-ledger" />

    <div class="report-heading">
        <h1>General ledger</h1>
        <p>@_companyName</p>
        <p>@_query.Describe() · @Labels.For(_report.Basis)@(_segments is null ? "" : $" · {_segments}")</p>
    </div>

    @if (_report.Accounts.Count == 0)
    {
        <div class="card"><p>No activity in this period.</p></div>
    }

    @{
        var room = _limit;
        var lineCount = _report.Accounts.Sum(a => a.Lines.Count);
    }
    @foreach (var account in _report.Accounts)
    {
        var shown = account.Lines.Take(room).ToList();
        room -= shown.Count;
        <h2 style="margin-top: 1.5rem">@Labels.AccountName(_chart, account.Account.Id, _useNumbers)</h2>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th>Date</th><th>Type</th><th class="num">No.</th><th>Description</th><th class="num">Debit</th><th class="num">Credit</th><th class="num">Balance</th></tr>
                </thead>
                <tbody>
                    @if (_query.Range.From is { } from)
                    {
                        <tr class="muted"><td>@Labels.Date(from)</td><td colspan="5">Opening balance</td><td class="num">@Labels.Amount(account.OpeningBalance)</td></tr>
                    }
                    @foreach (var line in shown)
                    {
                        <tr>
                            <td>@Labels.Date(line.Line.Date)</td>
                            <td class="muted">@(Links.DocumentName(line.Line.Source) ?? "Journal entry")</td>
                            <td class="num"><a href="@Links.ForEntry(line.Line.Source, line.Line.SourceId, line.Line.JournalEntryId)">@line.Line.EntryNumber</a></td>
                            <td>@(line.Line.EntryMemo ?? line.Line.LineMemo)</td>
                            <td class="num">@Labels.AmountOrBlank(line.Debit)</td>
                            <td class="num">@Labels.AmountOrBlank(line.Credit)</td>
                            <td class="num">@Labels.Amount(line.Balance)</td>
                        </tr>
                    }
                    @if (shown.Count < account.Lines.Count)
                    {
                        <tr class="muted"><td colspan="7">@((account.Lines.Count - shown.Count).ToString("N0")) more lines aren't shown here. The totals below count them.</td></tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4">Total for @account.FullName</td>
                        <td class="num">@Labels.Amount(account.TotalDebits)</td>
                        <td class="num">@Labels.Amount(account.TotalCredits)</td>
                        <td class="num">@Labels.Amount(account.ClosingBalance)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    @if (lineCount > _limit)
    {
        <p class="muted show-more">
            Showing @_limit.ToString("N0") of @lineCount.ToString("N0") lines. Choose one account above, or export the report for all of them.
            <a href="@MoreHref">Show @PageLines.ToString("N0") more</a>
        </p>
    }
    <p class="muted">Balances are shown in each account's normal direction: debits for assets and expenses, credits for the rest.</p>
</div>

@code {
    /// <summary>Lines drawn at a time: a long ledger as one page runs to many megabytes.</summary>
    private const int PageLines = 2000;

    private int _limit = PageLines;
    private GeneralLedger _report = null!;
    private ReportQuery _query = null!;
    private ChartOfAccounts _chart = new([]);
    private bool _useNumbers;
    private string? _companyName;

    [SupplyParameterFromQuery] private string? Preset { get; set; }
    [SupplyParameterFromQuery] private DateOnly? From { get; set; }
    [SupplyParameterFromQuery] private DateOnly? To { get; set; }
    [SupplyParameterFromQuery] private string? Basis { get; set; }
    [SupplyParameterFromQuery] private Guid? AccountId { get; set; }
    [SupplyParameterFromQuery] private string? ClassId { get; set; }
    [SupplyParameterFromQuery] private string? LocationId { get; set; }
    [SupplyParameterFromQuery] private string? TagId { get; set; }
    [SupplyParameterFromQuery] private int? Count { get; set; }
    [Inject] private NavigationManager Navigation { get; set; } = null!;
    private string? _segments;

    private string MoreHref => Navigation.GetUriWithQueryParameter("count", _limit + PageLines);

    protected override async Task OnInitializedAsync()
    {
        _limit = Math.Max(PageLines, Count ?? PageLines);
        var company = await Settings.GetAsync();
        _companyName = company.Name;
        _useNumbers = company.UseAccountNumbers;
        _chart = await AccountService.GetChartAsync();
        _query = ReportQuery.From(company, Preset, From, To, Basis, DatePreset.ThisMonth);
        var filter = ReportParameters.Parse($"classId={ClassId}&locationId={LocationId}&tagId={TagId}").Segments();
        _report = await Reports.GeneralLedgerAsync(_query.Range.From, _query.Range.To, _query.Basis, AccountId, filter);
        _segments = await Ledger.DescribeAsync(filter);
    }
}
