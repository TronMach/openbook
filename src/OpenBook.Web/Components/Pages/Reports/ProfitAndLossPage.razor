@page "/reports/profit-and-loss"
@using OpenBook.Application.Reporting
@inject FinancialReports Reports
@inject CompanySettingsService Settings

<PageTitle>Profit and loss · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <ReportFilter Action="/reports/profit-and-loss" Query="_query" Basis="_query.Basis" />
    </div>

    <div class="report-heading">
        <h1>Profit and loss</h1>
        <p>@_companyName</p>
        <p>@_query.Describe() · @Labels.For(_report.Basis)</p>
    </div>

    <table class="data statement">
        <tbody>
            <ReportSectionRows Section="_report.Income" LinkQuery="@_link" />
            @if (_report.CostOfGoodsSold.Rows.Count > 0)
            {
                <ReportSectionRows Section="_report.CostOfGoodsSold" LinkQuery="@_link" />
                <tr class="grand-total"><td>Gross profit</td><td class="num">@Labels.Amount(_report.GrossProfit)</td></tr>
            }
            <ReportSectionRows Section="_report.Expenses" LinkQuery="@_link" />
            @if (_report.OtherIncome.Rows.Count + _report.OtherExpenses.Rows.Count > 0)
            {
                <tr class="grand-total"><td>Net operating income</td><td class="num">@Labels.Amount(_report.NetOperatingIncome)</td></tr>
                @if (_report.OtherIncome.Rows.Count > 0)
                {
                    <ReportSectionRows Section="_report.OtherIncome" LinkQuery="@_link" />
                }
                @if (_report.OtherExpenses.Rows.Count > 0)
                {
                    <ReportSectionRows Section="_report.OtherExpenses" LinkQuery="@_link" />
                }
                <tr class="subtotal"><td>Net other income</td><td class="num">@Labels.Amount(_report.NetOtherIncome)</td></tr>
            }
            <tr class="grand-total"><td>Net income</td><td class="num">@Labels.Amount(_report.NetIncome)</td></tr>
        </tbody>
    </table>
</div>

@code {
    private ProfitAndLoss _report = null!;
    private ReportQuery _query = null!;
    private string? _companyName;
    private string _link = string.Empty;

    [SupplyParameterFromQuery] private string? Preset { get; set; }
    [SupplyParameterFromQuery] private DateOnly? From { get; set; }
    [SupplyParameterFromQuery] private DateOnly? To { get; set; }
    [SupplyParameterFromQuery] private string? Basis { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var company = await Settings.GetAsync();
        _companyName = company.Name;
        _query = ReportQuery.From(company, Preset, From, To, Basis, DatePreset.ThisFiscalYearToDate);
        _report = await Reports.ProfitAndLossAsync(_query.Range.From ?? DateRanges.Beginning, _query.Range.To, _query.Basis);
        _link = _query.ToQueryString();
    }
}
