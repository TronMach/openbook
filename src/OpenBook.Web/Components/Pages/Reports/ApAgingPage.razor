@page "/reports/ap-aging"
@inject PayablesService Payables
@inject CompanySettingsService Settings

<PageTitle>A/P aging · OpenBook</PageTitle>

<div class="wide">
    <form class="card filters no-print" method="get" data-enhance="false">
        <div class="row">
            <div class="field">
                <label for="as-of">As of</label>
                <input id="as-of" name="asOf" type="date" value="@AsOfDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="field">
                <label for="detail">Show</label>
                <select id="detail" name="detail">
                    <option value="false" selected="@(!Detail)">Summary by vendor</option>
                    <option value="true" selected="@Detail">Each open bill and credit</option>
                </select>
            </div>
        </div>
        <div class="actions">
            <button type="submit">Run report</button>
            <button type="button" class="secondary" onclick="window.print()">Print</button>
        </div>
    </form>

    <ReportActions Key="ap-aging" />

    <div class="report">
        <header class="report-heading">
            <h1>Accounts payable aging @(Detail ? "detail" : "summary")</h1>
            <p>@_companyName</p>
            <p>As of @Labels.Date(AsOfDate) · days past each bill's due date</p>
        </header>

        @if (_report is null || _report.Vendors.Count == 0)
        {
            <p class="muted">Nothing is owed to vendors on this date.</p>
        }
        else
        {
            <table class="data aging-report">
                <thead>
                    <tr>
                        <th>Vendor</th>
                        @if (Detail)
                        {
                            <th>Due</th><th class="num">Days past due</th>
                        }
                        <th class="num">Current</th><th class="num">1–30</th><th class="num">31–60</th><th class="num">61–90</th><th class="num">Over 90</th><th class="num">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in _report.Vendors)
                    {
                        if (Detail)
                        {
                            <tr class="section-heading"><td colspan="9"><a href="/vendors/@v.Vendor.Id">@v.Vendor.DisplayName</a></td></tr>
                            @foreach (var open in v.Bills)
                            {
                                <tr>
                                    <td class="indent-1"><a href="/purchases/bills/@open.Bill.Id">Bill @(open.Bill.Reference ?? Labels.Date(open.Bill.Date))</a></td>
                                    <td>@Labels.Date(open.Bill.DueDate)</td>
                                    <td class="num">@(open.DaysPastDue > 0 ? open.DaysPastDue : "")</td>
                                    <Cells Buckets="AgingBuckets.Zero.Add(open.DaysPastDue, open.Balance)" />
                                </tr>
                            }
                            @foreach (var (credit, amount) in v.Credits)
                            {
                                <tr>
                                    <td class="indent-1"><a href="/purchases/vendor-credits/@credit.Id">Credit @credit.Reference</a></td>
                                    <td>@Labels.Date(credit.Date)</td>
                                    <td></td>
                                    <Cells Buckets="AgingBuckets.Zero with { Current = -amount }" />
                                </tr>
                            }
                            <tr class="subtotal"><td colspan="3">Total @v.Vendor.DisplayName</td><Cells Buckets="v.Buckets" /></tr>
                        }
                        else
                        {
                            <tr>
                                <td><a href="/reports/ap-aging?asOf=@AsOfDate.ToString("yyyy-MM-dd")&detail=true">@v.Vendor.DisplayName</a></td>
                                <Cells Buckets="v.Buckets" />
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr class="grand-total">
                        <td colspan="@(Detail ? 3 : 1)">Total</td>
                        <Cells Buckets="_report.Totals" />
                    </tr>
                </tfoot>
            </table>
        }
    </div>
</div>

@code {
    private PayablesAgingReport? _report;
    private string? _companyName;

    [SupplyParameterFromQuery] private DateOnly? AsOf { get; set; }
    [SupplyParameterFromQuery] private bool Detail { get; set; }

    private DateOnly AsOfDate => AsOf ?? DateOnly.FromDateTime(DateTime.Today);

    protected override async Task OnParametersSetAsync()
    {
        _companyName = (await Settings.GetAsync()).Name;
        _report = await Payables.AgingAsync(AsOfDate);
    }
}
