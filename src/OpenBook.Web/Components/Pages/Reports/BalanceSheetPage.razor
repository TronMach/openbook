@page "/reports/balance-sheet"
@using OpenBook.Application.Reporting
@inject FinancialReports Reports
@inject CompanySettingsService Settings

<PageTitle>Balance sheet · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <ReportFilter Action="/reports/balance-sheet" AsOf="_report.AsOf" Basis="_report.Basis" />
    </div>

    <div class="report-heading">
        <h1>Balance sheet</h1>
        <p>@_companyName</p>
        <p>As of @Labels.Date(_report.AsOf) · @Labels.For(_report.Basis)</p>
    </div>

    @if (!_report.IsBalanced)
    {
        <div class="alert error" role="alert">Assets and liabilities plus equity differ by @Labels.Amount(_report.TotalAssets - _report.TotalLiabilitiesAndEquity). Please report this as a bug.</div>
    }

    <table class="data statement">
        <tbody>
            <tr class="section-heading"><td colspan="2"><strong>Assets</strong></td></tr>
            @foreach (var section in new[] { _report.CurrentAssets, _report.FixedAssets, _report.OtherAssets }.Where(s => s.Rows.Count > 0))
            {
                <ReportSectionRows Section="section" LinkQuery="@_link" />
            }
            <tr class="grand-total"><td>Total assets</td><td class="num">@Labels.Amount(_report.TotalAssets)</td></tr>

            <tr class="section-heading"><td colspan="2"><strong>Liabilities and equity</strong></td></tr>
            @foreach (var section in new[] { _report.CurrentLiabilities, _report.LongTermLiabilities }.Where(s => s.Rows.Count > 0))
            {
                <ReportSectionRows Section="section" LinkQuery="@_link" />
            }
            <tr class="subtotal"><td>Total liabilities</td><td class="num">@Labels.Amount(_report.TotalLiabilities)</td></tr>
            <ReportSectionRows Section="_report.Equity" LinkQuery="@_link" />
            <tr class="grand-total"><td>Total liabilities and equity</td><td class="num">@Labels.Amount(_report.TotalLiabilitiesAndEquity)</td></tr>
        </tbody>
    </table>
    <p class="muted">Retained earnings is net income from before this fiscal year (which began @Labels.Date(_fiscalStart)); net income is this fiscal year's so far. No closing entries are needed: <a href="/settings/close-books">closing a year</a> locks it.</p>
</div>

@code {
    private BalanceSheet _report = null!;
    private string? _companyName;
    private string _link = string.Empty;
    private DateOnly _fiscalStart;

    [SupplyParameterFromQuery] private DateOnly? AsOf { get; set; }
    [SupplyParameterFromQuery] private string? Basis { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var company = await Settings.GetAsync();
        _companyName = company.Name;
        ReportBasis? basis = Enum.TryParse<ReportBasis>(Basis, ignoreCase: true, out var b) ? b : null;
        _report = await Reports.BalanceSheetAsync(AsOf ?? DateOnly.FromDateTime(DateTime.Today), basis);
        _fiscalStart = company.FiscalYearStart(_report.AsOf);
        _link = $"preset=Custom&from={DateRanges.Beginning:yyyy-MM-dd}&to={_report.AsOf:yyyy-MM-dd}&basis={_report.Basis}";
    }
}
