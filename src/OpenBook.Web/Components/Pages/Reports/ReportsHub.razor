@page "/reports"
@using OpenBook.Application.Reporting
@inject SavedReportService SavedReports
@inject ReportCatalog Catalog
@inject OpenBook.Application.Companies.ICompanyStore Companies
@inject ViewModeService Views

<PageTitle>Reports · OpenBook</PageTitle>

@if (_simple && !All)
{
    @* The simple view starts with the reports a one-person business uses; every other report is a link away. *@
    <div class="wide">
        <div class="toolbar">
            <h1>Reports</h1>
            <ActionLink Class="button secondary" Href="/dashboard">Dashboard</ActionLink>
            <ActionLink Class="button secondary" Href="/reports?all=true">All reports</ActionLink>
        </div>
        <div class="report-list">
            @foreach (var report in Everyday.Select(Catalog.Find).OfType<ReportDefinition>().Where(r => HttpContext.User.CanReach(r.Path)))
            {
                <a class="card" href="@report.Path">
                    <h3>@report.Title</h3>
                    <p class="muted">@report.Description</p>
                </a>
            }
        </div>
        @if (_saved.Count > 0)
        {
            <h2>Saved reports</h2>
            <ul>
                @foreach (var report in _saved)
                {
                    <li><a href="@Href(report)">@report.Name</a></li>
                }
            </ul>
        }
        <p><a href="/reports?all=true">All reports</a>: comparisons, budgets, inventory valuation, the general ledger, custom reports and more.</p>
    </div>
    return;
}

<div class="wide">
    <h1>Reports</h1>
    <p class="muted">
        Most reports run on an accrual or cash basis (cash counts invoices and bills when they're paid). Every report can be
        exported as CSV, Excel or PDF, and saved with its settings to run again.
    </p>

    <p>
        <ActionLink Class="button" Href="/dashboard">Dashboard</ActionLink>
        <ActionLink Class="button secondary" Href="/reports/builder">Build a custom report</ActionLink>
        <ActionLink Class="button secondary" Href="/reports/schedules">Email reports on a schedule</ActionLink>
        <ActionLink Class="button secondary" Href="/reports/cash-forecast">Cash-flow forecast</ActionLink>
        <ActionLink Class="button secondary" Href="/accountant">Accountant tools</ActionLink>
    </p>

    @if (_saved.Count > 0)
    {
        <h2>Saved reports</h2>
        <table class="data">
            <thead><tr><th>Name</th><th>Report</th><th>Saved by</th><th><span class="visually-hidden">@L["Actions"]</span></th></tr></thead>
            <tbody>
                @foreach (var report in _saved)
                {
                    var definition = Catalog.Find(report.ReportKey);
                    <tr>
                        <td><a href="@Href(report)">@report.Name</a></td>
                        <td>@(definition?.Title ?? report.ReportKey)</td>
                        <td class="muted">@report.CreatedBy, @Labels.Date(DateOnly.FromDateTime(report.CreatedAt.InCompanyTime().DateTime))</td>
                        <td class="num">
                            <PostForm Action="@($"/reports/saved/{report.Id}/delete")" class="inline-form" data-enhance="false">
                                <AntiforgeryToken />
                                <button type="submit" class="link">Delete</button>
                            </PostForm>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @foreach (var group in Catalog.All.GroupBy(d => d.Group).OrderBy(g => _first.IndexOf(g.Key) is var i and >= 0 ? i : int.MaxValue))
    {
        <h2>@group.Key</h2>
        <div class="report-list">
            @foreach (var report in group)
            {
                <a class="card" href="@report.Path">
                    <h3>@report.Title</h3>
                    <p class="muted">@report.Description</p>
                </a>
            }
            @if (group.Key == "Accountant")
            {
                <a class="card" href="/journal">
                    <h3>Transaction list</h3>
                    <p class="muted">All transactions, newest first, filtered by date.</p>
                </a>
            }
            @if (group.Key == "Taxes")
            {
                <a class="card" href="/reports/tax-lines">
                    <h3>Tax lines</h3>
                    <p class="muted">Assign income and expense accounts to the lines of your tax return.</p>
                </a>
            }
            @if (group.Key == "Budgets")
            {
                <a class="card" href="/reports/budgets">
                    <h3>Budgets</h3>
                    <p class="muted">Plan income and expenses by month for a fiscal year.</p>
                </a>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<OpenBook.Domain.Reporting.SavedReport> _saved = [];
    private List<string> _first = [];
    private bool _simple;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // The whole catalog, also in the simple view.
    [SupplyParameterFromQuery]
    private bool All { get; set; }

    // What the simple view lists first, in this order.
    private static readonly string[] Everyday =
    [
        "profit-and-loss", "balance-sheet", "ar-aging", "ap-aging", "sales-by-customer", "sales-by-item",
        "expenses-by-vendor", "inventory-stock", "sales-tax", "tax-summary",
    ];

    protected override async Task OnInitializedAsync()
    {
        _simple = (await Views.CurrentAsync()).Mode == OpenBook.Domain.Companies.ViewMode.Simple;
        _saved = await SavedReports.ListAsync();
        if (await Companies.GetCompanyAsync(default) is { } company)
            _first = Editions.ReportGroupsFirst(company.Edition).ToList();
    }

    private string Href(OpenBook.Domain.Reporting.SavedReport report) =>
        (Catalog.Find(report.ReportKey)?.Path ?? "/reports") + (report.Query.Length > 0 ? "?" + report.Query : "");
}
