@page "/reports"

<PageTitle>Reports · OpenBook</PageTitle>

<div class="wide">
    <h1>Reports</h1>
    <p class="muted">Every report can run on an accrual or cash basis. Cash basis counts invoices and bills when they're paid.</p>

    <div class="report-list">
        <a class="card" href="/reports/profit-and-loss">
            <h2>Profit and loss</h2>
            <p class="muted">Income and expenses over a period, and the net income they leave.</p>
        </a>
        <a class="card" href="/reports/balance-sheet">
            <h2>Balance sheet</h2>
            <p class="muted">What the business owns and owes on a date, and the owner's equity.</p>
        </a>
        <a class="card" href="/reports/trial-balance">
            <h2>Trial balance</h2>
            <p class="muted">Every account's debit or credit balance on a date. Debits always equal credits.</p>
        </a>
        <a class="card" href="/reports/general-ledger">
            <h2>General ledger</h2>
            <p class="muted">Every transaction in each account, with opening and running balances.</p>
        </a>
        <a class="card" href="/reports/journal">
            <h2>Journal</h2>
            <p class="muted">Each journal entry in a period with all its debits and credits.</p>
        </a>
        <a class="card" href="/journal">
            <h2>Transaction list</h2>
            <p class="muted">All transactions, newest first, filtered by date.</p>
        </a>
    </div>
</div>
