@page "/setup"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using OpenBook.Application.Import.Migration
@using OpenBook.Domain.Companies
@inject CompanySetupService SetupService
@inject MigrationImportService ImportService
@inject MigrationSetupService MigrationSetup
@inject SetupState State
@inject ChartTemplates Templates
@inject ItemService Items
@inject NavigationManager Navigation
@inject SetupCode Code

<PageTitle>Set up your company · OpenBook</PageTitle>

<div class="card">
    <h1>Set up your company</h1>
    <p class="muted">This creates your company file and the account you'll sign in with. You can change company details later.</p>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (_errorRows.Count > 0)
    {
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th class="num">Row</th><th>Kind</th><th>Name</th><th>Problem</th></tr></thead>
                <tbody>
                    @foreach (var row in _errorRows.Take(50))
                    {
                        <tr><td class="num">@row.Line</td><td>@row.Kind</td><td>@row.Name</td><td class="out-of-balance">@row.Message</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Upload is { } upload)
    {
        <div class="alert notice" role="status">
            <strong>Setting up from @upload.FileName.</strong> @upload.Summary
            Creating the company imports all of it, or nothing if a row has a problem.
            <a href="/setup">Use another file, or start without one</a>
        </div>
    }
    else
    {
        <form method="post" enctype="multipart/form-data" @formname="read" @onsubmit="ReadAsync">
            <AntiforgeryToken />
            <fieldset>
                <legend>Moving from QuickBooks?</legend>
                @if (Code.Required)
                {
                    <div class="field">
                        <label for="read-setup-code">Setup code</label>
                        <input id="read-setup-code" name="SetupCode" autocomplete="off" spellcheck="false" required />
                    </div>
                }
                <p class="hint muted">Upload your export: OpenBook fills in the company details it finds below, and imports your accounts, customers, vendors, products and transactions when you create the company. Or skip this and start with a starter chart of accounts.</p>
                <div class="row">
                    <div class="field">
                        <label for="source">Export from</label>
                        <select id="source" name="Source">
                            @foreach (var (key, label) in ImportService.Sources())
                            {
                                <option value="@key" selected="@(key == Source)">@label</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="file">Export file</label>
                        <input id="file" type="file" name="file" accept=".iif,.xml,.qbxml,.json,.gnucash,.gz,.csv,.txt" required />
                    </div>
                </div>
                <p class="hint muted">
                    Company details come from QuickBooks Desktop qbXML files with a company query, QuickBooks Online files with CompanyInfo, and GnuCash books.
                    IIF files don't include them, so type those in yourself. The user guide's Moving in chapter says what to export from each program.
                    For a QuickBooks Desktop company (.QBW, or a .QBM or .QBB restored in QuickBooks), the QuickBooks export helper that comes with
                    OpenBook Desktop saves qbXML files with everything; upload the first here and the rest under Settings › Move in from another program.
                </p>
                <button type="submit" class="secondary">Read the file</button>
            </fieldset>
        </form>
    }

    <EditForm Model="Input" FormName="setup" OnValidSubmit="SetUpAsync" method="post">
        <DataAnnotationsValidator />
        <input type="hidden" name="Input.ImportToken" value="@Input.ImportToken" />

        @if (Code.Required)
        {
            <fieldset>
                <legend>Setup code</legend>
                <div class="field">
                    <label for="setup-code">Setup code</label>
                    <InputText id="setup-code" @bind-Value="Input.SetupCode" autocomplete="off" spellcheck="false" />
                    <span class="hint">Proves you run this server. OpenBook writes it to its log when it starts without a company
                        (with Docker: <code>docker compose logs openbook</code>), unless it was chosen in the setting OpenBook:SetupCode.</span>
                </div>
            </fieldset>
        }

        <fieldset>
            <legend>1. Company</legend>
            <div class="field">
                <label for="company-name">Company name</label>
                <InputText id="company-name" @bind-Value="Input.CompanyName" autocomplete="organization" />
                <ValidationMessage For="() => Input.CompanyName" />
            </div>
            <div class="row">
                <div class="field">
                    <label for="legal-name">Legal name <span class="muted">(optional)</span></label>
                    <InputText id="legal-name" @bind-Value="Input.LegalName" />
                </div>
                <div class="field">
                    <label for="business-type">Legal structure</label>
                    <InputSelect id="business-type" @bind-Value="Input.BusinessType">
                        @foreach (var type in Enum.GetValues<BusinessType>())
                        {
                            <option value="@type">@Labels.For(type)</option>
                        }
                    </InputSelect>
                    <span class="hint">Picks the starter chart of accounts and the tax form your accounts are mapped to.</span>
                </div>
            </div>
            <div class="field">
                <label for="edition">Which menu suits your work?</label>
                <InputSelect id="edition" @bind-Value="Input.Edition">
                    @foreach (var edition in Enum.GetValues<Edition>())
                    {
                        <option value="@edition">@Editions.Label(edition): @Editions.Description(edition)</option>
                    }
                </InputSelect>
                <span class="hint">Sets the menu and home page to suit. You can change it later in Settings; everything stays available either way.</span>
            </div>
            <div class="field">
                <label for="region">Region</label>
                <InputSelect id="region" @bind-Value="Input.Region">
                    @foreach (var region in OpenBook.Web.Localization.AppCulture.Regions)
                    {
                        <option value="@region">@OpenBook.Web.Localization.AppCulture.RegionName(region): @CompanyTime.Today.ToString("d", System.Globalization.CultureInfo.GetCultureInfo(region))</option>
                    }
                </InputSelect>
                <span class="hint">How dates look on invoices, statements and emails. You can change it later in Settings.</span>
            </div>
            <div class="field">
                <label for="view">How should OpenBook look?</label>
                <InputSelect id="view" @bind-Value="Input.DefaultViewMode">
                    <option value="@ViewMode.Simple">Simple view: a short menu and a home page that walks through each step (suggested when one person runs the business)</option>
                    <option value="@ViewMode.Full">Full view: every area of OpenBook in the menu</option>
                </InputSelect>
                <span class="hint">Both work on the same books. Anyone can switch between them at any time with the link at the top of the page.</span>
            </div>
            <div class="row">
                <div class="field">
                    <label for="sells">What do you sell?</label>
                    <InputSelect id="sells" @bind-Value="Input.Sells">
                        <option value="@StarterSales.Both">Services and products</option>
                        <option value="@StarterSales.Services">Services: work I do</option>
                        <option value="@StarterSales.Products">Products: things I sell</option>
                    </InputSelect>
                </div>
                <div class="field">
                    <label class="check">
                        <InputCheckbox @bind-Value="Input.KeepsStock" />
                        <span>I keep products in stock and want them counted</span>
                    </label>
                    <label class="check">
                        <InputCheckbox @bind-Value="Input.ChargesSalesTax" />
                        <span>I charge sales tax</span>
                    </label>
                </div>
            </div>
            <div class="field">
                <label for="basis">When do you count income and expenses?</label>
                <InputSelect id="basis" @bind-Value="Input.DefaultReportBasis">
                    <option value="@ReportBasis.Accrual">When I send the invoice or get the bill (accrual)</option>
                    <option value="@ReportBasis.Cash">When the money comes in or goes out (cash)</option>
                </InputSelect>
                <span class="hint">Reports start on this; each report can show the other. Many small businesses file on cash; ask your tax adviser if you aren't sure.</span>
            </div>
            <span class="hint">In the simple view these set up your chart of accounts for you, and sales tax is next if you charge it. In the full view you choose a starter chart on the next page. Starting from an export uses the accounts in it instead.</span>
            <div class="row">
                <div class="field">
                    <label for="email">Email <span class="muted">(optional)</span></label>
                    <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="email" />
                    <ValidationMessage For="() => Input.Email" />
                </div>
                <div class="field">
                    <label for="phone">Phone <span class="muted">(optional)</span></label>
                    <InputText id="phone" type="tel" @bind-Value="Input.Phone" autocomplete="tel" />
                </div>
            </div>
            <div class="field">
                <label for="address">Address <span class="muted">(optional, printed on invoices)</span></label>
                <InputTextArea id="address" rows="3" @bind-Value="Input.Address" autocomplete="street-address" />
            </div>
        </fieldset>

        <fieldset>
            <legend>2. Books</legend>
            <div class="row">
                <div class="field">
                    <label for="fiscal-month">Fiscal year starts in</label>
                    <InputSelect id="fiscal-month" @bind-Value="Input.FiscalYearStartMonth">
                        @for (var month = 1; month <= 12; month++)
                        {
                            <option value="@month">@Labels.Month(month)</option>
                        }
                    </InputSelect>
                    <span class="hint">Most small businesses use January.</span>
                </div>
                <div class="field">
                    <label for="currency">Home currency</label>
                    <InputText id="currency" @bind-Value="Input.HomeCurrency" maxlength="3" />
                    <span class="hint">3-letter code, e.g. USD. This can't be changed later.</span>
                    <ValidationMessage For="() => Input.HomeCurrency" />
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>3. Your sign-in</legend>
            <div class="field">
                <label for="username">Username</label>
                <InputText id="username" @bind-Value="Input.Username" autocomplete="username" />
                <ValidationMessage For="() => Input.Username" />
            </div>
            <div class="row">
                <div class="field">
                    <label for="password">Password</label>
                    <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" />
                    <span class="hint">At least @User.MinPasswordLength characters.</span>
                    <ValidationMessage For="() => Input.Password" />
                </div>
                <div class="field">
                    <label for="confirm">Confirm password</label>
                    <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
                    <ValidationMessage For="() => Input.ConfirmPassword" />
                </div>
            </div>
            <p class="hint muted">If you forget it, someone with access to this computer can reset it by running OpenBook with <code>reset-password</code>.</p>
        </fieldset>

        <button type="submit">@(Upload is null ? "Create company" : "Create company and import")</button>
    </EditForm>
</div>

@code {
    private string? _error;
    private IReadOnlyList<MigrationRow> _errorRows = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private SetupModel Input { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "read")]
    private string? Source { get; set; }

    private SetupUpload? Upload => State.Held(Input.ImportToken);

    protected override void OnInitialized()
    {
        Input ??= new();
        Input.Region ??= Company.Regions.Contains(System.Globalization.CultureInfo.CurrentCulture.Name)
            ? System.Globalization.CultureInfo.CurrentCulture.Name : Company.Regions[0];
    }

    private async Task ReadAsync()
    {
        string? typed = HttpContext.Request.Form["SetupCode"];
        if (!Code.Matches(typed))
        {
            _error = WrongCode;
            return;
        }

        Input.SetupCode = typed;
        var file = HttpContext.Request.Form.Files.GetFile("file");
        var source = ImportService.Sources().FirstOrDefault(s => s.Key == Source).Key ?? nameof(MigrationSource.QuickBooksIif);
        if (file is null || file.Length == 0)
        {
            _error = "Choose the export file to read.";
            return;
        }

        if (file.Length > MigrationImportService.MaxBytes)
        {
            _error = "That file is larger than 20 MB. Set up the company first, then import lists and transactions separately with Move in from another program.";
            return;
        }

        byte[] content;
        using (var buffer = new MemoryStream())
        {
            await file.CopyToAsync(buffer, HttpContext.RequestAborted);
            content = buffer.ToArray();
        }

        try
        {
            var company = MigrationSetupService.CompanyIn(source, content);
            var data = ImportService.Read(source, content, company?.Currency ?? Input.HomeCurrency);
            Fill(company);
            Input.ImportToken = State.Hold(source, Path.GetFileName(file.FileName), content, Describe(data, company));
        }
        catch (DomainException ex)
        {
            _error = $"That file couldn't be read: {ex.Message}";
        }
    }

    private void Fill(SourceCompany? company)
    {
        if (company is null)
            return;
        Input.CompanyName = company.Name ?? Input.CompanyName;
        Input.LegalName = company.LegalName ?? Input.LegalName;
        Input.Email = company.Email ?? Input.Email;
        Input.Phone = company.Phone ?? Input.Phone;
        Input.Address = company.Address ?? Input.Address;
        Input.FiscalYearStartMonth = company.FiscalYearStartMonth ?? Input.FiscalYearStartMonth;
        Input.HomeCurrency = company.Currency?.ToUpperInvariant() ?? Input.HomeCurrency;
        if (company.BusinessType is { } type)
        {
            Input.BusinessType = type;
            if (type == BusinessType.Nonprofit)
                Input.Edition = Edition.Nonprofit;
        }
    }

    private static string Describe(MigrationData data, SourceCompany? company)
    {
        var counts = new (int Count, string One, string Many)[]
        {
            (data.Accounts.Count(a => a.SkipReason is null), "account", "accounts"),
            (data.Customers.Count(c => c.SkipReason is null), "customer", "customers"),
            (data.Vendors.Count(v => v.SkipReason is null), "vendor", "vendors"),
            (data.Items.Count(i => i.Type is not null), "product or service", "products and services"),
            (data.Transactions.Count(t => t.SkipReason is null), "transaction", "transactions"),
        }.Where(c => c.Count > 0).Select(c => $"{c.Count} {(c.Count == 1 ? c.One : c.Many)}").ToList();
        var found = counts.Count == 0 ? "It has nothing to import." : $"It has {string.Join(", ", counts)}.";
        var left = data.Accounts.Count(a => a.SkipReason is not null) + data.Items.Count(i => i.Type is null) + data.Transactions.Count(t => t.SkipReason is not null);
        if (left > 0)
            found += $" {left} other row(s) won't come in.";
        if (data.Warnings.Count > 0)
            found += $" {string.Join(" ", data.Warnings.Take(5))}";
        var details = company is null
            ? "It doesn't include the company's details, so fill them in below."
            : "The company details below come from it; check them.";
        return $"{found} {details}";
    }

    private const string WrongCode = "That setup code isn't right. It's in OpenBook's log from when it started.";

    private async Task SetUpAsync()
    {
        if (!Code.Matches(Input.SetupCode))
        {
            _error = WrongCode;
            return;
        }

        var upload = Upload;
        if (Input.ImportToken is { Length: > 0 } && upload is null)
        {
            _error = "The uploaded file is no longer held (it's kept for an hour). Upload it again.";
            Input.ImportToken = null;
            return;
        }

        var command = new SetUpCompanyCommand(
            Input.CompanyName,
            Input.BusinessType,
            Input.HomeCurrency,
            Input.FiscalYearStartMonth,
            Input.Username,
            Input.Password,
            Input.LegalName,
            Input.Email,
            Input.Phone,
            Input.Address,
            Input.Edition,
            Input.DefaultViewMode ?? ViewMode.Simple,
            Input.Region,
            Input.DefaultReportBasis);
        try
        {
            User owner;
            if (upload is null)
            {
                owner = await SetupService.SetUpAsync(command, HttpContext.RequestAborted);
            }
            else
            {
                // Nobody is signed in yet: the imported records are audited as made by the owner being created.
                HttpContext.User = new ClaimsPrincipal(new ClaimsIdentity([new Claim(ClaimTypes.Name, User.NormalizeUsername(Input.Username))], "setup"));
                var result = await MigrationSetup.SetUpAsync(command, upload.Source, upload.Content, HttpContext.RequestAborted);
                if (result.Owner is null)
                {
                    _errorRows = [.. result.Result.Rows.Where(r => r.Status == MigrationRowStatus.Error)];
                    _error = $"{_errorRows.Count} row(s) in {upload.FileName} have problems, so nothing was set up. Fix them in your old program or the file and upload it again.";
                    Input.ImportToken = null;
                    return;
                }

                owner = result.Owner;
            }

            State.MarkSetUp();
            await WebSecurity.SignInAsync(HttpContext, new AuthenticatedUser(owner.Id, owner.Username, owner.SecurityStamp, owner.Role));
            if (upload is not null)
            {
                Navigation.NavigateTo("/accounts?movedIn=true");
                return;
            }

            // The simple view sets the accounts up from the answers; the full view's next page offers the starter charts.
            if (command.DefaultViewMode == ViewMode.Simple && await StarterChartAsync(owner))
                Navigation.NavigateTo(Input.ChargesSalesTax ? "/sales-tax?welcome=true" : "/");
            else
                Navigation.NavigateTo("/accounts");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }

    // The starter chart for the business type, trimmed to what they sell, audited as the new owner. False when it
    // couldn't be applied, so they choose one themselves on the accounts page.
    private async Task<bool> StarterChartAsync(User owner)
    {
        HttpContext.User = new ClaimsPrincipal(new ClaimsIdentity([new Claim(ClaimTypes.Name, owner.Username)], "setup"));
        try
        {
            var template = Input.Edition == Edition.Nonprofit ? "nonprofit" : ChartTemplates.ForBusinessType(Input.BusinessType).Key;
            await Templates.ApplyAsync(template, new StarterAnswers(Input.Sells ?? StarterSales.Both, Input.KeepsStock), HttpContext.RequestAborted);
            if (Input.Sells != StarterSales.Products)
                await Items.CreateStarterServiceAsync(HttpContext.RequestAborted);
            return true;
        }
        catch (DomainException)
        {
            return false;
        }
    }

    private sealed class SetupModel
    {
        public string? SetupCode { get; set; }

        [Required(ErrorMessage = "Enter your company's name.")]
        [StringLength(200)]
        public string CompanyName { get; set; } = string.Empty;

        [StringLength(200)]
        public string? LegalName { get; set; }

        public BusinessType BusinessType { get; set; } = BusinessType.SoleProprietorship;

        public Edition Edition { get; set; }

        public string? Region { get; set; }

        // Nullable because the form binder leaves an enum it isn't sent at its zero value (Full); not given means the suggested simple view.
        public ViewMode? DefaultViewMode { get; set; }

        // Nullable for the same reason: not given means both.
        public StarterSales? Sells { get; set; }

        public bool KeepsStock { get; set; }

        public bool ChargesSalesTax { get; set; }

        public ReportBasis DefaultReportBasis { get; set; } = ReportBasis.Accrual;

        // Not [EmailAddress]: it rejects the empty string an untouched optional field posts.
        [RegularExpression(@"^[^@\s]+@[^@\s]+\.[^@\s]+$", ErrorMessage = "Enter a valid email address, or leave it blank.")]
        public string? Email { get; set; }

        [StringLength(50)]
        public string? Phone { get; set; }

        [StringLength(1000)]
        public string? Address { get; set; }

        [Range(1, 12)]
        public int FiscalYearStartMonth { get; set; } = 1;

        [Required]
        [RegularExpression("^[A-Za-z]{3}$", ErrorMessage = "Use a 3-letter currency code, e.g. USD.")]
        public string HomeCurrency { get; set; } = "USD";

        [Required(ErrorMessage = "Choose a username.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Choose a password.")]
        [StringLength(User.MaxPasswordLength, MinimumLength = User.MinPasswordLength, ErrorMessage = "Passwords need 8 to 128 characters.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Repeat the password.")]
        [Compare(nameof(Password), ErrorMessage = "The passwords don't match.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        /// <summary>The export read by "Read the file", held by <see cref="SetupState"/>.</summary>
        public string? ImportToken { get; set; }
    }
}
