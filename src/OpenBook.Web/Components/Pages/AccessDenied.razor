@page "/access-denied"
@using OpenBook.Domain.Companies

<PageTitle>@L["Not allowed"] · OpenBook</PageTitle>

<div class="card">
    <h1>@L["You don't have access to that"]</h1>
    @if (_user.HasClaim(c => c.Type == WebSecurity.PermissionSetClaim) && Area is not null && ApiScopes.Areas.TryGetValue(Area, out var area) && Needed != nameof(UserRole.Admin))
    {
        <p>
            That needs <strong>@(Enum.TryParse<UserRole>(Needed, out var level) ? PermissionSet.Describe(level) : "admin")</strong> access to
            <strong>@area.Label</strong>, and your permission set gives <strong>@PermissionSet.Describe(AccessRules.LevelIn(_user, Area))</strong>.
            Ask an admin to change your permission set if you need it.
        </p>
    }
    else
    {
        <p>
            That needs the <strong>@(Enum.TryParse<UserRole>(Needed, out var role) ? AccessMiddleware.Describe(role) : "admin")</strong> role or higher,
            and you're signed in as <strong>@AccessMiddleware.Describe(AccessRules.RoleOf(_user) ?? UserRole.ViewOnly)</strong>.
            Ask an admin to change your role if you need it.
        </p>
    }
    <p><a href="/">@L["Back to the home page"]</a></p>
</div>

@code {
    private System.Security.Claims.ClaimsPrincipal _user = new();

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromQuery] private string? Needed { get; set; }

    [SupplyParameterFromQuery] private string? Area { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
            _user = (await AuthState).User;
    }
}
