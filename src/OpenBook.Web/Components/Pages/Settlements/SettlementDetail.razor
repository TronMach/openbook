@page "/settlements/{Id:guid}"
@using OpenBook.Application.Settlements
@using OpenBook.Domain.Settlements
@using OpenBook.Web.Components.Settlements
@inject SettlementService SettlementService
@inject AccountService AccountService

<PageTitle>@L["Settlement"] @_settlement?.Number · OpenBook</PageTitle>

<div class="wide">
    @if (_settlement is null || _carrier is null)
    {
        <div class="card"><p>@L["That settlement doesn't exist."] <a href="/settlements">@L["All settlements"]</a></p></div>
    }
    else
    {
        <div class="toolbar">
            <h1>@_carrier.Name · @_settlement.Number</h1>
            @if (_settlement.Status == SettlementStatus.Waiting)
            {
                <ActionLink Class="button secondary" Href="@($"/settlements/{_settlement.Id}/edit")">@L["Change"]</ActionLink>
            }
            @if (_settlement.Status == SettlementStatus.Posted)
            {
                <ActionLink Class="button secondary" Href="@StatementUrl(_settlement)">@L["Operating statement"]</ActionLink>
            }
            <ActionLink Class="button secondary" Href="/settlements">@L["All settlements"]</ActionLink>
            <ActionLink Class="button secondary" Href="@($"/audit?entityId={_settlement.Id}")">@L["History"]</ActionLink>
        </div>
        @if (Error is not null)
        {
            <div class="alert error" role="alert">@Error</div>
        }
        @if (_settlement.ReadMethod is { } method)
        {
            <SettlementReadBanner Settlement="_settlement" Method="@method" />
        }
        @if (Note is not null)
        {
            <div class="alert notice" role="status">@Note</div>
        }
        @if (_settlement.Status == SettlementStatus.Waiting)
        {
            @foreach (var deposit in _deposits)
            {
                <div class="alert notice" role="status">
                    @L["{0} was already entered as received on {1}", Labels.Amount(deposit.Amount), Labels.Date(deposit.Date)]@(deposit.Payee is null ? "" : $" ({deposit.Payee})").
                    @L["If that's this settlement's money, void it before posting, or it counts twice."]
                    <a href="/banking/transactions/@deposit.TransactionId">@L["Open it"]</a>
                </div>
            }
            @if (_settlement.Difference != 0m && !(_settlement.IsScanned && _settlement.CheckedBy is null))
            {
                <div class="alert error" role="alert">
                    @L["The lines add up to {0}, but the statement says {1} (net paid and carried forward): {2} apart. It can't be posted until they agree.",
                        Labels.Amount(_settlement.Total), Labels.Amount(_settlement.NetPaid + _settlement.CarriedForward), Labels.Amount(_settlement.Difference)]
                    <ActionLink Href="@($"/settlements/{_settlement.Id}/edit")">@L["Change the lines"]</ActionLink>
                </div>
            }
        }

        <div class="card">
            <dl class="facts">
                <dt>@L["Status"]</dt><dd>@SettlementLabels.Status(_settlement.Status)</dd>
                <dt>@L["Paid on"]</dt><dd>@Labels.Date(_settlement.Date)</dd>
                @if (_settlement.PeriodStart is { } from && _settlement.PeriodEnd is { } to)
                {
                    <dt>@L["Period"]</dt><dd>@Labels.Date(from) – @Labels.Date(to)</dd>
                }
                @if (_settlement.Memo is { } memo)
                {
                    <dt>@L["Memo"]</dt><dd>@memo</dd>
                }
                @if (_settlement.LoadedMiles + _settlement.EmptyMiles > 0m)
                {
                    <dt>@L["Miles"]</dt>
                    <dd>@L["{0} loaded, {1} empty", SettlementLabels.Miles(_settlement.LoadedMiles) is { Length: > 0 } l ? l : "0", SettlementLabels.Miles(_settlement.EmptyMiles) is { Length: > 0 } e ? e : "0"]</dd>
                }
                @if (_settlement.Gallons > 0m)
                {
                    <dt>@L["Gallons"]</dt><dd>@SettlementLabels.Gallons(_settlement.Gallons)</dd>
                }
                @if (_settlement.JournalEntryId is { } entryId)
                {
                    <dt>@L["Journal entry"]</dt><dd><a href="/journal/@entryId">@L["Open"]</a></dd>
                }
            </dl>

            <table class="data" style="margin-top: 1rem">
                <thead><tr><th>@L["Part"]</th><th class="num">@L["Lines"]</th><th class="num">@L["Amount"]</th></tr></thead>
                <tbody>
                    @foreach (var section in Enum.GetValues<SettlementSection>().Where(s => _settlement.Lines.Any(x => x.Section == s)))
                    {
                        <tr>
                            <td>@SettlementSections.Label(section)</td>
                            <td class="num">@_settlement.Lines.Count(x => x.Section == section)</td>
                            <td class="num">@Labels.Amount(_settlement.SectionTotal(section))</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    @if (_settlement.CarriedForward != 0m)
                    {
                        <tr><td>@(_settlement.CarriedForward < 0m ? L["Owed to the carrier, carried forward"] : L["Held by the carrier, carried forward"])</td><td></td><td class="num">@Labels.Amount(-_settlement.CarriedForward)</td></tr>
                    }
                    @if (_settlement.Deposits.Count > 0)
                    {
                        @foreach (var d in _settlement.Deposits)
                        {
                            <tr><td>@L["Paid into {0}", Account(d.AccountId)]</td><td></td><td class="num">@Labels.Amount(d.Amount)</td></tr>
                        }
                    }
                    else
                    {
                        <tr><td>@L["Net paid into {0}", Account(_carrier.DepositAccountId)]</td><td></td><td class="num">@Labels.Amount(_settlement.NetPaid)</td></tr>
                    }
                </tfoot>
            </table>

            <div class="actions">
                @if (_settlement.Status == SettlementStatus.Waiting)
                {
                    <PostForm Action="@($"/settlements/{_settlement.Id}/post")" data-enhance="false" class="inline">
                        <AntiforgeryToken />
                        <button type="submit" disabled="@(_settlement.Difference != 0m || _unassigned.Count > 0 || _settlement.IsScanned && _settlement.CheckedBy is null)">@L["Post settlement"]</button>
                    </PostForm>
                    <PostForm Action="@($"/settlements/{_settlement.Id}/dismiss")" data-enhance="false" class="inline">
                        <AntiforgeryToken />
                        <button type="submit" class="secondary">@L["Dismiss"]</button>
                    </PostForm>
                }
                else if (_settlement.Status == SettlementStatus.Dismissed)
                {
                    <PostForm Action="@($"/settlements/{_settlement.Id}/dismiss")" data-enhance="false" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="restore" value="true" />
                        <button type="submit" class="secondary">@L["Restore"]</button>
                    </PostForm>
                }
                else
                {
                    <PostForm Action="@($"/settlements/{_settlement.Id}/void")" data-enhance="false" class="inline">
                        <AntiforgeryToken />
                        <input name="reason" placeholder="@L["Reason for voiding"]" aria-label="@L["Reason for voiding"]" maxlength="500" />
                        <button type="submit" class="danger">@L["Void the entry"]</button>
                    </PostForm>
                }
            </div>
            @if (_settlement.Status == SettlementStatus.Waiting && _unassigned.Count > 0)
            {
                <p class="hint">@L["Choose an account for each code below before posting."]</p>
            }
        </div>

        @if (_settlement.Status == SettlementStatus.Waiting && _unassigned.Count > 0)
        {
            <div class="card" style="margin-top: 1.5rem">
                <h2 id="accounts">@L["Codes without an account"]</h2>
                <p class="muted">@L["Choose where each goes; it's remembered for every settlement from this carrier. Suggestions come from the words on the statement, so check them."]</p>
                <PostForm Action="@($"/settlements/carriers/{_carrier.Id}/codes")" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="back" value="/settlements/@_settlement.Id" />
                    <div class="table-wrap">
                        <table class="data entry">
                            <thead><tr><th>@L["Part"]</th><th>@L["Code"]</th><th>@L["Description"]</th><th class="num">@L["Amount"]</th><th>@L["Account"]</th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < _unassigned.Count; i++)
                                {
                                    var item = _unassigned[i];
                                    <tr>
                                        <td>@SettlementSections.Label(item.Section)<input type="hidden" name="section:@i" value="@item.Section" /></td>
                                        <td>@item.Code<input type="hidden" name="code:@i" value="@item.Code" /></td>
                                        <td>@item.Name<input type="hidden" name="name:@i" value="@item.Name" /></td>
                                        <td class="num">@Labels.Amount(item.Amount)</td>
                                        <td><SettlementAccountSelect Name="@($"account:{i}")" Label="@L["Account for {0}", item.Code]" Chart="_chart" Value="item.SuggestedAccountId" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="actions"><button type="submit">@L["Save the accounts"]</button></div>
                </PostForm>
            </div>
        }

        @if (_settlement.IsScanned && _settlement.Status == SettlementStatus.Waiting)
        {
            <SettlementScanCheck Settlement="_settlement" />
        }

        @if (_review is not null)
        {
            <SettlementReviewCard Review="_review" Chart="_chart" CarrierId="_settlement.CarrierId" />
        }

        <h2 style="margin-top: 1.5rem">@L["Lines"] <span class="muted">(@_settlement.Lines.Count)</span></h2>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>@L["Part"]</th><th>@L["Code"]</th><th>@L["Date"]</th><th>@L["Load"]</th><th>@L["Description"]</th><th>@L["Account"]</th>
                        <th class="num">@L["Loaded miles"]</th><th class="num">@L["Empty miles"]</th><th class="num">@L["Gallons"]</th><th class="num">@L["Amount"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in _settlement.Lines)
                    {
                        <tr>
                            <td>@SettlementSections.Label(line.Section)</td>
                            <td>@line.Code @if (line.NeedsChecking) { <span class="badge" title="@line.Doubt">@L["Check this"]</span> }</td>
                            <td>@(line.Date is { } date ? Labels.Date(date) : "")</td>
                            <td>@line.Load @line.Dispatch</td>
                            <td>@line.Description</td>
                            <td>@AccountOf(line)</td>
                            <td class="num">@SettlementLabels.Miles(line.LoadedMiles)</td>
                            <td class="num">@SettlementLabels.Miles(line.EmptyMiles)</td>
                            <td class="num">@SettlementLabels.Gallons(line.Gallons)</td>
                            <td class="num">@Labels.Amount(line.Amount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="hint">@L["Money taken out is shown with a minus."]</p>

        <Notes EntityType="settlement" EntityId="_settlement.Id" />
        <Attachments EntityType="settlement" EntityId="_settlement.Id" />
    }
</div>

@code {
    private Settlement? _settlement;
    private Carrier? _carrier;
    private ChartOfAccounts _chart = new([]);
    private IReadOnlyList<UnassignedCode> _unassigned = [];
    private IReadOnlyList<PossibleDeposit> _deposits = [];
    private SettlementReview? _review;

    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? Note { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _settlement = await SettlementService.GetAsync(Id);
        if (_settlement is null)
            return;
        _carrier = await SettlementService.GetCarrierAsync(_settlement.CarrierId);
        _chart = await AccountService.GetChartAsync();
        if (_settlement.Status != SettlementStatus.Dismissed)
            _review = await SettlementService.ReviewAsync(_settlement);
        if (_settlement.Status == SettlementStatus.Waiting)
        {
            _unassigned = await SettlementService.UnassignedAsync(_settlement);
            _deposits = await SettlementService.PossibleDepositsAsync(_settlement);
        }
    }

    // The week it paid for: its entry is dated the day it was paid.
    private static string StatementUrl(Settlement s) =>
        $"/reports/operating-statement?preset=Custom&from={(s.PeriodStart is { } from && from < s.Date ? from : s.Date.AddDays(-6)):yyyy-MM-dd}&to={s.Date:yyyy-MM-dd}";

    private string Account(Guid id) => _chart.Find(id) is null ? "" : _chart.FullName(id);

    private string AccountOf(SettlementLine line) =>
        (line.PostedAccountId ?? Settlement.AccountFor(_carrier!, line)) is { } id ? Account(id) : "";
}
