@page "/settings/users"
@using System.ComponentModel.DataAnnotations
@using OpenBook.Domain.Companies
@inject UserService UserService
@inject InviteService Invites
@inject PermissionSetService PermissionSets
@inject IClock Clock
@inject NavigationManager Navigation

<PageTitle>Users · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Users</h1>
        <a href="/settings/permission-sets">Permission sets</a>
        <a href="/settings/sign-in">Sign-in and two-factor</a>
        <a href="/settings">Company settings</a>
    </div>
    <p class="muted">
        <strong>View-only</strong> users read everything and change nothing. <strong>Standard</strong> users do the day-to-day work: sales, purchases,
        banking, inventory and sales tax. <strong>Accountants</strong> also keep the books: chart of accounts, journal entries, closing date,
        company settings, budgets and the audit log. <strong>Admins</strong> also manage users, backups, email and webhooks.
        Changing someone's role or making them inactive signs them out. Users are never deleted, so the audit log keeps its names.
        To bring someone in (an outside accountant, say), invite them by email below: they choose their own username and password.
    </p>

    @if (_message is not null)
    {
        <div class="alert notice" role="status">@_message</div>
    }
    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (_sent is not null)
    {
        <div class="alert notice" role="status">
            <p>@(_sent.Emailed ? $"Invitation emailed to {_sent.Invite.Email}." : $"Invitation for {_sent.Invite.Email} created.") @_sent.EmailError</p>
            <p>Invitation link (shown only now; it works until @_sent.Invite.ExpiresAt.InCompanyTime().ToString("d")):</p>
            <input type="text" readonly value="@_sent.Link" class="copy-link" aria-label="Invitation link" onfocus="this.select()" />
        </div>
    }

    <table class="data">
        <thead><tr><th>User</th><th>Role</th><th>Last sign-in</th><th>Two-factor</th><th></th><th></th></tr></thead>
        <tbody>
            @foreach (var user in _users)
            {
                <tr class="@(user.IsActive ? null : "inactive")">
                    <td>
                        <a href="/settings/users/@user.Id">@user.Username</a> @(user.IsActive ? "" : "(inactive)")
                        @if (user.Email is not null)
                        {
                            <br /><span class="muted">@user.Email</span>
                        }
                        @if (user.AccessEndsOn is { } ends && user.IsActive)
                        {
                            <br /><span class="muted">access ends @Labels.Date(ends)</span>
                        }
                    </td>
                    <td>
                        <form method="post" @formname="@($"role-{user.Id}")" @onsubmit="() => ChangeRoleAsync(user.Id)" class="inline">
                            <AntiforgeryToken />
                            <select name="Role" aria-label="Role for @user.Username" @onchange="e => _role = e.Value as string">
                                @foreach (var role in Enum.GetValues<UserRole>().Reverse())
                                {
                                    <option value="@role" selected="@(user.PermissionSetId is null && role == user.Role)">@AccessMiddleware.Describe(role)</option>
                                }
                                @if (_sets.Count > 0)
                                {
                                    <optgroup label="Permission sets">
                                        @foreach (var set in _sets.Where(s => s.IsActive || s.Id == user.PermissionSetId))
                                        {
                                            <option value="set:@set.Id" selected="@(set.Id == user.PermissionSetId)">@set.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <button type="submit" class="secondary">Change</button>
                        </form>
                    </td>
                    <td class="muted">@(user.LastLoginAt is { } at ? Labels.Date(DateOnly.FromDateTime(at.InCompanyTime().DateTime)) : "never")</td>
                    <td>
                        @if (user.HasTwoFactor)
                        {
                            <span>On</span>
                            @if (user.Username != HttpContext.User.Identity?.Name)
                            {
                                <form method="post" @formname="@($"two-factor-{user.Id}")" @onsubmit="() => ResetTwoFactorAsync(user.Id)" class="inline">
                                    <AntiforgeryToken />
                                    <button type="submit" class="link" title="For someone who lost their phone and recovery codes">Turn off</button>
                                </form>
                            }
                        }
                        else
                        {
                            <span class="muted">Off</span>
                        }
                    </td>
                    <td>
                        <form method="post" @formname="@($"active-{user.Id}")" @onsubmit="() => ToggleAsync(user.Id, !user.IsActive)" class="inline">
                            <AntiforgeryToken />
                            <button type="submit" class="link">@(user.IsActive ? "Make inactive" : "Make active")</button>
                        </form>
                    </td>
                    <td>
                        <form method="post" @formname="@($"reset-{user.Id}")" @onsubmit="() => ResetAsync(user.Id)" class="inline">
                            <AntiforgeryToken />
                            <input type="password" name="NewPassword" autocomplete="new-password" placeholder="New password" aria-label="New password for @user.Username" />
                            <button type="submit" class="link">Reset password</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="card" id="invites">
        <h2>Invite someone</h2>
        <DesktopNote>OpenBook Desktop can only be reached from this computer: an invitation works for someone who signs in here. To work from other computers, move the company to OpenBook Server.</DesktopNote>
        <p class="muted">They get a link to choose their own username and password. With email set up (Settings → Email) it's emailed to them; either way the link is shown here to copy.</p>
        <form method="post" @formname="invite" @onsubmit="InviteAsync">
            <AntiforgeryToken />
            <div class="row">
                <div class="field">
                    <label for="invite-email">Email</label>
                    <input id="invite-email" name="InviteEmail" type="email" autocomplete="off" />
                </div>
                <div class="field">
                    <label for="invite-name">Name (optional)</label>
                    <input id="invite-name" name="InviteName" autocomplete="off" />
                </div>
                <div class="field">
                    <label for="invite-role">Role</label>
                    <select id="invite-role" name="InviteRole">
                        @foreach (var role in Enum.GetValues<UserRole>().Reverse())
                        {
                            <option value="@role" selected="@(role == UserRole.Accountant)">@AccessMiddleware.Describe(role)</option>
                        }
                        @if (_sets.Any(s => s.IsActive))
                        {
                            <optgroup label="Permission sets">
                                @foreach (var set in _sets.Where(s => s.IsActive))
                                {
                                    <option value="set:@set.Id">@set.Name</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="invite-ends">Access ends on (optional)</label>
                    <input id="invite-ends" name="InviteEnds" type="date" />
                    <span class="hint">For someone who needs the books for a while, like tax season.</span>
                </div>
                <div class="field">
                    <label for="invite-days">Link works for</label>
                    <select id="invite-days" name="InviteDays">
                        @foreach (var days in new[] { 1, 3, 7, 14, 30 })
                        {
                            <option value="@days" selected="@(days == UserInvite.DefaultDays)">@days @(days == 1 ? "day" : "days")</option>
                        }
                    </select>
                </div>
            </div>
            <label class="check"><input type="checkbox" name="InviteSend" value="true" checked /> <span>Email the link</span></label>
            <div class="actions"><button type="submit">Send invitation</button></div>
        </form>

        @if (_invites.Count > 0)
        {
            <h3>Invitations</h3>
            <table class="data">
                <thead><tr><th>Email</th><th>Role</th><th>Invited</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var invite in _invites)
                    {
                        var now = Clock.UtcNow;
                        <tr>
                            <td>@invite.Email @(invite.Name is { } n ? $"({n})" : "")</td>
                            <td>@(invite.PermissionSetId is { } setId ? _sets.FirstOrDefault(s => s.Id == setId)?.Name : AccessMiddleware.Describe(invite.Role))@(invite.AccessEndsOn is { } e ? $", until {Labels.Date(e)}" : "")</td>
                            <td class="muted">@Labels.Date(DateOnly.FromDateTime(invite.CreatedAt.InCompanyTime().DateTime)) by @invite.InvitedBy</td>
                            <td>@Status(invite, now)</td>
                            <td>
                                @if (invite.Status == InviteStatus.Pending)
                                {
                                    <form method="post" @formname="@($"resend-{invite.Id}")" @onsubmit="() => ResendAsync(invite.Id)" class="inline">
                                        <AntiforgeryToken />
                                        <button type="submit" class="link">Send again</button>
                                    </form>
                                }
                                @if (invite.IsOpen(now))
                                {
                                    <form method="post" @formname="@($"revoke-{invite.Id}")" @onsubmit="() => RevokeAsync(invite.Id)" class="inline">
                                        <AntiforgeryToken />
                                        <button type="submit" class="link">Withdraw</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="card">
        <h2>Add a user</h2>
        <EditForm Model="Input" FormName="new-user" OnValidSubmit="CreateAsync" method="post">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="field">
                    <label for="username">Username</label>
                    <InputText id="username" @bind-Value="Input.Username" autocomplete="off" />
                    <ValidationMessage For="() => Input.Username" />
                </div>
                <div class="field">
                    <label for="role">Role</label>
                    <InputSelect id="role" @bind-Value="Input.Role">
                        @foreach (var role in Enum.GetValues<UserRole>().Reverse())
                        {
                            <option value="@role">@AccessMiddleware.Describe(role)</option>
                        }
                    </InputSelect>
                </div>
                <div class="field">
                    <label for="password">Starting password</label>
                    <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" />
                    <ValidationMessage For="() => Input.Password" />
                    <span class="hint">At least @User.MinPasswordLength characters. Ask them to change it after signing in.</span>
                </div>
            </div>
            <div class="actions"><button type="submit">Add user</button></div>
        </EditForm>
    </div>
</div>

@code {
    private IReadOnlyList<User> _users = [];
    private string? _role;
    private string? _message;
    private string? _error;

    [SupplyParameterFromForm(FormName = "new-user")]
    private NewUserModel Input { get; set; } = default!;

    [SupplyParameterFromForm(Name = "Role")]
    private string? PostedRole { get; set; }

    [SupplyParameterFromForm(Name = "NewPassword")]
    private string? PostedPassword { get; set; }

    [SupplyParameterFromQuery] private string? Done { get; set; }

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new NewUserModel();
        _message = Done;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _users = await UserService.ListAsync();
        _sets = await PermissionSets.ListAsync();
        // Waiting ones first, then the last 30 days of the rest.
        var now = Clock.UtcNow;
        _invites = (await Invites.ListAsync()).Where(i => i.Status == InviteStatus.Pending || i.CreatedAt >= now.AddDays(-30))
            .OrderBy(i => i.IsOpen(now) ? 0 : 1).ThenByDescending(i => i.CreatedAt).ToList();
    }

    private IReadOnlyList<UserInvite> _invites = [];
    private IReadOnlyList<PermissionSet> _sets = [];
    private SentInvite? _sent;

    [SupplyParameterFromForm(Name = "InviteEmail")] private string? InviteEmail { get; set; }
    [SupplyParameterFromForm(Name = "InviteName")] private string? InviteName { get; set; }
    [SupplyParameterFromForm(Name = "InviteRole")] private string? InviteRole { get; set; }
    [SupplyParameterFromForm(Name = "InviteEnds")] private string? InviteEnds { get; set; }
    [SupplyParameterFromForm(Name = "InviteDays")] private int? InviteDays { get; set; }
    [SupplyParameterFromForm(Name = "InviteSend")] private bool InviteSend { get; set; }

    private string LinkBase => $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}{HttpContext.Request.PathBase}";

    private static string Status(UserInvite invite, DateTimeOffset now) => invite.Status switch
    {
        InviteStatus.Accepted => "accepted",
        InviteStatus.Revoked => "withdrawn",
        _ when invite.IsExpired(now) => "expired",
        _ => $"waiting, until {Labels.Date(DateOnly.FromDateTime(invite.ExpiresAt.InCompanyTime().DateTime))}",
    };

    // The link is shown in this response only (it holds the token), so these don't redirect.
    private Task InviteAsync() => ShowSentAsync(async () =>
    {
        Guid? setId = InviteRole?.StartsWith("set:", StringComparison.Ordinal) == true && Guid.TryParse(InviteRole[4..], out var s) ? s : null;
        var role = Enum.TryParse<UserRole>(InviteRole, out var r) ? r : UserRole.Accountant;
        DateOnly? ends = string.IsNullOrWhiteSpace(InviteEnds) ? null
            : DateOnly.TryParseExact(InviteEnds, "yyyy-MM-dd", out var d) ? d
            : throw new DomainException("user.access_end_invalid", "Enter the date access ends, or leave it empty.");
        return await Invites.InviteAsync(new InviteCommand(InviteEmail ?? string.Empty, role, InviteName, ends, InviteDays ?? UserInvite.DefaultDays, InviteSend, setId), LinkBase);
    });

    private Task ResendAsync(Guid id) => ShowSentAsync(() => Invites.ResendAsync(id, LinkBase));

    private Task RevokeAsync(Guid id) => RunAsync(async () =>
    {
        var invite = await Invites.RevokeAsync(id);
        return $"The invitation for {invite.Email} was withdrawn; its link no longer works.";
    });

    private async Task ShowSentAsync(Func<Task<SentInvite>> action)
    {
        try
        {
            _sent = await action();
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }

        await LoadAsync();
    }

    private Task CreateAsync() => RunAsync(async () =>
    {
        var user = await UserService.CreateAsync(Input.Username, Input.Password, Input.Role);
        return $"Added {user.Username}.";
    });

    private Task ChangeRoleAsync(Guid id) => RunAsync(async () =>
    {
        var posted = PostedRole ?? _role;
        if (posted?.StartsWith("set:", StringComparison.Ordinal) == true && Guid.TryParse(posted[4..], out var setId))
        {
            var withSet = await UserService.AssignPermissionSetAsync(id, setId);
            return $"{withSet.Username} now has the permission set '{_sets.FirstOrDefault(s => s.Id == setId)?.Name}'.";
        }

        var role = Enum.TryParse<UserRole>(posted, out var r) ? r : throw new DomainException("user.role_invalid", "Choose a role.");
        var user = await UserService.ChangeRoleAsync(id, role);
        return $"{user.Username} is now {AccessMiddleware.Describe(user.Role)}.";
    });

    private Task ToggleAsync(Guid id, bool active) => RunAsync(async () =>
    {
        var user = await UserService.SetActiveAsync(id, active);
        return $"{user.Username} is {(user.IsActive ? "active" : "inactive")}.";
    });

    private Task ResetAsync(Guid id) => RunAsync(async () =>
    {
        var user = await UserService.ResetPasswordAsync(id, PostedPassword ?? string.Empty);
        return $"{user.Username}'s password was reset and their sessions ended.";
    });

    private Task ResetTwoFactorAsync(Guid id) => RunAsync(async () =>
    {
        var user = await UserService.ResetTwoFactorAsync(id);
        return $"Two-factor sign-in is off for {user.Username} and their sessions ended. They can set it up again after signing in.";
    });

    private async Task RunAsync(Func<Task<string>> action)
    {
        try
        {
            var message = await action();
            Navigation.NavigateTo($"/settings/users?done={Uri.EscapeDataString(message)}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            await LoadAsync();
        }
    }

    private sealed class NewUserModel
    {
        [Required(ErrorMessage = "Enter a username.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter a starting password.")]
        public string Password { get; set; } = string.Empty;

        public UserRole Role { get; set; } = UserRole.Standard;
    }
}
