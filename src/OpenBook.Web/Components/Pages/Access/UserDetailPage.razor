@page "/settings/users/{Id:guid}"
@using OpenBook.Domain.Companies
@inject UserService UserService
@inject SingleSignOnService SingleSignOn
@inject ApiKeyService Keys
@inject NavigationManager Navigation

<PageTitle>@(_user?.Username ?? "User") · OpenBook</PageTitle>

<div class="card narrow">
    @if (_user is null)
    {
        <h1>@L["User not found"]</h1>
    }
    else
    {
        <div class="toolbar">
            <h1>@_user.Username</h1>
            <ActionLink Href="/settings/users">@L["Users"]</ActionLink>
        </div>
        <p class="muted">
            @AccessMiddleware.Describe(_user.Role) · @(_user.IsActive ? L["Active"] : L["Inactive"]) ·
            @(_user.HasTwoFactor ? L["two-factor sign-in on"] : L["two-factor sign-in off"])
        </p>

        @if (Saved)
        {
            <div class="alert notice" role="status">@L["Saved."]</div>
        }
        @if (_error is not null)
        {
            <div class="alert error" role="alert">@_error</div>
        }

        <form method="post" @formname="details" @onsubmit="SaveAsync">
            <AntiforgeryToken />
            <div class="field">
                <label for="email">@L["Email"]</label>
                <input id="email" name="Email" type="email" value="@_user.Email" autocomplete="off" />
                <span class="hint">@L["Optional. Used to match single sign-on and shown on invitations."]</span>
            </div>
            <div class="field">
                <label for="ends">@L["Access ends on"]</label>
                <input id="ends" name="AccessEndsOn" type="date" value="@_user.AccessEndsOn?.ToString("yyyy-MM-dd")" />
                <span class="hint">@L["Optional. From this day they can't sign in and are made inactive. Leave empty for no end."]</span>
            </div>
            <button type="submit">@L["Save"]</button>
        </form>

        <h2>@L["API keys"]</h2>
        @if (_keys.Count == 0)
        {
            <p class="muted">@L["No API keys."]</p>
        }
        else
        {
            <table class="data">
                <thead><tr><th>@L["Name"]</th><th>@L["Key"]</th><th>@L["Made"]</th><th>@L["Last used"]</th><th><span class="visually-hidden">@L["Actions"]</span></th></tr></thead>
                <tbody>
                    @foreach (var key in _keys)
                    {
                        <tr class="@(key.RevokedAt is null ? null : "muted")">
                            <td>@key.Name</td>
                            <td><code>@key.Hint</code></td>
                            <td>@key.CreatedAt.InCompanyTime().ToString("d")</td>
                            <td>@(key.LastUsedAt?.InCompanyTime().ToString("g") ?? "")</td>
                            <td>
                                @if (key.RevokedAt is { } revoked)
                                {
                                    @L["Revoked {0}", revoked.InCompanyTime().ToString("d")]
                                }
                                else
                                {
                                    <form method="post" @formname="@($"revoke-key-{key.Id}")" @onsubmit="() => RevokeKeyAsync(key.Id)" class="inline">
                                        <AntiforgeryToken />
                                        <button type="submit" class="secondary" data-confirm="@L["Revoke this key? Programs using it stop working at once."]">@L["Revoke"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h2>@L["Single sign-on"]</h2>
        @if (_user.ExternalLogin is null)
        {
            <p class="muted">@L["Not linked. They're linked at their first single sign-on with this email, or from their own account page."]</p>
        }
        else
        {
            <p>@L["Linked to a single sign-on account."]</p>
            <form method="post" @formname="unlink" @onsubmit="UnlinkAsync">
                <AntiforgeryToken />
                <button type="submit" class="secondary">@L["Unlink"]</button>
                <span class="hint">@L["For an account given to someone else at the provider; their next single sign-on links again by email."]</span>
            </form>
        }
    }
</div>

@code {
    private User? _user;
    private string? _error;

    [Parameter] public Guid Id { get; set; }

    [SupplyParameterFromQuery] private bool Saved { get; set; }

    [SupplyParameterFromForm(Name = "Email")] private string? PostedEmail { get; set; }
    [SupplyParameterFromForm(Name = "AccessEndsOn")] private string? PostedEnd { get; set; }

    private IReadOnlyList<ApiKey> _keys = [];

    protected override async Task OnInitializedAsync()
    {
        _user = await UserService.GetAsync(Id);
        _keys = _user is null ? [] : await Keys.ListAsync(_user.Id);
    }

    /// <summary>An admin revoking someone else's key (a leaver's, or one in the wrong hands).</summary>
    private async Task RevokeKeyAsync(Guid keyId)
    {
        await Keys.RevokeAsync(keyId, null);
        Navigation.NavigateTo($"/settings/users/{Id}");
    }

    private async Task UnlinkAsync()
    {
        await SingleSignOn.UnlinkAsync(Id);
        Navigation.NavigateTo($"/settings/users/{Id}?saved=true");
    }

    private async Task SaveAsync()
    {
        try
        {
            DateOnly? end = string.IsNullOrWhiteSpace(PostedEnd) ? null
                : DateOnly.TryParseExact(PostedEnd, "yyyy-MM-dd", out var d) ? d
                : throw new DomainException("user.access_end_invalid", "Enter the date access ends, or leave it empty.");
            await UserService.SetDetailsAsync(Id, PostedEmail, end);
            Navigation.NavigateTo($"/settings/users/{Id}?saved=true");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _user = await UserService.GetAsync(Id);
        }
    }
}
