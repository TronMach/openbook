@page "/sales/channels/{Id:guid}"
@using OpenBook.Application.Accounts
@using OpenBook.Application.Channels
@using OpenBook.Domain.Channels
@using OpenBook.Web.Components.Channels
@inject ChannelService ChannelService
@inject AccountService AccountService

<PageTitle>@(_channel?.Name ?? "Channel") · OpenBook</PageTitle>

<div class="wide">
    @if (_channel is null)
    {
        <div class="card"><p>That channel doesn't exist. <a href="/sales/channels">Back to sales channels</a>.</p></div>
    }
    else
    {
        <div class="toolbar">
            <h1>@_channel.Name</h1>
            <a class="button secondary" href="/sales/channels">@L["Sales channels"]</a>
            <a class="button secondary" href="/audit?entityId=@_channel.Id">@L["History"]</a>
        </div>
        @if (Error is not null)
        {
            <div class="alert error" role="alert">@Error</div>
        }
        @if (Imported is not null)
        {
            <div class="alert notice" role="status">
                Imported @Imported new @(Imported == 1 ? "payout" : "payouts")@(Skipped > 0 ? $"; {Skipped} already imported were skipped" : "").
                @Note
            </div>
        }

        @if (SalesChannel.CanConnect(_channel.Kind))
        {
            <div class="card">
                <h2>@L["Live connection"]</h2>
                @if (_channel.IsConnected)
                {
                    <p>
                        Connected@(_channel.ShopDomain is { } shop ? $" to {shop}" : ""). Payouts are fetched every few hours and wait below to be posted.
                        @if (_channel.LastSyncAt is { } at)
                        {
                            <span class="muted">Last fetched @at.ToLocalTime().ToString("g")@(_channel.SyncedThrough is { } t ? $", payouts through {Labels.Date(t)}" : "").</span>
                        }
                    </p>
                    @if (_channel.LastSyncFailed)
                    {
                        <div class="alert error" role="alert">The last fetch failed: @_channel.LastError</div>
                    }
                    <div class="actions">
                        <form method="post" action="/sales/channels/connections/@_channel.Id/sync" data-enhance="false" class="inline">
                            <AntiforgeryToken />
                            <button type="submit">@L["Fetch payouts now"]</button>
                        </form>
                        <form method="post" action="/sales/channels/connections/@_channel.Id/disconnect" data-enhance="false" class="inline">
                            <AntiforgeryToken />
                            <button type="submit" class="secondary">@L["Disconnect"]</button>
                        </form>
                    </div>
                }
                else
                {
                    <p class="muted">
                        @if (_channel.Kind == ChannelKind.Shopify)
                        {
                            <span>In Shopify: Settings › Apps and sales channels › Develop apps › Create an app, give it the Admin API scope "read_shopify_payments_payouts", install it, and copy the Admin API access token.</span>
                        }
                        else
                        {
                            <span>In Stripe: Developers › API keys › Create restricted key with read access to Balance and Payouts (a secret key works too).</span>
                        }
                        The key is stored encrypted and never shown again.
                    </p>
                    <form method="post" action="/sales/channels/connections/@_channel.Id" data-enhance="false" autocomplete="off">
                        <AntiforgeryToken />
                        <div class="row">
                            @if (_channel.Kind == ChannelKind.Shopify)
                            {
                                <div class="field">
                                    <label for="shop">@L["Store address"]</label>
                                    <input id="shop" name="shopDomain" placeholder="my-store.myshopify.com" required />
                                </div>
                            }
                            <div class="field">
                                <label for="credential">@(_channel.Kind == ChannelKind.Shopify ? L["Admin API access token"] : L["Restricted or secret key"])</label>
                                <input id="credential" name="credential" type="password" required />
                            </div>
                        </div>
                        <div class="actions"><button type="submit">@L["Connect"]</button></div>
                    </form>
                }
            </div>
        }

        <div class="card">
            <h2>@L["Import a payout report"]</h2>
            <p class="muted">@ChannelLabels.ReportHelp(_channel.Kind)</p>
            <form method="post" action="/sales/channels/@_channel.Id/import" enctype="multipart/form-data" data-enhance="false">
                <AntiforgeryToken />
                <div class="field">
                    <input type="file" name="file" accept=".csv,.txt,.tsv" required />
                </div>
                <div class="actions"><button type="submit" disabled="@(!_channel.IsActive)">@L["Import"]</button></div>
            </form>
        </div>

        <h2 style="margin-top: 1.5rem">@L["Payouts"]</h2>
        @if (_payouts.Count == 0)
        {
            <p class="muted">@L["No payouts yet."]</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>@L["Date"]</th><th>@L["Payout"]</th><th class="num">@L["Sales"]</th><th class="num">@L["Refunds"]</th>
                            <th class="num">@L["Fees"]</th><th class="num">@L["Net"]</th><th>@L["Status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _payouts)
                        {
                            <tr class="@(p.Status == PayoutStatus.Dismissed ? "muted" : "")">
                                <td>@Labels.Date(p.Date)</td>
                                <td><a href="/sales/channels/payouts/@p.Id">@p.ExternalId</a></td>
                                <td class="num">@Labels.Amount(p.Total(ChannelLineType.Sale) + p.Total(ChannelLineType.Shipping))</td>
                                <td class="num">@Labels.Amount(p.Total(ChannelLineType.Refund))</td>
                                <td class="num">@Labels.Amount(p.Total(ChannelLineType.Fee))</td>
                                <td class="num">@Labels.Amount(p.Net)</td>
                                <td>@ChannelLabels.Status(p.Status)@(p.Difference != 0m ? " · doesn't add up" : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="card" style="margin-top: 1.5rem">
            <h2>@L["Settings"]</h2>
            <form method="post" action="/sales/channels/@_channel.Id" data-enhance="false">
                <AntiforgeryToken />
                <ChannelForm Channel="_channel" Chart="_chart" />
                <label class="check"><input type="checkbox" name="active" value="true" checked="@_channel.IsActive" /> <span>@L["Active"]</span></label>
                <div class="actions"><button type="submit">@L["Save"]</button></div>
            </form>
        </div>
    }
</div>

@code {
    private SalesChannel? _channel;
    private IReadOnlyList<ChannelPayout> _payouts = [];
    private OpenBook.Domain.Accounts.ChartOfAccounts _chart = new([]);

    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private int? Imported { get; set; }
    [SupplyParameterFromQuery] private int Skipped { get; set; }
    [SupplyParameterFromQuery] private string? Note { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _channel = await ChannelService.GetAsync(Id);
        if (_channel is null)
            return;
        _payouts = await ChannelService.PayoutsAsync(Id);
        _chart = await AccountService.GetChartAsync();
    }
}
