@page "/sales/channels/{Id:guid}"
@using OpenBook.Application.Accounts
@using OpenBook.Application.Channels
@using OpenBook.Domain.Channels
@using OpenBook.Web.Components.Channels
@inject ChannelService ChannelService
@inject AccountService AccountService

<PageTitle>@(_channel?.Name ?? "Channel") · OpenBook</PageTitle>

<div class="wide">
    @if (_channel is null)
    {
        <div class="card"><p>That channel doesn't exist. <a href="/sales/channels">Back to sales channels</a>.</p></div>
    }
    else
    {
        <div class="toolbar">
            <h1>@_channel.Name</h1>
            <ActionLink Class="button secondary" Href="/sales/channels">@L["Sales channels"]</ActionLink>
            <ActionLink Class="button secondary" Href="@($"/audit?entityId={_channel.Id}")">@L["History"]</ActionLink>
        </div>
        @if (Error is not null)
        {
            <div class="alert error" role="alert">@Error</div>
        }
        @if (Done is not null)
        {
            <div class="alert notice" role="status">@Done</div>
        }
        @if (Imported is not null)
        {
            <div class="alert notice" role="status">
                Imported @Imported new @(Imported == 1 ? "payout" : "payouts")@(Skipped > 0 ? $"; {Skipped} already imported were skipped" : "").
                @Note
            </div>
        }

        @if (SalesChannel.CanConnect(_channel.Kind))
        {
            <div class="card">
                <h2>@L["Live connection"]</h2>
                @if (_channel.IsConnected)
                {
                    <p>
                        Connected@(_channel.ShopDomain is { } shop ? $" to {shop}" : ""). Payouts are fetched every few hours and wait below to be posted.
                        @if (_channel.LastSyncAt is { } at)
                        {
                            <span class="muted">Last fetched @at.InCompanyTime().ToString("g")@(_channel.SyncedThrough is { } t ? $", payouts through {Labels.Date(t)}" : "").</span>
                        }
                    </p>
                    @if (_channel.LastSyncFailed)
                    {
                        <div class="alert error" role="alert">The last fetch failed: @_channel.LastError</div>
                    }
                    <div class="actions">
                        <PostForm Action="@($"/sales/channels/connections/{_channel.Id}/sync")" data-enhance="false" class="inline">
                            <AntiforgeryToken />
                            <button type="submit">@L["Fetch payouts now"]</button>
                        </PostForm>
                        <PostForm Action="@($"/sales/channels/connections/{_channel.Id}/disconnect")" data-enhance="false" class="inline">
                            <AntiforgeryToken />
                            <button type="submit" class="secondary">@L["Disconnect"]</button>
                        </PostForm>
                    </div>
                }
                else
                {
                    <p class="muted">
                        @if (_channel.Kind == ChannelKind.Shopify)
                        {
                            <span>In Shopify: Settings › Apps and sales channels › Develop apps › Create an app, give it the Admin API scopes "read_shopify_payments_payouts" and "read_orders", install it, and copy the Admin API access token.</span>
                        }
                        else
                        {
                            <span>In Stripe: Developers › API keys › Create restricted key with read access to Balance and Payouts (a secret key works too).</span>
                        }
                        The key is stored encrypted and never shown again.
                    </p>
                    <PostForm Action="@($"/sales/channels/connections/{_channel.Id}")" data-enhance="false" autocomplete="off">
                        <AntiforgeryToken />
                        <div class="row">
                            @if (_channel.Kind == ChannelKind.Shopify)
                            {
                                <div class="field">
                                    <label for="shop">@L["Store address"]</label>
                                    <input id="shop" name="shopDomain" placeholder="my-store.myshopify.com" required />
                                </div>
                            }
                            <div class="field">
                                <label for="credential">@(_channel.Kind == ChannelKind.Shopify ? L["Admin API access token"] : L["Restricted or secret key"])</label>
                                <input id="credential" name="credential" type="password" required />
                            </div>
                        </div>
                        <div class="actions"><button type="submit">@L["Connect"]</button></div>
                    </PostForm>
                }
            </div>
        }

        <div class="card">
            <h2>@L["Import a payout report"]</h2>
            <p class="muted">@ChannelLabels.ReportHelp(_channel.Kind)</p>
            <PostForm Action="@($"/sales/channels/{_channel.Id}/import")" enctype="multipart/form-data" data-enhance="false">
                <AntiforgeryToken />
                <div class="field">
                    <input type="file" name="file" accept=".csv,.txt,.tsv" required />
                </div>
                <div class="actions"><button type="submit" disabled="@(!_channel.IsActive)">@L["Import"]</button></div>
            </PostForm>
        </div>

        <div class="card" style="margin-top: 1.5rem">
            <h2>@L["Orders"]</h2>
            <p class="muted">
                Orders move stock (and its cost) and give sales tax by state; the money comes with the payouts.
                @if (_channel.Kind == ChannelKind.Shopify && _channel.IsConnected)
                {
                    <span>They're fetched with the payouts.</span>
                }
                else
                {
                    <span>Import an orders report: @OrderHelp(_channel.Kind)</span>
                }
                <a href="/sales/channels/@_channel.Id/skus">Map SKUs to items</a>.
            </p>
            @if (Orders is not null)
            {
                <div class="alert notice" role="status">Imported @Orders new @(Orders == 1 ? "order" : "orders")@(Skipped > 0 ? $"; {Skipped} already imported were skipped" : ""). @Note</div>
            }
            <PostForm Action="@($"/sales/channels/{_channel.Id}/orders")" enctype="multipart/form-data" data-enhance="false">
                <AntiforgeryToken />
                <div class="field"><input type="file" name="file" accept=".csv,.txt,.tsv" required /></div>
                <div class="actions"><button type="submit" class="secondary" disabled="@(!_channel.IsActive)">@L["Import orders"]</button></div>
            </PostForm>
            @if (_batches.Count(b => b.Status == PayoutStatus.Pending) is var waiting and > 0)
            {
                <PostForm Action="@($"/sales/channels/{_channel.Id}/orders/post-waiting")" data-enhance="false" class="actions">
                    <AntiforgeryToken />
                    <button type="submit">Post all waiting (@waiting)</button>
                    <span class="hint">Each batch posts its stock and cost on its own; one that can't (an unmapped SKU, say) is left waiting with the reason.</span>
                </PostForm>
            }
            @if (_batches.Count > 0)
            {
                <table class="data" style="margin-top: 1rem">
                    <thead><tr><th>@L["Date"]</th><th class="num">@L["Orders"]</th><th class="num">@L["Items"]</th><th class="num">@L["Sales"]</th><th>@L["Status"]</th></tr></thead>
                    <tbody>
                        @foreach (var b in _batches.Where(b => b.Status == PayoutStatus.Pending).Concat(_batches.Where(b => b.Status != PayoutStatus.Pending).Take(60)))
                        {
                            <tr class="@(b.Status == PayoutStatus.Dismissed ? "muted" : "")">
                                <td><a href="/sales/channels/orders/@b.Id">@Labels.Date(b.Date)</a></td>
                                <td class="num">@b.Orders</td>
                                <td class="num">@Labels.Quantity(b.Lines.Sum(l => l.Quantity))</td>
                                <td class="num">@Labels.Amount(b.Lines.Sum(l => l.Sales))</td>
                                <td>@ChannelLabels.Status(b.Status)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <h2 style="margin-top: 1.5rem">@L["Payouts"]</h2>
        @if (_payouts.Count == 0)
        {
            <p class="muted">@L["No payouts yet."]</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>@L["Date"]</th><th>@L["Payout"]</th><th class="num">@L["Sales"]</th><th class="num">@L["Refunds"]</th>
                            <th class="num">@L["Fees"]</th><th class="num">@L["Net"]</th><th>@L["Status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _payouts)
                        {
                            <tr class="@(p.Status == PayoutStatus.Dismissed ? "muted" : "")">
                                <td>@Labels.Date(p.Date)</td>
                                <td><a href="/sales/channels/payouts/@p.Id">@p.ExternalId</a></td>
                                <td class="num">@Labels.Amount(p.Total(ChannelLineType.Sale) + p.Total(ChannelLineType.Shipping))</td>
                                <td class="num">@Labels.Amount(p.Total(ChannelLineType.Refund))</td>
                                <td class="num">@Labels.Amount(p.Total(ChannelLineType.Fee))</td>
                                <td class="num">@Labels.Amount(p.Net)</td>
                                <td>@ChannelLabels.Status(p.Status)@(p.Difference != 0m ? " · doesn't add up" : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="card" style="margin-top: 1.5rem" id="rules">
            <h2>Account rules</h2>
            <p class="hint">Send some payout lines to their own account: advertising fees to Advertising, a reserve held back to an asset account, and so on. A line whose description or reference contains the words (and of the type, when one is chosen) goes to the account of the first rule that fits; the rest go to the accounts below. Payouts waiting to post follow the rules; posted ones keep their entries. Tax lines always go to the tax account.</p>
            <PostForm Action="@($"/sales/channels/{_channel.Id}/rules")" data-enhance="false">
                <AntiforgeryToken />
                <div class="table-wrap">
                    <table class="data entry">
                        <thead><tr><th>Words in the line</th><th>Type of line</th><th>Account</th></tr></thead>
                        <tbody>
                            @{ var rules = _channel.Rules; }
                            @for (var i = 0; i < rules.Count + 3; i++)
                            {
                                var rule = i < rules.Count ? rules[i] : null;
                                var index = i;
                                <tr>
                                    <td><input name="rtext:@index" value="@rule?.Text" maxlength="100" aria-label="Words to look for, rule @(index + 1)" /></td>
                                    <td>
                                        <select name="rtype:@index" aria-label="Type of line, rule @(index + 1)">
                                            <option value="">Any type</option>
                                            @foreach (var type in RuleTypes)
                                            {
                                                <option value="@type" selected="@(rule?.Type == type)">@ChannelPayout.Label(type)</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <select name="racct:@index" data-search aria-label="Account, rule @(index + 1)">
                                            <option value="">Choose an account…</option>
                                            @foreach (var (account, _) in _chart.Ordered(includeInactive: false).Where(x => x.Account.Type is not (AccountType.AccountsReceivable or AccountType.AccountsPayable)))
                                            {
                                                <option value="@account.Id" selected="@(rule?.AccountId == account.Id)">@_chart.FullName(account.Id)</option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="actions"><button type="submit">Save rules</button></div>
            </PostForm>
        </div>

        <div class="card" style="margin-top: 1.5rem">
            <h2>@L["Settings"]</h2>
            <PostForm Action="@($"/sales/channels/{_channel.Id}")" data-enhance="false">
                <AntiforgeryToken />
                <ChannelForm Channel="_channel" Chart="_chart" />
                <label class="check"><input type="checkbox" name="active" value="true" checked="@_channel.IsActive" /> <span>@L["Active"]</span></label>
                <div class="actions"><button type="submit">@L["Save"]</button></div>
            </PostForm>
        </div>
    }
</div>

@code {
    private SalesChannel? _channel;
    private IReadOnlyList<ChannelPayout> _payouts = [];
    private IReadOnlyList<ChannelOrderBatch> _batches = [];

    [Inject] private ChannelOrderService OrderService { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "orders")] private int? Orders { get; set; }

    private static string OrderHelp(ChannelKind kind) => kind switch
    {
        ChannelKind.Amazon => "Seller Central › Reports › Fulfillment or Order Reports › All Orders (tab-separated).",
        ChannelKind.Ebay => "Seller Hub › Orders › Download report (CSV).",
        ChannelKind.Etsy => "Shop Manager › Settings › Options › Download Data › Orders, \"Order Items\" (CSV).",
        ChannelKind.Shopify => "Orders › Export (CSV), or connect the store to fetch them.",
        _ => "any CSV with order id, date, SKU, quantity and price columns (shipping, tax and ship-to state if you have them).",
    };
    private OpenBook.Domain.Accounts.ChartOfAccounts _chart = new([]);

    private static readonly ChannelLineType[] RuleTypes =
        [ChannelLineType.Sale, ChannelLineType.Shipping, ChannelLineType.Refund, ChannelLineType.Fee, ChannelLineType.Adjustment];

    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? Done { get; set; }
    [SupplyParameterFromQuery] private int? Imported { get; set; }
    [SupplyParameterFromQuery] private int Skipped { get; set; }
    [SupplyParameterFromQuery] private string? Note { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _channel = await ChannelService.GetAsync(Id);
        if (_channel is null)
            return;
        _payouts = await ChannelService.PayoutsAsync(Id);
        _batches = await OrderService.BatchesAsync(Id);
        _chart = await AccountService.GetChartAsync();
    }
}
