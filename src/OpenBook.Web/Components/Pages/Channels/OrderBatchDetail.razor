@page "/sales/channels/orders/{Id:guid}"
@using OpenBook.Application.Channels
@using OpenBook.Domain.Channels
@using OpenBook.Web.Components.Channels
@inject ChannelOrderService Orders
@inject ChannelService ChannelService

<PageTitle>@L["Orders"] · OpenBook</PageTitle>

<div class="wide">
    @if (_batch is null || _channel is null)
    {
        <div class="card"><p>Those orders don't exist. <a href="/sales/channels">Back to sales channels</a>.</p></div>
    }
    else
    {
        <div class="toolbar">
            <h1>@_channel.Name · orders of @Labels.Date(_batch.Date)</h1>
            <ActionLink Class="button secondary" Href="@($"/sales/channels/{_channel.Id}")">@L["Back to the channel"]</ActionLink>
            <ActionLink Class="button secondary" Href="@($"/sales/channels/{_channel.Id}/skus")">@L["SKUs"]</ActionLink>
            <ActionLink Class="button secondary" Href="@($"/audit?entityId={_batch.Id}")">@L["History"]</ActionLink>
        </div>
        @if (Error is not null)
        {
            <div class="alert error" role="alert">@Error</div>
        }

        <div class="card">
            <p class="muted">
                Posting takes the stocked items out of stock on this date and moves their cost to cost of goods sold. The money for these
                orders comes in with the channel's payouts. Unmapped SKUs need an item (or "not stocked") on the SKUs page first.
            </p>
            <dl class="facts">
                <dt>@L["Status"]</dt><dd>@ChannelLabels.Status(_batch.Status)</dd>
                <dt>@L["Orders"]</dt><dd>@_batch.Orders</dd>
                @if (_batch.JournalEntryId is { } entryId)
                {
                    <dt>@L["Journal entry"]</dt><dd><a href="/journal/@entryId">@L["Open"]</a></dd>
                }
            </dl>
            @if (_unmapped.Count > 0 && _batch.Status == PayoutStatus.Pending)
            {
                <div class="alert notice" role="status">Not mapped yet: @string.Join(", ", _unmapped). <a href="/sales/channels/@_channel.Id/skus">Map them</a>.</div>
            }
            <div class="actions">
                @if (_batch.Status == PayoutStatus.Pending)
                {
                    <PostForm Action="@($"/sales/channels/orders/{_batch.Id}/post")" data-enhance="false" class="inline">
                        <AntiforgeryToken />
                        <button type="submit" disabled="@(_unmapped.Count > 0)">@L["Post stock"]</button>
                    </PostForm>
                    <PostForm Action="@($"/sales/channels/orders/{_batch.Id}/dismiss")" data-enhance="false" class="inline">
                        <AntiforgeryToken />
                        <button type="submit" class="secondary">@L["Dismiss"]</button>
                    </PostForm>
                }
                else if (_batch.Status == PayoutStatus.Dismissed)
                {
                    <PostForm Action="@($"/sales/channels/orders/{_batch.Id}/dismiss")" data-enhance="false" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="restore" value="true" />
                        <button type="submit" class="secondary">@L["Restore"]</button>
                    </PostForm>
                }
                else
                {
                    <PostForm Action="@($"/sales/channels/orders/{_batch.Id}/void")" data-enhance="false" class="inline">
                        <AntiforgeryToken />
                        <input name="reason" placeholder="Reason for voiding" maxlength="500" />
                        <button type="submit" class="danger">@L["Put the stock back"]</button>
                    </PostForm>
                }
            </div>
        </div>

        <div class="table-wrap" style="margin-top: 1.5rem">
            <table class="data">
                <thead>
                    <tr>
                        <th>@L["Order"]</th><th>@L["SKU"]</th><th>@L["Item"]</th><th class="num">@L["Qty"]</th><th class="num">@L["Sales"]</th>
                        <th class="num">@L["Shipping"]</th><th class="num">@L["Tax"]</th><th>@L["State"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in _batch.Lines)
                    {
                        <tr>
                            <td>@l.OrderId</td>
                            <td>@l.Sku</td>
                            <td>@l.Title</td>
                            <td class="num">@Labels.Quantity(l.Quantity)</td>
                            <td class="num">@Labels.Amount(l.Sales)</td>
                            <td class="num">@Labels.AmountOrBlank(l.Shipping)</td>
                            <td class="num">@Labels.AmountOrBlank(l.Tax)</td>
                            <td>@l.Region</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_batch.Status == PayoutStatus.Posted)
        {
            <div class="card" style="margin-top: 1.5rem">
                <h2>Returns</h2>
                <p class="muted">Items that came back go into stock at their latest sale cost. The refund itself comes in with the channel's payout.</p>
                @if (_returns.Count > 0)
                {
                    <ul>
                        @foreach (var r in _returns)
                        {
                            <li><a href="/sales/channels/returns/@r.Id">@Labels.Date(r.Date): @r.Lines.Sum(l => l.Quantity).ToString("0.####") item(s)</a>@(r.Status == DocumentStatus.Voided ? " (voided)" : "")</li>
                        }
                    </ul>
                }
                @if (_batch.Lines.Any(l => l.Quantity - _returned.GetValueOrDefault(l.LineNumber) > 0m))
                {
                    <PostForm Action="@($"/sales/channels/orders/{_batch.Id}/returns")" data-enhance="false">
                        <AntiforgeryToken />
                        <table class="data">
                            <thead><tr><th>Order</th><th>SKU</th><th class="num">Sold</th><th class="num">Back already</th><th class="num">Came back now</th></tr></thead>
                            <tbody>
                                @foreach (var l in _batch.Lines.Where(l => l.Quantity - _returned.GetValueOrDefault(l.LineNumber) > 0m))
                                {
                                    <tr>
                                        <td>@l.OrderId</td>
                                        <td>@l.Sku</td>
                                        <td class="num">@Labels.Quantity(l.Quantity)</td>
                                        <td class="num">@Labels.Quantity(_returned.GetValueOrDefault(l.LineNumber))</td>
                                        <td class="num"><input name="qty:@l.LineNumber" inputmode="decimal" size="5" aria-label="Returned from order @l.OrderId" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="row">
                            <div class="field"><label for="return-date">Date</label><input id="return-date" name="date" type="date" value="@CompanyTime.Today.ToString("yyyy-MM-dd")" /></div>
                            <div class="field"><label for="return-memo">Memo <span class="muted">(optional)</span></label><input id="return-memo" name="memo" maxlength="@ChannelReturn.MaxMemoLength" /></div>
                        </div>
                        <div class="actions"><button type="submit" class="secondary">Put the returns in stock</button></div>
                    </PostForm>
                }
            </div>
        }
    }
</div>

@code {
    private ChannelOrderBatch? _batch;
    private SalesChannel? _channel;
    private IReadOnlyList<string> _unmapped = [];
    private IReadOnlyList<ChannelReturn> _returns = [];
    private IReadOnlyDictionary<int, decimal> _returned = new Dictionary<int, decimal>();

    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _batch = await Orders.GetBatchAsync(Id);
        if (_batch is null)
            return;
        _channel = await ChannelService.GetAsync(_batch.ChannelId);
        _returns = await Orders.ListReturnsAsync(_batch.Id);
        _returned = await Orders.ReturnedAsync(_batch.Id);
        var skus = (await Orders.SkusAsync(_batch.ChannelId)).ToDictionary(s => s.Sku, StringComparer.OrdinalIgnoreCase);
        _unmapped = _batch.Lines.Select(l => l.MappingKey).Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(s => !skus.TryGetValue(s, out var m) || !m.Mapped).ToList();
    }
}
