@page "/accounts/new"
@page "/accounts/{Id:guid}"
@using System.ComponentModel.DataAnnotations
@inject AccountService AccountService
@inject CompanySettingsService Settings
@inject NavigationManager Navigation

<PageTitle>@(_account is null ? "New account" : _account.Name) · OpenBook</PageTitle>

@if (Id is not null && _account is null)
{
    <div class="card"><p>That account doesn't exist. <a href="/accounts">Back to the chart of accounts</a>.</p></div>
    return;
}

<div class="card">
    <h1>@(_account is null ? "New account" : "Edit account")</h1>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (_account is { IsActive: false })
    {
        <div class="alert notice" role="status">This account is inactive: it can't be used in new transactions.</div>
    }

    <EditForm Model="Input" FormName="account" OnValidSubmit="SaveAsync" method="post">
        <DataAnnotationsValidator />
        <div class="row">
            <div class="field">
                <label for="name">Name</label>
                <InputText id="name" @bind-Value="Input.Name" />
                <ValidationMessage For="() => Input.Name" />
            </div>
            @if (_useNumbers)
            {
                <div class="field">
                    <label for="number">Number <span class="muted">(optional)</span></label>
                    <InputText id="number" @bind-Value="Input.Number" />
                </div>
            }
        </div>
        <div class="row">
            <div class="field">
                <label for="type">Type</label>
                <InputSelect id="type" @bind-Value="Input.Type">
                    @foreach (var group in Enum.GetValues<AccountType>().GroupBy(t => t.ClassOf()))
                    {
                        <optgroup label="@Labels.For(group.Key)">
                            @foreach (var type in group)
                            {
                                <option value="@type">@Labels.For(type)</option>
                            }
                        </optgroup>
                    }
                </InputSelect>
            </div>
            <div class="field">
                <label for="parent">Subaccount of</label>
                <InputSelect id="parent" @bind-Value="Input.ParentId">
                    <option value="">(none: top-level account)</option>
                    @foreach (var (candidate, _) in _parents)
                    {
                        <option value="@candidate.Id">@Labels.AccountName(_chart, candidate.Id, _useNumbers) (@Labels.For(candidate.Type))</option>
                    }
                </InputSelect>
                <span class="hint">A subaccount must have the same type as its parent.</span>
            </div>
        </div>
        <div class="field">
            <label for="description">Description <span class="muted">(optional)</span></label>
            <InputText id="description" @bind-Value="Input.Description" />
        </div>
        <div class="actions">
            <button type="submit">@(_account is null ? "Create account" : "Save changes")</button>
            <a href="/accounts">Cancel</a>
        </div>
    </EditForm>
</div>

@if (_account is not null)
{
    <div class="card">
        <h2>@(_account.IsActive ? "Make inactive" : "Make active")</h2>
        <p class="muted">
            @(_account.IsActive
                ? "Inactive accounts keep their history and still appear in reports, but can't be used in new transactions. Accounts are never deleted."
                : "Make this account available for new transactions again.")
        </p>
        <form method="post" @formname="toggle-active" @onsubmit="ToggleActiveAsync">
            <AntiforgeryToken />
            <button type="submit" class="secondary">@(_account.IsActive ? "Make inactive" : "Make active")</button>
        </form>
    </div>
}

@code {
    private Account? _account;
    private ChartOfAccounts _chart = new([]);
    private List<(Account Account, int Depth)> _parents = [];
    private bool _useNumbers;
    private string? _error;

    [Parameter]
    public Guid? Id { get; set; }

    [SupplyParameterFromForm(FormName = "account")]
    private AccountModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _useNumbers = (await Settings.GetAsync()).UseAccountNumbers;
        _chart = await AccountService.GetChartAsync();
        _account = Id is { } id ? _chart.Find(id) : null;

        // Active accounts, excluding this one and its subaccounts (an account can't move under itself).
        var excluded = _account is null ? [] : Subtree(_account.Id).ToHashSet();
        _parents = _chart.Ordered(includeInactive: false).Where(x => !excluded.Contains(x.Account.Id)).ToList();

        Input ??= _account is null
            ? new AccountModel()
            : new AccountModel
            {
                Name = _account.Name,
                Number = _account.Number,
                Type = _account.Type,
                ParentId = _account.ParentId,
                Description = _account.Description,
            };
    }

    private async Task SaveAsync()
    {
        try
        {
            if (_account is null)
                await AccountService.CreateAsync(new CreateAccountCommand(Input.Name, Input.Type, NumberToSave(), Input.ParentId, Input.Description));
            else
                await AccountService.UpdateAsync(new UpdateAccountCommand(_account.Id, Input.Name, Input.Type, NumberToSave(), Input.ParentId, Input.Description));
            Navigation.NavigateTo("/accounts");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ToggleActiveAsync()
    {
        try
        {
            if (_account!.IsActive)
                await AccountService.DeactivateAsync(_account.Id);
            else
                await AccountService.ReactivateAsync(_account.Id);
            Navigation.NavigateTo($"/accounts/{_account.Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }

    // With numbering off the field is hidden; keep whatever number the account already has.
    private string? NumberToSave() => _useNumbers ? Input.Number : _account?.Number;

    private IEnumerable<Guid> Subtree(Guid id) =>
        _chart.ChildrenOf(id).SelectMany(c => Subtree(c.Id)).Prepend(id);

    private sealed class AccountModel
    {
        [Required(ErrorMessage = "Enter a name.")]
        [StringLength(Account.MaxNameLength)]
        public string Name { get; set; } = string.Empty;

        public string? Number { get; set; }

        public AccountType Type { get; set; } = AccountType.Expense;

        public Guid? ParentId { get; set; }

        public string? Description { get; set; }
    }
}
