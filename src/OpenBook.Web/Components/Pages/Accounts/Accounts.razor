@page "/accounts"
@inject AccountService AccountService
@inject CompanySettingsService Settings
@inject ChartTemplates Templates

<PageTitle>Chart of accounts · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Chart of accounts</h1>
        <ActionLink Class="button" Href="/accounts/new">New account</ActionLink>
    </div>
    <div class="hub-actions">
        <div class="hub-group"><span class="hub-label">Lists</span>
            <ActionLink Class="button secondary" Href="/segments">Classes and locations</ActionLink>
            <ActionLink Class="button secondary" Href="/assets">Fixed assets</ActionLink>
            <ActionLink Class="button secondary" Href="/loans">Loans</ActionLink>
        </div>
        <div class="hub-group"><span class="hub-label">Tools</span>
            <ActionLink Class="button secondary" Href="/journal">Journal</ActionLink>
            <ActionLink Class="button secondary" Href="/settings/close-books">Close the books</ActionLink>
            <ActionLink Class="button secondary" Href="/accountant">Accountant tools</ActionLink>
            <ActionLink Class="button secondary" Href="/accounts/import">Import CSV</ActionLink>
            <a class="button secondary" href="@(ShowInactive ? "/accounts" : "/accounts?showInactive=true")">
            @(ShowInactive ? "Hide inactive" : "Show inactive")
        </a>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (MovedIn)
    {
        <div class="alert notice" role="status">
            Your company is set up and your export is imported. Check the accounts below; the transactions are in the <a href="/journal">Journal</a>,
            and customers, vendors and products in their lists. Enter open invoices and bills you still need to collect or pay, since imported transactions don't list in aging.
        </div>
    }
    @if (_imported is { } imported)
    {
        <div class="alert notice" role="status">Added @imported accounts. Rename, renumber or deactivate any you don't need.</div>
    }

    @if (_rows.Count == 0)
    {
        <div class="card">
            <h2>Start with a chart of accounts</h2>
            <p class="muted">Pick a starter chart to begin with; you can change it afterwards. Or <ActionLink Href="/accounts/new">add accounts one by one</ActionLink>, or <ActionLink Href="/accounts/import">import your own from a CSV file</ActionLink>.</p>
            <form method="post" @formname="template" @onsubmit="ApplyTemplateAsync">
                <AntiforgeryToken />
                <div class="choices">
                    @foreach (var template in ChartTemplates.All)
                    {
                        var recommended = template.Key == _recommended;
                        <div class="choice @(recommended ? "recommended" : null)">
                            <h3>@template.Name @if (recommended) { <span class="badge">Recommended</span> }</h3>
                            <p class="muted">@template.Description</p>
                            <button type="submit" name="TemplateKey" value="@template.Key" class="@(recommended ? null : "secondary")">Use this chart</button>
                        </div>
                    }
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        @if (_useNumbers)
                        {
                            <th>Number</th>
                        }
                        <th>Name</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (account, depth) in _rows)
                    {
                        <tr class="@(account.IsActive ? null : "inactive")">
                            @if (_useNumbers)
                            {
                                <td>@account.Number</td>
                            }
                            <td class="indent-@depth">
                                <a href="/accounts/@account.Id">@account.Name</a>
                                @if (!account.IsActive)
                                {
                                    <span class="badge">Inactive</span>
                                }
                            </td>
                            <td>@Labels.For(account.Type)</td>
                            <td class="muted">@account.Description</td>
                            <td><a href="/accounts/@account.Id/register">Register</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<(Account Account, int Depth)> _rows = [];
    private bool _useNumbers;

    [SupplyParameterFromQuery]
    private bool ShowInactive { get; set; }

    // Arriving from company setup with an import.
    [SupplyParameterFromQuery]
    private bool MovedIn { get; set; }

    private string? _recommended;
    private string? _error;
    private int? _imported;

    [SupplyParameterFromForm(FormName = "template")]
    private string? TemplateKey { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var company = await Settings.GetAsync();
        _useNumbers = company.UseAccountNumbers;
        _recommended = ChartTemplates.ForBusinessType(company.BusinessType).Key;
        await LoadAsync();
    }

    private async Task LoadAsync() => _rows = (await AccountService.GetChartAsync()).Ordered(includeInactive: ShowInactive).ToList();

    private async Task ApplyTemplateAsync()
    {
        try
        {
            if (_rows.Count > 0 || string.IsNullOrEmpty(TemplateKey))
                return;
            var result = await Templates.ApplyAsync(TemplateKey);
            _imported = result.NewCount;
            _useNumbers = (await Settings.GetAsync()).UseAccountNumbers;
            await LoadAsync();
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }
}
