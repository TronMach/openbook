@page "/banking/{AccountId:guid}/import"
@rendermode InteractiveServer
@using OpenBook.Application.Import
@inject Operations Ops

<PageTitle>Import transactions · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Import transactions</h1>
        <ActionLink Class="button secondary" Href="@($"/banking/{AccountId}/feed")">Review queue</ActionLink>
        <ActionLink Class="button secondary" Href="@($"/banking/{AccountId}")">Back to register</ActionLink>
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (_result is { } result)
    {
        <div class="alert notice" role="status">
            @result.Queued @(result.Queued == 1 ? "line is" : "lines are") waiting for review@(result.AutoAdded > 0 ? $"; rules added {result.AutoAdded} straight to the books" : "")@(result.Skipped > 0 ? $"; {result.Skipped} already imported were skipped" : "").
            <ActionLink Href="@($"/banking/{AccountId}/feed")">Review them now</ActionLink>.
            @if (result.NotAdded is { } notAdded)
            {
                <p>@notAdded</p>
            }
        </div>
    }

    @if (_account is not null)
    {
        <div class="card">
            <p>
                Into <strong>@_accountName</strong>. Download transactions from your bank's website as <strong>OFX, QFX or QBO</strong>
                (best: each line carries the bank's own id, so nothing imports twice) or as <strong>CSV</strong>, and upload the file here.
                Lines go to a review queue, where bank rules suggest categories and you add, match or exclude each one.
            </p>
            <div class="field">
                <label for="file">Statement file</label>
                <InputFile id="file" accept=".csv,.ofx,.qfx,.qbo,text/csv" OnChange="LoadAsync" disabled="@_busy" />
            </div>
        </div>
    }

    @if (_preview is not null && _result is null)
    {
        <div class="card">
            <h2>Check how the file was read</h2>
            <p class="muted">@string.Join(" · ", _preview.ColumnsUsed)</p>
            @if (!_isOfx)
            {
                <div class="row">
                    <div class="field">
                        <label for="date-order">Dates are written</label>
                        <select id="date-order" value="@_preview.DateOrder" @onchange="ChangeDateOrderAsync">
                            <option value="@DateOrder.YearFirst">Year first (2026-10-31)</option>
                            <option value="@DateOrder.MonthFirst">Month first (10/31/2026)</option>
                            <option value="@DateOrder.DayFirst">Day first (31/10/2026)</option>
                        </select>
                        @if (_preview.DateOrderAmbiguous)
                        {
                            <span class="hint out-of-balance">Every date in this file fits both month-first and day-first. Check the dates below.</span>
                        }
                    </div>
                    @if (!_preview.HasDebitCreditColumns)
                    {
                        <div class="field">
                            <label for="sign">In the amount column</label>
                            <select id="sign" value="@_options.AmountSign" @onchange="ChangeSignAsync">
                                <option value="@AmountSign.PositiveIsMoneyIn">Positive amounts are money in</option>
                                <option value="@AmountSign.PositiveIsMoneyOut">Positive amounts are money out</option>
                            </select>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="table-wrap">
            <table class="data entry">
                <thead>
                    <tr>
                        <th class="check"><input type="checkbox" aria-label="Choose all new rows" checked="@_rows.Where(Selectable).All(r => r.Include)" @onchange="ToggleAll" /></th>
                        <th>Date</th>
                        <th>Payee / description</th>
                        <th>Ref</th>
                        <th class="num">Money out</th>
                        <th class="num">Money in</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _rows)
                    {
                        var row = item.Row;
                        <tr class="@(Selectable(item) ? null : "inactive")">
                            <td class="check">
                                @if (Selectable(item))
                                {
                                    <input type="checkbox" aria-label="Import line @row.Line" @bind="item.Include" />
                                }
                            </td>
                            <td>@(row.Date is { } d ? Labels.Date(d) : "")</td>
                            <td>
                                @row.Payee
                                @if (row.AlreadyImported)
                                {
                                    <span class="badge" title="This line was imported before; it will be skipped">Already imported</span>
                                }
                                else if (row.PossibleDuplicate)
                                {
                                    <span class="badge warn" title="Same date, amount and payee as a transaction already in OpenBook">Possible duplicate</span>
                                }
                                @if (row.Error is not null)
                                {
                                    <div class="out-of-balance">Line @row.Line: @row.Error</div>
                                }
                            </td>
                            <td>@row.Reference</td>
                            <td class="num">@(row.Amount < 0m ? Labels.Amount(-row.Amount.Value) : "")</td>
                            <td class="num">@(row.Amount > 0m ? Labels.Amount(row.Amount.Value) : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="actions">
            <button type="button" @onclick="QueueAsync" disabled="@(!Selected.Any() || _busy)">Send @Selected.Count() to review</button>
            <span class="muted">Nothing is posted until you review it, except lines an automatic rule adds.</span>
        </div>
    }
</div>

@code {
    private const long MaxFileBytes = 5 * 1024 * 1024;

    private Account? _account;
    private string? _accountName;
    private string? _text;
    private bool _isOfx;
    private BankImportOptions _options = new();
    private BankImportPreview? _preview;
    private List<RowModel> _rows = [];
    private FeedImportResult? _result;
    private string? _error;
    private bool _busy;

    [Parameter]
    public Guid AccountId { get; set; }

    private IEnumerable<RowModel> Selected => _rows.Where(r => r.Include && Selectable(r));

    private static bool Selectable(RowModel r) => r.Row.IsValid && !r.Row.AlreadyImported;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var chart = await Ops.RunAsync(sp => sp.GetRequiredService<AccountService>().GetChartAsync());
            _account = chart.Get(AccountId);
            BankingRules.EnsureBankingAccount(_account);
            _accountName = chart.FullName(AccountId);
        }
        catch (DomainException ex)
        {
            _account = null;
            _error = ex.Message;
        }
    }

    private async Task LoadAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        _result = null;
        if (e.File.Size > MaxFileBytes)
        {
            _error = "That file is larger than 5 MB. Export a shorter date range.";
            return;
        }

        await using var stream = e.File.OpenReadStream(MaxFileBytes);
        using var reader = new StreamReader(stream);
        _text = await reader.ReadToEndAsync();
        _isOfx = Ofx.LooksLikeOfx(_text);
        _options = new BankImportOptions();
        await PreviewAsync();
    }

    private async Task ChangeDateOrderAsync(ChangeEventArgs e)
    {
        _options = _options with { DateOrder = Enum.Parse<DateOrder>((string)e.Value!) };
        await PreviewAsync();
    }

    private async Task ChangeSignAsync(ChangeEventArgs e)
    {
        _options = _options with { AmountSign = Enum.Parse<AmountSign>((string)e.Value!) };
        await PreviewAsync();
    }

    private async Task PreviewAsync()
    {
        if (_text is null)
            return;
        if (_busy)
            return;
        _busy = true;
        try
        {
            _preview = await Ops.RunAsync<BankFeedService, BankImportPreview>(s => s.PreviewAsync(AccountId, _text, _options));
            _rows = _preview.Rows.Select(r => new RowModel(r) { Include = r.IsValid && !r.AlreadyImported && !r.PossibleDuplicate }).ToList();
        }
        catch (DomainException ex)
        {
            _preview = null;
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        var include = e.Value is true;
        foreach (var row in _rows.Where(Selectable))
            row.Include = include;
    }

    private async Task QueueAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            var lines = Selected.Select(r => new FeedLine(r.Row.Date!.Value, r.Row.Amount!.Value, r.Row.Payee, r.Row.Reference, r.Row.Memo, r.Row.FitId, Occurrence: r.Row.Occurrence)).ToList();
            _result = await Ops.RunAsync<BankFeedService, FeedImportResult>(s => s.QueueAsync(AccountId, lines));
            _preview = null;
            _rows = [];
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class RowModel(BankImportRow row)
    {
        public BankImportRow Row { get; } = row;
        public bool Include { get; set; }
    }
}
