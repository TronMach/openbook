@page "/banking"
@inject BankingService BankingService
@inject DepositService Deposits
@inject BankFeedService Feed

<PageTitle>Banking · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Banking</h1>
        @if (_accounts.Count >= 2)
        {
            <ActionLink Class="button secondary" Href="/banking/transfer">Transfer</ActionLink>
        }
        @if (_undeposited > 0)
        {
            <ActionLink Class="button" Href="/banking/deposits/new">Make deposit (@_undeposited waiting)</ActionLink>
        }
    </div>
    <div class="hub-actions">
        <div class="hub-group"><span class="hub-label">Tools</span>
            <ActionLink Class="button secondary" Href="/banking/checks">Print checks</ActionLink>
            <ActionLink Class="button secondary" Href="/banking/positive-pay">Positive pay</ActionLink>
            <ActionLink Class="button secondary" Href="/banking/petty-cash">Petty cash</ActionLink>
            <ActionLink Class="button secondary" Href="/banking/recurring">Recurring expenses</ActionLink>
            <PostForm Action="/banking/paid-personally" class="inline inline-form">
                <AntiforgeryToken />
                <button type="submit" class="secondary">Paid with your own money</button>
            </PostForm>
        </div>
        <div class="hub-group"><span class="hub-label">Set up</span>
            <ActionLink Class="button secondary" Href="/banking/rules">Bank rules</ActionLink>
            <ActionLink Class="button secondary" Href="/banking/connections">Bank connections</ActionLink>
        </div>
    </div>

    @if (_accounts.Count == 0)
    {
        <div class="card">
            <p>
                No bank or credit card accounts yet. <ActionLink Href="/accounts/new">Add an account</ActionLink> with type
                <strong>Bank</strong> or <strong>Credit card</strong>, and it will appear here.
            </p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Account</th>
                        <th>Type</th>
                        <th class="num">Balance in books</th>
                        <th class="num">Reconciled balance</th>
                        <th>Reconciled through</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var summary in _accounts)
                    {
                        var account = summary.Account;
                        <tr>
                            <td>
                                <a href="/banking/@account.Id">@summary.FullName</a>
                                @if (_pending.GetValueOrDefault(account.Id) is > 0 and var pending)
                                {
                                    <ActionLink Class="badge warn" Href="@($"/banking/{account.Id}/feed")">@pending to review</ActionLink>
                                }
                            </td>
                            <td class="muted">@Labels.For(account.Type)</td>
                            <td class="num">@Labels.Amount(summary.Balance)</td>
                            <td class="num">@Labels.Amount(summary.ReconciledBalance)</td>
                            <td>
                                @(summary.LastReconciledDate is { } d ? Labels.Date(d) : "Never")
                                @if (summary.ReconciliationInProgressId is not null)
                                {
                                    <span class="badge">In progress</span>
                                }
                            </td>
                            <td>
                                <ActionLink Href="@($"/banking/{account.Id}/record/spend")">@Labels.For(BankTransactionKind.Spend, account.Type)</ActionLink> ·
                                <ActionLink Href="@($"/banking/{account.Id}/record/receive")">@Labels.For(BankTransactionKind.Receive, account.Type)</ActionLink> ·
                                <ActionLink Href="@($"/banking/{account.Id}/import")">Import</ActionLink> ·
                                <ActionLink Href="@($"/banking/{account.Id}/feed")">Review</ActionLink> ·
                                <ActionLink Href="@($"/banking/{account.Id}/reconcile")">Reconcile</ActionLink>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted">Credit card balances show what's owed. Balances include every posted transaction, reconciled or not.</p>
    }
</div>

@code {
    private IReadOnlyList<BankAccountSummary> _accounts = [];

    private int _undeposited;
    private readonly Dictionary<Guid, int> _pending = [];

    protected override async Task OnInitializedAsync()
    {
        _accounts = await BankingService.ListAccountsAsync();
        _undeposited = (await Deposits.UndepositedAsync()).Count;
        foreach (var summary in _accounts)
            _pending[summary.Account.Id] = await Feed.PendingCountAsync(summary.Account.Id);
    }
}
