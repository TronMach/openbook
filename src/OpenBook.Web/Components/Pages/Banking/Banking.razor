@page "/banking"
@inject BankingService BankingService
@inject DepositService Deposits
@inject BankFeedService Feed

<PageTitle>Banking · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Banking</h1>
        @if (_undeposited > 0)
        {
            <a class="button" href="/banking/deposits/new">Make deposit (@_undeposited waiting)</a>
        }
        <a class="button secondary" href="/banking/rules">Bank rules</a>
        <a class="button secondary" href="/banking/checks">Print checks</a>
        <a class="button secondary" href="/banking/positive-pay">Positive pay</a>
        <a class="button secondary" href="/banking/petty-cash">Petty cash</a>
        <AuthorizeView>
            @if (context.User.CanReach("/banking/connections"))
            {
                <a class="button secondary" href="/banking/connections">Bank connections</a>
            }
        </AuthorizeView>
        @if (_accounts.Count >= 2)
        {
            <a class="button secondary" href="/banking/transfer">Transfer</a>
        }
    </div>

    @if (_accounts.Count == 0)
    {
        <div class="card">
            <p>
                No bank or credit card accounts yet. <a href="/accounts/new">Add an account</a> with type
                <strong>Bank</strong> or <strong>Credit card</strong>, and it will appear here.
            </p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Account</th>
                        <th>Type</th>
                        <th class="num">Balance in books</th>
                        <th class="num">Reconciled balance</th>
                        <th>Reconciled through</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var summary in _accounts)
                    {
                        var account = summary.Account;
                        <tr>
                            <td>
                                <a href="/banking/@account.Id">@summary.FullName</a>
                                @if (_pending.GetValueOrDefault(account.Id) is > 0 and var pending)
                                {
                                    <a class="badge warn" href="/banking/@account.Id/feed">@pending to review</a>
                                }
                            </td>
                            <td class="muted">@Labels.For(account.Type)</td>
                            <td class="num">@Labels.Amount(summary.Balance)</td>
                            <td class="num">@Labels.Amount(summary.ReconciledBalance)</td>
                            <td>
                                @(summary.LastReconciledDate is { } d ? Labels.Date(d) : "Never")
                                @if (summary.ReconciliationInProgressId is not null)
                                {
                                    <span class="badge">In progress</span>
                                }
                            </td>
                            <td>
                                <a href="/banking/@account.Id/record/spend">@Labels.For(BankTransactionKind.Spend, account.Type)</a> ·
                                <a href="/banking/@account.Id/record/receive">@Labels.For(BankTransactionKind.Receive, account.Type)</a> ·
                                <a href="/banking/@account.Id/import">Import</a> ·
                                <a href="/banking/@account.Id/feed">Review</a> ·
                                <a href="/banking/@account.Id/reconcile">Reconcile</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted">Credit card balances show what's owed. Balances include every posted transaction, reconciled or not.</p>
    }
</div>

@code {
    private IReadOnlyList<BankAccountSummary> _accounts = [];

    private int _undeposited;
    private readonly Dictionary<Guid, int> _pending = [];

    protected override async Task OnInitializedAsync()
    {
        _accounts = await BankingService.ListAccountsAsync();
        _undeposited = (await Deposits.UndepositedAsync()).Count;
        foreach (var summary in _accounts)
            _pending[summary.Account.Id] = await Feed.PendingCountAsync(summary.Account.Id);
    }
}
