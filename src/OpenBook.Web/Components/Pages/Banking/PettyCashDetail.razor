@page "/banking/petty-cash/{Id:guid}"
@inject PettyCashService PettyCashService
@inject AccountService AccountService

<PageTitle>@(_summary?.AccountName ?? "Petty cash") · OpenBook</PageTitle>

<div class="wide">
    @if (_summary is null)
    {
        <h1>Petty cash</h1>
        <p>That petty cash box doesn't exist. <a href="/banking/petty-cash">Back to petty cash</a></p>
    }
    else
    {
        var fund = _summary.Fund;
        // One filled button at a time: replenishing is the next thing only once today's count is in; until then it's the count.
        var replenishNext = _summary.ToReplenish > 0m && _banks.Count > 0 && (Done == "counted" || _summary.LastCount?.Date == CompanyTime.Today);
        <div class="toolbar">
            <h1>@_summary.AccountName</h1>
            <ActionLink Class="button secondary" Href="/banking/petty-cash">All boxes</ActionLink>
            @if (fund.IsActive)
            {
                <ActionLink Class="button secondary" Href="@($"/banking/{fund.AccountId}/record/spend")">Record spending</ActionLink>
            }
            <ActionLink Class="button secondary" Href="@($"/banking/{fund.AccountId}")">Register</ActionLink>
        </div>

        @if (Error is not null)
        {
            <div class="alert error" role="alert">@Error</div>
        }
        else if (Done is not null)
        {
            @* What happened, then what to do next: a count is the middle of the routine, not the end of it. *@
            <div class="alert success" role="status">
                @if (Done == "created")
                {
                    <div>@L["Petty cash box created."]</div>
                }
                else if (Done == "counted")
                {
                    if (Difference is null or 0m)
                    {
                        <div>@L["Count recorded. The box agrees with the books."]</div>
                    }
                    else if (Difference > 0m)
                    {
                        <div>@L["Count recorded. The box was over by {0}; that's been recorded to “{1}”, so the books now match the box.", Labels.Amount(Difference.Value), PettyCashService.OverShortName]</div>
                    }
                    else
                    {
                        <div>@L["Count recorded. The box was short by {0}; that's been recorded to “{1}”, so the books now match the box.", Labels.Amount(-Difference.Value), PettyCashService.OverShortName]</div>
                    }

                    if (Difference is not (null or 0m))
                    {
                        // The count this message is about: the newest one with that difference.
                        var difference = _counts.Where(c => c.AdjustmentTransactionId is not null && c.Difference == Difference)
                            .OrderByDescending(c => c.CountedAt).FirstOrDefault();
                        <div>
                            @L["If the difference is really spending that wasn't recorded yet, void the difference, record the spending and count again."]
                            @if (difference is not null)
                            {
                                @(" ")<ActionLink Href="@($"/banking/transactions/{difference.AdjustmentTransactionId}")">@L["Open the difference"]</ActionLink>
                            }
                        </div>
                    }

                    if (fund.IsActive && _summary.ToReplenish > 0m)
                    {
                        <div>
                            <strong>@L["Next: replenish {0} from the bank to bring the box back to its float.", Labels.Amount(_summary.ToReplenish)]</strong>
                            <a href="#replenish">@L["Go to Replenish"]</a>
                        </div>
                    }
                    else if (fund.IsActive)
                    {
                        <div><strong>@L["The box holds its float, so there's nothing to replenish. You're done until money is spent from it."]</strong></div>
                    }
                }
                else if (Done == "replenished")
                {
                    <div>@L["Transferred {0} into the box in the books. Now take that much cash from the bank and put it in the box, which brings it back to its float.", Labels.Amount(Amount ?? 0m)]</div>
                }
                else
                {
                    <div>@L["Saved."]</div>
                }
            </div>
        }

        <div class="card">
            <div class="row">
                <div><div class="muted">Float</div><strong>@Labels.Amount(fund.FloatAmount)</strong></div>
                <div><div class="muted">Balance in books today</div><strong>@Labels.Amount(_summary.Balance)</strong></div>
                <div><div class="muted">To replenish</div><strong>@Labels.Amount(_summary.ToReplenish)</strong></div>
                <div><div class="muted">Custodian</div><strong>@(fund.Custodian ?? "—")</strong></div>
            </div>
            @if (!fund.IsActive)
            {
                <p><span class="badge">Closed</span> Counts and replenishments are off.</p>
            }
        </div>

        @if (fund.IsActive)
        {
            <div class="card">
                <div class="muted">@L["Step {0} of 3", 1]</div>
                <h2>@L["Record what was spent"]</h2>
                <p class="muted">@L["Before you count, record each receipt in the box as spending from it. Anything spent and not recorded shows up as cash short when you count."]</p>
                <p><ActionLink Href="@($"/banking/{fund.AccountId}/record/spend")">@L["Record spending"]</ActionLink></p>
            </div>

            <div class="card" id="count">
                <div class="muted">@L["Step {0} of 3", 2]</div>
                <h2>Count the cash</h2>
                <p class="muted">
                    @L["Enter what's in the box. The books say it holds {0} today. If your count differs from the books on that date, the difference is recorded to “{1}” (created on first use) so the books match the box.", Labels.Amount(_summary.Balance), PettyCashService.OverShortName]
                </p>
                <PostForm Action="@($"/banking/petty-cash/{Id}/count")" data-enhance="false">
                    <AntiforgeryToken />
                    <div class="row">
                        <div class="field">
                            <label for="count-date">Date</label>
                            <input id="count-date" type="date" name="date" value="@CompanyTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="field">
                            <label for="counted">Cash counted</label>
                            <input id="counted" name="counted" class="amount" inputmode="decimal" required />
                        </div>
                    </div>
                    <div class="field">
                        <label for="breakdown">Notes and coins <span class="muted">(optional, value x count, e.g. 20x5; 1x3; 0.25x8)</span></label>
                        <input id="breakdown" name="breakdown" maxlength="1000" autocomplete="off" />
                    </div>
                    <div class="field">
                        <label for="note">Note <span class="muted">(optional)</span></label>
                        <input id="note" name="note" maxlength="500" />
                    </div>
                    <ClosedPeriodPassword Visible="Password" Interactive="false" />
                    <div class="actions"><button type="submit" data-confirm="@(_counts.Count == 0 && _summary.Balance == 0m ? "The books show nothing in this box, so the whole count would be booked as cash over, which lowers your expenses. If the money came from a bank account, record that first. Record the count anyway?" : null)" class="@(replenishNext ? "secondary" : null)">Record count</button></div>
                </PostForm>
            </div>

            <div class="card" id="replenish">
                <div class="muted">@L["Step {0} of 3", 3]</div>
                <h2>Replenish</h2>
                @if (_summary.ToReplenish <= 0m)
                {
                    <p>@L["Nothing to replenish: the books say the box holds its float."]</p>
                }
                else if (_banks.Count == 0)
                {
                    <p>@L["The box is {0} under its float today, but there's no other bank account to replenish it from.", Labels.Amount(_summary.ToReplenish)] <ActionLink Href="/accounts/new">@L["Add a bank account"]</ActionLink></p>
                }
                else
                {
                    <p class="muted">@L["The box is {0} under its float today. Replenish records a transfer of the float less the balance on the date from the bank account you choose into the box. Take the same amount of cash from the bank and put it in the box.", Labels.Amount(_summary.ToReplenish)]</p>
                    <PostForm Action="@($"/banking/petty-cash/{Id}/replenish")" data-enhance="false" class="row">
                        <AntiforgeryToken />
                        <div class="field">
                            <label for="from">From</label>
                            <select id="from" name="fromAccountId" required>
                                @foreach (var a in _banks)
                                {
                                    <option value="@a.Id">@_chart.FullName(a.Id)</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label for="replenish-date">Date</label>
                            <input id="replenish-date" type="date" name="date" value="@CompanyTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <ClosedPeriodPassword Visible="Password" Interactive="false" />
                        <div class="actions"><button type="submit" class="@(replenishNext ? null : "secondary")">Replenish</button></div>
                    </PostForm>
                }
            </div>
        }

        <h2>Counts</h2>
        @if (_counts.Count == 0)
        {
            <div class="card"><p>No counts yet.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Date</th><th class="num">Counted</th><th class="num">In books</th><th class="num">Over (short)</th><th>Notes and coins</th><th>By</th></tr></thead>
                    <tbody>
                        @foreach (var c in _counts)
                        {
                            <tr>
                                <td>@Labels.Date(c.Date)</td>
                                <td class="num">@Labels.Amount(c.Counted)</td>
                                <td class="num">@Labels.Amount(c.BookBalance)</td>
                                <td class="num">
                                    @if (c.AdjustmentTransactionId is { } adjustment)
                                    {
                                        <a href="/banking/transactions/@adjustment">@Labels.Amount(c.Difference)</a>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td>@c.Breakdown @(c.Note is { } n ? $" · {n}" : "")</td>
                                <td>@c.CountedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="card">
            <h2>Settings</h2>
            <PostForm Action="@($"/banking/petty-cash/{Id}/edit")" data-enhance="false">
                <AntiforgeryToken />
                <div class="row">
                    <div class="field">
                        <label for="float">Float</label>
                        <input id="float" name="float" class="amount" inputmode="decimal" value="@fund.FloatAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required />
                        <span class="hint">@L["What the box should hold once it's replenished."]</span>
                    </div>
                    <div class="field">
                        <label for="custodian">Custodian</label>
                        <input id="custodian" name="custodian" value="@fund.Custodian" maxlength="100" />
                    </div>
                </div>
                <label class="check"><input type="checkbox" name="active" value="true" checked="@fund.IsActive" /> <span>Box in use</span></label>
                <div class="actions"><button type="submit" class="secondary">Save</button></div>
            </PostForm>
        </div>
    }
</div>

@code {
    private PettyCashSummary? _summary;
    private IReadOnlyList<CashCount> _counts = [];
    private ChartOfAccounts _chart = new([]);
    private List<Account> _banks = [];

    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? Done { get; set; }
    [SupplyParameterFromQuery] private bool Password { get; set; }
    [SupplyParameterFromQuery] private decimal? Difference { get; set; }
    [SupplyParameterFromQuery] private decimal? Amount { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _summary = await PettyCashService.GetAsync(Id);
        if (_summary is null)
            return;
        _counts = await PettyCashService.CountsAsync(Id);
        _chart = await AccountService.GetChartAsync();
        _banks = _chart.Ordered(includeInactive: false).Select(x => x.Account)
            .Where(a => a.Type == AccountType.Bank && a.Id != _summary.Fund.AccountId).ToList();
    }
}
