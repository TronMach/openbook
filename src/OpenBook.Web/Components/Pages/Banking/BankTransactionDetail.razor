@page "/banking/transactions/{Id:guid}"
@using System.ComponentModel.DataAnnotations
@inject BankingService BankingService
@inject PostingEngine Engine
@inject AccountService AccountService
@inject CompanySettingsService Settings
@inject NavigationManager Navigation
@inject ClosedPeriodOverride ClosingOverride

<PageTitle>@(_title ?? "Bank transaction") · OpenBook</PageTitle>

@if (_transaction is null || _entry is null)
{
    <div class="card"><p>That transaction doesn't exist. <a href="/banking">Back to banking</a>.</p></div>
    return;
}

<div class="wide">
    <div class="toolbar">
        <h1>@_title</h1>
        <ActionLink Class="button secondary" Href="@($"/banking/{_transaction.AccountId}")">Back to register</ActionLink>
        <ActionLink Class="button secondary" Href="@($"/audit?entityId={_transaction.Id}")">History</ActionLink>
        @if (_transaction.Status == BankTransactionStatus.Posted)
        {
            <a class="button secondary" href="@(_transaction.Kind == BankTransactionKind.Transfer ? $"/banking/transfers/{_transaction.Id}/edit" : $"/banking/transactions/{_transaction.Id}/edit")">Change</a>
        }
        @if (_transaction is { Kind: BankTransactionKind.Spend, Status: BankTransactionStatus.Posted } && _chart.Find(_transaction.AccountId)?.Type == AccountType.Bank)
        {
            <PrintCheckButton Kind="CheckKind.Expense" Id="_transaction.Id" PrintedAt="_transaction.PrintedAt" />
        }
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (_transaction.Status == BankTransactionStatus.Voided)
    {
        <div class="alert notice" role="status">This transaction is voided. Its journal entry was reversed on the same date.</div>
    }
    @if (_changes.Count > 0)
    {
        var last = _changes[^1];
        <p class="muted no-print">Changed @last.At.InCompanyTime().ToString("g") by @last.By: @last.Reason</p>
    }

    <div class="card">
        <dl class="facts">
            <dt>@(_transaction.Kind == BankTransactionKind.Transfer ? "From" : "Account")</dt>
            <dd><a href="/banking/@_transaction.AccountId">@_chart.FullName(_transaction.AccountId)</a></dd>
            @if (_transaction.TransferAccountId is { } to)
            {
                <dt>To</dt>
                <dd><a href="/banking/@to">@_chart.FullName(to)</a></dd>
            }
            <dt>Date</dt>
            <dd>@Labels.Date(_transaction.Date)</dd>
            <dt>Amount</dt>
            <dd>@Labels.Amount(_transaction.Amount) @_entry.Currency</dd>
            @if (_transaction.Payee is not null)
            {
                <dt>@(_transaction.Kind == BankTransactionKind.Spend ? "Payee" : "Received from")</dt>
                <dd>@_transaction.Payee</dd>
            }
            @if (_transaction.Reference is not null)
            {
                <dt>Reference</dt>
                <dd>@_transaction.Reference</dd>
            }
            @if (_transaction.Memo is not null)
            {
                <dt>Memo</dt>
                <dd>@_transaction.Memo</dd>
            }
            <dt>Journal entry</dt>
            <dd><a href="/journal/@_entry.Id">@_entry.Number</a></dd>
        </dl>
    </div>

    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th>Account</th>
                    <th class="num">Debit</th>
                    <th class="num">Credit</th>
                    <th>Memo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in _entry.Lines.OrderBy(l => l.LineNumber))
                {
                    <tr>
                        <td>@Labels.AccountName(_chart, line.AccountId, _useNumbers)</td>
                        <td class="num">@Labels.AmountOrBlank(line.Debit)</td>
                        <td class="num">@Labels.AmountOrBlank(line.Credit)</td>
                        <td>@line.Memo</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_transaction.Status == BankTransactionStatus.Posted)
    {
        <div class="card" style="margin-top: 1.5rem">
            <h2>Void this transaction</h2>
            <p class="muted">Voiding reverses its journal entry on the same date. Reconciled transactions can't be voided.</p>
            <EditForm Model="VoidInput" FormName="void" OnValidSubmit="VoidAsync" method="post">
                <DataAnnotationsValidator />
                <div class="field">
                    <label for="reason">Reason</label>
                    <InputText id="reason" @bind-Value="VoidInput.Reason" />
                    <ValidationMessage For="() => VoidInput.Reason" />
                </div>
                <ClosedPeriodPassword Visible="_needsClosingPassword" Interactive="false" Name="VoidInput.ClosingPassword" />
                <button type="submit" class="danger">Void</button>
            </EditForm>
        </div>
    }

    <DocumentChangeList Changes="_changes" />

    <EntryTags EntryId="_transaction.JournalEntryId" />

    @if (_transaction.Kind == BankTransactionKind.Spend && _transaction.Status == BankTransactionStatus.Posted)
    {
        <BillableLinesPanel Kind="BillableSource.Expense" DocumentId="_transaction.Id" Back="@($"/banking/transactions/{_transaction.Id}")" Error="@BillableError" />
    }

    <Attachments EntityType="bank_transaction" EntityId="_transaction.Id" />

    <Notes EntityType="bank_transaction" EntityId="_transaction.Id" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "billableError")] private string? BillableError { get; set; }

    private BankTransaction? _transaction;
    private JournalEntry? _entry;
    private ChartOfAccounts _chart = new([]);
    private bool _useNumbers;
    private string? _title;
    private IReadOnlyList<DocumentChange> _changes = [];
    private string? _error;
    private bool _needsClosingPassword;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "void")]
    private VoidModel VoidInput { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        VoidInput ??= new();
        _transaction = await BankingService.GetAsync(Id);
        if (_transaction is null)
            return;
        _chart = await AccountService.GetChartAsync();
        _useNumbers = (await Settings.GetAsync()).UseAccountNumbers;
        _entry = await Engine.GetAsync(_transaction.JournalEntryId);
        _title = Labels.For(_transaction.Kind, _chart.Get(_transaction.AccountId).Type);
        _changes = await BankingService.ChangesAsync(Id);
    }

    private async Task VoidAsync()
    {
        try
        {
            ClosingOverride.Password = VoidInput.ClosingPassword;
            await BankingService.VoidAsync(Id, VoidInput.Reason);
            Navigation.NavigateTo($"/banking/transactions/{Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword = ClosedPeriod.NeedsPassword(ex);
        }
    }

    private sealed class VoidModel
    {
        [Required(ErrorMessage = "Say why the transaction is being voided.")]
        [StringLength(500)]
        public string Reason { get; set; } = string.Empty;

        public string? ClosingPassword { get; set; }
    }
}
