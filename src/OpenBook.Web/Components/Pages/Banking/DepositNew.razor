@page "/banking/deposits/new"
@rendermode InteractiveServer
@inject Operations Ops
@inject NavigationManager Navigation

<PageTitle>@(Change is null ? "Make deposit" : "Change deposit") · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>@(Change is null ? "Make deposit" : "Change deposit")</h1>
        <ActionLink Class="button secondary" Href="/banking">Back to banking</ActionLink>
    </div>
    <p class="muted">
        Payments and sales receipts recorded to Undeposited Funds wait here. Pick the ones you took to the bank together,
        so the deposit matches the single amount on your bank statement.
    </p>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    @if (_loaded && _items.Count == 0)
    {
        <div class="card"><p>Nothing is waiting to be deposited.</p></div>
    }
    else if (_loaded)
    {
        <div class="card">
            <div class="row">
                <div class="field">
                    <label for="bank">Deposit to</label>
                    <select id="bank" @bind="_bankAccountId">
                        @foreach (var a in _banks)
                        {
                            <option value="@a.Id">@a.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="date">Date</label>
                    <input id="date" type="date" @bind="_date" />
                </div>
                <div class="field">
                    <label for="memo">Memo <span class="muted">(optional)</span></label>
                    <input id="memo" @bind="_memo" maxlength="1000" />
                </div>
            </div>
        </div>

        @if (_items.Select(i => i.Item.Method).Distinct().Count() > 1)
        {
            <div class="toolbar" role="group" aria-label="Tick by payment method">
                <span class="muted">Tick only:</span>
                @foreach (var method in _items.Select(i => i.Item.Method).Distinct().OrderBy(m => m is null ? 99 : (int)m))
                {
                    <button type="button" class="secondary" @onclick="() => TickOnly(method)">@(method is null ? "No method given" : PaymentMethods.Label(method))</button>
                }
            </div>
        }
        <div class="table-wrap">
            <table class="data entry">
                <thead>
                    <tr>
                        <th><input type="checkbox" aria-label="Select all" checked="@(_items.All(i => i.Selected))" @onchange="SelectAll" /></th>
                        <th>Date</th><th>Received from</th><th>Method</th><th>Reference</th><th>Held in</th><th class="num">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _items)
                    {
                        <tr @key="(row.Item.Kind, row.Item.Id)">
                            <td><input type="checkbox" aria-label="Deposit @row.Item.Label" @bind="row.Selected" /></td>
                            <td>@Labels.Date(row.Item.Date)</td>
                            <td>
                                <a href="@Links.ForDeposited(row.Item.Kind, row.Item.Id)" target="_blank">@row.Item.Label</a>
                            </td>
                            <td>@PaymentMethods.Label(row.Item.Method)</td>
                            <td>@row.Item.Reference</td>
                            <td class="muted">@_chart.FullName(row.Item.AccountId)</td>
                            <td class="num">@Labels.Amount(row.Item.Amount)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    @if (_extras.Count > 0)
                    {
                        <tr><td colspan="6">Items (@_items.Count(i => i.Selected) selected)</td><td class="num">@Labels.Amount(ItemsTotal)</td></tr>
                        <tr><td colspan="6">Fees, cash back and other money</td><td class="num">@Labels.Amount(ExtrasTotal)</td></tr>
                    }
                    <tr><td colspan="6">Deposit total@(_extras.Count > 0 ? "" : $" ({_items.Count(i => i.Selected)} selected)")</td><td class="num">@Labels.Amount(Total)</td></tr>
                </tfoot>
            </table>
        </div>

        <h2>Fees, cash back and other money</h2>
        <p class="muted">So the deposit matches what reached the bank: a card processor's fee or cash kept back comes off, money from elsewhere adds on.</p>
        @if (_extras.Count > 0)
        {
            <div class="table-wrap">
                <table class="data entry">
                    <thead><tr><th>What</th><th>Account</th><th>Memo</th><th class="num">Amount</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var extra in _extras)
                        {
                            <tr @key="extra">
                                <td>
                                    <select aria-label="What it is" @bind="extra.TakeOff">
                                        <option value="true">Take off (fee, cash back)</option>
                                        <option value="false">Add (other money)</option>
                                    </select>
                                </td>
                                <td>
                                    <select aria-label="Account" @bind="extra.AccountId">
                                        <option value="@Guid.Empty">Choose an account</option>
                                        @foreach (var a in _extraAccounts)
                                        {
                                            <option value="@a.Id">@_chart.FullName(a.Id)</option>
                                        }
                                    </select>
                                </td>
                                <td><input aria-label="Memo" maxlength="200" @bind="extra.Memo" /></td>
                                <td class="num"><input aria-label="Amount" class="amount" inputmode="decimal" @bind="extra.Amount" @bind:event="oninput" /></td>
                                <td><button type="button" class="secondary" @onclick="() => _extras.Remove(extra)">Remove</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <p><button type="button" class="secondary" disabled="@(_extras.Count >= BankDeposit.MaxExtras)" @onclick="AddExtra">Add a fee or other line</button></p>

        @if (Change is not null)
        {
            <div class="field">
                <label for="reason">Why is it changing?</label>
                <input id="reason" @bind="_reason" @bind:event="oninput" maxlength="500" />
                <span class="hint">The deposit's entry is voided with this reason and a new one posted; anything you untick goes back to waiting.</span>
            </div>
        }

        <ClosedPeriodPassword Visible="_needsClosingPassword" @bind-Value="_closingPassword" />

        <div class="actions">
            <button type="button" @onclick="SaveAsync" disabled="@(Total <= 0m || _bankAccountId == Guid.Empty || _busy || (Change is not null && string.IsNullOrWhiteSpace(_reason)))">@(Change is null ? "Save deposit" : "Save change")</button>
        </div>
    }
</div>

@code {
    // Noted when the form opens, so a save can tell if the record has moved on.
    private int? _version;

    private List<Row> _items = [];
    private List<Account> _banks = [];
    private ChartOfAccounts _chart = new([]);
    private Guid _bankAccountId;
    private DateOnly _date = CompanyTime.Today;
    private string? _memo;
    private bool _loaded;
    private bool _busy;
    private string? _error;
    private bool _needsClosingPassword;
    private string? _closingPassword;

    private List<ExtraRow> _extras = [];
    private List<Account> _extraAccounts = [];

    private decimal ItemsTotal => _items.Where(i => i.Selected).Sum(i => i.Item.Amount);

    private decimal ExtrasTotal => _extras.Sum(e => e.Signed);

    private decimal Total => ItemsTotal + ExtrasTotal;

    /// <summary>A deposit being changed ("Change" on its page): its items come ticked, with what's waiting below.</summary>
    [SupplyParameterFromQuery(Name = "change")]
    private Guid? Change { get; set; }

    private string? _reason;

    protected override async Task OnInitializedAsync()
    {
        if (Change is { } versionOf)
            _version = await Ops.VersionAsync<BankDeposit>(versionOf);
        var (items, chart, deposit, contents) = await Ops.RunAsync(async sp =>
        {
            var deposits = sp.GetRequiredService<DepositService>();
            var deposit = Change is { } id ? await deposits.GetAsync(id) : null;
            return (await deposits.UndepositedAsync(), await sp.GetRequiredService<AccountService>().GetChartAsync(), deposit,
                deposit is { Status: DocumentStatus.Posted } ? await deposits.ContentsAsync(deposit) : []);
        });
        _chart = chart;
        _items = [.. contents.Select(i => new Row(i) { Selected = true }), .. items.Select(i => new Row(i))];
        _banks = chart.Ordered(includeInactive: false).Select(x => x.Account).Where(a => a.Type == AccountType.Bank).ToList();
        _bankAccountId = _banks.FirstOrDefault()?.Id ?? Guid.Empty;
        var kept = deposit?.Extras.Select(e => e.AccountId).ToHashSet() ?? [];
        _extraAccounts = chart.Ordered(includeInactive: true).Select(x => x.Account)
            .Where(a => (a.IsActive || kept.Contains(a.Id)) && a.Type is not (AccountType.AccountsReceivable or AccountType.AccountsPayable)).ToList();
        if (deposit is { Status: DocumentStatus.Posted })
        {
            _bankAccountId = deposit.BankAccountId;
            _date = deposit.Date;
            _memo = deposit.Memo;
            _extras = [.. deposit.Extras.Select(e => new ExtraRow
            {
                TakeOff = e.Amount < 0m,
                AccountId = e.AccountId,
                Memo = e.Memo,
                Amount = Math.Abs(e.Amount).ToString("0.00", System.Globalization.CultureInfo.CurrentCulture),
            })];
        }
        else
        {
            Change = null;
        }

        _loaded = true;
    }

    /// <summary>A fee by default, to "Merchant and Marketplace Fees" or "Bank Service Charges" when the chart has one.</summary>
    private void AddExtra()
    {
        var fee = _extraAccounts.FirstOrDefault(a => a.IsActive && a.Type == AccountType.Expense
            && (a.Name.Contains("fee", StringComparison.OrdinalIgnoreCase) || a.Name.Contains("charge", StringComparison.OrdinalIgnoreCase)));
        _extras.Add(new ExtraRow { TakeOff = true, AccountId = fee?.Id ?? Guid.Empty });
    }

    /// <summary>Cash and checks usually go to the bank together, card payments arrive on their own.</summary>
    private void TickOnly(PaymentMethod? method)
    {
        foreach (var row in _items)
            row.Selected = row.Item.Method == method;
    }

    private void SelectAll(ChangeEventArgs e)
    {
        var selected = e.Value is true;
        foreach (var row in _items)
            row.Selected = selected;
    }

    private async Task SaveAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            if (_extras.Any(e => e.Value is null))
                throw new DomainException("deposit.extra_amount", "Each fee or other line needs an amount above zero, like 12.50.");
            var command = new MakeDepositCommand(_bankAccountId, _date, _items.Where(i => i.Selected).Select(i => (i.Item.Kind, i.Item.Id)).ToList(), _memo,
                [.. _extras.Select(e => new DepositExtraDraft(e.AccountId, e.Signed, e.Memo))]);
            var deposit = await Ops.ChangeAsync<BankDeposit, DepositService, BankDeposit>(Change ?? Guid.Empty, _version, s => Change is { } id ? s.ChangeAsync(id, command, _reason ?? "") : s.DepositAsync(command), _closingPassword);
            Navigation.NavigateTo($"/banking/deposits/{deposit.Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword |= ClosedPeriod.NeedsPassword(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ExtraRow
    {
        public bool TakeOff { get; set; } = true;

        public Guid AccountId { get; set; }

        public string? Memo { get; set; }

        public string? Amount { get; set; }

        /// <summary>The typed amount, above zero, or null when it can't be read ("." is the decimal point).</summary>
        public decimal? Value => decimal.TryParse(Amount, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.CurrentCulture, out var v) && v > 0m ? v : null;

        public decimal Signed => Value is { } v ? (TakeOff ? -v : v) : 0m;
    }

    private sealed class Row(UndepositedItem item)
    {
        public UndepositedItem Item { get; } = item;
        public bool Selected { get; set; }
    }
}
