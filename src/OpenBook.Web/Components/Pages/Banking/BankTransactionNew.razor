@page "/banking/{AccountId:guid}/record/{KindName}"
@rendermode InteractiveServer
@inject Operations Ops
@inject NavigationManager Navigation

<PageTitle>@_title · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>@_title</h1>
        <ActionLink Class="button secondary" Href="@RegisterUrl">Back to register</ActionLink>
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    @if (_account is not null)
    {
        <div class="card">
            @if (_ownMoney)
            {
                <p class="muted">Paid with your own money: it's recorded as money you put into the business, in <strong>@_accountName</strong>.</p>
            }
            else
            {
                <p class="muted">@(_kind == BankTransactionKind.Spend ? "From" : "Into") <strong>@_accountName</strong></p>
            }
            @if (_kind == BankTransactionKind.Spend)
            {
                <div class="field">
                    <label for="vendor">Vendor <span class="muted">(optional)</span></label>
                    <SearchSelect Id="vendor" Options="PickerOptions.Vendors(_vendors)" VendorAdded="v => _vendors = [.. _vendors, v]" Value="_vendorId" OnChange="PickVendor" EmptyText="None" Placeholder="Type a name or leave blank" />
                    <span class="hint">Shows the expense on the vendor's page and fills in their default category.</span>
                </div>
            }
            <div class="row">
                <div class="field">
                    <label for="payee">@(_kind == BankTransactionKind.Spend ? "Payee" : "Received from") <span class="muted">(optional)</span></label>
                    <input id="payee" @bind="_payee" maxlength="200" />
                </div>
                <div class="field">
                    <label for="date">Date</label>
                    <input id="date" type="date" @bind="_date" />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="reference">@(IsCheck ? "Check number" : "Reference") <span class="muted">(optional)</span></label>
                    <input id="reference" @bind="_reference" maxlength="30" />
                </div>
                <div class="field">
                    <label for="memo">Memo <span class="muted">(optional)</span></label>
                    <input id="memo" @bind="_memo" maxlength="1000" />
                </div>
            </div>
            <MoreOptions HasContent="@(_segments.Locations.Count > 0)" Open="@(_locationId is not null)">
                <LocationField Options="_segments" @bind-Value="_locationId" />
            </MoreOptions>
            @if (_kind == BankTransactionKind.Spend)
            {
                <MoreOptions HasContent="@(_customers.Count > 0)" Open="@(_billTo is not null)" Title="Billing a customer">
                    <BillableToField Customers="_customers" @bind-Value="_billTo" @bind-Markup="_billMarkup" />
                </MoreOptions>
            }

            <div class="table-wrap">
                <table class="data entry">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th class="num">Amount</th>
                            <th>Line memo</th>
                            @if (_segments.ClassColumn is not null)
                            {
                                <th>Class</th>
                            }
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _lines)
                        {
                            <tr @key="line">
                                <td>
                                    <SearchSelect Options="CategoryOptions" @bind-Value="line.AccountId" Placeholder="Find a category…" AriaLabel="Category" />
                                </td>
                                <td><input class="amount" type="number" step="0.01" aria-label="Amount" @bind="line.Amount" /></td>
                                <td><input @bind="line.Memo" aria-label="Line memo" /></td>
                                @if (_segments.ClassColumn is { } lineClasses)
                                {
                                    <td><ClassSelect Classes="lineClasses" Value="line.ClassId" ValueChanged="v => line.ClassId = v" /></td>
                                }
                                <td>
                                    @if (_lines.Count > 1)
                                    {
                                        <button type="button" class="remove" title="Remove line" aria-label="Remove line" @onclick="() => _lines.Remove(line)">×</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td><button type="button" class="secondary" @onclick="() => _lines.Add(new LineModel())">Add line</button></td>
                            <td class="num">@Labels.Amount(Total)</td>
                            <td colspan="@(_segments.ClassColumn is null ? 2 : 3)" class="muted">A negative line reduces the total, e.g. a discount.</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <ClosedPeriodPassword Visible="_needsClosingPassword" @bind-Value="_closingPassword" />


            <div class="actions">
                @if (_duplicateOf is { } taken && taken == _reference?.Trim())
                {
                    <div class="alert notice" role="status">Check number @taken is already used on this account. Check the number, or save anyway if it's right.</div>
                }
                <button type="button" @onclick="SaveAsync" disabled="@(!CanSave || _busy)">@(_duplicateOf is { } t && t == _reference?.Trim() ? "Save anyway" : "Save")</button>
                <a href="@RegisterUrl">Cancel</a>
            </div>
        </div>
    }
</div>

@code {
    private List<Account>? _categoriesFor;
    private IReadOnlyList<PickerOption> _categoryOptions = [];

    private IReadOnlyList<PickerOption> CategoryOptions
    {
        get
        {
            if (!ReferenceEquals(_categoriesFor, _categories))
                (_categoriesFor, _categoryOptions) = (_categories, PickerOptions.Accounts(_categories, _chart, _useNumbers));
            return _categoryOptions;
        }
    }

    private Account? _account;
    private string? _accountName;
    private ChartOfAccounts _chart = new([]);
    private List<Account> _categories = [];
    private bool _useNumbers;
    private BankTransactionKind _kind;
    private string _title = "Bank transaction";
    private string? _error;
    private bool _needsClosingPassword;
    private string? _closingPassword;
    private bool _busy;

    private DateOnly _date = CompanyTime.Today;
    private string? _payee;
    private Guid? _vendorId;
    private IReadOnlyList<Vendor> _vendors = [];
    private string? _reference;
    private string? _memo;
    private List<LineModel> _lines = [new()];

    [Parameter]
    public Guid AccountId { get; set; }

    [Parameter]
    public string KindName { get; set; } = string.Empty;

    /// <summary>A spend or receive to start from ("Copy" on its page).</summary>
    [SupplyParameterFromQuery(Name = "copy")]
    private Guid? Copy { get; set; }

    private bool _ownMoney;
    private string RegisterUrl => _ownMoney ? $"/accounts/{AccountId}/register" : $"/banking/{AccountId}";
    private bool IsCheck => _kind == BankTransactionKind.Spend && _account?.Type == AccountType.Bank;
    private IEnumerable<LineModel> Filled => _lines.Where(l => l.AccountId is not null || (l.Amount ?? 0m) != 0m);
    private decimal Total => _lines.Sum(l => l.Amount ?? 0m);
    private bool CanSave => Total > 0m && Filled.Any() && Filled.All(l => l.AccountId is not null && (l.Amount ?? 0m) != 0m);

    private SegmentOptions _segments = SegmentOptions.None;

    private Guid? _locationId;
    private IReadOnlyList<OpenBook.Domain.Sales.Customer> _customers = [];
    private Guid? _billTo;
    private decimal? _billMarkup;


    protected override async Task OnParametersSetAsync()
    {

        _segments = await Ops.RunAsync(SegmentOptions.LoadAsync);
        _kind = KindName.Equals("receive", StringComparison.OrdinalIgnoreCase) ? BankTransactionKind.Receive : BankTransactionKind.Spend;
        try
        {
            (_chart, _useNumbers, var suggestion, _vendors) = await Ops.RunAsync(async sp => (
                await sp.GetRequiredService<AccountService>().GetChartAsync(),
                (await sp.GetRequiredService<CompanySettingsService>().GetAsync()).UseAccountNumbers,
                await sp.GetRequiredService<BankingService>().SuggestCheckNumberAsync(AccountId),
                (IReadOnlyList<Vendor>)(await sp.GetRequiredService<VendorService>().ListAsync(_date)).Select(v => v.Vendor).ToList()));
            _account = _chart.Get(AccountId);
            BankingRules.EnsurePayFrom(_account, _kind);
            if (_kind == BankTransactionKind.Spend)
                _customers = await Ops.RunAsync(async sp => (IReadOnlyList<OpenBook.Domain.Sales.Customer>)(await sp.GetRequiredService<OpenBook.Application.Sales.CustomerService>().ListAsync(_date)).Select(s => s.Customer).ToList());
            _ownMoney = !BankTransaction.IsBankingAccount(_account.Type);
            _accountName = _chart.FullName(AccountId);
            _title = _ownMoney ? "Paid with your own money" : Labels.For(_kind, _account.Type);
            _categories = _chart.Ordered(includeInactive: false).Select(x => x.Account).Where(a => a.Id != AccountId && a.Type is not (AccountType.AccountsReceivable or AccountType.AccountsPayable)).ToList();
            if (IsCheck)
                _reference ??= suggestion;

            // "Copy": the same payee, splits and memo, dated today (with the next check number, not the old one).
            if (Copy is { } copyId)
            {
                var copied = await Ops.RunAsync(async sp =>
                {
                    var banking = sp.GetRequiredService<BankingService>();
                    return await banking.GetAsync(copyId) is { } t && t.Kind == _kind
                        ? (t, await banking.SplitsAsync(t))
                        : ((BankTransaction, IReadOnlyList<BankSplit>)?)null;
                });
                if (copied is var (source, splits))
                {
                    _vendorId = source.VendorId;
                    _payee = source.Payee;
                    _memo = source.Memo;
                    _locationId = source.LocationId;
                    _lines = splits.Select(s => new LineModel { AccountId = s.AccountId, Amount = s.Amount, Memo = s.Memo, ClassId = s.ClassId }).ToList();
                    if (_lines.Count == 0)
                        _lines.Add(new());
                }
            }
        }
        catch (DomainException ex)
        {
            _account = null;
            _error = ex.Message;
        }
    }

    /// <summary>A check number found in use, once warned about: saving with it again goes ahead.</summary>
    private string? _duplicateOf;

    private async Task SaveAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            if (_kind == BankTransactionKind.Spend && _reference?.Trim() is { Length: > 0 } number && number != _duplicateOf
                && await Ops.RunAsync<BankingService, bool>(s => s.CheckNumberUsedAsync(AccountId, number)))
            {
                _duplicateOf = number;
                return;
            }

            var splits = Filled.Select(l => new BankSplit(l.AccountId!.Value, l.Amount!.Value, l.Memo, l.ClassId)).ToList();
            var command = new RecordBankTransactionCommand(_kind, AccountId, _date, splits, _payee, _reference, _memo, _kind == BankTransactionKind.Spend ? _vendorId : null, LocationId: _locationId);
            var (billTo, markup) = (_kind == BankTransactionKind.Spend ? _billTo : null, _billMarkup);
            var saved = await Ops.RunAsync(async sp =>
            {
                // The marks go in with the expense, or neither does.
                await using var tx = await sp.GetRequiredService<OpenBook.Application.IUnitOfWork>().BeginAsync(default);
                var recorded = await sp.GetRequiredService<BankingService>().RecordAsync(command);
                if (billTo is { } customer)
                    await sp.GetRequiredService<OpenBook.Application.Sales.BillableExpenseService>().MarkAllAsync(OpenBook.Domain.Sales.BillableSource.Expense, recorded.Id, customer, markup);
                await tx.CommitAsync(default);
                return recorded;
            }, _closingPassword);
            Navigation.NavigateTo($"/banking/transactions/{saved.Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword |= ClosedPeriod.NeedsPassword(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private void PickVendor(ChangeEventArgs e)
    {
        var previous = _vendors.FirstOrDefault(v => v.Id == _vendorId);
        _vendorId = Guid.TryParse(e.Value as string, out var id) ? id : null;
        var vendor = _vendors.FirstOrDefault(v => v.Id == _vendorId);
        if (string.IsNullOrWhiteSpace(_payee) || _payee == previous?.DisplayName)
            _payee = vendor?.DisplayName;
        if (vendor?.DefaultExpenseAccountId is { } category && _lines[0].AccountId is null)
            _lines[0].AccountId = category;
    }

    private sealed class LineModel
    {
        public Guid? AccountId { get; set; }
        public decimal? Amount { get; set; }
        public string? Memo { get; set; }
        public Guid? ClassId { get; set; }
    }
}
