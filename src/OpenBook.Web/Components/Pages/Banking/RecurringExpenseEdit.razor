@page "/banking/recurring/new"
@page "/banking/recurring/{Id:guid}"
@rendermode InteractiveServer
@using OpenBook.Domain.Banking
@inject Operations Ops
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "New recurring expense" : _name) · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>@(Id is null ? "New recurring expense" : _name)</h1>
        <ActionLink Class="button secondary" Href="/banking/recurring">Back to recurring expenses</ActionLink>
        @if (Id is { } id)
        {
            <ActionLink Class="button secondary" Href="@($"/audit?entityId={id}")">History</ActionLink>
        }
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (_saved)
    {
        <div class="alert notice" role="status">Saved.</div>
    }

    @if (_notFound)
    {
        <div class="card"><p>That recurring expense doesn't exist. <a href="/banking/recurring">Back to recurring expenses</a>.</p></div>
    }
    else if (_loaded && _payFrom.Count == 0)
    {
        <div class="card"><p>Recurring expenses are paid from a bank or credit card account. <ActionLink Href="/accounts/new">Add one</ActionLink> first.</p></div>
    }
    else if (_loaded)
    {
        @if (!_active)
        {
            <div class="alert notice" role="status">This recurring expense is inactive, so nothing is recorded from it.</div>
        }

        <div class="card">
            <div class="row">
                <div class="field">
                    <label for="name">Name</label>
                    <input id="name" @bind="_name" maxlength="100" placeholder="Software subscription" />
                </div>
                <div class="field">
                    <label for="account">Paid from</label>
                    <select id="account" @bind="_accountId">
                        @foreach (var a in _payFrom)
                        {
                            <option value="@a.Id">@_chart.FullName(a.Id)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="vendor">Vendor <span class="muted">(optional)</span></label>
                    <SearchSelect Id="vendor" Options="PickerOptions.Vendors(_vendors)" @bind-Value="_vendorId" EmptyText="No vendor" Placeholder="Choose a vendor…" />
                </div>
                <div class="field">
                    <label for="payee">Payee <span class="muted">(optional; defaults to the vendor's name)</span></label>
                    <input id="payee" @bind="_payee" maxlength="100" />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="interval">Repeat every</label>
                    <div class="inline">
                        <input id="interval" class="short" type="number" min="1" max="99" @bind="_interval" />
                        <select aria-label="Frequency" @bind="_frequency">
                            @foreach (var frequency in Enum.GetValues<RecurrenceFrequency>())
                            {
                                <option value="@frequency">@RecurrenceLabels.Unit(frequency, _interval)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="field">
                    <label for="start">First payment date</label>
                    <input id="start" type="date" @bind="_startDate" />
                </div>
                <div class="field">
                    <label for="end">End date <span class="muted">(optional)</span></label>
                    <input id="end" type="date" @bind="_endDate" />
                </div>
                <div class="field">
                    <label for="max">Times <span class="muted">(optional)</span></label>
                    <input id="max" class="short" type="number" min="1" @bind="_maxOccurrences" />
                </div>
            </div>
            <label class="check">
                <input type="checkbox" @bind="_autoCreate" />
                <span>Record expenses automatically when due</span>
            </label>

            <div class="row">
                <LocationField Options="_segments" @bind-Value="_locationId" />
            </div>
            <TagChecks Options="_segments" Value="_tags" />

            <BillLinesEditor Classes="_segments.ClassColumn" Lines="_lines" Categories="_categories" Chart="_chart" UseNumbers="_useNumbers" Changed="StateHasChanged" />

            <div class="field" style="margin-top: 1rem">
                <label for="memo">Memo <span class="muted">(optional; defaults to the name)</span></label>
                <input id="memo" @bind="_memo" maxlength="1000" />
            </div>

            <div class="actions">
                <button type="button" @onclick="SaveAsync" disabled="@(_accountId == Guid.Empty || string.IsNullOrWhiteSpace(_name) || !BillLineModel.IsComplete(_lines) || _busy)">Save</button>
                @if (Id is not null)
                {
                    <button type="button" class="secondary" @onclick="ToggleActiveAsync" disabled="@_busy">@(_active ? "Make inactive" : "Make active")</button>
                }
                @if (_created > 0)
                {
                    <span class="muted">@_created recorded so far. Changes apply to future expenses only.</span>
                }
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<Vendor> _vendors = [];
    private ChartOfAccounts _chart = new([]);
    private List<Account> _categories = [];
    private List<Account> _payFrom = [];
    private bool _useNumbers;
    private bool _loaded;
    private bool _notFound;
    private bool _busy;
    private bool _saved;
    private string? _error;

    private string _name = string.Empty;
    private Guid _accountId;
    private Guid? _vendorId;
    private string? _payee;
    private string? _memo;
    private int _interval = 1;
    private RecurrenceFrequency _frequency = RecurrenceFrequency.Monthly;
    private DateOnly _startDate = CompanyTime.Today;
    private DateOnly? _endDate;
    private int? _maxOccurrences;
    private bool _autoCreate;
    private bool _active = true;
    private int _created;
    private List<BillLineModel> _lines = [new()];
    private SegmentOptions _segments = SegmentOptions.None;
    private Guid? _locationId;
    private HashSet<Guid> _tags = [];

    [Parameter]
    public Guid? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        RecurringExpense? template;
        (_vendors, _chart, _useNumbers, template) = await Ops.RunAsync(async sp => (
            (IReadOnlyList<Vendor>)(await sp.GetRequiredService<VendorService>().ListAsync(CompanyTime.Today)).Select(s => s.Vendor).ToList(),
            await sp.GetRequiredService<AccountService>().GetChartAsync(),
            (await sp.GetRequiredService<CompanySettingsService>().GetAsync()).UseAccountNumbers,
            Id is { } id ? await sp.GetRequiredService<RecurringExpenseService>().GetAsync(id) : null));
        _categories = BillLineModel.Categories(_chart);
        _payFrom = _chart.Ordered(includeInactive: false).Select(x => x.Account).Where(a => a.Type is AccountType.Bank or AccountType.CreditCard).ToList();
        _accountId = _payFrom.FirstOrDefault()?.Id ?? Guid.Empty;
        _segments = await Ops.RunAsync(SegmentOptions.LoadAsync);

        if (Id is not null)
        {
            if (template is null)
            {
                _notFound = true;
                return;
            }

            Show(template);
        }

        _loaded = true;
    }

    private void Show(RecurringExpense t)
    {
        _name = t.Name;
        _accountId = t.AccountId;
        _vendorId = t.VendorId;
        _payee = t.Payee;
        _memo = t.Memo;
        _interval = t.Interval;
        _frequency = t.Frequency;
        _startDate = t.StartDate;
        _endDate = t.EndDate;
        _maxOccurrences = t.MaxOccurrences;
        _autoCreate = t.AutoCreate;
        _active = t.IsActive;
        _created = t.OccurrencesPosted;
        _lines = t.Lines.OrderBy(l => l.LineNumber).Select(l => BillLineModel.From(new BillLineDraft(l.AccountId, l.Amount, l.Description, ClassId: l.ClassId))).ToList();
        _locationId = t.LocationId;
        _tags = t.TagIds.ToHashSet();
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        _saved = false;
        try
        {
            var splits = BillLineModel.Drafts(_lines).Select(l => new BankSplit(l.AccountId, l.Amount, l.Description, l.ClassId)).ToList();
            var details = new RecurringExpenseDetails(_name, _accountId, splits, _frequency, _startDate, _interval, _endDate, _maxOccurrences, _autoCreate,
                _vendorId, _payee, _memo, _locationId, _tags.ToList());
            if (Id is { } id)
            {
                Show(await Ops.RunAsync<RecurringExpenseService, RecurringExpense>(s => s.UpdateAsync(id, details)));
                _saved = true;
            }
            else
            {
                var created = await Ops.RunAsync<RecurringExpenseService, RecurringExpense>(s => s.CreateAsync(details));
                Navigation.NavigateTo($"/banking/recurring/{created.Id}");
            }
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleActiveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _active = (await Ops.RunAsync<RecurringExpenseService, RecurringExpense>(s => s.SetActiveAsync(Id!.Value, !_active))).IsActive;
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
