@page "/banking/{AccountId:guid}/feed"
@rendermode InteractiveServer
@inject Operations Ops

<PageTitle>Bank feed · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Review @_accountName</h1>
        <ActionLink Class="button secondary" Href="@($"/banking/{AccountId}")">Register</ActionLink>
        <ActionLink Class="button secondary" Href="/banking/rules">Bank rules</ActionLink>
        <ActionLink Class="button" Href="@($"/banking/{AccountId}/import")">Import a statement</ActionLink>
    </div>
    <p class="muted">
        Each imported line waits here until you <strong>add</strong> it as a new transaction, <strong>match</strong> it to one already
        recorded (a deposit, a check, a bill payment), or <strong>exclude</strong> it. Bank rules fill in categories for lines that look alike.
    </p>

    <nav class="toolbar" aria-label="Show">
        @foreach (var status in Enum.GetValues<BankFeedStatus>())
        {
            <button type="button" class="@(status == _status ? null : "secondary")" @onclick="() => ShowAsync(status)">@Labels.For(status)</button>
        }
    </nav>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
        <ClosedPeriodPassword Visible="_needsClosingPassword" @bind-Value="_closingPassword" />
    }
    @if (_message is not null)
    {
        <div class="alert notice" role="status">@_message</div>
    }

    @if (_loaded && _rows.Count == 0)
    {
        <div class="card"><p>@(_status == BankFeedStatus.Pending ? "Nothing to review." : $"Nothing {Labels.For(_status).ToLowerInvariant()}.") <ActionLink Href="@($"/banking/{AccountId}/import")">Import a statement</ActionLink>.</p></div>
    }
    else if (_loaded && _status == BankFeedStatus.Pending)
    {
        @if (_rows.Count(r => r.CategoryId is not null && r.Matches.Count == 0) is var ready and > 0)
        {
            <div class="actions">
                <button type="button" class="secondary" @onclick="AddAllReadyAsync" disabled="@_busy">Add the @ready with a category and no match</button>
            </div>
        }
        <div class="table-wrap">
            <table class="data entry feed">
                <thead>
                    <tr><th>Date</th><th>Description</th><th class="num">Money out</th><th class="num">Money in</th><th>Action</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        var item = row.Item;
                        <tr @key="item.Id">
                            <td class="nowrap">@Labels.Date(item.Date)</td>
                            <td>
                                <div>@(item.Payee ?? item.Memo ?? "(no description)")</div>
                                @if (item.Payee is not null && item.Memo is not null)
                                {
                                    <div class="muted">@item.Memo</div>
                                }
                                @if (item.Reference is not null)
                                {
                                    <div class="muted">Ref @item.Reference</div>
                                }
                                @if (row.RuleName is not null)
                                {
                                    <span class="badge ok" title="Suggested by a bank rule">Rule: @row.RuleName</span>
                                }
                            </td>
                            <td class="num">@(item.Amount < 0m ? Labels.Amount(-item.Amount) : "")</td>
                            <td class="num">@(item.Amount > 0m ? Labels.Amount(item.Amount) : "")</td>
                            <td class="feed-actions">
                                @if (row.Matches.Count > 0)
                                {
                                    <div class="inline">
                                        <select aria-label="Match to" @bind="row.MatchEntryId">
                                            @foreach (var m in row.Matches)
                                            {
                                                <option value="@m.JournalEntryId">@Labels.Date(m.Date) · @m.Description · #@m.EntryNumber</option>
                                            }
                                        </select>
                                        <button type="button" @onclick="() => MatchAsync(row)" disabled="@_busy">Match</button>
                                    </div>
                                    <div class="muted">or add it as a new transaction:</div>
                                }
                                @if (row.Documents.Count > 0)
                                {
                                    <div class="inline">
                                        <select aria-label="Pays" @bind="row.DocumentKey">
                                            @foreach (var d in row.Documents)
                                            {
                                                <option value="@($"{d.Kind}:{d.Id}")">@d.Label · @d.Party · due @Labels.Date(d.DueDate)</option>
                                            }
                                        </select>
                                        <button type="button" @onclick="() => PayDocumentAsync(row)" disabled="@_busy">@(item.IsMoneyIn ? "Receive payment and match" : "Pay bill and match")</button>
                                    </div>
                                    <div class="muted">or:</div>
                                }
                                @if (row.Choosing)
                                {
                                    <fieldset class="feed-several">
                                        <legend>Tick what this line paid for</legend>
                                        @foreach (var m in row.Matches.Concat(row.PartMatches))
                                        {
                                            <label class="check">
                                                <input type="checkbox" checked="@row.Chosen.Contains(m.JournalEntryId)" @onchange="e => Toggle(row, m.JournalEntryId, e)" />
                                                <span>@Labels.Date(m.Date) · @m.Description · @Labels.Amount(Math.Abs(m.Amount))</span>
                                            </label>
                                        }
                                        <p class="muted">Ticked @Labels.Amount(row.ChosenTotal) of @Labels.Amount(Math.Abs(item.Amount))</p>
                                        <button type="button" @onclick="() => MatchSeveralAsync(row)" disabled="@(row.ChosenTotal != Math.Abs(item.Amount) || _busy)">Match</button>
                                        <button type="button" class="link" @onclick="() => row.Choosing = false">Close</button>
                                    </fieldset>
                                }
                                else if (row.PartMatches.Count > 1)
                                {
                                    <div><button type="button" class="link" @onclick="() => row.Choosing = true">Match several transactions</button></div>
                                }
                                <div class="inline">
                                    @if (row.Splits is null)
                                    {
                                        <SearchSelect AriaLabel="Category" Options="_categoryOptions" @bind-Value="row.CategoryId" Placeholder="Category…" />
                                        @if (_segments.ClassColumn is { } classes)
                                        {
                                            <ClassSelect Classes="classes" Value="row.ClassId" ValueChanged="v => row.ClassId = v" />
                                        }
                                    }
                                    @if (!item.IsMoneyIn)
                                    {
                                        <SearchSelect AriaLabel="Vendor" Options="_vendorOptions" @bind-Value="row.VendorId" EmptyText="No vendor" Placeholder="Vendor…" />
                                    }
                                    @if (_segments.Locations.Count > 0)
                                    {
                                        <select aria-label="@_segments.LocationLabel" value="@row.LocationId" @onchange="e => row.LocationId = Guid.TryParse(e.Value as string, out var l) ? l : null">
                                            <option value="">@_segments.LocationLabel…</option>
                                            @foreach (var l in _segments.Locations)
                                            {
                                                <option value="@l.Segment.Id">@(new string(' ', l.Depth * 3))@l.Segment.Name</option>
                                            }
                                        </select>
                                    }
                                    <input aria-label="Payee" placeholder="Payee" @bind="row.Payee" class="short-text" />
                                    <button type="button" class="secondary" @onclick="() => AddAsync(row)" disabled="@(!row.CanAdd || _busy)">Add</button>
                                    <button type="button" class="link" @onclick="() => ToggleSplit(row)">@(row.Splits is null ? "Split" : "One category")</button>
                                    <button type="button" class="link" @onclick="() => ExcludeAsync(row)" disabled="@_busy" title="For duplicates and lines that never happened in this account. Personal spending did happen: add it to an owner's draw account instead, or the account won't reconcile.">Exclude</button>
                                    <a class="link" href="@RuleLink(row)" target="_blank" title="Make a rule for lines like this">Rule…</a>
                                </div>
                                @if (row.Splits is { } splits)
                                {
                                    <div class="feed-splits">
                                        @foreach (var split in splits)
                                        {
                                            <div class="inline" @key="split">
                                                <SearchSelect AriaLabel="Category" Options="_categoryOptions" @bind-Value="split.AccountId" Placeholder="Category…" />
                                                <input class="amount" type="number" step="0.01" min="0" aria-label="Amount" @bind="split.Amount" @bind:event="oninput" />
                                                @if (_segments.ClassColumn is { } splitClasses)
                                                {
                                                    <ClassSelect Classes="splitClasses" Value="split.ClassId" ValueChanged="v => split.ClassId = v" />
                                                }
                                                @if (splits.Count > 2)
                                                {
                                                    <button type="button" class="remove" title="Remove line" aria-label="Remove line" @onclick="() => splits.Remove(split)">×</button>
                                                }
                                            </div>
                                        }
                                        <button type="button" class="link" @onclick="() => splits.Add(new SplitRow())">Add a line</button>
                                        <span class="muted">Left to assign: @Labels.Amount(Math.Abs(item.Amount) - row.SplitTotal)</span>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_loaded)
    {
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Date</th><th>Description</th><th class="num">Amount</th><th>Result</th><th></th></tr></thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        var item = row.Item;
                        <tr @key="item.Id">
                            <td>@Labels.Date(item.Date)</td>
                            <td>@(item.Payee ?? item.Memo)</td>
                            <td class="num">@Labels.Amount(item.Amount)</td>
                            <td>
                                @if (item.BankTransactionId is { } transactionId)
                                {
                                    <a href="/banking/transactions/@transactionId">Transaction</a>
                                }
                                else if (item.MatchedJournalEntryId is { } entryId)
                                {
                                    <a href="/journal/@entryId">Matched entry</a>
                                }
                                @if (item.ResolvedBy is not null)
                                {
                                    <span class="muted"> · @item.ResolvedBy</span>
                                }
                            </td>
                            <td><button type="button" class="link" @onclick="() => ReopenAsync(row)" disabled="@_busy">@(item.Status == BankFeedStatus.Added ? "Undo (voids the transaction)" : "Undo")</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private string? _accountName;
    private ChartOfAccounts _chart = new([]);
    private bool _useNumbers;
    private IReadOnlyList<PickerOption> _categoryOptions = [];
    private IReadOnlyList<PickerOption> _vendorOptions = [];
    private BankFeedStatus _status = BankFeedStatus.Pending;
    private List<Row> _rows = [];
    private bool _loaded;
    private bool _busy;
    private string? _error;
    private string? _closingPassword;
    private bool _needsClosingPassword;
    private string? _message;
    private SegmentOptions _segments = SegmentOptions.None;

    [Parameter]
    public Guid AccountId { get; set; }

    /// <summary>The tab to open (?show=Added), for links from the audit log. Enums don't bind from the query.</summary>
    [SupplyParameterFromQuery(Name = "show")]
    private string? Show { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _segments = await Ops.RunAsync(SegmentOptions.LoadAsync);
        (_chart, _useNumbers, var vendors) = await Ops.RunAsync(async sp => (
            await sp.GetRequiredService<AccountService>().GetChartAsync(),
            (await sp.GetRequiredService<CompanySettingsService>().GetAsync()).UseAccountNumbers,
            (IReadOnlyList<Vendor>)(await sp.GetRequiredService<VendorService>().ListAsync(CompanyTime.Today)).Select(v => v.Vendor).ToList()));
        if (_chart.Find(AccountId) is null)
        {
            _error = "That account doesn't exist.";
            return;
        }

        _accountName = _chart.FullName(AccountId);
        if (Enum.TryParse<BankFeedStatus>(Show, ignoreCase: true, out var shown) && Enum.IsDefined(shown))
            _status = shown;
        var categories = _chart.Ordered(includeInactive: false).Select(x => x.Account)
            .Where(a => a.Id != AccountId && a.Type is not (AccountType.AccountsReceivable or AccountType.AccountsPayable))
            .OrderBy(a => a.Type.ClassOf() is not (AccountClass.Expense or AccountClass.Income));
        _categoryOptions = PickerOptions.Accounts(categories, _chart, _useNumbers);
        _vendorOptions = PickerOptions.Vendors(vendors);
        await LoadAsync();
    }

    private async Task ShowAsync(BankFeedStatus status)
    {
        _status = status;
        _message = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var review = await Ops.RunAsync<BankFeedService, IReadOnlyList<FeedReviewItem>>(s => s.ReviewAsync(AccountId, _status));
        var documents = await Ops.RunAsync<FeedDocumentService, IReadOnlyDictionary<Guid, IReadOnlyList<FeedDocument>>>(s => s.CandidatesAsync(AccountId, [.. review.Select(r => r.Item)]));
        // What's been chosen on other lines stays: acting on one line mustn't lose the rest.
        var chosen = _rows.ToDictionary(r => r.Item.Id);
        _rows = review.Select(r => new Row(r.Item, r.Matches, r.PartMatches)
        {
            ClassId = chosen.GetValueOrDefault(r.Item.Id)?.ClassId ?? r.Suggestion?.ClassId,
            LocationId = chosen.GetValueOrDefault(r.Item.Id)?.LocationId ?? r.Suggestion?.LocationId,
            Splits = chosen.GetValueOrDefault(r.Item.Id)?.Splits,
            CategoryId = chosen.GetValueOrDefault(r.Item.Id)?.CategoryId ?? r.Suggestion?.CategoryAccountId,
            VendorId = chosen.GetValueOrDefault(r.Item.Id)?.VendorId ?? r.Suggestion?.VendorId,
            Payee = chosen.GetValueOrDefault(r.Item.Id)?.Payee ?? r.Suggestion?.Payee,
            RuleName = r.Suggestion?.Rule.Name,
            MatchEntryId = chosen.GetValueOrDefault(r.Item.Id)?.MatchEntryId ?? r.Matches.FirstOrDefault()?.JournalEntryId,
            Documents = documents.GetValueOrDefault(r.Item.Id) ?? [],
            DocumentKey = documents.GetValueOrDefault(r.Item.Id)?.FirstOrDefault() is { } first ? $"{first.Kind}:{first.Id}" : null,
        }).ToList();
        _loaded = true;
    }

    private static AddFeedItemCommand CommandFor(Row row) => new(
        row.Splits is { } splits ? splits[0].AccountId!.Value : row.CategoryId!.Value, row.Payee, row.VendorId, null, row.ClassId, row.LocationId,
        row.Splits?.Select(s => new BankSplit(s.AccountId!.Value, s.Amount!.Value, null, s.ClassId)).ToList());

    private static void ToggleSplit(Row row)
    {
        if (row.Splits is not null)
        {
            row.Splits = null;
            return;
        }

        var size = Math.Abs(row.Item.Amount);
        row.Splits = [new SplitRow { AccountId = row.CategoryId, Amount = size, ClassId = row.ClassId }, new SplitRow()];
    }

    private static void Toggle(Row row, Guid entryId, ChangeEventArgs e)
    {
        if (e.Value is true)
            row.Chosen.Add(entryId);
        else
            row.Chosen.Remove(entryId);
    }

    private Task MatchSeveralAsync(Row row) => RunAsync(async () =>
    {
        IReadOnlyCollection<Guid> entries = [.. row.Chosen];
        await Ops.RunAsync<BankFeedService, bool>(async s => { await s.MatchAsync(row.Item.Id, entries); return true; }, _closingPassword);
        _message = "Matched.";
    });

    private Task AddAsync(Row row) => RunAsync(async () =>
    {
        var command = CommandFor(row);
        await Ops.RunAsync<BankFeedService, BankTransaction>(s => s.AddAsync(row.Item.Id, command), _closingPassword);
        _message = $"Added {Labels.Amount(Math.Abs(row.Item.Amount))} {(row.Item.IsMoneyIn ? "from" : "to")} {row.Payee ?? row.Item.Payee}.";
    });

    private Task MatchAsync(Row row) => RunAsync(async () =>
    {
        var entryId = row.MatchEntryId!.Value;
        await Ops.RunAsync<BankFeedService, bool>(async s => { await s.MatchAsync(row.Item.Id, entryId); return true; }, _closingPassword);
        _message = "Matched.";
    });

    private Task ExcludeAsync(Row row) => RunAsync(async () =>
    {
        await Ops.RunAsync<BankFeedService, bool>(async s => { await s.ExcludeAsync(row.Item.Id); return true; });
        _message = "Excluded. It's under Excluded if you need it back.";
    });

    private Task ReopenAsync(Row row) => RunAsync(async () =>
    {
        await Ops.RunAsync<BankFeedService, bool>(async s => { await s.ReopenAsync(row.Item.Id); return true; }, _closingPassword);
        _message = "Back in the review queue.";
    });

    private Task AddAllReadyAsync() => RunAsync(async () =>
    {
        var added = 0;
        foreach (var row in _rows.Where(r => r.CanAdd && r.Matches.Count == 0).ToList())
        {
            var command = CommandFor(row);
            await Ops.RunAsync<BankFeedService, BankTransaction>(s => s.AddAsync(row.Item.Id, command), _closingPassword);
            added++;
        }

        _message = $"Added {added} {(added == 1 ? "transaction" : "transactions")}.";
    });

    private Task PayDocumentAsync(Row row) => RunAsync(async () =>
    {
        if (row.DocumentKey?.Split(':') is not [var kindText, var idText] || !Enum.TryParse<FeedDocumentKind>(kindText, out var kind) || !Guid.TryParse(idText, out var id))
            return;
        await Ops.RunAsync<FeedDocumentService, Guid>(s => s.ApplyAsync(row.Item.Id, kind, id), _closingPassword);
        _message = kind == FeedDocumentKind.Invoice ? "Payment received and matched." : "Bill paid and matched.";
    });

    /// <summary>Runs an action, then reloads the queue; a refusal shows as an error and stops there.</summary>
    private async Task RunAsync(Func<Task> action)
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            await action();
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword = ClosedPeriod.NeedsPassword(ex);
        }
        finally
        {
            await LoadAsync();
            _busy = false;
        }
    }

    private string RuleLink(Row row)
    {
        var text = row.Item.Payee ?? row.Item.Memo ?? "";
        var query = $"contains={Uri.EscapeDataString(text)}&account={AccountId}&direction={(row.Item.IsMoneyIn ? RuleDirection.MoneyIn : RuleDirection.MoneyOut)}";
        if (row.CategoryId is { } category)
            query += $"&category={category}";
        return $"/banking/rules/new?{query}";
    }

    private sealed class SplitRow
    {
        public Guid? AccountId { get; set; }
        public decimal? Amount { get; set; }
        public Guid? ClassId { get; set; }
    }

    private sealed class Row(BankFeedItem item, IReadOnlyList<FeedMatch> matches, IReadOnlyList<FeedMatch> partMatches)
    {
        public BankFeedItem Item { get; } = item;
        public IReadOnlyList<FeedMatch> Matches { get; } = matches;
        public IReadOnlyList<FeedMatch> PartMatches { get; } = partMatches;
        public bool Choosing { get; set; }
        public HashSet<Guid> Chosen { get; } = [];
        public decimal ChosenTotal => Math.Abs(Matches.Concat(PartMatches).Where(m => Chosen.Contains(m.JournalEntryId)).Sum(m => m.Amount));
        public Guid? ClassId { get; set; }
        public Guid? LocationId { get; set; }
        public List<SplitRow>? Splits { get; set; }
        public decimal SplitTotal => Splits?.Sum(s => s.Amount ?? 0m) ?? 0m;

        public bool CanAdd => Splits is null
            ? CategoryId is not null
            : Splits.All(s => s.AccountId is not null && s.Amount > 0m) && SplitTotal == Math.Abs(Item.Amount);

        public Guid? CategoryId { get; set; }
        public Guid? VendorId { get; set; }
        public string? Payee { get; set; }
        public string? RuleName { get; set; }
        public Guid? MatchEntryId { get; set; }

        /// <summary>Open invoices or bills owing exactly this line's amount.</summary>
        public IReadOnlyList<FeedDocument> Documents { get; init; } = [];

        /// <summary>The one chosen, as "Kind:id".</summary>
        public string? DocumentKey { get; set; }
    }
}
