@page "/banking/connections"
@inject BankConnectionService ConnectionService
@inject PlaidSettingsService PlaidSettings

<PageTitle>Bank connections · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Bank connections</h1>
        <ActionLink Class="button secondary" Href="/banking">Back to banking</ActionLink>
    </div>
    <p class="muted">
        A connection fetches your bank and card transactions automatically, every @((int)BankConnectionService.SyncEvery.TotalHours) hours,
        into each account's bank feed, where you review them as if you'd imported a statement. Nothing posts until you add it
        (or an auto-add bank rule does).
    </p>

    @if (Error is not null)
    {
        <div class="alert error" role="alert">@Error</div>
    }

    @if (_connections.Count > 0)
    {
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Connection</th><th>Accounts</th><th>Last sync</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var c in _connections)
                    {
                        <tr>
                            <td><ActionLink Href="@($"/banking/connections/{c.Id}")">@c.Name</ActionLink></td>
                            <td>@c.Accounts.Count(a => a.AccountId is not null) of @c.Accounts.Count linked</td>
                            <td>@(c.LastSyncAt is { } at ? at.InCompanyTime().ToString("g") : "Never")</td>
                            <td>
                                @if (!c.IsActive)
                                {
                                    <span class="badge">Disconnected</span>
                                }
                                else if (c.LastSyncFailed)
                                {
                                    <span class="badge warn">Failed</span>
                                }
                                else
                                {
                                    <span class="badge ok">Connected</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="card">
        <h2>Connect with Plaid</h2>
        @if (_plaid.IsReady)
        {
            <p class="muted">
                Choose your bank in Plaid's window and sign in to it there; OpenBook never sees your bank password. Plaid hands back a key
                OpenBook stores encrypted.
                @if (_plaid.Environment == PlaidEnvironment.Sandbox)
                {
                    <span>These are Sandbox keys, so only Plaid's test banks are offered.</span>
                }
            </p>
            <PostForm Action="/banking/connections/plaid" data-enhance="false" data-plaid-link="/banking/connections/plaid/link-token">
                <AntiforgeryToken />
                <input type="hidden" name="publicToken" />
                <input type="hidden" name="name" />
                <div class="alert error" role="alert" data-plaid-error hidden></div>
                <div class="actions"><button type="submit">Connect a bank</button></div>
            </PostForm>
        }
        else
        {
            <p class="muted">
                Plaid links to most US and Canadian banks and cards. It needs your company's own Plaid keys, which an admin enters under
                <ActionLink Href="/settings/plaid">Settings → Plaid</ActionLink>.
            </p>
        }
    </div>

    <div class="card">
        <h2>Connect with SimpleFIN</h2>
        <p class="muted">
            <a href="https://beta-bridge.simplefin.org/" target="_blank" rel="noopener">SimpleFIN Bridge</a> links to thousands of US and
            Canadian banks for a small yearly fee. Connect your banks there, then create a <strong>setup token</strong> and paste it here.
            The token works once; OpenBook swaps it for a key it stores encrypted.
        </p>
        <PostForm Action="/banking/connections/connect" data-enhance="false">
            <AntiforgeryToken />
            <div class="field">
                <label for="setup-token">Setup token</label>
                <textarea id="setup-token" name="setupToken" rows="3" required autocomplete="off" spellcheck="false"></textarea>
            </div>
            <div class="field">
                <label for="name">Name <span class="muted">(optional)</span></label>
                <input id="name" name="name" maxlength="100" placeholder="SimpleFIN" />
            </div>
            <div class="actions"><button type="submit">Connect</button></div>
        </PostForm>
    </div>
</div>

@code {
    private IReadOnlyList<BankConnection> _connections = [];
    private OpenBook.Domain.Banking.PlaidSettings _plaid = OpenBook.Domain.Banking.PlaidSettings.Create();

    [SupplyParameterFromQuery] private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _connections = await ConnectionService.ListAsync();
        _plaid = await PlaidSettings.GetSettingsAsync();
    }
}
