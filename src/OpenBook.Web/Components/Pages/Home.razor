@page "/"
@inject ICompanyStore Companies

<PageTitle>@(_company?.Name ?? "OpenBook")</PageTitle>

@if (_company is not null)
{
    <h1>@_company.Name</h1>

    <div class="card">
        <h2>Company</h2>
        <dl class="facts">
            @if (_company.LegalName is not null)
            {
                <dt>Legal name</dt>
                <dd>@_company.LegalName</dd>
            }
            <dt>Business type</dt>
            <dd>@Labels.For(_company.BusinessType)</dd>
            <dt>Home currency</dt>
            <dd>@_company.HomeCurrency</dd>
            <dt>Fiscal year</dt>
            <dd>Starts in @Labels.Month(_company.FiscalYearStartMonth); current year began @_company.FiscalYearStart(DateOnly.FromDateTime(DateTime.Today)).ToString("d")</dd>
        </dl>
    </div>

    <div class="card">
        <h2>Getting started</h2>
        <ol>
            <li>Set up your <a href="/accounts">chart of accounts</a>: add accounts one by one, or <a href="/accounts/import">import a CSV</a> (there's a starter chart to download).</li>
            <li>Record transactions as <a href="/journal/new">journal entries</a>.</li>
            <li>Check the <a href="/reports/trial-balance">trial balance</a>.</li>
        </ol>
        <p class="muted">Banking, invoices and bills arrive in the next milestones. Everything is also available through the REST API under <code>/api</code>.</p>
    </div>
}

@code {
    private OpenBook.Domain.Companies.Company? _company;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync() =>
        _company = await Companies.GetCompanyAsync(HttpContext.RequestAborted);
}
