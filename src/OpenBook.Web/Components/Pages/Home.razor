@page "/"
@using OpenBook.Web.Components.Home
@inject ICompanyStore Companies
@inject ViewModeService Views
@inject HomeWorkflowService Workflow

<PageTitle>@(_company?.Name ?? "OpenBook")</PageTitle>

@if (_company is not null && _figures is not null)
{
    <h1>@_company.Name</h1>
    <WorkflowHome F="_figures" User="HttpContext.User" Edition="_company.Edition" />
}
else if (_company is not null)
{
    <h1>@_company.Name</h1>

    @if (Editions.Shortcuts(_company.Edition) is { Count: > 0 } shortcuts)
    {
        <div class="report-list" style="margin-bottom: 1.5rem">
            @foreach (var s in shortcuts.Where(s => HttpContext.User.CanReach(s.Href)))
            {
                <a class="card" href="@s.Href">
                    <h3>@s.Label</h3>
                    <p class="muted">@s.Hint</p>
                </a>
            }
        </div>
    }

    <div class="card">
        <h2>@L["Company"]</h2>
        <dl class="facts">
            @if (_company.LegalName is not null)
            {
                <dt>@L["Legal name"]</dt>
                <dd>@_company.LegalName</dd>
            }
            <dt>@L["Business type"]</dt>
            <dd>@Labels.For(_company.BusinessType)</dd>
            <dt>@L["Home currency"]</dt>
            <dd>@_company.HomeCurrency</dd>
            <dt>@L["Fiscal year"]</dt>
            <dd>@L["Starts in {0}; current year began {1}", Labels.Month(_company.FiscalYearStartMonth), _company.FiscalYearStart(CompanyTime.Today).ToString("d")]</dd>
        </dl>
    </div>

    <div class="card">
        <h2>@L["Getting started"]</h2>
        <ol>
            <li>Set up your <a href="/accounts">chart of accounts</a>: add accounts one by one, or <a href="/accounts/import">import a CSV</a> (there's a starter chart to download).</li>
            <li>Add your <a href="/customers">customers</a>, <a href="/vendors">vendors</a> and <a href="/items">products and services</a>, or import them.</li>
            <li>Record day-to-day work: <a href="/sales">invoices and payments</a>, <a href="/purchases">bills</a>, and <a href="/banking">bank and card transactions</a>.</li>
            <li>Reconcile each bank and card account against its statement.</li>
            <li>See where you stand in <a href="/reports">reports</a>: profit and loss, balance sheet, and more.</li>
        </ol>
        <p class="muted">Everything is also available through the REST API under <code>/api</code>. Back up regularly from <a href="/backup">Backup</a>.</p>
    </div>
}

@code {
    private OpenBook.Domain.Companies.Company? _company;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Set in the simple view only, which shows the workflow instead of the shortcuts and getting started.
    private WorkflowFigures? _figures;

    protected override async Task OnInitializedAsync()
    {
        _company = await Companies.GetCompanyAsync(HttpContext.RequestAborted);
        if (_company is not null && (await Views.CurrentAsync(HttpContext.RequestAborted)).Mode == OpenBook.Domain.Companies.ViewMode.Simple)
            _figures = await Workflow.FiguresAsync(CompanyTime.Today, HttpContext.RequestAborted);
    }
}
