@page "/loans/{Id:guid}"
@inject LoanService LoanService
@inject OpenBook.Application.Segments.SegmentService Segments
@inject AccountService AccountService

<PageTitle>@(_loan?.Name ?? "Loan") · OpenBook</PageTitle>

<div class="wide">
    @if (_loan is null)
    {
        <h1>Loan not found</h1>
        <p><a href="/loans">Back to loans</a></p>
    }
    else
    {
        <div class="toolbar">
            <h1>@_loan.Name</h1>
            <ActionLink Class="button secondary" Href="/loans">Loans</ActionLink>
        </div>
        @if (Error is not null)
        {
            <div class="alert error" role="alert">@Error</div>
        }
        @if (_loan.VoidedAt is { } voided)
        {
            <div class="alert notice" role="status">This loan was voided on @voided.InCompanyTime().ToString("d"). It stays here for the record.</div>
        }
        <dl class="facts">
            <dt>Borrowed</dt><dd>@Labels.Amount(_loan.Principal) in @_chart.FullName(_loan.LiabilityAccountId)</dd>
            <dt>Rate</dt><dd>@Labels.Percent(_loan.RateOn(CompanyTime.Today)) a year@(_loan.RateChanges.Count > 0 ? $" (variable; {Labels.Percent(_loan.AnnualRatePercent)} at the start)" : "")</dd>
            <dt>Payment</dt><dd>@Labels.Amount(_loan.PaymentAmount) a month, @_loan.Payments payments from @Labels.Date(_loan.FirstPaymentDate)</dd>
            <dt>Interest to</dt><dd>@_chart.FullName(_loan.InterestAccountId)</dd>
            <dt>Balance</dt><dd>@Labels.Amount(_loan.Balance)</dd>
        </dl>

        @if (!_loan.IsPaidOff)
        {
            <div class="card">
                <h2>Record a payment</h2>
                <PostForm Action="@($"/loans/{_loan.Id}/pay")" data-enhance="false">
                    <AntiforgeryToken />
                    <div class="row">
                        <div class="field"><label for="date">Date</label><input id="date" name="date" type="date" value="@(_remaining.Count > 0 ? _remaining[0].Date.ToString("yyyy-MM-dd") : CompanyTime.Today.ToString("yyyy-MM-dd"))" /></div>
                        <div class="field"><label for="amount">Amount</label><input id="amount" name="amount" class="amount" inputmode="decimal" value="@_loan.NextPaymentOn(CompanyTime.Today).ToString("0.00")" /></div>
                        <div class="field">
                            <label for="from">Paid from</label>
                            <select id="from" name="paymentAccountId">
                                @foreach (var a in _payFrom)
                                {
                                    <option value="@a.Id">@_chart.FullName(a.Id)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <p class="hint">Interest is a month on the balance owed; anything above the interest pays down the loan.</p>
                    <ClosedPeriodPassword Visible="Password" Interactive="false" />
                    <div class="actions"><button type="submit">Record payment</button></div>
                </PostForm>
            </div>
        }

        @if (_loan.CreditLimit is { } limit && !_loan.IsVoided)
        {
            <div class="card" style="margin-top: 1.5rem">
                <h2>Draw on the line of credit</h2>
                <p class="muted">Owed @Labels.Amount(_loan.Balance) of a @Labels.Amount(limit) limit: up to @Labels.Amount(limit - _loan.Balance) can be drawn.</p>
                <PostForm Action="@($"/loans/{_loan.Id}/draw")" data-enhance="false">
                    <AntiforgeryToken />
                    <div class="row">
                        <div class="field"><label for="draw-amount">Amount</label><input id="draw-amount" name="amount" class="amount" inputmode="decimal" required /></div>
                        <div class="field"><label for="draw-date">Date</label><input id="draw-date" name="date" type="date" value="@CompanyTime.Today.ToString("yyyy-MM-dd")" /></div>
                        <div class="field">
                            <label for="draw-bank">Into</label>
                            <select id="draw-bank" name="bankAccountId">
                                @foreach (var a in _payFrom.Where(a => a.Type == AccountType.Bank))
                                {
                                    <option value="@a.Id">@_chart.FullName(a.Id)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <ClosedPeriodPassword Visible="Password" Interactive="false" />
                    <div class="actions"><button type="submit">Record the draw</button></div>
                </PostForm>
                @if (_loan.Draws.Count > 0)
                {
                    <table class="data" style="margin-top: 1rem">
                        <thead><tr><th>Drawn</th><th class="num">Amount</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var d in _loan.Draws)
                            {
                                <tr class="@(d.IsVoided ? "muted" : "")">
                                    <td><a href="/journal/@d.EntryId">@Labels.Date(d.Date)</a>@(d.IsVoided ? " (voided)" : "")</td>
                                    <td class="num">@Labels.Amount(d.Amount)</td>
                                    <td>@if (!d.IsVoided) { <OpenBook.Web.Components.Pages.Nonprofit.VoidLine Action="@($"/loans/{_loan.Id}/draws/{d.Id}/void")" Password="Password" /> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
        @if (_loan.FactorFee is { } fee)
        {
            <p class="muted">A merchant advance: a fixed fee of @Labels.Amount(fee), @Labels.Amount(_loan.FeePaid) of it paid so far.</p>
        }

        @if (_loan.PaymentsMade.Count > 0)
        {
            <h2>Payments</h2>
            <table class="data">
                <thead><tr><th>Date</th><th class="num">Amount</th><th class="num">Interest</th><th class="num">Principal</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in _loan.PaymentsMade.OrderBy(p => p.Date))
                    {
                        <tr class="@(p.IsVoided ? "muted" : "")">
                            <td><a href="/journal/@p.JournalEntryId">@Labels.Date(p.Date)</a></td>
                            <td class="num">@Labels.Amount(p.Amount)</td>
                            <td class="num">@Labels.Amount(p.Interest)</td>
                            <td class="num">@Labels.Amount(p.Principal)</td>
                            <td>
                                @if (p.IsVoided)
                                {
                                    <span>Voided</span>
                                }
                                else if (_loan.LatestPayment?.Id == p.Id)
                                {
                                    <PostForm Action="@($"/loans/{_loan.Id}/payments/{p.Id}/void")" data-enhance="false" class="inline">
                                        <AntiforgeryToken />
                                        <input name="reason" required placeholder="Reason" aria-label="Reason" maxlength="500" />
                                        <button type="submit" class="secondary">Void</button>
                                    </PostForm>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (!_loan.IsVoided)
        {
            <div class="card">
                <h2>Name, class and notes</h2>
                <PostForm Action="@($"/loans/{_loan.Id}/details")" data-enhance="false">
                    <AntiforgeryToken />
                    <div class="field"><label for="name">Name</label><input id="name" name="name" maxlength="200" value="@_loan.Name" /></div>
                    @if (_classes.Count > 0)
                {
                    <div class="field">
                        <label for="classId">Class <span class="muted">(optional)</span></label>
                        <select id="classId" name="classId">
                            <option value="">None</option>
                            @foreach (var c in _classes)
                            {
                                <option value="@c.Segment.Id" selected="@(c.Segment.Id == _loan.ClassId)">@(new string(' ', c.Depth * 3))@c.FullName</option>
                            }
                        </select>
                        <span class="hint">Interest is posted to this class from the next payment on.</span>
                    </div>
                }
                    <div class="field"><label for="notes">Notes</label><textarea id="notes" name="notes" maxlength="1000">@_loan.Notes</textarea></div>
                    <div class="actions"><button type="submit" class="secondary">Save</button></div>
                </PostForm>
            </div>
            @if (_loan.FactorFee is null)
            {
                <div class="card" id="rates">
                    <h2>Rate changes</h2>
                    <p class="hint">For a variable rate: the new yearly rate from a date, and the new monthly payment if the lender changed it. Each payment's interest uses the rate on its date, and what's left is worked out at today's.</p>
                    @if (_loan.RateChanges.Count > 0)
                    {
                        <table class="data">
                            <thead><tr><th>From</th><th class="num">Rate</th><th class="num">Payment</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var c in _loan.RateChanges)
                                {
                                    <tr>
                                        <td>@Labels.Date(c.EffectiveFrom)</td>
                                        <td class="num">@Labels.Percent(c.RatePercent)</td>
                                        <td class="num">@(c.PaymentAmount is { } p ? Labels.Amount(p) : "unchanged")</td>
                                        <td>
                                            @if (_loan.LatestPayment is not { } last || c.EffectiveFrom > last.Date)
                                            {
                                                <PostForm Action="@($"/loans/{_loan.Id}/rates/{c.EffectiveFrom:yyyy-MM-dd}/remove")" data-enhance="false" class="inline">
                                                    <AntiforgeryToken />
                                                    <button type="submit" class="link" data-confirm="Remove this rate change?">Remove</button>
                                                </PostForm>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    <PostForm Action="@($"/loans/{_loan.Id}/rates")" data-enhance="false">
                        <AntiforgeryToken />
                        <div class="row">
                            <div class="field"><label for="rate-from">From</label><input id="rate-from" name="from" type="date" required /></div>
                            <div class="field"><label for="rate">Yearly rate %</label><input id="rate" name="rate" inputmode="decimal" required /></div>
                            <div class="field"><label for="rate-payment">New monthly payment <span class="muted">(optional)</span></label><input id="rate-payment" name="payment" class="amount" inputmode="decimal" /></div>
                        </div>
                        <div class="actions"><button type="submit" class="secondary">Save rate change</button></div>
                    </PostForm>
                </div>
            }
            <div class="card">
                <h2>Void this loan</h2>
                @if (_loan.PaymentsMade.Any(p => !p.IsVoided))
                {
                    <p class="hint">Its payments come first: void them, latest first.</p>
                }
                else
                {
                    <p class="hint">For a loan entered by mistake. @(_loan.ProceedsEntryId is null ? "" : "The entry recording the money is reversed too. ")To change the terms, void it and enter it again.</p>
                    <PostForm Action="@($"/loans/{_loan.Id}/void")" data-enhance="false">
                        <AntiforgeryToken />
                        <div class="field"><label for="reason">Why</label><input id="reason" name="reason" required maxlength="200" /></div>
                        <ClosedPeriodPassword Visible="Password" Interactive="false" />
                        <div class="actions"><button type="submit" class="secondary">Void loan</button></div>
                    </PostForm>
                }
            </div>
        }

        @if (_remaining.Count > 0)
        {
            <h2>What's left</h2>
            <table class="data">
                <thead><tr><th>No.</th><th>Date</th><th class="num">Payment</th><th class="num">Interest</th><th class="num">Principal</th><th class="num">Balance</th></tr></thead>
                <tbody>
                    @foreach (var i in _remaining)
                    {
                        <tr>
                            <td>@i.Number</td><td>@Labels.Date(i.Date)</td><td class="num">@Labels.Amount(i.Payment)</td><td class="num">@Labels.Amount(i.Interest)</td>
                            <td class="num">@Labels.Amount(i.Principal)</td><td class="num">@Labels.Amount(i.Balance)</td>
                        </tr>
                    }
                </tbody>
                <tfoot><tr><td colspan="2">Total</td><td class="num">@Labels.Amount(_remaining.Sum(i => i.Payment))</td><td class="num">@Labels.Amount(_remaining.Sum(i => i.Interest))</td><td class="num">@Labels.Amount(_remaining.Sum(i => i.Principal))</td><td></td></tr></tfoot>
            </table>
        }

        <Attachments EntityType="loan" EntityId="_loan.Id" />
        <Notes EntityType="loan" EntityId="_loan.Id" />
    }
</div>

@code {
    private Loan? _loan;
    private ChartOfAccounts _chart = new([]);
    private IReadOnlyList<Installment> _remaining = [];
    private List<Account> _payFrom = [];
    private IReadOnlyList<OpenBook.Application.Segments.SegmentChoice> _classes = [];

    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private bool Password { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _loan = await LoanService.GetAsync(Id);
        _chart = await AccountService.GetChartAsync();
        if (_loan is not null)
            _remaining = LoanService.RemainingSchedule(_loan);
        _payFrom = _chart.Ordered(includeInactive: false).Select(x => x.Account).Where(a => a.Type is AccountType.Bank or AccountType.CreditCard).ToList();
        _classes = await Segments.ListAsync(OpenBook.Domain.Segments.SegmentKind.Class, includeInactive: false);
    }
}
