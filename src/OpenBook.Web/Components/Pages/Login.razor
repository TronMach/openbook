@page "/login"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@inject AuthService Auth
@inject TwoFactorService TwoFactor
@inject TwoFactorCookies TwoFactorCookies
@inject NavigationManager Navigation

<PageTitle>@L["Sign in"] · OpenBook</PageTitle>

<div class="card narrow">
    <h1>@L["Sign in"]</h1>

    @if (Restored)
    {
        <div class="alert notice" role="status">@L["Backup restored. Sign in with an account from the restored file."]</div>
    }
    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    <EditForm Model="Input" FormName="login" OnValidSubmit="SignInAsync" method="post">
        <DataAnnotationsValidator />
        <div class="field">
            <label for="username">@L["Username"]</label>
            <InputText id="username" @bind-Value="Input.Username" autocomplete="username" />
            <ValidationMessage For="() => Input.Username" />
        </div>
        <div class="field">
            <label for="password">@L["Password"]</label>
            <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password" />
            <ValidationMessage For="() => Input.Password" />
        </div>
        <button type="submit">@L["Sign in"]</button>
    </EditForm>
    <p class="hint muted">@L["Forgot your password? On the computer running OpenBook, run it with reset-password to set a new one."]</p>
</div>

@code {
    private string? _error;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private LoginModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private bool Restored { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task SignInAsync()
    {
        var result = await Auth.SignInAsync(Input.Username, Input.Password, HttpContext.RequestAborted);
        switch (result.Status)
        {
            case SignInStatus.Succeeded:
                Navigation.NavigateTo(await WebSecurity.CompleteSignInAsync(HttpContext, result, ReturnUrl));
                break;
            case SignInStatus.TwoFactorRequired:
                // A browser remembered since two-factor was turned on skips the code.
                if (TwoFactorCookies.Remembered(HttpContext, result.User!) is { } since && since == result.TwoFactorSince
                    && await TwoFactor.SignInRememberedAsync(result.User!.Id, result.User.SecurityStamp, since, HttpContext.RequestAborted) is { Status: SignInStatus.Succeeded } remembered)
                {
                    Navigation.NavigateTo(await WebSecurity.CompleteSignInAsync(HttpContext, remembered, ReturnUrl));
                    break;
                }

                TwoFactorCookies.StartPending(HttpContext, result.User!, WebSecurity.SafeReturnUrl(ReturnUrl));
                Navigation.NavigateTo("/login/two-factor");
                break;
            case SignInStatus.LockedOut:
                _error = $"Too many failed attempts. Try again after {result.LockedUntil!.Value.InCompanyTime():t}.";
                break;
            default:
                _error = "That username and password don't match.";
                break;
        }
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Enter your username.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;
    }
}
