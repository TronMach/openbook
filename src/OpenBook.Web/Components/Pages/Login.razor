@page "/login"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Logging
@inject AuthService Auth
@inject ILogger<Login> Log
@inject TwoFactorService TwoFactor
@inject TwoFactorCookies TwoFactorCookies
@inject PasskeyChallenges Challenges
@inject SingleSignOnService SingleSignOn
@inject NavigationManager Navigation

<PageTitle>@L["Sign in"] · OpenBook</PageTitle>

<div class="card narrow">
    <h1>@L["Sign in"]</h1>

    @if (Restored)
    {
        <div class="alert notice" role="status">@L["Backup restored. Sign in with an account from the restored file."]</div>
    }
    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (PasskeyMessage is { } passkeyMessage)
    {
        <div class="alert error" role="alert">@passkeyMessage</div>
    }
    @if (SsoMessage is { } ssoMessage)
    {
        <div class="alert error" role="alert">@ssoMessage</div>
    }

    @if (_secretUnreadable)
    {
        <div class="alert notice" role="status">@L["Single sign-on isn't available: its client secret can't be read on this computer. An administrator can sign in with their password and enter it again under Settings, Sign-in."]</div>
    }
    else if (_settings is { IsSsoReady: true })
    {
        <p><a class="button" href="/login/sso?returnUrl=@Uri.EscapeDataString(WebSecurity.SafeReturnUrl(ReturnUrl))" data-enhance-nav="false">@_settings.ButtonText</a></p>
        <p class="muted">@(_settings.SsoOnly ? L["Administrators can also sign in with their password:"] : L["Or with your OpenBook username and password:"])</p>
    }

    <EditForm Model="Input" FormName="login" OnValidSubmit="SignInAsync" method="post">
        <DataAnnotationsValidator />
        <div class="field">
            <label for="username">@L["Username"]</label>
            <InputText id="username" @bind-Value="Input.Username" autocomplete="username" />
            <ValidationMessage For="() => Input.Username" />
        </div>
        <div class="field">
            <label for="password">@L["Password"]</label>
            <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password" />
            <ValidationMessage For="() => Input.Password" />
        </div>
        <button type="submit">@L["Sign in"]</button>
    </EditForm>
    <form method="post" action="/login/passkey" data-enhance="false" data-passkey="get" data-passkey-part="1" hidden
          data-challenge="@_challenge" data-site="@PasskeyEndpoints.Here(HttpContext.Request).Site" data-failed-text="@L["No passkey was used. Try again, or sign in with your password."]">
        <AntiforgeryToken />
        <input type="hidden" name="token" value="@_passkeyToken" />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <input type="hidden" name="credentialId" />
        <input type="hidden" name="clientData" />
        <input type="hidden" name="authenticatorData" />
        <input type="hidden" name="signature" />
        <div class="alert error" role="alert" data-passkey-error hidden></div>
        <button type="submit" class="secondary">@L["Sign in with a passkey"]</button>
    </form>
    <script src="@Assets["passkeys.js"]"></script>
    <p class="hint muted">@L["Forgot your password? On the computer running OpenBook, run it with reset-password to set a new one."]</p>
</div>

@code {
    private string? _error;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private LoginModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private bool Restored { get; set; }

    [SupplyParameterFromQuery(Name = "passkey")]
    private string? PasskeyOutcome { get; set; }

    private string _challenge = "";
    private string _passkeyToken = "";

    private string? PasskeyMessage => PasskeyOutcome switch
    {
        null or "" => null,
        "lapsed" => L["That took too long. Try again."].Value,
        "locked" => L["Too many tries. Wait a while, then try again."].Value,
        "sso" => L["Only administrators sign in with a password or passkey here. Use single sign-on."].Value,
        _ => L["That passkey can't sign in here. Sign in with your password; under Passkeys you can add it again."].Value,
    };

    private OpenBook.Domain.Companies.SignInSettings? _settings;
    private bool _secretUnreadable;

    [SupplyParameterFromQuery(Name = "sso")]
    private string? Sso { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        (_challenge, _passkeyToken) = Challenges.Make(null);
        _settings = await SingleSignOn.SettingsAsync(HttpContext.RequestAborted);
        _secretUnreadable = await SingleSignOn.ClientAsync(HttpContext.RequestAborted) is { ClientSecret: null };
    }

    private string? SsoMessage => Sso switch
    {
        null => null,
        // The notice below says it already.
        SingleSignOnService.SecretUnreadableCode when _secretUnreadable => null,
        "not-invited" => "You signed in with the provider, but nobody here is set up for that account. Ask an admin to invite you (with the email your provider uses).",
        "off" => "Single sign-on isn't set up.",
        "invite.access_ended" => "The access your invitation gave has already ended. Ask for a new one.",
        "refused" => "That account can't sign in here: it's inactive or its access has ended.",
        _ => "Single sign-on didn't work. Try again, or sign in with your password if you have one.",
    };

    private async Task SignInAsync()
    {
        var address = HttpContext.Connection.RemoteIpAddress?.ToString();
        var result = await Auth.SignInAsync(Input.Username, Input.Password, address, HttpContext.RequestAborted);
        // The username as typed (cut short, one line), the address and the outcome; never the password.
        var who = SignInLog.Name(Input.Username);
        if (result.Status is SignInStatus.InvalidCredentials or SignInStatus.LockedOut)
            Log.LogWarning("Sign-in refused for {Username} from {Address}: {Outcome}", who, address, result.Status == SignInStatus.LockedOut ? "paused after too many tries" : "wrong username or password");
        else
            Log.LogInformation("Password accepted for {Username} from {Address} ({Outcome})", who, address, result.Status);
        switch (result.Status)
        {
            case SignInStatus.Succeeded:
                Navigation.NavigateTo(await WebSecurity.CompleteSignInAsync(HttpContext, result, ReturnUrl));
                break;
            case SignInStatus.TwoFactorRequired:
                // A browser remembered since two-factor was turned on skips the code.
                if (TwoFactorCookies.Remembered(HttpContext, result.User!) is { } since && since == result.TwoFactorSince
                    && await TwoFactor.SignInRememberedAsync(result.User!.Id, result.User.SecurityStamp, since, HttpContext.RequestAborted) is { Status: SignInStatus.Succeeded } remembered)
                {
                    Navigation.NavigateTo(await WebSecurity.CompleteSignInAsync(HttpContext, remembered, ReturnUrl));
                    break;
                }

                TwoFactorCookies.StartPending(HttpContext, result.User!, WebSecurity.SafeReturnUrl(ReturnUrl));
                Navigation.NavigateTo("/login/two-factor");
                break;
            case SignInStatus.SsoRequired:
                _error = _secretUnreadable
                    ? L["Only administrators sign in with a password here."].Value
                    : $"Use \"{_settings?.ButtonText}\" above: only administrators sign in with a password here.";
                break;
            default:
                // The same for someone shut out, or the answer would say which usernames exist.
                _error = "That username and password don't match. After several tries, sign-in pauses here for a few minutes.";
                break;
        }
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Enter your username.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;
    }
}
