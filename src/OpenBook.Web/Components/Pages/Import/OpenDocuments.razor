@page "/import/open-documents"
@rendermode InteractiveServer
@using OpenBook.Application.Import
@using OpenBook.Domain.Accounts
@inject Operations Ops

<PageTitle>Import unpaid invoices and bills · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Import unpaid invoices and bills</h1>
        <ActionLink Class="button secondary" Href="/help/24-moving-in">Moving in</ActionLink>
    </div>

    <div class="card">
        <p>
            For starting fresh: what customers owe you and what you owe vendors on your start date, as real invoices and bills, so the agings list them and
            payments apply. Upload a CSV with a header row: <strong>Customer</strong> or <strong>Vendor</strong>, <strong>Date</strong> and <strong>Open balance</strong>
            (or Amount), with a <strong>Number</strong> (invoices need one) and a <strong>Due date</strong> when you have them. Names not on your list are added, a
            number already in the books is skipped, and nothing is imported unless every row is good.
        </p>
        <div class="row">
            <div class="field">
                <label for="kind">What's in the file</label>
                <select id="kind" @bind="_kind" @bind:after="ChangedAsync">
                    <option value="@OpenDocumentKind.Invoices">Unpaid invoices</option>
                    <option value="@OpenDocumentKind.Bills">Unpaid bills</option>
                </select>
            </div>
            <div class="field">
                <label for="account">@(_kind == OpenDocumentKind.Invoices ? "Income account" : "Category")</label>
                <select id="account" @bind="_accountId">
                    @foreach (var a in Choices)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </select>
                <span class="hint">Date them before your start date, so this year's income and expenses aren't changed.</span>
            </div>
        </div>
        <div class="field">
            <label for="file">@L["CSV file"]</label>
            <InputFile id="file" accept=".csv,text/csv" OnChange="LoadAsync" disabled="@_busy" />
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (_imported is not null)
    {
        <div class="alert notice" role="status">Imported @_imported.NewCount for @Labels.Amount(_imported.Total).</div>
    }

    @if (_preview is not null && _imported is null)
    {
        @foreach (var warning in _preview.Warnings)
        {
            <div class="alert notice">@warning</div>
        }
        <div class="import-summary">
            <span><span class="badge ok">@_preview.NewCount</span> new, @Labels.Amount(_preview.Total)</span>
            <span><span class="badge">@_preview.NewParties</span> new names</span>
            <span><span class="badge">@_preview.ExistingCount</span> skipped</span>
            <span><span class="badge @(_preview.ErrorCount > 0 ? "warn" : null)">@_preview.ErrorCount</span> with errors</span>
        </div>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th class="num">Line</th><th>Status</th><th>Name</th><th>Number</th><th>Date</th><th>Due</th><th class="num">Amount</th><th>Note</th></tr></thead>
                <tbody>
                    @foreach (var row in _preview.Rows)
                    {
                        <tr class="@(row.Status == ImportRowStatus.Exists ? "inactive" : null)">
                            <td class="num">@row.Line</td>
                            <td><span class="badge @(row.Status switch { ImportRowStatus.New => "ok", ImportRowStatus.Error => "warn", _ => null })">@row.Status</span></td>
                            <td>@row.Party @(row.NewParty ? "(new)" : null)</td>
                            <td>@row.Number</td>
                            <td>@(row.Date is { } date ? Labels.Date(date) : null)</td>
                            <td>@(row.DueDate is { } due ? Labels.Date(due) : null)</td>
                            <td class="num">@Labels.AmountOrBlank(row.Amount)</td>
                            <td class="out-of-balance">@row.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <ClosedPeriodPassword Visible="_needsClosingPassword" @bind-Value="_closingPassword" />
        <div class="actions">
            <button type="button" @onclick="ImportAsync" disabled="@(!_preview.CanImport || _accountId == Guid.Empty || _busy)">Import @_preview.NewCount</button>
        </div>
    }
</div>

@code {
    private OpenDocumentKind _kind = OpenDocumentKind.Invoices;
    private string? _csv;
    private OpenDocumentPlan? _preview;
    private OpenDocumentPlan? _imported;
    private List<Account> _income = [];
    private List<Account> _categories = [];
    private Guid _accountId;
    private string? _error;
    private bool _busy;
    private bool _needsClosingPassword;
    private string? _closingPassword;

    private List<Account> Choices => _kind == OpenDocumentKind.Invoices ? _income : _categories;

    protected override async Task OnInitializedAsync()
    {
        var chart = await Ops.RunAsync<AccountService, ChartOfAccounts>(s => s.GetChartAsync());
        var accounts = chart.Ordered(includeInactive: false).Select(x => x.Account).ToList();
        _income = accounts.Where(a => a.Type.ClassOf() == AccountClass.Income).ToList();
        _categories = accounts.Where(a => a.Type is not (AccountType.AccountsPayable or AccountType.AccountsReceivable))
            .OrderBy(a => a.Type.ClassOf() != AccountClass.Expense).ToList();
        _accountId = Choices.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private async Task ChangedAsync()
    {
        _accountId = Choices.FirstOrDefault()?.Id ?? Guid.Empty;
        _imported = null;
        await PreviewAsync();
    }

    private async Task LoadAsync(InputFileChangeEventArgs e)
    {
        if (_busy)
            return;
        _busy = true;
        _imported = null;
        _error = null;
        try
        {
            await using var stream = e.File.OpenReadStream(5 * 1024 * 1024);
            _csv = await OpenBook.Application.Import.TextFiles.ReadAsync(stream);
            await PreviewAsync();
        }
        catch (IOException)
        {
            _error = "That file is larger than 5 MB.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PreviewAsync()
    {
        _preview = null;
        if (_csv is null)
            return;
        try
        {
            var kind = _kind;
            _preview = await Ops.RunAsync<OpenDocumentImportService, OpenDocumentPlan>(s => s.PreviewAsync(kind, _csv));
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ImportAsync()
    {
        if (_busy || _csv is null)
            return;
        _busy = true;
        _error = null;
        try
        {
            var (kind, account) = (_kind, _accountId);
            _imported = await Ops.RunAsync<OpenDocumentImportService, OpenDocumentPlan>(s => s.ImportAsync(kind, _csv, account), _closingPassword);
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
            _needsClosingPassword |= ClosedPeriod.NeedsPassword(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
