@page "/sales-tax"
@inject SalesTaxService Taxes
@inject SalesTaxPaymentService Payments
@inject SalesTaxReports Reports

<PageTitle>Sales tax · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Sales tax</h1>
        <ActionLink Class="button secondary" Href="/reports/sales-tax">Liability report</ActionLink>
        <ActionLink Class="button secondary" Href="/sales-tax/nexus">Nexus thresholds</ActionLink>
        <ActionLink Class="button" Href="/sales-tax/pay">Pay sales tax</ActionLink>
    </div>
    @if (Error is not null)
    {
        <div class="alert error" role="alert">@Error</div>
    }
    @if (Welcome)
    {
        <div class="alert notice" role="status">
            Your company is set up. Since you charge sales tax, add the agency you pay it to and its rate here; then
            customers and invoices can charge it. Or <a href="/">go to the home page</a> and do it later.
        </div>
    }
    <p class="muted">
        Each <strong>agency</strong> you collect for has its own account under "Sales Tax Payable", so what you owe it is always in the
        books. <strong>Rates</strong> belong to an agency; a <strong>tax code</strong> charges one rate or combines several (state + county +
        city). Customers carry a default code, items say whether they're taxable, and each invoice, receipt, estimate or credit memo
        can change both.
    </p>

    <section class="card">
        <div class="toolbar">
            <h2>Agencies</h2>
            <ActionLink Class="button secondary" Href="/sales-tax/agencies/new">New agency</ActionLink>
        </div>
        @if (_agencies.Count == 0)
        {
            <p>No agencies yet. Start by <ActionLink Href="/sales-tax/agencies/new">adding the agency you file with</ActionLink>, such as your state's department of revenue.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Agency</th><th>Files</th><th>Period to file</th><th class="num">Owed today</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in _agencies)
                        {
                            var (from, to) = FilingPeriods.LastCompleted(a.FilingFrequency, _today);
                            <tr class="@(a.IsActive ? null : "inactive")">
                                <td>
                                    <a href="/sales-tax/agencies/@a.Id">@a.Name</a>
                                    @if (a.RegistrationNumber is not null) { <span class="muted"> · @a.RegistrationNumber</span> }
                                </td>
                                <td>@a.FilingFrequency</td>
                                <td><a href="/reports/sales-tax?preset=Custom&amp;from=@from.ToString("yyyy-MM-dd")&amp;to=@to.ToString("yyyy-MM-dd")">@Labels.Date(from) – @Labels.Date(to)</a>@(_payments.Any(p => p.AgencyId == a.Id && p.PeriodEnd == to && p.Status == DocumentStatus.Posted) ? " · paid" : "")@(_filings.FirstOrDefault(f => f.AgencyId == a.Id && f.PeriodTo == to) is { } filed ? $" · filed {Labels.Date(filed.FiledOn)}" : "")</td>
                                <td class="num">@Labels.Amount(_owed.GetValueOrDefault(a.Id))</td>
                                <td>
                                    @if (_owed.GetValueOrDefault(a.Id) > 0m)
                                    {
                                        <ActionLink Class="button secondary" Href="@($"/sales-tax/pay?agency={a.Id}")">Pay</ActionLink>
                                    }
                                    @if (a.IsActive && !_filings.Any(f => f.AgencyId == a.Id && f.PeriodTo == to))
                                    {
                                        <details class="menu">
                                            <summary class="button secondary">Mark filed</summary>
                                            <PostForm Action="/sales-tax/filings" data-enhance="false">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="agencyId" value="@a.Id" />
                                                <input type="hidden" name="periodTo" value="@to.ToString("yyyy-MM-dd")" />
                                                <div class="field"><label for="filed-@a.Id">Filed on</label><input id="filed-@a.Id" name="filedOn" type="date" value="@_today.ToString("yyyy-MM-dd")" /></div>
                                                <div class="field"><label for="reported-@a.Id">Tax reported</label><input id="reported-@a.Id" name="amount" class="amount" inputmode="decimal" value="@_owed.GetValueOrDefault(a.Id).ToString("0.00")" /></div>
                                                <div class="field"><label for="ref-@a.Id">Confirmation number <span class="muted">(optional)</span></label><input id="ref-@a.Id" name="reference" maxlength="100" /></div>
                                                <div class="actions"><button type="submit">Record the return as filed</button></div>
                                            </PostForm>
                                        </details>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (_filings.Count > 0)
    {
        <section class="card">
            <h2>Returns filed</h2>
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Agency</th><th>Period</th><th>Filed on</th><th class="num">Tax reported</th><th>Confirmation</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var f in _filings.Take(24))
                        {
                            <tr>
                                <td>@_agencyNames.GetValueOrDefault(f.AgencyId)</td>
                                <td>@Labels.Date(f.PeriodFrom) – @Labels.Date(f.PeriodTo)</td>
                                <td>@Labels.Date(f.FiledOn)</td>
                                <td class="num">@Labels.Amount(f.AmountReported)</td>
                                <td>@f.Reference</td>
                                <td>
                                    <PostForm Action="@($"/sales-tax/filings/{f.Id}/remove")" data-enhance="false" class="inline">
                                        <AntiforgeryToken />
                                        <button type="submit" class="link" data-confirm="Remove this filing record? Nothing posted is changed.">Remove</button>
                                    </PostForm>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <div class="split-grid">
        <section class="card">
            <div class="toolbar">
                <h2>Rates</h2>
                @if (_agencies.Any(a => a.IsActive))
                {
                    <ActionLink Class="button secondary" Href="/sales-tax/rates/new">New rate</ActionLink>
                }
            </div>
            @if (_rates.Count == 0)
            {
                <p class="muted">No rates yet.</p>
            }
            else
            {
                <table class="data">
                    <thead><tr><th>Rate</th><th>Agency</th><th class="num">Percent</th></tr></thead>
                    <tbody>
                        @foreach (var r in _rates)
                        {
                            <tr class="@(r.IsActive ? null : "inactive")">
                                <td><a href="/sales-tax/rates/@r.Id">@r.Name</a></td>
                                <td>@_agencyNames.GetValueOrDefault(r.AgencyId)</td>
                                <td class="num">@Labels.Percent(r.Percent)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="card">
            <div class="toolbar">
                <h2>Tax codes</h2>
                @if (_rates.Any(r => r.IsActive))
                {
                    <ActionLink Class="button secondary" Href="/sales-tax/codes/new">New code</ActionLink>
                }
            </div>
            @if (_codes.Count == 0)
            {
                <p class="muted">No tax codes yet. Each new rate makes a code of its own; add a code to combine rates.</p>
            }
            else
            {
                <table class="data">
                    <thead><tr><th>Code</th><th>Charges</th><th class="num">Total</th></tr></thead>
                    <tbody>
                        @foreach (var c in _codes)
                        {
                            var rates = c.RateIds.Select(id => _rateById.GetValueOrDefault(id)).OfType<TaxRate>().ToList();
                            <tr class="@(c.IsActive ? null : "inactive")">
                                <td><a href="/sales-tax/codes/@c.Id">@c.Name</a></td>
                                <td>@string.Join(" + ", rates.Select(r => r.Name))</td>
                                <td class="num">@Labels.Percent(rates.Sum(r => r.Percent))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    </div>

    <section class="card">
        <h2>Exempt customers</h2>
        @if (_exempt.Count == 0)
        {
            <p class="muted">No customer has an exemption certificate. Add one on the customer's page; their sales are then taxed at zero and reported as exempt.</p>
        }
        else
        {
            <table class="data">
                <thead><tr><th>Customer</th><th>Reason</th><th>Certificate</th><th>Expires</th></tr></thead>
                <tbody>
                    @foreach (var x in _exempt)
                    {
                        <tr>
                            <td><a href="/customers/@x.Customer.Id">@x.Customer.DisplayName</a></td>
                            <td>@ExemptionReasons.Label(x.Customer.ExemptionReason!.Value)</td>
                            <td>@x.Customer.ExemptionCertificate</td>
                            <td>
                                @(x.Customer.ExemptionExpiresOn is { } e ? Labels.Date(e) : "Doesn't expire")
                                @if (x.Expired) { <span class="badge warn">Expired: sales are taxed</span> }
                                else if (x.ExpiresSoon) { <span class="badge warn">Expires soon</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="card">
        <h2>Payments</h2>
        @if (_payments.Count == 0)
        {
            <p class="muted">No sales tax payments yet.</p>
        }
        else
        {
            <table class="data">
                <thead><tr><th>Date</th><th>Agency</th><th>For period ending</th><th>Reference</th><th class="num">Paid</th><th class="num">Settled</th></tr></thead>
                <tbody>
                    @foreach (var p in _payments.Take(20))
                    {
                        <tr class="@(p.Status == DocumentStatus.Voided ? "inactive" : null)">
                            <td><a href="/sales-tax/payments/@p.Id">@Labels.Date(p.Date)</a></td>
                            <td>@_agencyNames.GetValueOrDefault(p.AgencyId)</td>
                            <td>@(p.PeriodEnd is { } end ? Labels.Date(end) : "")</td>
                            <td>@p.Reference</td>
                            <td class="num">@Labels.Amount(p.Amount)</td>
                            <td class="num">@(p.Status == DocumentStatus.Voided ? "Voided" : Labels.Amount(p.LiabilitySettled))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>

@code {
    // Coming straight from setup, having said they charge sales tax.
    [SupplyParameterFromQuery]
    private bool Welcome { get; set; }

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    private readonly DateOnly _today = CompanyTime.Today;
    private IReadOnlyList<TaxAgency> _agencies = [];
    private IReadOnlyList<TaxRate> _rates = [];
    private IReadOnlyList<TaxCode> _codes = [];
    private IReadOnlyList<SalesTaxPayment> _payments = [];
    private IReadOnlyList<SalesTaxFiling> _filings = [];
    private IReadOnlyList<ExemptCustomer> _exempt = [];
    private IReadOnlyDictionary<Guid, decimal> _owed = new Dictionary<Guid, decimal>();
    private Dictionary<Guid, string> _agencyNames = [];
    private Dictionary<Guid, TaxRate> _rateById = [];

    protected override async Task OnInitializedAsync()
    {
        _agencies = await Taxes.ListAgenciesAsync();
        _rates = await Taxes.ListRatesAsync();
        _codes = await Taxes.ListCodesAsync();
        _payments = await Payments.ListAsync();
        _filings = await Payments.FilingsAsync();
        _exempt = await Reports.ExemptCustomersAsync();
        _owed = await Payments.OwedAsync(_today);
        _agencyNames = _agencies.ToDictionary(a => a.Id, a => a.Name);
        _rateById = _rates.ToDictionary(r => r.Id);
    }
}
