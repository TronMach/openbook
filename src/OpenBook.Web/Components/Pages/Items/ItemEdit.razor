@page "/items/new"
@page "/items/{Id:guid}"
@using System.ComponentModel.DataAnnotations
@using OpenBook.Application.Inventory
@using OpenBook.Domain.Inventory
@inject OpenBook.Application.IRecordVersions Versions
@inject ItemService ItemService
@inject VendorService VendorService
@inject AccountService AccountService
@inject InventoryService Inventory
@inject WarehouseService WarehouseService
@inject ViewModeService Views
@inject ICompanyStore Companies
@inject OpenBook.Application.SalesTax.SalesTaxService Taxes
@inject NavigationManager Navigation

<PageTitle>@(_item?.Name ?? "New product or service") · OpenBook</PageTitle>

@if (Id is not null && _item is null)
{
    <div class="card"><p>That item doesn't exist. <a href="/items">Back to products and services</a>.</p></div>
    return;
}

<div class="card">
    <h1>@(_item is null ? "New product or service" : "Edit product or service")</h1>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (_item is { IsActive: false })
    {
        <div class="alert notice" role="status">This item is inactive and can't be used on new sales.</div>
    }
    @if (_incomeAccounts.Count == 0)
    {
        <div class="alert error" role="alert">There are no income accounts yet. <ActionLink Href="/accounts/new">Add one</ActionLink> first.</div>
    }

    <EditForm Model="Input" FormName="item" OnValidSubmit="SaveAsync" method="post">

        <input type="hidden" name="Input.Version" value="@Input.Version" />
        <DataAnnotationsValidator />
        <div class="row">
            <div class="field">
                <label for="name">Name</label>
                <InputText id="name" @bind-Value="Input.Name" />
                <ValidationMessage For="() => Input.Name" />
            </div>
            <div class="field">
                <label for="type">@(_simple ? "What is it?" : "Type")</label>
                <InputSelect id="type" @bind-Value="Input.Type">
                    @foreach (var type in Enum.GetValues<ItemType>())
                    {
                        <option value="@type">@Labels.For(type)</option>
                    }
                </InputSelect>
                @if (_simple)
                {
                    <span class="hint">A service is work you do. Choose "Inventory product" for something you keep in stock and want counted.</span>
                }
            </div>
        </div>
        <div class="row">
            <div class="field">
                <label for="description">Description on sales forms <span class="muted">(optional)</span></label>
                <InputText id="description" @bind-Value="Input.Description" />
            </div>
            <div class="field">
                <label for="category">Category <span class="muted">(optional)</span></label>
                <InputText id="category" @bind-Value="Input.Category" maxlength="50" list="categories" placeholder="Mugs, Consulting…" />
                <datalist id="categories">
                    @foreach (var c in _categories)
                    {
                        <option value="@c"></option>
                    }
                </datalist>
            </div>
            <div class="field">
                <label for="barcode">Barcode <span class="muted">(optional)</span></label>
                <InputText id="barcode" @bind-Value="Input.Barcode" maxlength="50" autocomplete="off" />
                <span class="hint">UPC, EAN or your own code. Scanning it into an item picker chooses this item.
                    @if (_item?.Barcode is not null)
                    {
                        <a href="/inventory/labels?item=@_item.Id">Print labels</a>
                    }
                </span>
            </div>
        </div>
        <div class="row">
            <div class="field">
                <label for="rate">@(_simple ? "What do you sell it for?" : "Price")</label>
                <InputNumber id="rate" step="any" @bind-Value="Input.Rate" />
                <span class="hint">Up to 4 decimal places; line totals round to the cent.</span>
            </div>
            @if (!_simple)
            {
                @IncomeField
            }
        </div>
        <label class="check">
            <InputCheckbox @bind-Value="Input.Taxable" />
            <span>Taxable: charge sales tax on it where the customer or document has a tax code</span>
        </label>
        <fieldset>
            <legend>@(_simple ? "If you keep it in stock" : "Inventory products and assemblies only")</legend>
            @if (_simple)
            {
                <p class="hint">For inventory products and assemblies: OpenBook counts what's on hand and what it cost.</p>
            }
            else
            {
                <p class="hint">Stock and its cost are tracked: bills and builds add stock, sales take it out at cost. Leave the accounts on "Default" to use Inventory Asset and Cost of Goods Sold.</p>
                @StockAccounts
                @AutoBuildField
            }
            <div class="row">
                @if (!_simple)
                {
                    @TrackingFields
                }
                <div class="field">
                    <label for="purchase-cost">@(_simple ? "What does it cost you?" : "Purchase cost")</label>
                    <InputNumber id="purchase-cost" step="any" @bind-Value="Input.PurchaseCost" />
                    <span class="hint">Default unit cost for stock added by adjustments.</span>
                </div>
                <div class="field">
                    <label for="reorder">@(_simple ? "Reorder when you're down to" : "Reorder point") <span class="muted">(optional)</span></label>
                    <InputNumber id="reorder" step="any" @bind-Value="Input.ReorderPoint" />
                    <span class="hint">Flagged for reordering at or below this quantity.</span>
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label for="reorder-quantity">@(_simple ? "How many to order then" : "Reorder quantity") <span class="muted">(optional)</span></label>
                    <InputNumber id="reorder-quantity" step="any" @bind-Value="Input.ReorderQuantity" />
                    <span class="hint">Suggested when reordering. Leave blank to order back up to the reorder point.</span>
                </div>
                <div class="field">
                    <label for="lead-time">@(_simple ? "Days it takes to arrive" : "Lead time in days") <span class="muted">(optional)</span></label>
                    <InputNumber id="lead-time" @bind-Value="Input.LeadTimeDays" />
                    <span class="hint">With what it sold over the last 90 days, it's flagged for reordering while there's still enough to last until a new order arrives.</span>
                </div>
                <div class="field">
                    <label for="preferred-vendor">@(_simple ? "Who do you buy it from?" : "Preferred vendor") <span class="muted">(optional)</span></label>
                    <InputSelect id="preferred-vendor" @bind-Value="Input.PreferredVendorId" data-search>
                        <option value="">None</option>
                        @foreach (var v in _vendors)
                        {
                            <option value="@v.Id">@v.DisplayName</option>
                        }
                    </InputSelect>
                    <span class="hint"><ActionLink Href="/purchases/reorder">Reorder stock</ActionLink> puts it on a purchase order to them.</span>
                </div>
            </div>
        </fieldset>
        @if (_simple)
        {
            <MoreOptions Open="AccountingChanged" Title="More options: accounts and stock tracking">
                <div class="row">@IncomeField</div>
                <p class="hint">Leave the stock accounts on "Default" to use Inventory Asset and Cost of Goods Sold.</p>
                @StockAccounts
                @AutoBuildField
                <div class="row">@TrackingFields</div>
            </MoreOptions>
        }
        <div class="actions">
            <button type="submit">@(_item is null ? "Create" : "Save changes")</button>
            <a href="/items">Cancel</a>
        </div>
    </EditForm>

    @if (_item is not null)
    {
        <form method="post" @formname="toggle-active" @onsubmit="ToggleActiveAsync" style="margin-top: 1rem">
            <AntiforgeryToken />
            <button type="submit" class="secondary">@(_item.IsActive ? "Make inactive" : "Make active")</button>
        </form>
    }
</div>

@if (_item is not null)
{
    <div class="card">
        <div class="toolbar">
            <h2>Quantity breaks</h2>
            <a href="/pricing">Price levels and rules</a>
        </div>
        @if (BreakError is not null)
        {
            <div class="alert error" role="alert">@BreakError</div>
        }
        <p class="muted">
            Volume pricing on automatically priced lines, by this item's total quantity on the document (all its lines together). Applied after
            the customer's price level; a unit price break never raises the price.
        </p>
        <PostForm Action="@($"/pricing/items/{_item.Id}/breaks")">
            <AntiforgeryToken />
            <table class="data entry">
                <thead><tr><th class="num">From quantity</th><th>Break</th><th class="num">Percent off or unit price</th></tr></thead>
                <tbody>
                    @for (var n = 0; n < _item.QuantityBreaks.Count + 3; n++)
                    {
                        var b = n < _item.QuantityBreaks.Count ? _item.QuantityBreaks[n] : null;
                        <tr>
                            <td><input class="amount" name="from@(n)" aria-label="From quantity" inputmode="decimal" value="@(b?.FromQuantity.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))" /></td>
                            <td>
                                <select name="kind@(n)" aria-label="Break type">
                                    @foreach (var k in Enum.GetValues<QuantityBreakKind>())
                                    {
                                        <option value="@k" selected="@(b?.Kind == k)">@Labels.For(k)</option>
                                    }
                                </select>
                            </td>
                            <td><input class="amount" name="value@(n)" aria-label="Percent off or unit price" inputmode="decimal" value="@(b?.Value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="actions"><button type="submit" class="secondary">Save quantity breaks</button></div>
        </PostForm>
    </div>
}

@if (_item is not null && Item.HasComponents(_item.Type))
{
    <div class="card" id="components">
        <div class="toolbar">
            <h2>@(_item.IsAssembly ? "Bill of materials" : "Bundle contents")</h2>
            @if (_item.IsAssembly)
            {
                <ActionLink Href="@($"/inventory/builds/new?item={_item.Id}")">Build</ActionLink>
            }
        </div>
        @if (ComponentError is not null)
        {
            <div class="alert error" role="alert">@ComponentError</div>
        }
        else if (ComponentsSaved is not null)
        {
            <div class="alert success" role="status">Saved.</div>
        }
        <p class="muted">
            @if (_item.IsAssembly)
            {
                <span>What goes into one @_item.Name. A build takes these from stock (inventory products and other assemblies) at their cost and adds finished units at the total.</span>
            }
            else
            {
                <span>What one @_item.Name contains. It sells as one line at its own price; inventory products in it leave stock and their cost goes to cost of goods sold.
                    A bundle keeps no stock of its own: for kits you keep pre-packed on the shelf, make an assembly instead (it can build itself when a sale is short).</span>
            }
        </p>
        <PostForm Action="@($"/items/{_item.Id}/components")" data-enhance="false">
            <AntiforgeryToken />
            <table class="data entry">
                <thead><tr><th>Item</th><th class="num">Quantity per unit</th></tr></thead>
                <tbody>
                    @for (var n = 0; n < _item.Components.Count + 3; n++)
                    {
                        var c = n < _item.Components.Count ? _item.Components[n] : null;
                        <tr>
                            <td>
                                <select name="component@(n)" aria-label="Component @(n + 1)" data-search>
                                    <option value="">Choose…</option>
                                    @foreach (var candidate in _componentChoices)
                                    {
                                        <option value="@candidate.Id" selected="@(c?.ComponentItemId == candidate.Id)">@candidate.Name</option>
                                    }
                                </select>
                            </td>
                            <td><input class="amount" name="quantity@(n)" aria-label="Quantity of component @(n + 1)" inputmode="decimal" value="@(c?.Quantity.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="actions"><button type="submit" class="secondary">Save components</button></div>
        </PostForm>
    </div>
}

@if (_item is { IsInventory: true } && _stock is not null)
{
    <div class="card">
        <div class="toolbar">
            <h2>Stock</h2>
            <ActionLink Href="@($"/inventory/adjustments/new?item={_item.Id}")">Adjust quantity</ActionLink>
            <a href="/reports/inventory-valuation?detail=true">Valuation</a>
        </div>
        <p>
            <strong>@Labels.Quantity(_stock.Quantity)</strong> on hand, worth @Labels.Amount(_stock.Value)
            @if (_stock.AverageCost is { } average)
            {
                <span class="muted"> (@Labels.Amount(average) each on average)</span>
            }
            @if (_stock.NeedsReorder)
            {
                <span class="badge warn">Low</span>
            }
        </p>
        @if (_byPlace.Count > 0 && (_byPlace.Count > 1 || _byPlace[0].Lot is not null || _byPlace[0].Place != OpenBook.Domain.Inventory.StockPlace.Default))
        {
            <table class="data">
                <thead><tr><th>Where</th>@if (_item.Tracking != ItemTracking.None) { <th>@(_item.Tracking == ItemTracking.Serial ? "Serial" : "Lot")</th><th>Received</th> }<th class="num">On hand</th><th class="num">Value</th></tr></thead>
                <tbody>
                    @foreach (var s in _byPlace.OrderBy(p => _place(p.Place)).ThenBy(p => p.Received).ThenBy(p => p.Lot))
                    {
                        <tr>
                            <td>@_place(s.Place)</td>
                            @if (_item.Tracking != ItemTracking.None)
                            {
                                <td><a href="/inventory?lot=@Uri.EscapeDataString(s.Lot ?? "")">@s.Lot</a></td>
                                <td>@Labels.Date(s.Received)</td>
                            }
                            <td class="num">@Labels.Quantity(s.Quantity)</td>
                            <td class="num">@Labels.Amount(s.Value)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p><ActionLink Href="@($"/inventory/transfers/new?item={_item.Id}")">Transfer stock</ActionLink></p>
        }
        @if (_item.Tracking == ItemTracking.Lot && _byPlace.Any(p => p.Lot is not null))
        {
            <h3 id="lots">Lot expiry dates</h3>
            @if (LotError is not null)
            {
                <div class="alert error" role="alert">@LotError</div>
            }
            else if (LotsSaved is not null)
            {
                <div class="alert success" role="status">Saved.</div>
            }
            <p class="muted">Sales and transfers that don't name a lot take the one that expires first and skip expired lots.</p>
            <table class="data">
                <thead><tr><th>Lot</th><th class="num">On hand</th><th>Expires</th></tr></thead>
                <tbody>
                    @foreach (var lot in _byPlace.Where(p => p.Lot is not null).GroupBy(p => p.Lot!, StringComparer.OrdinalIgnoreCase).OrderBy(g => g.Key))
                    {
                        var expires = _expiries.TryGetValue(lot.Key, out var e) ? e : (DateOnly?)null;
                        <tr>
                            <td>@lot.Key</td>
                            <td class="num">@Labels.Quantity(lot.Sum(p => p.Quantity))</td>
                            <td>
                                <PostForm Action="@($"/items/{_item.Id}/lots/expiry")" data-enhance="false" class="inline">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="lot" value="@lot.Key" />
                                    <input type="date" name="expiresOn" value="@expires?.ToString("yyyy-MM-dd")" aria-label="Expiry of lot @lot.Key" />
                                    <button type="submit" class="secondary">Save</button>
                                    @if (expires is { } date && date < CompanyTime.Today)
                                    {
                                        <span class="badge warn">Expired</span>
                                    }
                                </PostForm>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (_movements.Count == 0)
        {
            <p class="muted">No stock yet. Enter a bill with this item, or <ActionLink Href="@($"/inventory/adjustments/new?item={_item.Id}")">add starting stock</ActionLink>.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Date</th><th>From</th><th class="num">Quantity</th><th class="num">Cost</th><th class="num">On hand</th></tr></thead>
                    <tbody>
                        @{ var running = 0m; }
                        @foreach (var group in Grouped())
                        {
                            var first = group[0];
                            running += group.Sum(m => m.Quantity);
                            <tr class="@(first.ReversalOf is null ? null : "inactive")">
                                <td>@Labels.Date(first.Date)</td>
                                <td><a href="@Links.ForAuditEntity(first.SourceType, first.SourceId)">@SourceName(first)</a></td>
                                <td class="num">@Labels.Quantity(group.Sum(m => m.Quantity))</td>
                                <td class="num">@Labels.Amount(group.Sum(m => m.Cost))</td>
                                <td class="num">@Labels.Quantity(running)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}


@if (_item is not null)
{
    <CustomFieldPanel EntityType="item" EntityId="_item.Id" />
    <Notes EntityType="item" EntityId="_item.Id" />
    @if (!_item.IsInventory && !_item.IsBundle)
    {
        <MergeCard Kind="items" Id="_item.Id" Name="@_item.Name" />
    }
}

@code {
    private Item? _item;
    private IReadOnlyList<Vendor> _vendors = [];
    private ChartOfAccounts _chart = new([]);
    private List<Account> _incomeAccounts = [];
    private List<Account> _liabilities = [];
    private IReadOnlyList<string> _categories = [];
    private List<Account> _assetAccounts = [];
    private List<Account> _costAccounts = [];
    private StockLevel? _stock;
    private IReadOnlyList<InventoryMovement> _movements = [];
    private List<Item> _componentChoices = [];
    private IReadOnlyList<StockAt> _byPlace = [];
    private IReadOnlyDictionary<string, DateOnly> _expiries = new Dictionary<string, DateOnly>();

    [SupplyParameterFromQuery]
    public string? LotError { get; set; }

    [SupplyParameterFromQuery(Name = "lots")]
    public string? LotsSaved { get; set; }
    private Func<OpenBook.Domain.Inventory.StockPlace, string> _place = _ => "";
    private bool _assetLocked;
    private string? _error;

    [Parameter]
    public Guid? Id { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? BreakError { get; set; }

    [SupplyParameterFromQuery]
    public string? ComponentError { get; set; }

    [SupplyParameterFromQuery(Name = "components")]
    public string? ComponentsSaved { get; set; }

    [SupplyParameterFromForm(FormName = "item")]
    private ItemModel Input { get; set; } = default!;

    // The simple view asks plain questions and folds the accounts and stock tracking under "More options".
    private bool _simple;
    private bool _sellShortAllowed;

    // Anything under "More options" away from its default opens it, so a record's choices stay in sight.
    private bool AccountingChanged =>
        Input.IncomeAccountId is null || Input.IncomeAccountId != _incomeAccounts.FirstOrDefault()?.Id
        || Input.InventoryAssetAccountId is not null || Input.CostAccountId is not null
        || Input.Tracking != ItemTracking.None || Input.CostMethod != InventoryCostMethod.Fifo || Input.AutoBuild || Input.SellShort != ShortStock.Company;

    private RenderFragment IncomeField => @<div class="field">
        <label for="account">Income account</label>
        <InputSelect id="account" @bind-Value="Input.IncomeAccountId" data-search>
            <option value="">Choose…</option>
            @foreach (var account in _incomeAccounts)
            {
                <option value="@account.Id">@_chart.FullName(account.Id)</option>
            }
            @if (_liabilities.Count > 0 && Input.Type is ItemType.Service or ItemType.NonInventory)
            {
                <optgroup label="Liabilities (gift cards and the like)">
                    @foreach (var account in _liabilities)
                    {
                        <option value="@account.Id">@_chart.FullName(account.Id)</option>
                    }
                </optgroup>
            }
        </InputSelect>
        <ValidationMessage For="() => Input.IncomeAccountId" />
    </div>;

    private RenderFragment StockAccounts => @<div class="row">
        <div class="field">
            <label for="asset">Inventory asset account</label>
            <InputSelect id="asset" @bind-Value="Input.InventoryAssetAccountId" disabled="@_assetLocked" data-search>
                <option value="">Default (Inventory Asset)</option>
                @foreach (var account in _assetAccounts)
                {
                    <option value="@account.Id">@_chart.FullName(account.Id)</option>
                }
            </InputSelect>
            @if (_assetLocked)
            {
                <span class="hint">Fixed once stock has moved.</span>
            }
        </div>
        <div class="field">
            <label for="cost-account">Cost of goods sold account</label>
            <InputSelect id="cost-account" @bind-Value="Input.CostAccountId" data-search>
                <option value="">Default (Cost of Goods Sold)</option>
                @foreach (var account in _costAccounts)
                {
                    <option value="@account.Id">@_chart.FullName(account.Id)</option>
                }
            </InputSelect>
        </div>
    </div>;

    private RenderFragment AutoBuildField => @<text>
        @if (Input.Type == ItemType.Assembly)
        {
            <label class="check">
                <InputCheckbox @bind-Value="Input.AutoBuild" />
                <span>Build automatically when a sale is short: the shortfall is built from components in the sale's own entry (assemblies without lot or serial numbers)</span>
            </label>
        }
    </text>;

    private RenderFragment TrackingFields => @<text>
        <div class="field">
            <label for="tracking">Lot or serial numbers</label>
            <InputSelect id="tracking" @bind-Value="Input.Tracking" disabled="@_assetLocked">
                <option value="@ItemTracking.None">Not tracked</option>
                <option value="@ItemTracking.Lot">Lot numbers</option>
                <option value="@ItemTracking.Serial">Serial numbers</option>
            </InputSelect>
            <span class="hint">@(_assetLocked ? "Fixed once stock has moved." : "Receipts must name their lots or serials; sales can name them or take the oldest.")</span>
        </div>
        <div class="field">
            <label for="cost-method">Costing</label>
            <InputSelect id="cost-method" @bind-Value="Input.CostMethod" disabled="@_assetLocked">
                @foreach (var method in Enum.GetValues<InventoryCostMethod>())
                {
                    <option value="@method">@Labels.For(method)</option>
                }
            </InputSelect>
            <span class="hint">@(_assetLocked ? "Fixed once stock has moved." : "Average costs every sale at the average of what's on hand.")</span>
        </div>
        <div class="field">
            <label for="sell-short">Selling more than is on hand</label>
            <InputSelect id="sell-short" @bind-Value="Input.SellShort">
                <option value="@ShortStock.Company">@(_sellShortAllowed ? "Allowed (the company's setting)" : "Not allowed (the company's setting)")</option>
                <option value="@ShortStock.Allow">Always allowed</option>
                <option value="@ShortStock.Never">Never allowed</option>
            </InputSelect>
            <span class="hint">When allowed, the count goes below zero and the cost is corrected when stock comes in. Not for lot or serial numbers.</span>
        </div>
    </text>;

    protected override async Task OnInitializedAsync()
    {
        var opened = Id is { } version ? await Versions.GetAsync<Item>(version) : null;
        _simple = (await Views.CurrentAsync()).Mode == OpenBook.Domain.Companies.ViewMode.Simple;
        _sellShortAllowed = (await Companies.GetCompanyAsync(default))?.AllowSellingShort ?? false;
        _chart = await AccountService.GetChartAsync();
        _incomeAccounts = _chart.Ordered(includeInactive: false).Select(x => x.Account).Where(a => a.Type.ClassOf() == AccountClass.Income).ToList();
        // Sales tax liabilities (and the account above them) belong to the tax agencies, not to items.
        var taxAccounts = (await Taxes.ListAgenciesAsync()).Select(t => t.LiabilityAccountId).ToHashSet();
        var taxParents = taxAccounts.Select(id => _chart.Find(id)?.ParentId).OfType<Guid>().ToHashSet();
        _categories = [.. (await ItemService.ListAsync(includeInactive: true)).Select(i => i.Category).OfType<string>().Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.CurrentCultureIgnoreCase)];
        _liabilities = _chart.Ordered(includeInactive: false).Select(x => x.Account)
            .Where(a => a.Type == AccountType.OtherCurrentLiability && !taxAccounts.Contains(a.Id) && !taxParents.Contains(a.Id)).ToList();
        _assetAccounts = _chart.Ordered(includeInactive: false).Select(x => x.Account).Where(a => a.Type == AccountType.OtherCurrentAsset).ToList();
        _costAccounts = _chart.Ordered(includeInactive: false).Select(x => x.Account).Where(a => a.Type.ClassOf() == AccountClass.Expense).ToList();
        _item = Id is { } id ? await ItemService.GetAsync(id) : null;
        if (_item is not null && Item.HasComponents(_item.Type))
        {
            // Bundles hold anything but bundles; assemblies are built from tracked stock.
            var chosen = _item.Components.Select(c => c.ComponentItemId).ToHashSet();
            _componentChoices = (await ItemService.ListAsync(includeInactive: true))
                .Where(i => i.Id != _item.Id && !i.IsBundle && (!_item.IsAssembly || i.IsInventory) && (i.IsActive || chosen.Contains(i.Id)))
                .ToList();
        }
        if (_item is { IsInventory: true })
        {
            _stock = await Inventory.StockForAsync(_item.Id);
            _movements = await Inventory.MovementsAsync(_item.Id);
            _byPlace = await Inventory.StockByPlaceAsync(_item.Id);
            _expiries = await Inventory.ExpiriesAsync(_item.Id);
            _place = await WarehouseService.NamerAsync();
            _assetLocked = _movements.Count > 0;
        }

        Input ??= _item is null
            ? new ItemModel { IncomeAccountId = _incomeAccounts.FirstOrDefault()?.Id, Taxable = true }
            : new ItemModel
            {
                Name = _item.Name, Type = _item.Type, Description = _item.Description, Rate = _item.Rate, IncomeAccountId = _item.IncomeAccountId, Taxable = _item.Taxable,
                InventoryAssetAccountId = _item.InventoryAssetAccountId, CostAccountId = _item.CostAccountId, ReorderPoint = _item.ReorderPoint, PurchaseCost = _item.PurchaseCost,
                CostMethod = _item.CostMethod, Tracking = _item.Tracking, Barcode = _item.Barcode, Category = _item.Category, AutoBuild = _item.AutoBuild, SellShort = _item.SellShort,
                PreferredVendorId = _item.PreferredVendorId, ReorderQuantity = _item.ReorderQuantity, LeadTimeDays = _item.LeadTimeDays,
            };
        Input.Version ??= opened;
        _vendors = (await VendorService.ListAsync(CompanyTime.Today, includeInactive: true)).Select(v => v.Vendor)
            .Where(v => v.IsActive || v.Id == _item?.PreferredVendorId).ToList();
    }

    /// <summary>One row per document (a sale can take from several layers), in order.</summary>
    private List<List<InventoryMovement>> Grouped() => _movements
        .GroupBy(m => (m.Date, m.SourceType, m.SourceId, Reversal: m.ReversalOf is not null))
        .Select(g => g.ToList())
        .ToList();

    private static string SourceName(InventoryMovement m) => (m.SourceType, m.ReversalOf is null) switch
    {
        (InventorySources.Bill, true) => "Bill",
        (InventorySources.Invoice, true) => "Invoice",
        (InventorySources.SalesReceipt, true) => "Sales receipt",
        (InventorySources.CreditMemo, true) => "Credit memo (return)",
        (InventorySources.Adjustment, true) => "Adjustment",
        (InventorySources.AssemblyBuild, true) => "Assembly build",
        (InventorySources.LandedCost, true) => "Landed cost",
        (InventorySources.Transfer, true) => "Transfer",
        (InventorySources.PurchaseReceipt, true) => "Purchase order delivery",
        (InventorySources.ChannelOrders, true) => "Channel orders",
        (InventorySources.ChannelReturn, true) => "Channel return",
        (InventorySources.VendorCredit, true) => "Sent back to the vendor",
        (_, true) => "Document",
        _ => "Voided",
    };

    private async Task SaveAsync()
    {
        try
        {
            // A disabled select doesn't post, so a locked asset account keeps the saved one.
            var asset = _assetLocked ? _item!.InventoryAssetAccountId : Input.InventoryAssetAccountId;
            var method = _assetLocked ? _item!.CostMethod : Input.CostMethod;
            var tracking = _assetLocked ? _item!.Tracking : Input.Tracking;
            var details = new ItemDetails(Input.Name, Input.Type, Input.IncomeAccountId!.Value, Input.Rate ?? 0m, Input.Description, Input.Taxable,
                asset, Input.CostAccountId, Input.ReorderPoint, Input.PurchaseCost ?? 0m, method, tracking, Input.Barcode, Input.AutoBuild, Input.SellShort,
                Input.PreferredVendorId, Input.ReorderQuantity, Input.LeadTimeDays, Input.Category ?? "");
            await Versions.EnsureUnchangedAsync<Item>(_item?.Id ?? Guid.Empty, Input.Version);
            var saved = _item is null ? await ItemService.CreateAsync(details) : await ItemService.UpdateAsync(_item.Id, details);
            // A new bundle or assembly goes straight on to its components.
            Navigation.NavigateTo(_item is null && Item.HasComponents(saved.Type) ? $"/items/{saved.Id}#components" : "/items");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ToggleActiveAsync()
    {
        await ItemService.SetActiveAsync(_item!.Id, !_item.IsActive);
        Navigation.NavigateTo($"/items/{_item.Id}");
    }

    private sealed class ItemModel
    {
        /// <summary>The record's version when the form opened.</summary>
        public int? Version { get; set; }

        [Required(ErrorMessage = "Enter a name.")]
        [StringLength(100)]
        public string Name { get; set; } = string.Empty;

        public ItemType Type { get; set; } = ItemType.Service;

        [StringLength(1000)]
        public string? Description { get; set; }

        public decimal? Rate { get; set; }

        [Required(ErrorMessage = "Choose an income account.")]
        public Guid? IncomeAccountId { get; set; }

        public bool Taxable { get; set; }

        public Guid? InventoryAssetAccountId { get; set; }

        public Guid? CostAccountId { get; set; }

        public decimal? ReorderPoint { get; set; }

        public decimal? PurchaseCost { get; set; }

        public InventoryCostMethod CostMethod { get; set; }

        public ItemTracking Tracking { get; set; }

        public bool AutoBuild { get; set; }

        public ShortStock SellShort { get; set; }

        [StringLength(50)]
        public string? Barcode { get; set; }
        public string? Category { get; set; }

        public Guid? PreferredVendorId { get; set; }

        public decimal? ReorderQuantity { get; set; }

        public int? LeadTimeDays { get; set; }
    }
}
