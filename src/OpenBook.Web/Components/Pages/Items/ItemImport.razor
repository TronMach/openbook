@page "/items/import"
@rendermode InteractiveServer
@inject Operations Ops

<PageTitle>Import products and services · OpenBook</PageTitle>

<div class="wide">
    <div class="toolbar">
        <h1>Import products and services</h1>
        <ActionLink Class="button secondary" Href="/items">Back to products and services</ActionLink>
    </div>

    <div class="card">
        <p>
            Upload a CSV with a header row. A <strong>name</strong> column is required. Type ("Service" or "Non-inventory"),
            description, price, income account (full name or number) and columns named after your custom fields are used when present. Rows without an
            income account use the default below. Items already in OpenBook are skipped; nothing is imported unless every row is valid.
        </p>
        <div class="row">
            <div class="field">
                <label for="default-account">Default income account</label>
                <select id="default-account" value="@_defaultAccountId" @onchange="ChangeDefaultAsync">
                    <option value="">None</option>
                    @foreach (var account in _incomeAccounts)
                    {
                        <option value="@account.Id">@_chart.FullName(account.Id)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="file">CSV file</label>
                <InputFile id="file" accept=".csv,text/csv" OnChange="LoadAsync" disabled="@_busy" />
            </div>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }
    @if (_imported is not null)
    {
        <div class="alert notice" role="status">Imported @_imported.NewCount item(s). <a href="/items">View products and services</a>.</div>
    }

    @if (_preview is not null && _imported is null)
    {
        <div class="import-summary">
            <span><span class="badge ok">@_preview.NewCount</span> new</span>
            <span><span class="badge">@_preview.ExistingCount</span> already exist</span>
            <span><span class="badge @(_preview.ErrorCount > 0 ? "warn" : null)">@_preview.ErrorCount</span> with errors</span>
        </div>
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th class="num">Line</th><th>Status</th><th>Name</th><th>Type</th><th class="num">Price</th><th>Income account</th><th>Note</th></tr></thead>
                <tbody>
                    @foreach (var row in _preview.Rows)
                    {
                        <tr class="@(row.Status == ImportRowStatus.Exists ? "inactive" : null)">
                            <td class="num">@row.Line</td>
                            <td><span class="badge @(row.Status switch { ImportRowStatus.New => "ok", ImportRowStatus.Error => "warn", _ => null })">@Labels.For(row.Status)</span></td>
                            <td>@row.Details?.Name</td>
                            <td>@(row.Details is { } d ? Labels.For(d.Type) : null)</td>
                            <td class="num">@row.Details?.Rate.ToString("#,##0.00##")</td>
                            <td>@row.IncomeAccountName</td>
                            <td class="out-of-balance">@row.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="actions">
            <button type="button" @onclick="ImportAsync" disabled="@(!_preview.CanImport || _busy)">Import @_preview.NewCount item(s)</button>
        </div>
    }
</div>

@code {
    private ChartOfAccounts _chart = new([]);
    private List<Account> _incomeAccounts = [];
    private Guid? _defaultAccountId;
    private string? _csv;
    private ImportResult<ItemImportRow>? _preview;
    private ImportResult<ItemImportRow>? _imported;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _chart = await Ops.RunAsync<AccountService, ChartOfAccounts>(s => s.GetChartAsync());
        _incomeAccounts = _chart.Ordered(includeInactive: false).Select(x => x.Account).Where(a => a.Type.ClassOf() == AccountClass.Income).ToList();
    }

    private async Task LoadAsync(InputFileChangeEventArgs e)
    {
        _imported = null;
        try
        {
            await using var stream = e.File.OpenReadStream(5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            _csv = await reader.ReadToEndAsync();
        }
        catch (IOException)
        {
            _error = "That file is larger than 5 MB.";
            return;
        }

        await PreviewAsync();
    }

    private async Task ChangeDefaultAsync(ChangeEventArgs e)
    {
        _defaultAccountId = Guid.TryParse(e.Value as string, out var id) ? id : null;
        await PreviewAsync();
    }

    private async Task PreviewAsync()
    {
        if (_csv is null)
            return;
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            _preview = await Ops.RunAsync<ItemImportService, ImportResult<ItemImportRow>>(s => s.PreviewAsync(_csv, _defaultAccountId));
        }
        catch (DomainException ex)
        {
            _preview = null;
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            _imported = await Ops.RunAsync<ItemImportService, ImportResult<ItemImportRow>>(s => s.ImportAsync(_csv!, _defaultAccountId));
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
