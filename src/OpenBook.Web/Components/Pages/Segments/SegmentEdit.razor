@page "/segments/{Id:guid}"
@using System.ComponentModel.DataAnnotations
@using OpenBook.Application.Segments
@using OpenBook.Domain.Segments
@inject SegmentService Segments
@inject NavigationManager Navigation

<PageTitle>@(_segment?.Name ?? "Segment") · OpenBook</PageTitle>

<div class="card">
    <div class="toolbar">
        <h1>@(_segment?.Name ?? "Not found")</h1>
        <ActionLink Class="button secondary" Href="/segments">Back</ActionLink>
        @if (_segment is not null)
        {
            <a class="button secondary" href="@ReportLink">Profit and loss</a>
            <ActionLink Class="button secondary" Href="@($"/audit?entityId={_segment.Id}")">History</ActionLink>
        }
    </div>

    @if (_error is not null)
    {
        <div class="alert error" role="alert">@_error</div>
    }

    @if (_segment is null)
    {
        <p>That class, location or tag doesn't exist. <a href="/segments">Back</a>.</p>
    }
    else
    {
        <p class="muted">@(_segment.Kind == SegmentKind.Location ? _label : _segment.Kind.ToString())@(_segment.IsActive ? "" : " · inactive")</p>
        <EditForm Model="Input" FormName="segment" OnValidSubmit="SaveAsync" method="post"><FormAccess>
            <DataAnnotationsValidator />
            <div class="row">
                <div class="field">
                    <label for="name">Name</label>
                    <InputText id="name" @bind-Value="Input.Name" />
                    <ValidationMessage For="() => Input.Name" />
                </div>
                @if (_segment.Kind != SegmentKind.Tag)
                {
                    <div class="field">
                        <label for="parent">Under</label>
                        <InputSelect id="parent" @bind-Value="Input.ParentId">
                            <option value="">(top level)</option>
                            @foreach (var s in _siblings.Where(s => s.Segment.Id != _segment.Id))
                            {
                                <option value="@s.Segment.Id">@s.FullName</option>
                            }
                        </InputSelect>
                    </div>
                }
            </div>
            <div class="actions"><button type="submit">Save</button></div>
        </FormAccess>
        </EditForm>

        @if (_segment.Kind == SegmentKind.Class)
        {
            <PostForm Action="@($"/segments/{_segment.Id}/functional-area")" data-enhance="false" style="margin-top: 1rem">
                <AntiforgeryToken />
                <div class="field">
                    <label for="area">Functional area <span class="muted">(nonprofits)</span></label>
                    <select id="area" name="area">
                        <option value="">(the parent class's, or not assigned)</option>
                        @foreach (var area in Enum.GetValues<FunctionalArea>())
                        {
                            <option value="@area" selected="@(_segment.FunctionalArea == area)">@OpenBook.Domain.Nonprofit.FunctionalAreas.Label(area)</option>
                        }
                    </select>
                    <span class="hint">Where this class's expenses go on the statement of functional expenses.</span>
                </div>
                <div class="actions"><button type="submit" class="secondary">Save area</button></div>
            </PostForm>
        }

        <form method="post" @formname="toggle" @onsubmit="ToggleAsync" style="margin-top: 1rem"><FormAccess>
            <AntiforgeryToken />
            <button type="submit" class="secondary">@(_segment.IsActive ? "Make inactive" : "Make active")</button>
        </FormAccess>
        </form>
    }
</div>

@code {
    private Segment? _segment;
    private IReadOnlyList<SegmentChoice> _siblings = [];
    private string _label = "Location";
    private string? _error;

    [SupplyParameterFromQuery(Name = "error")]
    private string? QueryError { get; set; }

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "segment")]
    private SegmentModel Input { get; set; } = default!;

    private string ReportLink => _segment!.Kind switch
    {
        SegmentKind.Class => $"/reports/profit-and-loss?classId={_segment.Id}",
        SegmentKind.Location => $"/reports/profit-and-loss?locationId={_segment.Id}",
        _ => $"/reports/profit-and-loss?tagId={_segment.Id}",
    };

    protected override async Task OnInitializedAsync()
    {
        _error ??= QueryError;
        _segment = await Segments.GetAsync(Id);
        if (_segment is null)
            return;
        // Its own parent stays on offer though inactive: missing from the list, it would save as top level.
        _siblings = (await Segments.ListAsync(_segment.Kind)).Where(s => s.Segment.IsActive || s.Segment.Id == _segment.ParentId).ToList();
        _label = (await Segments.GetTrackingAsync()).LocationLabel;
        Input ??= new SegmentModel { Name = _segment.Name, ParentId = _segment.ParentId };
    }

    private async Task SaveAsync()
    {
        try
        {
            await Segments.UpdateAsync(Id, Input.Name, Input.ParentId);
            Navigation.NavigateTo("/segments");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ToggleAsync()
    {
        try
        {
            await Segments.SetActiveAsync(Id, !_segment!.IsActive);
            Navigation.NavigateTo($"/segments/{Id}");
        }
        catch (DomainException ex)
        {
            _error = ex.Message;
        }
    }

    private sealed class SegmentModel
    {
        [Required(ErrorMessage = "Enter a name.")]
        [StringLength(100)]
        public string Name { get; set; } = "";

        public Guid? ParentId { get; set; }
    }
}
