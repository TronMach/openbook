@using OpenBook.Application.Reporting
@inject NavigationManager Navigation
@* Export and save buttons for a report page; both carry the page's own query string. *@

@if (_saved is not null)
{
    <div class="alert notice no-print" role="status">Saved as "@_saved". Find it under <a href="/reports">Reports</a>.</div>
}
@if (_saveError is not null)
{
    <div class="alert error no-print" role="alert">@_saveError</div>
}

<div class="report-actions no-print">
    <span class="muted">Export</span>
    <a class="button secondary" href="@Export("csv")">CSV</a>
    <a class="button secondary" href="@Export("xlsx")">Excel</a>
    <a class="button secondary" href="@Export("pdf")" target="_blank" rel="noopener">PDF</a>
    <PostForm Action="/reports/saved" class="inline" data-enhance="false">
        <AntiforgeryToken />
        <input type="hidden" name="report" value="@Key" />
        <input type="hidden" name="query" value="@_query" />
        <input name="name" aria-label="Name for the saved report" placeholder="Name to save as" maxlength="100" required />
        <button type="submit" class="secondary">Save report</button>
    </PostForm>
</div>

@code {
    private string _query = string.Empty;
    private string? _saved;
    private string? _saveError;

    [Parameter, EditorRequired]
    public string Key { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        var all = ReportParameters.Parse(new Uri(Navigation.Uri).Query);
        _saved = all.Get("saved");
        _saveError = all.Get("saveError");
        _query = WithoutMessages(new Uri(Navigation.Uri).Query);
    }

    private string Export(string format) => $"/api/reports/{Key}/export?format={format}" + (_query.Length > 0 ? "&" + _query : "");

    /// <summary>The page's query string without the save messages, so they're never saved or exported.</summary>
    public static string WithoutMessages(string query) => string.Join('&', query.TrimStart('?')
        .Split('&', StringSplitOptions.RemoveEmptyEntries)
        .Where(pair => !pair.StartsWith("saved=", StringComparison.OrdinalIgnoreCase) && !pair.StartsWith("saveError=", StringComparison.OrdinalIgnoreCase)));
}
