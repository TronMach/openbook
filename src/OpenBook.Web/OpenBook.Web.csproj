<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OpenBook.Api\OpenBook.Api.csproj" />
    <ProjectReference Include="..\OpenBook.Infrastructure\OpenBook.Infrastructure.csproj" />
    <ProjectReference Include="..\OpenBook.Infrastructure.Postgres\OpenBook.Infrastructure.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.38.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- The user guide, shown in the app at /help (HelpGuide reads it from the help folder beside the app). -->
  <ItemGroup>
    <None Include="..\..\docs\user-guide\*.md" Link="help\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

</Project>
